# 팝콘PC AI — 쇼핑몰 가격 자동 갱신 (2026-10-11 신설 · 중헌 님 지시 「하루에 1~2회」)
#
# tools/mall_price_auto.py 한 번 = api/mall_price_auto.run('auto'):
#   쇼핑몰 가격 수집 -> 우리 판매가와 비교 -> 다르면 판매가 반영(가격 이력 · 되돌리기 가능) ->
#   실행 기록(mall_price_runs). 관리자 화면 /admin2/mall-price 「자동 갱신」에 마지막 결과가 보인다.
#
# popcorn-mall-sync(공급처 · A-124 로 꺼 둠)와는 다른 unit 이다. 그쪽이 꺼진 이유는 «미리 넣어 둔
# 세션 쿠키»가 며칠이면 만료돼 조용히 실패하기 때문이었다. 이 unit 은 쿠키를 저장하지 않는다:
#   · 기본은 공개 상품 페이지(익명) — 로그인이 필요 없다
#   · MALL_ADMIN_ID · MALL_ADMIN_PW · MALL_EXPORT_URL 이 셋 다 있으면 실행마다 새로 로그인해
#     관리자 상품엑셀을 받는다(쿠키는 프로세스 메모리에서만 산다). 근거 decision-log A-143.
#
# 실패 알림 — 이 unit 은 템플릿이 아니므로 %n 을 그대로 쓴다(popcorn-mall-sync.service 머리말 · A-112).

[Unit]
Description=팝콘PC AI 쇼핑몰 가격 자동 갱신
Documentation=file:///srv/popcorn-ai/docs/design/mall-price-sync.md
After=network-online.target
Wants=network-online.target
OnFailure=popcorn-notify-failure@%n.service

[Service]
Type=oneshot
User=popcorn
Group=popcorn
WorkingDirectory=/srv/popcorn-ai

# 비밀값은 이 파일에 쓰지 않는다 — /etc/popcorn-ai.env(권한 640, root:popcorn)에서 읽는다.
# 필요한 키: DATABASE_URL(이미 있음). 선택: MALL_ADMIN_ID · MALL_ADMIN_PW · MALL_EXPORT_URL ·
# MALL_EXPORT_DATA · MALL_PRICE_MAX_READS. 값을 다루는 것은 사람 몫이고 이 파일은 이름만 참조한다.
EnvironmentFile=/etc/popcorn-ai.env

# 공개 페이지 길: 판매중 완제품 PC 수 × 1.5초. 상한 MALL_PRICE_MAX_READS(기본 3000) × 1.5초 = 75분.
# 그 두 배를 둔다. 걸리면 journald 에 실패로 남고 OnFailure 가 알린다.
TimeoutStartSec=9000

ExecStart=/srv/popcorn-ai/.venv/bin/python /srv/popcorn-ai/tools/mall_price_auto.py

Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=popcorn-mall-price

# 최소 권한 — 파일시스템에 쓰지 않는다(정본 쓰기는 전부 DATABASE_URL 을 통한다).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
