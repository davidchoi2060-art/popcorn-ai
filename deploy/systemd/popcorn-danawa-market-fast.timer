# 팝콘PC AI — 다나와 시세 재수집 fast 그룹 타이머 (A-109: GPU·CPU·CPU쿨러 공랭/수랭,
# 주 1회, 2026-08-23). 부품 목록 자체는 여기서 정의하지 않는다 — 단일 원천은
# tools/danawa_fetch.py의 PART_GROUPS(.claude/CANON.md §1) — 이 타이머는 그 이름
# (fast)만 popcorn-danawa-market@fast.service 인스턴스로 넘긴다.
#
# ── ② fast·slow 겹침 회피 ────────────────────────────────────────────────────
# slow 타이머(popcorn-danawa-market-slow.timer)는 매월 1일 01:00 KST에 시작해
# 약 96분(정상 완주 시 ~02:36 KST 종료)이 걸린다. 1일이 마침 월요일이면 이
# fast 타이머와 같은 날이 되는데, 시작 시각을 05:00 KST로 갈라 두면 slow가
# 정상 종료(~02:36)한 뒤로도 fast 시작(05:00)까지 144분(2시간 24분) 여유가
# 남는다 — 두 프로세스가 동시에 다나와에 요청을 보내는 일이 없다(A-18 "요청
# 간격 1.5초·연속 실패 5회 중단"의 취지 — 요청이 겹치면 사실상 그 간격이
# 무너진다). 무거운 쪽(slow, 96분)을 먼저, 가벼운 쪽(fast, 37분)을 나중에 둔
# 이유이기도 하다 — slow가 새벽 앞자리를 넉넉히 쓰고 fast는 남는 시간에도
# 충분히 여유 있게(05:37경 종료) 끝난다.
# ⚠ 이 144분 여유는 "정상 완주" 기준이다. slow가 --limit 5000을 실제로 다
# 채우는 극단적 경우(이론상 최대 약 3.1시간, popcorn-danawa-market@.service
# 주석 참조)까지 가면 여유가 좁아진다 — 카탈로그가 그 정도로 커지면 이 시각도
# 함께 재조정한다.
#
# ── ③ KST 새벽 ────────────────────────────────────────────────────────────
# systemd 255는 OnCalendar에 시간대 접미사를 붙일 수 있다(이 syntax 자체는
# systemd 239부터 있어 안정적이다). 서버는 UTC로 돈다 — KST를 직접 적는 편이
# journalctl 타임스탬프(UTC로 찍힘)와 대조할 때도, 의도를 읽을 때도 오해가
# 없다. 아래 줄이 이 서버 systemd에서 실제로 유효한지는 설치 전 다음 명령으로
# 확인한다(deploy/README.md 절차 참조):
#   systemd-analyze calendar 'Mon *-*-* 05:00:00 Asia/Seoul'
# 문법이 거부되거나 Next elapse가 기대와 다르면, 위 줄을 주석 처리하고 아래
# UTC 대체 줄의 주석을 풀어 쓴다(월요일 05:00 KST = 일요일 20:00 UTC. UTC는
# 요일이 하루 당겨진다는 점에 주의 — Sun으로 적어야 한다).

[Unit]
Description=팝콘PC AI 다나와 시세 재수집 — fast 그룹(GPU·CPU·CPU쿨러, 주 1회, A-109)
Documentation=file:///srv/popcorn-ai/deploy/README.md

[Timer]
# UTC 대체(위 시간대 접미사 문법이 이 systemd에서 안 먹히면 아래 줄로 바꾸고
# 위 OnCalendar 줄은 주석 처리한다 — 바꾼 뒤 systemd-analyze calendar로 재검증):
# OnCalendar=Sun *-*-* 20:00:00
OnCalendar=Mon *-*-* 05:00:00 Asia/Seoul

# 서버가 꺼져 있어 이번 주 실행을 놓쳤으면 다음 기동 때 한 번 돌려 만회한다.
Persistent=true

# 정각 몰림 방지용으로 짧게만 둔다 — 위 ②의 144분 여유에 비하면 무시할 수
# 있는 폭이다(최대 5분 밀려도 안전 마진이 크게 줄지 않는다).
RandomizedDelaySec=300

# 템플릿 인스턴스를 명시한다 — 파일명(popcorn-danawa-market-fast.timer)과
# 같은 이름의 .service가 없으므로(템플릿 popcorn-danawa-market@.service를
# fast 인스턴스로 부르는 구조) 암묵적 이름 매칭에 기대지 않고 직접 적는다.
Unit=popcorn-danawa-market@fast.service

[Install]
WantedBy=timers.target
