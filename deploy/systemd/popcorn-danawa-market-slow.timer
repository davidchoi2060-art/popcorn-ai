# 팝콘PC AI — 다나와 시세 재수집 slow 그룹 타이머 (A-109: MB·RAM·SSD·HDD·케이스·
# 파워, 월 1회, 2026-08-23). 부품 목록 자체는 여기서 정의하지 않는다 — 단일
# 원천은 tools/danawa_fetch.py의 PART_GROUPS(.claude/CANON.md §1) — 이 타이머는
# 그 이름(slow)만 popcorn-danawa-market@slow.service 인스턴스로 넘긴다.
#
# ── ② fast·slow 겹침 회피 ────────────────────────────────────────────────────
# 겹침 분석(144분 여유 계산)은 popcorn-danawa-market-fast.timer 쪽 주석 참조 —
# 이 타이머를 더 이른 새벽(01:00 KST)에 두어, 96분짜리 작업이 정상 종료한
# (~02:36 KST) 뒤로도 fast 시작(05:00 KST)까지 여유가 남게 했다.
#
# ── ③ KST 새벽 + 월 경계 ────────────────────────────────────────────────────
# "매월 1일 01:00 KST"를 순수 UTC 요일/일자 지정으로 고정된 한 줄로 옮기려면
# "전월 마지막 날 16:00 UTC"가 되는데, 전월 마지막 날짜는 28~31일로 매달
# 달라 고정 숫자로 못 적는다(fast 쪽은 요일 고정이라 UTC 환산이 쉬웠던 것과
# 다른 점). 그래서 이 타이머는 시간대 접미사 쪽이 "UTC 환산보다 더 안전하다".
# 아래 줄이 이 서버 systemd에서 실제로 유효한지는 설치 전 다음 명령으로
# 확인한다(deploy/README.md 절차 참조):
#   systemd-analyze calendar '*-*-01 01:00:00 Asia/Seoul'
# 문법이 거부되거나 Next elapse가 기대와 다르면, 위 줄을 주석 처리하고 아래
# UTC 대체 줄의 주석을 풀어 쓴다(`~1` = 매달 마지막 날 — 이 표기는 이
# 저장소에서 실측 검증한 적이 없으므로 **적용 전 반드시 systemd-analyze
# calendar로 별도 재확인**한다. 검증 없이 이 대체 줄을 그대로 믿지 않는다).

[Unit]
Description=팝콘PC AI 다나와 시세 재수집 — slow 그룹(MB·RAM·SSD·HDD·케이스·파워, 월 1회, A-109)
Documentation=file:///srv/popcorn-ai/deploy/README.md

[Timer]
# UTC 대체(위 시간대 접미사 문법이 이 systemd에서 안 먹히면 아래 줄로 바꾸고
# 위 OnCalendar 줄은 주석 처리한다 — `~1`=매달 마지막 날 16:00 UTC = 다음달
# 1일 01:00 KST와 같다. 바꾼 뒤 반드시 systemd-analyze calendar로 재검증):
# OnCalendar=*-*~1 16:00:00
OnCalendar=*-*-01 01:00:00 Asia/Seoul

# 서버가 꺼져 있어 이번 달 실행을 놓쳤으면 다음 기동 때 한 번 돌려 만회한다.
Persistent=true

# 정각 몰림 방지용으로 짧게만 둔다 — fast와 같은 값(§근거는 그쪽 주석).
RandomizedDelaySec=300

# 템플릿 인스턴스를 명시한다 — 파일명(popcorn-danawa-market-slow.timer)과
# 같은 이름의 .service가 없으므로(템플릿 popcorn-danawa-market@.service를
# slow 인스턴스로 부르는 구조) 암묵적 이름 매칭에 기대지 않고 직접 적는다.
Unit=popcorn-danawa-market@slow.service

[Install]
WantedBy=timers.target
