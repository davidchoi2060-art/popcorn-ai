# 팝콘PC AI — unit 실패 알림 (U-57 해소 · 2026-08-24)
#
# OnFailure= 로 불리는 템플릿 서비스다. 어떤 unit 이든 실패하면 이 unit 의
# 인스턴스 하나를 시작해 텔레그램으로 알린다. 실제 발송 · journald 조회 로직은
# scripts/notify_failure.py 에 있다(이 파일은 배선만 한다).
#
# ── 인스턴스 이름을 %n 이 아니라 %p-%i 로 받는 이유 ──────────────────────────
# 실패한 unit 이 이미 '@' 를 포함한 템플릿 인스턴스(예:
# popcorn-danawa-market@fast.service)면, 그 전체 이름(%n)을 이 unit 의 인스턴스
# 자리에 그대로 넣을 수 없다. systemd 유닛 이름의 인스턴스 부분(첫 '@' 뒤,
# 타입 접미사 앞)은 '@' 문자를 허용하지 않는다 — systemd-escape(1) 기준 안전
# 문자는 글자 · 숫자 · 콜론 · 밑줄 · 마침표 · 하이픈뿐이고 그 밖은 16진수로
# escape 된다. OnFailure=popcorn-notify-failure@%n.service 처럼 쓰면 전개
# 결과에 '@' 가 두 번(새로 붙는 것 + %n 안의 것) 들어가 인스턴스 이름이
# 무효해지고, systemd 는 그 OnFailure= 의존성 자체를 "조용히" 버린다(경고만
# 남기고 그 관계를 안 맺는다) — 알림을 달아 놓고도 정작 실패하면 아무 일도
# 안 일어나는, 지금 고치려는 증상이 알림 배선 위에서 그대로 재발하는 셈이다.
#
# unit 파일 지시어는 systemd-escape 를 직접 실행할 수 없다(선언적 치환만
# 한다) — 그래서 '@' 가 아예 안 생기게 피한다: 실패하는 쪽(예:
# popcorn-danawa-market@.service)은 %n 대신 %p(접두사, 첫 '@' 앞부분)와
# %i(인스턴스, '@' 뒤 · 접미사 앞부분)를 하이픈으로 이어 붙인 값을 넘긴다.
# %p · %i 는 정의상 '@' 를 포함할 수 없다(그 자체가 '@' 로 나뉜 조각이므로) —
# 그래서 이어 붙여도 '@' 가 두 번 나올 일이 없다. 실제 배선은
# deploy/systemd/popcorn-danawa-market@.service 의 OnFailure= 줄 참조.
#
# 받는 쪽(여기)은 반드시 %i 를 쓴다 — %I 가 아니다(2026-08-24 서버 실측 사고,
# 아래). scripts/notify_failure.py 에 인자로 넘기면 그 스크립트의
# resolve_unit_name() 이 "prefix-instance" 를 다시 "prefix@instance.service"
# 로 복원해 journalctl -u 에 쓴다 — 복원 규칙의 전제와 한계는 그 함수 docstring
# 참조(지금은 인스턴스 이름에 하이픈이 없는 fast/slow 뿐이라 안전하다).
#
# ── 왜 %I 가 아니라 %i 인가 (2026-08-24 서버 실측 사고) ──────────────────────
# systemd 에서 '-' 는 '/' 의 escape 표현이다(경로에서 자동 생성되는 인스턴스
# 이름 관례 — 예: /dev/sda1 이 인스턴스로 쓰이면 파일명은 dev-sda1). %i 는
# "인스턴스 이름을 이 unit 의 이름에 실제로 쓰인 그대로"(escape 된 형태
# 그대로, 추가 처리 없음) 주고, %I 는 그것을 **unescape** 해 사람이 읽는
# 형태로 되돌린다 — 그 과정에서 '-' 를 전부 '/' 로 되돌린다. 우리는 %p-%i
# 조인에서 '-' 를 "그냥 이어붙이는 구분자"로 썼을 뿐인데, %I 입장에서는 그
# '-' 가 전부 "escape 된 '/'"로 보인다. 그래서 처음 이 파일을 %I 로 배선해
# 실제 서버에 설치하고 popcorn-danawa-market@fast.service 를 일부러
# 실패시켜 봤더니, journald 에 "popcorn-danawa-market-fast" 가 아니라
# **"popcorn/danawa/market/fast"** 로 깨져 남았다(Description 문구·
# scripts/notify_failure.py 가 받는 인자 양쪽 다). `journalctl -u
# popcorn/danawa/market/fast.service` 는 존재하지 않는 unit 이라 마지막
# 로그를 못 가져온다 — 알림은 가지만 «왜 실패했는지»가 빠진다. %i 로 바꾸면
# scripts/notify_failure.py 의 resolve_unit_name() 이 원래 받기로 설계된
# "하이픈이 살아있는 원문"이 그대로 오므로, **스크립트 쪽은 고치지 않았다**
# (로컬에서 resolve_unit_name('popcorn-danawa-market-fast') 가
# 'popcorn-danawa-market@fast.service' 를 내는 것으로 재확인함).
#
# 앞으로 다른 unit 의 OnFailure= 를 여기로 연결할 때: 그 unit 이 템플릿이
# 아니면(이름에 '@' 가 없으면) OnFailure=popcorn-notify-failure@%n.service 를
# 그대로 써도 된다(그 경우 %n 은 이미 완전한 이름이고 '@' 충돌이 없다). 그
# unit 도 템플릿이면 이 파일과 같은 방식(%p-%i)을 따른다.
#
# ── 재귀 방지 ─────────────────────────────────────────────────────────────
# 이 unit 자신에는 OnFailure= 를 걸지 않는다. 걸면 텔레그램 자격증명이 없는
# 채로 배포됐을 때 "알림 실패 -> 자기 자신을 다시 호출 -> 또 실패 -> ..." 로
# 반복될 수 있다.
#
# 이 파일 자체를 systemctl enable 하지 않는다(그래서 [Install] 이 없다) —
# 시작은 실패한 unit 의 OnFailure= 가 그때그때 담당한다.
#
# 설치 · 검증(안전하게 실패를 흉내 내는 법 포함) 절차는 deploy/README.md
# 「실패 알림」 참조.

[Unit]
Description=팝콘PC AI unit 실패 알림 (%i 가 실패한 unit — U-57)
Documentation=file:///srv/popcorn-ai/deploy/README.md

[Service]
Type=oneshot
User=popcorn
Group=popcorn
# 다른 unit(예: popcorn-danawa-market@.service)의 저널을 읽으려면 이 그룹이
# 필요하다 — 2026-08-24 서버 실측 사고, 왜 계정 전체가 아니라 이 unit에만
# 주는지·NoNewPrivileges와 충돌하지 않는 근거는 파일 하단 주석 참조.
SupplementaryGroups=systemd-journal
WorkingDirectory=/srv/popcorn-ai

# TELEGRAM_BOT_TOKEN · TELEGRAM_CHAT_ID 를 여기서 읽는다. scripts/_tg_env.py 는
# 프로젝트 .env 를 먼저 보고, 이 서버처럼 그 파일이 아예 없으면 프로세스
# 환경변수로 넘어간다 — EnvironmentFile= 이 채우는 것이 바로 그 환경변수다.
# 판정 근거는 deploy/README.md 「실패 알림」 절 참조. 이 두 키가 아직
# 없으면(사장님이 넣기 전) scripts/notify_failure.py 가 그 사실을 journald 에
# 분명히 남기고 조용히 넘어가지 않는다.
EnvironmentFile=/etc/popcorn-ai.env

# journalctl 조회 + 텔레그램 전송을 합쳐도 보통 몇 초면 끝난다. 다만 둘 다
# 순서대로(직렬로) 실행되고 각자 자체 타임아웃이 있다 — journalctl 조회 15초
# (scripts/notify_failure.py) + 텔레그램 발송 하위 프로세스 30초(그 안에서
# 다시 scripts/notify_telegram.py 의 HTTP 타임아웃 15초) = 최악의 경우 최대
# 약 45초. 120초로 넉넉히 잡아 그 위에 파이썬 기동·프로세스 생성 여유를 더
# 둔다 — 이 unit은 실패가 났을 때만 드물게 도는 것이라 값을 크게 잡아도
# 비용이 없다.
TimeoutStartSec=120

ExecStart=/srv/popcorn-ai/.venv/bin/python /srv/popcorn-ai/scripts/notify_failure.py %i

Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=popcorn-notify-failure

# 최소 권한 — popcorn-danawa-market@.service 와 같은 프로파일(이미 이
# 프로파일로 그 서비스가 정상 동작하고 있다). 이 스크립트는 파일을 쓰지
# 않는다(journalctl 조회 + 텔레그램 HTTP 전송뿐 — danawa 쪽 .cache 쓰기와
# 다르다) — 그래서 ReadWritePaths 가 없다.
#
# User=popcorn 을 그대로 쓰는 이유: 실패를 알려야 하는 unit 들(예:
# popcorn-danawa-market@.service)이 전부 User=popcorn 로 돈다 — 계정을
# 새로 만들 이유가 없다.
#
# ⚠ 2026-08-24 서버 실측 정정 — 이 문단이 원래 "같은 UID 면 자기 로그는
# 권한 없이도 본다"고만 적고 있었는데 **절반만 맞았다.** 그 규칙은 "자기
# 자신이 낸 로그"에만 적용되고, 이 unit 이 실제로 읽어야 하는 것은 «다른»
# unit 의 로그다(둘 다 User=popcorn 라 UID 는 같아도, journald 의 열람
# 권한은 "요청하는 프로세스가 systemd-journal/adm 그룹에 있는가"로 갈린다 —
# UID 가 같다고 자동으로 열리지 않는다). 그래서 서버에서 실제로
# "No journal files were opened due to insufficient permissions." 로
# 막혔다(폰에 도착한 알림 본문에 그 문구가 그대로 실렸다).
#
# ── 그래서 SupplementaryGroups=systemd-journal 를 추가했다(위 참조) ────────
# ✗ 안 고른 방법 — `usermod -aG systemd-journal popcorn`: popcorn **계정
#   자체**에 영구히 그룹을 준다. popcorn-api.service(고객이 여는 API
#   서버 — deploy/popcorn-api.service 확인, 이 unit과 같은 User=popcorn
#   Group=popcorn)도 그 즉시 저널 열람 권한을 갖는다. 그 프로세스는
#   인터넷에서 오는 요청을 그대로 받고(CLAUDE.md 「남아 있는 위험」 —
#   고객 인증이 아직 dev 어댑터), 이미 있는 취약점이 있다면 공격 표면을
#   불필요하게 넓히는 선택이다.
# ○ 고른 방법 — `SupplementaryGroups=`(이 unit 파일에만): systemd.exec(5)
#   문서 — "이 옵션은 시스템 그룹 데이터베이스에 이미 설정된 보조 그룹
#   목록을 덮어쓰지 않고 확장한다." `/etc/group` 자체는 그대로이고, **이
#   unit 이 실행하는 프로세스에만** 한시적으로 그룹이 더해진다 — 같은
#   User=popcorn 로 도는 다른 unit(popcorn-api·popcorn-danawa-market@)은
#   이 unit 파일을 손대지 않는 한 영향이 없다. 최소 권한에 맞는 쪽이다.
#
# systemd 버전 확인: `SupplementaryGroups=`는 systemd.exec(5)의 오래된 핵심
# 지시어(수 년째 문법이 안 바뀐, nginx 의 ssl-cert 그룹 부여 등에 널리 쓰이는
# 관용구)라 이 서버의 systemd 255 에도 있다고 판단했다. ⚠ 이 판단은 문서·
# 관행 지식이다 — 이 개발 PC(Windows, systemd 없음. WSL 도 설치돼 있지 않음을
# `wsl --list`로 확인함)에서 `systemd-analyze verify`로 실제 파싱을 시험하지
# 못했다 — 설치 시(daemon-reload) 오류 없이 로드되는지로 최종 확인해야 한다.
#
# ── NoNewPrivileges=true 와 충돌하는가 — 안 한다고 판단한다. 근거: ─────────
#   ① systemd 가 프로세스를 띄우는 순서는 "자격증명(uid/gid/보조그룹) 설정
#      → capability 조정 → NoNewPrivileges 적용(prctl PR_SET_NO_NEW_PRIVS)
#      → execve()"다(systemd.exec(5) 「Process Properties」 절 서술 순서).
#      SupplementaryGroups= 가 적용되는 setgroups() 호출은 NoNewPrivileges
#      가 걸리기 «전», 대상 바이너리를 execve() 하기 «전»에 끝난다.
#   ② 이건 우연이 아니라 권한 모델상 필연이다 — setgroups() 는 CAP_SETGID
#      가 있어야 하는데, 이 호출은 systemd(사실상 root)가 자식 프로세스의
#      자격증명을 자리잡아 주는 단계에서 이뤄진다. NoNewPrivileges 는 "이후
#      execve() 로 «새로» 권한을 얻는 것"(setuid/setgid 비트, 파일
#      capability)을 막는 장치이지, 이미 부여된 자격증명(uid/gid/보조그룹)을
#      취소하거나 그 설정 자체를 막는 장치가 아니다.
#   ③ 실무 선례 — `User=`+`SupplementaryGroups=`+`NoNewPrivileges=yes` 조합은
#      systemd 하드닝 가이드(`systemd-analyze security`)가 권장하는 표준
#      패턴이다(예: 여러 배포판의 nginx.service 가 ssl-cert 그룹을 이
#      방식으로 받으면서 NoNewPrivileges=true 도 함께 쓴다) — 충돌한다면
#      이 조합 자체가 성립하지 않았을 것이다.
#   ⚠ 이 역시 문서·선례 기반 판단이다 — 이 서버에서 실제로 다른 unit 의
#      로그가 알림 본문에 실리는지는 하네스가 재설치 후 실측으로 확정한다.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
