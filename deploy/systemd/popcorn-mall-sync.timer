# 팝콘PC AI — 몰 공급처·가격 일일 자동 반영 타이머 (2026-08-27 신설)
#
# ⚠⚠⚠ 2026-08-29 — 이 unit 을 설치·활성화(systemctl enable)하지 않는다 ⚠⚠⚠
# decision-log A-124(2026-08-29 사장님 확정) — 몰 공급처·가격 갱신은 자동 타이머로
# 돌리지 않고 손으로 돌린다. 아래 OnCalendar=03:00 KST 무인 실행 시각에는 몰 로그인
# 쿠키를 줄 사람이 없다(사장님도 하네스도 없다) — 이 unit 이 있어야 할 이유 자체가
# 없다. 자세한 경위는 popcorn-mall-sync.service 머리말(같은 경고)과 decision-log
# A-124 참조. **지우지 않는 이유·재사용 조건**도 그쪽에 있다. ⚠ 이 파일을 보고
# "등록만 빠뜨렸다"고 오해해 enable 하지 마라 — 실제로 그런 오해가 있었다.
#
# ── 왜 새벽 03:00 KST 인가 (2026-08-27 설계 당시 근거 — 지금은 실행하지 않는다) ──
# 두 가지를 피해야 한다: ① 몰(popcornpc.co.kr) 이 실제 고객·운영자 트래픽으로
# 붐비는 시간대 ② 이 서버가 이미 돌리는 다른 새벽 배치(다나와 시세 재수집,
# deploy/systemd/popcorn-danawa-market-fast.timer·-slow.timer)와의 겹침(A-18 규약
# — 요청 간격을 지키는 배치가 같은 시각에 여럿 몰리면 사실상 그 간격이 무너진다).
#
#   popcorn-danawa-market-slow.timer   매월 1일 01:00 KST 시작, 정상 완주 시 약 96분
#                                       (~02:36 KST 종료, 최악의 경우 popcorn-danawa-
#                                       market@.service 문서 기준 최대 약 3.1시간)
#   popcorn-danawa-market-fast.timer   매주 월요일 05:00 KST 시작, 정상 완주 시 약 37분
#   이 unit(몰 공급처·가격)             매일 03:00 KST 시작, 실측 기준 약 68분(아래 참조)
#
# 03:00 은 slow 의 «정상» 완주 시각(~02:36)보다 24분 뒤라 겹치지 않고, fast 시작
# (05:00)까지는 약 2시간 여유가 있어 이 unit(최대 4시간 타임아웃 안에서 실제로는
# 68분 안팎 소요, popcorn-mall-sync.service 참조)이 정상적으로 끝나면 fast 시작 전에
# 비켜준다. ⚠ 매월 1일에 한해 slow 가 최악의 경우(최대 3.1시간)까지 늘어나면 이
# unit 의 시작(03:00)과 짧게 겹칠 수 있다 — 다만 대상 서버가 다르므로(다나와 vs
# 팝콘PC 몰) 서로의 요청 간격 자체를 침범하지는 않는다(각자 자기 목표 서버에만
# 1.5초 간격을 지킨다). 이 서버 자체의 CPU·네트워크를 동시에 나눠 쓰는 정도이고,
# 한 달에 한 번뿐이라 지금은 감수한다 — 대상 건수가 크게 늘어 이 여유가 좁아지면
# 이 시각을 다시 잰다(아래 재검토 시점).
#
# ── 실측 근거(68분) ─────────────────────────────────────────────────────
# 2026-08-27 기준 추천 후보(v_recommendation_candidates) 약 2,726건(A-115 적용 후) ×
# 요청 간격 1.5초(tools/mall_supplier_fetch.DELAY) ≈ 68분. 정확한 실측(서버에서
# 처음 --apply 로 돌려본 시간)은 아직 없다 — 로컬 캐시가 없는 서버의 첫 실행은
# popcorn-danawa-market@.service 도 겪은 것과 같은 이유로 전량 새 네트워크 요청이다.
#
# ── 재검토 시점 ──────────────────────────────────────────────────────────
# 대상 건수가 지금의 2~3배(5,000~8,000건)에 근접하면 이 시각과
# popcorn-mall-sync.service 의 TimeoutStartSec 을 함께 다시 잰다(다나와 타이머와
# 같은 방식 — popcorn-danawa-market@.service 참조).
#
# ── KST 새벽 시간대 표기 검증(다나와 타이머와 같은 절차) ────────────────────
# 이 서버 systemd 에서 아래 줄이 실제로 유효한지 설치 전 확인한다:
#   systemd-analyze calendar '*-*-* 03:00:00 Asia/Seoul'
# 문법이 거부되거나 Next elapse 가 기대와 다르면 이 줄을 주석 처리하고 아래 UTC
# 대체 줄(03:00 KST = 전날 18:00 UTC — 매일 반복이라 요일 이동이 없다, 다나와
# 타이머의 주간 스케줄과 다른 점)의 주석을 풀어 쓴다.

[Unit]
Description=팝콘PC AI 몰 공급처·가격 일일 자동 반영 — 매일 새벽
Documentation=file:///srv/popcorn-ai/deploy/README.md

[Timer]
# UTC 대체(위 시간대 접미사 문법이 이 systemd 에서 안 먹히면 아래 줄로 바꾸고 위
# OnCalendar 줄은 주석 처리한다 — 바꾼 뒤 systemd-analyze calendar 로 재검증):
# OnCalendar=*-*-* 18:00:00
OnCalendar=*-*-* 03:00:00 Asia/Seoul

# 서버가 꺼져 있어 오늘 실행을 놓쳤으면 다음 기동 때 한 번 돌려 만회한다 — 몰 값이
# 매일 바뀌므로 하루 이상 안 도는 것을 그대로 두지 않는다(다나와 타이머와 같은 이유).
Persistent=true

# 정각 몰림 방지용으로 짧게만 둔다(다나와 타이머와 같은 폭).
RandomizedDelaySec=300

Unit=popcorn-mall-sync.service

[Install]
WantedBy=timers.target
