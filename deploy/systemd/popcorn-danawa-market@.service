# 팝콘PC AI — 다나와 시세 재수집 (A-109 차등 주기의 실행 수단 · 2026-08-23)
#
# 템플릿 서비스 하나(인스턴스 %i = fast|slow)를 타이머 둘이 각자 부른다:
#   popcorn-danawa-market@fast.service  <- popcorn-danawa-market-fast.timer (주 1회)
#   popcorn-danawa-market@slow.service  <- popcorn-danawa-market-slow.timer (월 1회)
#
# 부품 묶음 정의(fast=GPU·CPU·CPU쿨러 공랭/수랭, slow=MB·RAM·SSD·HDD·케이스·파워)는
# 여기 다시 적지 않는다 — 단일 원천은 tools/danawa_fetch.py의 PART_GROUPS다
# (.claude/CANON.md §1). 이 파일은 그 이름(fast/slow)만 --group 인자로 넘긴다.
#
# 보안 설정(User·ProtectSystem 이하)은 배포 중인 deploy/popcorn-api.service를 그대로
# 본떴다 — 같은 프로파일로 그 서비스가 이미 정상 동작하고 있다.
#
# 이 파일 자체를 systemctl enable 하지 않는다(그래서 [Install] 이 없다) — 활성화는
# popcorn-danawa-market-fast.timer · -slow.timer 둘이 담당한다.
#
# 설치 · 검증 · 되돌리는 절차는 deploy/README.md 「다나와 시세 재수집 타이머」 참조.

[Unit]
Description=팝콘PC AI 다나와 시세 재수집 (%i 그룹 — A-109/A-110)
Documentation=file:///srv/popcorn-ai/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=popcorn
Group=popcorn
WorkingDirectory=/srv/popcorn-ai

# 비밀값은 이 파일에 쓰지 않는다 — /etc/popcorn-ai.env(권한 600, root:popcorn)에서 읽는다.
# 필요한 키: DATABASE_URL. danawa_fetch.py의 main()은 os.environ["DATABASE_URL"]을
# 대괄호로 직접 읽는다(.get이 아니다) — 이 파일이 없거나 키가 비면 즉시 KeyError로
# 죽는다. 조용히 넘어가지 않는다(제작팀 규약 ④).
EnvironmentFile=/etc/popcorn-ai.env

# ── ① 시작 타임아웃 ──────────────────────────────────────────────────────────
# 기본 TimeoutStartSec(시스템 기본값, 대개 90초)이면 fast(약 37분=2,220초)도
# slow(약 96분=5,760초)도 "시작 중 멈춘 것"으로 오판돼 SIGTERM으로 죽는다 —
# 매주/매월 조용히 실패한다. 두 그룹이 이 템플릿 하나를 공유하므로 타임아웃값도
# 하나뿐이다 — 더 오래 걸리는 slow(5,760초) 기준으로 넉넉히 잡으면 fast는 그 안에서
# 훨씬 일찍 끝난다.
#
# 18,000초(5시간) 근거:
#   · slow 실측(약 96분=5,760초)의 약 3.1배
#   · fast 실측(약 37분=2,220초)의 약 8.1배(더 짧은 쪽은 이 상한 안에서 여유가 큼)
#   · 아래 --limit 5000 을 실제로 다 채우는 최악의 경우(현재 관측 처리율 약
#     2.2초/건 기준 5,000건 ≈ 11,000초 ≈ 3.1시간)도 이 상한 밑이다 — --limit을
#     늘려 잡은 여유분까지 타임아웃이 커버한다
#   · 서버 캐시가 지금 0건이라 첫 실행은 전량 새 네트워크 요청이라는 점(캐시 있으면
#     더 빠를 수 있지만, 없다고 더 오래 걸리는 방향은 위 실측치에 이미 포함돼 있다 —
#     실측 자체가 캐시 없는 조건에서 나온 시간이다)
# 타임아웃에 걸려도 journald에 실패로 남는다(⑥, 아래 SyslogIdentifier) — 조용히
# 사라지지 않는다.
TimeoutStartSec=18000

# ── --limit 5000: 기본값 100 이 아니라 명시값을 쓰는 이유 (직접 코드를 읽고 확인) ──
# tools/danawa_fetch.py의 --limit 기본값은 100이다(코드 실측 — main()의
# `limit = args.limit if args.limit is not None else 100`, --market 분기도 이
# limit을 그대로 쓴다). A-109 대상은 fast 999건 · slow 2,632건(2026-08-23 하네스
# 실측 — 카탈로그가 늘면 이 수는 커진다, 그 자체는 문제가 아니다 아래 참조).
# --limit을 명시하지 않으면 매주/매월 100건만 처리되고 나머지는 «영원히» 못 돈다
# — 대상 조회가 `ORDER BY product_code LIMIT :n`이라 항상 같은 앞쪽 100건만
# 반복 처리되기 때문이다(뒤쪽 899건/2,532건은 이 스케줄러로는 결코 차례가 안 온다).
# 5,000은 slow(더 큰 쪽) 실측의 약 1.9배 여유다. LIMIT은 상한일 뿐이라 실제
# 대상보다 커도 손해가 없다(초과분은 매칭되는 행이 없어 그냥 안 나온다 — 쿼리
# 실행 시간·수집 시간 모두 «실제 매칭 건수»에 좌우되지 LIMIT 숫자 자체와는 무관).
# fast·slow가 이 템플릿 하나를 공유하므로 값도 하나 — 어느 인스턴스든 실제 대상
# 이상이면 전량 처리된다.
# 재검토 시점: 대상이 5,000건에 근접하면(현재의 약 2~5배) 이 값과 위 타임아웃·
# deploy/README.md의 시각 간격(fast·slow 144분 여유)을 함께 다시 잰다.
ExecStart=/srv/popcorn-ai/.venv/bin/python /srv/popcorn-ai/tools/danawa_fetch.py \
    --market --group %i --limit 5000

Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=popcorn-danawa-%i

# 최소 권한 — popcorn-api.service와 동일 프로파일. 이 도구가 파일시스템에 쓰는
# 유일한 자리는 .cache/danawa/(다나와 원문 HTML 캐시, danawa_fetch.py의
# `os.makedirs(CACHE, exist_ok=True)`) — 그래서 ReadWritePaths도 그 한 곳뿐이다.
# 정본(product_reviews·products.market_price)에 대한 쓰기는 전부 DATABASE_URL을
# 통한 네트워크 쓰기(Cloud SQL)라 ProtectSystem=strict의 파일시스템 잠금과 무관하다.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/popcorn-ai/.cache
