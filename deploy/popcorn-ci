#!/usr/bin/env bash
# 서버(GCP VM)에서 배포·검증을 실행하는 **고정 스크립트**.
#
# 왜 리포가 아니라 /usr/local/bin 에 두는가:
#   GitHub Actions self-hosted 러너는 리포의 워크플로 파일을 그대로 실행한다.
#   그래서 배포·재시작 같은 root 작업을 워크플로에 적어두면, 리포에 푸시할 수 있는
#   사람은 누구나 서버에서 root 명령을 돌릴 수 있게 된다.
#   대신 root 작업은 전부 이 파일 하나에 가두고, 러너 계정(ghrunner)에게는
#   sudoers 로 아래 `case` 에 있는 부명령만 한 줄씩 허용한다.
#   → 워크플로를 고쳐도 서버에서 할 수 있는 일은 그 목록을 벗어나지 못한다.
#
# 설치(서버에서 한 번):
#   sudo install -m 755 -o root -g root /srv/popcorn-ai/deploy/popcorn-ci /usr/local/bin/popcorn-ci
#   ⚠ 이 파일이 리포에서 바뀌면 위 명령을 다시 실행해야 반영된다(자동 반영 아님 — 의도된 것).
#
# 자세한 설치 절차는 deploy/RUNNER.md.

set -Eeuo pipefail

APP_DIR=/srv/popcorn-ai
APP_USER=popcorn
ENV_FILE=/etc/popcorn-ai.env
SERVICE=popcorn-api
API=http://127.0.0.1:8000
BRANCH=main

if [ "$(id -u)" -ne 0 ]; then
  echo "popcorn-ci: root 로 실행해야 한다 (sudo popcorn-ci ...)" >&2
  exit 1
fi

# popcorn 계정으로, /etc/popcorn-ai.env 를 읽은 상태에서 명령을 돌린다.
# env 파일은 640 root:popcorn 이라 popcorn 이 그룹 권한으로 읽는다(deploy/README.md §2).
as_app() {
  runuser -u "$APP_USER" -- bash -c "set -a; . '$ENV_FILE'; set +a; $1"
}

step() { echo; echo "=== $* ==="; }

cmd_deploy() {
  step "1. 코드 받기 ($BRANCH)"
  # --ff-only: 서버 트리에 손댄 흔적이 있으면 조용히 합치지 말고 실패시킨다.
  # FETCH_HEAD 로 합친다 — `origin/$BRANCH` 는 원격 추적 참조라 fetch 가 그것을
  # 갱신하지 못한 경우(원격 refspec 설정이 다르면 생긴다) 낡은 지점으로 합치고도
  # "Already up to date." 를 찍는다. 그러면 배포는 초록불인데 서버 코드는 어제 것이다.
  runuser -u "$APP_USER" -- git -C "$APP_DIR" fetch origin "$BRANCH"
  want=$(runuser -u "$APP_USER" -- git -C "$APP_DIR" rev-parse FETCH_HEAD)
  runuser -u "$APP_USER" -- git -C "$APP_DIR" merge --ff-only FETCH_HEAD
  got=$(runuser -u "$APP_USER" -- git -C "$APP_DIR" rev-parse HEAD)
  # 합쳤는데도 받아온 지점과 다르면 멈춘다 — 여기서 넘어가면 그 뒤 단계가 전부
  # 「낡은 코드를 성공적으로 배포」한다.
  if [ "$got" != "$want" ]; then
    echo "  받아온 지점 $want 과 서버 HEAD $got 이 다르다 — 배포를 멈춘다." >&2
    exit 1
  fi
  runuser -u "$APP_USER" -- git -C "$APP_DIR" log -1 --pretty='  HEAD %h %s'

  step "2. 의존성"
  runuser -u "$APP_USER" -- "$APP_DIR/.venv/bin/pip" install -q -r "$APP_DIR/requirements.txt"

  step "3. 마이그레이션"
  as_app "cd '$APP_DIR/db' && ../.venv/bin/python -m alembic upgrade head"
  as_app "cd '$APP_DIR/db' && ../.venv/bin/python -m alembic current"

  step "4. 재시작"
  systemctl restart "$SERVICE"
  systemctl is-active "$SERVICE"

  step "5. 헬스 체크"
  # 재시작 직후에는 아직 안 뜬다 — 최대 30초까지 기다린다.
  for i in $(seq 1 15); do
    if curl -fsS --max-time 5 "$API/api/health" 2>/dev/null; then
      echo; echo "  배포 완료."
      return 0
    fi
    sleep 2
  done
  echo "  헬스 체크 실패 — 최근 로그:" >&2
  journalctl -u "$SERVICE" -n 40 --no-pager >&2
  return 1
}

cmd_regression() {
  step "회귀 세트 (서버 코드 · 운영 DB 대조)"
  # 실행 중인 서버(127.0.0.1:8000)를 검사하므로 배포 뒤에 돌려야 의미가 있다.
  as_app "cd '$APP_DIR' && REGRESSION_BASE='$API' .venv/bin/python tests/regression.py"
}

# 견적 격자(grid_cells·grid_quotes) 재생성. 파생 표라 되돌림은 재실행이다.
# DATABASE_URL 과 127.0.0.1:8000 을 둘 다 쓰므로 ghrunner 로는 못 돌고 여기를 거친다.
# 이 배치가 만드는 상담 행은 tools/grid_generate.py 가 스스로 표시한다
# (`_mark_batch_session` — 응답의 session_id 로 자기 행만 data_origin='test').
# X-Popcorn-Test 헤더도 함께 보내지만(b3dc231) **서버에서는 그것이 듣지 않는다**:
# 그 헤더는 `POPCORN_TEST_HEADER_ENABLED` 가 켜져 있을 때만 신뢰되는데, 그 값은
# 서버 env 에 두지 않는 것이 규칙이다(deploy/README.md — "0 이어야 한다").
# 그래서 서버에서 실제로 일하는 것은 DB 직접 표시 쪽 하나다.
# 드라이런 경로에도 표시가 붙은 것은 685c7e5 부터다 — 그 앞 코드로 grid-dry 를
# 돌리면 표식 없는 상담이 쌓인다. 재설치는 685c7e5 이후 코드로 한다.
cmd_grid() {
  step "견적 격자 재생성"
  as_app "cd '$APP_DIR' && .venv/bin/python tools/grid_generate.py"
}

cmd_grid_dry() {
  step "견적 격자 재생성 — 드라이런(쓰기 없음)"
  as_app "cd '$APP_DIR' && .venv/bin/python tools/grid_generate.py --dry"
}

# 몰 시중가 -> products.market_price (2026-09-22 사장님 「승인」).
# 몰(popcornpc.co.kr)과 DATABASE_URL 을 둘 다 써야 해서 ghrunner 로는 못 돌고 여기를 거친다.
# 값 쓰기는 새로 구현하지 않는다 — 검수 제안 -> 승인 -> 잠금까지 기존 코드가 한다
# (A-103·A-104·A-108 · tools/mall_market_price_apply.py 머리말 참고).
# `--approve-mall` 은 A-108 자동 승인 문턱(5%)에 걸린 건도 반영한다는 뜻이다. 그 문턱은
# 다나와 제안(남의 사이트 값)을 대상으로 정해진 것이고, 여기 값은 우리 몰의 시중가라
# 카탈로그 적재가 검수 없이 넣는 값과 같다. 판정 함수는 그대로다 — 근거는 원장에 남는다.
# ⚠ 서버에 깔린 옛 판은 `--approve-first` 로 부른다. 도구가 그 이름도 받아 준다.
cmd_mall_price_dry() {
  step "몰 시중가 반영 - 드라이런(쓰기 없음)"
  as_app "cd '$APP_DIR' && .venv/bin/python tools/mall_market_price_apply.py --fetch"
}

cmd_mall_price() {
  step "몰 시중가 반영"
  as_app "cd '$APP_DIR' && .venv/bin/python tools/mall_market_price_apply.py --fetch --apply --approve-mall"
}

cmd_verify() {
  step "배포 후 검증 (deploy/verify.sh)"
  bash "$APP_DIR/deploy/verify.sh"
}

case "${1-}" in
  deploy)     cmd_deploy ;;
  regression) cmd_regression ;;
  verify)     cmd_verify ;;
  grid)       cmd_grid ;;
  grid-dry)   cmd_grid_dry ;;
  mall-price)     cmd_mall_price ;;
  mall-price-dry) cmd_mall_price_dry ;;
  *)
    echo "사용법: popcorn-ci deploy|regression|verify|grid|grid-dry|mall-price|mall-price-dry" >&2
    exit 2
    ;;
esac
