# 로컬 전용 — 실제 값은 .env(커밋 금지)에. 비밀번호는 비밀번호 관리 도구에 보관.
# 서버는 /etc/popcorn-ai.env (권한 600, root:popcorn) — deploy/README.md §2 참조.

DATABASE_URL=postgresql+psycopg2://popcorn_app:CHANGE_ME@CLOUD_SQL_IP:5432/popcorn_pc?sslmode=require

# 첫 관리자 — 이 이메일만 첫 로그인 시 자동 owner가 된다(쉼표로 여러 개 가능).
# 그 뒤 직원은 admin/login.html에서 신청하고, 관리자가 '운영자·권한' 화면에서 승인한다.
ADMIN_BOOTSTRAP_EMAILS=

# 세션 쿠키를 HTTPS 전용으로 할지(1이면 켜짐).
# **HTTP로 운영하는 동안은 비워둔다** — 켜면 브라우저가 쿠키를 저장하지 않아 로그인이 안 된다.
# 도메인·인증서를 붙이는 날 1로 바꾸고 서비스만 재시작하면 된다(코드 수정 없음).
COOKIE_SECURE=

# LLM 프로바이더 키 (api/llm.py) — 값은 이 파일이 아니라 .env(커밋 금지)에만 넣는다.
# 비어 있거나 없으면 api/llm.call()이 LLMNotConfiguredError로 명확히 실패한다(조용한
# 더미 응답 없음). 2026-08-16 기준 등록된 프로바이더는 Gemini 하나뿐이다(A-35 — 3사
# 역할분담·폴백이 최종 방향이나 이번 슬라이스는 Gemini만).
GEMINI_API_KEY=
