.prow .stwrap{display:flex;align-items:center;gap:9px;min-width:0}
.chip{font:600 10.5px/1 var(--rv-font);border-radius:4px;padding:5px 8px;white-space:nowrap;border:1px solid;flex:none}
.chip.ok{color:var(--rv-green);background:oklch(0.95 0.03 165);border-color:rgba(0,0,0,.14)}
.chip.fail{color:var(--rv-amber);background:var(--rv-amber-bg);border-color:var(--rv-amber-line)}
.chip.unset{color:#8a8377;background:var(--rv-panel2);border-color:rgba(0,0,0,.16)}
.prow .stnote{font:400 10.5px/1.4 var(--rv-font);color:var(--rv-faint);flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* 하단 2단 패널(정적 안내 — 원안 LEGEND/outOfScope 그대로) */
.panels{flex:1;min-height:0;display:flex;gap:14px;margin-top:14px}
.panel{flex:1;min-width:0;background:var(--rv-card);border:1px solid rgba(0,0,0,.11);border-radius:8px;
      padding:13px 15px;display:flex;flex-direction:column;gap:10px;overflow:auto}
.panel.alt{background:var(--rv-panel2)}
.panel .cap{font:600 10.5px/1 var(--rv-font);color:#8a8377;letter-spacing:.04em}
.leg-item{display:flex;align-items:flex-start;gap:9px}
.leg-item .desc{font:400 11px/1.6 var(--rv-font);color:#4a463e;flex:1}
.panel .foot{font:400 10.5px/1.6 var(--rv-font);color:#8a8377;margin-top:auto;padding-top:9px;
            border-top:1px solid rgba(0,0,0,.08)}
.oos-item{display:flex;align-items:baseline;gap:8px}
.oos-item .dash{font:600 10px/1.4 var(--rv-mono);color:var(--rv-dim)}
.oos-item .t{font:400 11px/1.6 var(--rv-font);color:#4a463e;flex:1}

/* 드로어 */
.backdrop{position:absolute;inset:0;background:rgba(38,35,30,.22);z-index:7}
.backdrop[hidden]{display:none}
.drawer{position:absolute;top:0;right:0;bottom:0;width:552px;max-width:92vw;background:var(--rv-card);
       border-left:1px solid rgba(0,0,0,.16);box-shadow:-22px 0 48px rgba(38,35,30,.24);
       display:flex;flex-direction:column;z-index:8}
.drawer[hidden]{display:none}
.dw-hd{flex:none;padding:14px 18px 12px;border-bottom:1px solid rgba(0,0,0,.09)}
.dw-hd .row1{display:flex;align-items:center;gap:9px}
.dw-hd .dot{width:10px;height:10px;border-radius:50%;flex:none}
.dw-hd .vn{font:600 14.5px/1.3 var(--rv-font)}
.dw-hd .cp{font:400 11.5px/1.3 var(--rv-font);color:#8a8377}
.dw-hd .close{margin-left:auto;font:400 15px/1 var(--rv-font);color:#8a8377;cursor:pointer;
             padding:2px 4px;background:none;border:0}
.dw-hd .meta{display:flex;align-items:center;gap:10px;margin-top:7px}
.dw-hd .envk{font:400 11px/1.3 var(--rv-mono);color:#6f6a61}
.dw-hd .chkat{font:400 10.5px/1.3 var(--rv-font);color:var(--rv-dim)}
.dw-body{flex:1;min-height:0;overflow:auto;padding:15px 18px;display:flex;flex-direction:column;gap:15px}
.keybox{border:1px solid rgba(0,0,0,.12);border-left:3px solid #bdb6a8;background:var(--rv-panel2);
       border-radius:6px;padding:10px 12px;font:400 11px/1.65 var(--rv-font);color:#4a463e}
.sect .schead{display:flex;align-items:baseline;gap:8px;margin-bottom:9px;flex-wrap:wrap}
.sect .schead .cap{font:600 10.5px/1 var(--rv-font);color:#8a8377;letter-spacing:.04em}
.sect .schead .src{font:400 10.5px/1.3 var(--rv-font);color:var(--rv-dim)}
.lfields{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}
.lfield{border:1px solid rgba(0,0,0,.12);border-radius:7px;padding:9px 11px;background:#faf7f0}
.lfield .lb{font:400 10.5px/1.3 var(--rv-font);color:#8a8377;margin-bottom:6px}
