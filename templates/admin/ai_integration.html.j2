{% block content %}
<div class="ai-body" id="aiBody">
  <div class="ai-scroll" id="aiScroll">

    <div class="keynote">
      <span class="tag">키</span>
      <span class="main">키 값은 서버 <code>.env</code>에만 있습니다 — 이 화면은 키를 입력받지 않습니다</span>
      <span class="sub">CANON §2-5. 이 화면은 "그 키가 있는가"와 "얼마까지 쓰게 할 것인가"만 다룹니다.
        연결 확인은 env 키 존재 여부만 보고 프로바이더에 호출을 보내지 않으므로,
        이 화면을 여는 것으로 과금이 생기지 않습니다.</span>
    </div>

    <div class="stats" id="stats">
      <div class="stat"><div class="row1"><span class="lb">불러오는 중…</span></div></div>
    </div>

    <div class="pwrap">
      <div class="phead">
        <span>프로바이더</span><span>env 키 이름</span><span>모델</span><span>일 한도</span><span>호출 제한</span><span>상태</span>
      </div>
      <div class="ptable" id="ptable">
        <div class="loading">불러오는 중…</div>
      </div>

      <div class="panels">
        <div class="panel">
          <div class="cap">상태 표기 규칙 — "없음"과 "못 함"은 다르다</div>
          <div class="leg-item"><span class="chip unset">○ 미설정</span>
            <span class="desc">env에 해당 키 항목 자체가 없습니다 — 확인 대상이 아닙니다.</span></div>
          <div class="leg-item"><span class="chip ok">● 설정됨</span>
            <span class="desc">env에 키가 있습니다. 값은 화면에 오지 않습니다.</span></div>
          <div class="leg-item"><span class="chip fail">▲ 확인 실패</span>
            <span class="desc">키는 있는데 값이 비어 있습니다 — "없음"과 절대 같은 말로 쓰지 않습니다.</span></div>
          <div class="foot">연결 확인은 <b>env 키 존재 여부만</b> 봅니다 — 프로바이더에 호출을 보내지 않으므로
            이 화면을 여는 것으로 과금이 생기지 않습니다.</div>
        </div>
        <div class="panel alt">
          <div class="cap">이 화면이 하지 않는 일</div>
          <div class="oos-item"><span class="dash">—</span><span class="t">키 값 입력·수정·삭제 — 서버 .env에만 둡니다(CANON §2-5)</span></div>
          <div class="oos-item"><span class="dash">—</span><span class="t">개별 호출 로그(무엇을 묻고 뭐라 답했는지) — AI 응답 기록 소관</span></div>
          <div class="oos-item"><span class="dash">—</span><span class="t">비용 추이·용도별 분석 — AI 사용량·비용 소관</span></div>
          <div class="oos-item"><span class="dash">—</span><span class="t">작업↔모델 배정·폴백 순서 — AI 작업 설정 소관</span></div>
        </div>
      </div>
    </div>

  </div>

  <div class="backdrop" id="backdrop" data-keep="1" hidden></div>
  <aside class="drawer" id="drawer" data-keep="1" hidden>
    <div class="dw-hd">
      <div class="row1">
        <span class="dot" id="dwDot"></span>
        <span class="vn" id="dwVendor">—</span>
        <span class="cp" id="dwCompany">—</span>
        <span class="chip" id="dwState">—</span>
        <button type="button" class="close" data-action="close-drawer" aria-label="닫기">✕</button>
      </div>
      <div class="meta">
        <span class="envk" id="dwEnvKey">—</span>
        <span class="chkat" id="dwCheckedAt">—</span>
      </div>
    </div>
    <div class="dw-body">
      <div class="keybox" id="dwKeyNote">—</div>

      <div class="sect">
        <div class="schead"><span class="cap">프로바이더 한도</span><span class="src">cost_thresholds · rate_limit_policies</span></div>
        <div class="lfields">
          <div class="lfield">
            <div class="lb">일 한도</div>
            <div class="row"><span class="pfx">$</span>
              <input id="fDaily" data-field="daily" inputmode="decimal" placeholder="미설정" style="width:64px">
              <span class="unit">/ 일</span></div>
          </div>
          <div class="lfield">
            <div class="lb">분당 호출</div>
            <div class="row"><input id="fPerMin" data-field="perMin" inputmode="numeric" placeholder="미설정" style="width:60px">
              <span class="unit">회 / 분</span></div>
          </div>
          <div class="lfield">
            <div class="lb">일 호출</div>
            <div class="row"><input id="fPerDay" data-field="perDay" inputmode="numeric" placeholder="미설정" style="width:76px">
              <span class="unit">회 / 일</span></div>
          </div>
        </div>
      </div>

      <div class="sect">
        <div class="schead"><span class="cap">작업별 부분 한도</span><span class="src" id="dwSubSum">—</span></div>
        <div class="sublist" id="dwSubList"></div>
        <div class="subnote" id="dwSubNote"></div>
      </div>

      <div class="sect" data-keep="1">
        <div class="schead"><span class="cap">한도 초과 시 동작</span></div>
        <div class="actlist" id="dwActions"></div>
      </div>

      <div class="diffbox" id="dwDiff" hidden>
        <div class="t">변경됨 · 저장 필요</div>
        <div id="dwDiffLines"></div>
      </div>
    </div>
    <div class="dw-foot">
      <span class="note" id="dwFootNote">—</span>
      <button type="button" class="btn-clear" id="dwClear" data-action="clear-limit" disabled>한도 초기화</button>
      <button type="button" class="btn-revert" id="dwRevert" data-action="revert" disabled>되돌리기</button>
      <button type="button" class="btn-save" id="dwSave" data-action="save" disabled>저장</button>
    </div>
  </aside>
</div>
{% endblock %}

{% block foot_extra %}
{% raw %}
<script>
(function () {
  'use strict';

  var PROVIDER_DOT = { codex: 'var(--dot-blue)', claude: 'var(--rv-amber)', gemini: 'var(--rv-green)' };

  var S = {
    data: null, loadErr: null,
    sel: null, drawerOpen: false,
    draft: null, saved: null,
    me: null,
  };

  function $(id) { return document.getElementById(id); }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function fmtMoney(v) { return (v === null || v === undefined) ? '—' : ('$' + Number(v).toLocaleString('en-US', { maximumFractionDigits: 2 })); }
  function fmtInt(v) { return (v === null || v === undefined) ? '—' : Number(v).toLocaleString('en-US'); }
  function fmtTime(iso) {
    if (!iso) return '—';
    try {
      var d = new Date(iso);
      return d.toLocaleString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
    } catch (e) { return iso; }
  }
  function parseNum(v) {
    if (v === '' || v === null || v === undefined) return null;
    var n = Number(v);
    return isNaN(n) ? null : n;
  }
  function toInput(v) { return (v === null || v === undefined) ? '' : String(v); }

  function handle(res) {
    return res.clone().json().catch(function () { return null; }).then(function (j) {
      if (!res.ok) {
        var msg = (window.popcornProgress && window.popcornProgress.errText)
          ? window.popcornProgress.errText(j, res.status, '') : ('오류 ' + res.status);
        var e = new Error(msg); e.status = res.status; e.body = j; throw e;
      }
      return j;
    });
  }
  function apiGet(path) { return fetch(path, { credentials: 'same-origin' }).then(handle); }
  function apiPost(path, body) {
    return fetch(path, {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {})
    }).then(handle);
  }
  function apiDelete(path) { return fetch(path, { method: 'DELETE', credentials: 'same-origin' }).then(handle); }

  function toast(msg, kind) { window.Admin2Shell && window.Admin2Shell.toast(msg, kind); }
  function canWrite() { return !!(window.Admin2Shell && window.Admin2Shell.canWrite('owner')); }

  // ── 초기 로드 ────────────────────────────────────────────────────
  function boot() {
    bindStatic();
    window.Admin2Shell.meReady.then(function (me) {
      S.me = me;
      $('ownerHint').textContent = me
        ? ('한도 변경은 owner 등급만 가능합니다 · 현재 ' + (me.role === 'owner' ? 'owner' : me.role))
        : '한도 변경은 owner 등급만 가능합니다 · 로그인 필요';
      renderFoot();
    });
    load();
  }

  function load() {
    apiGet('/api/admin/ai-integration/status').then(function (j) {
      S.data = j; S.loadErr = null;
      // 드로어가 열려 있었으면 같은 프로바이더의 최신 값으로 다시 맞춘다(다른 창에서 바뀌었을 수 있다)
      if (S.sel && findProvider(S.sel)) {
        var dirty = diffOf().length > 0;
        if (!dirty) { S.saved = cloneLimit(findProvider(S.sel).limit); S.draft = cloneLimit(S.saved); }
      }
      renderAll();
    }).catch(function (err) {
      S.data = null; S.loadErr = err;
      renderAll();
    });
  }

  function findProvider(key) {
    if (!S.data) return null;
    var found = null;
    S.data.providers.forEach(function (p) { if (p.key === key) found = p; });
    return found;
  }

  function cloneLimit(l) {
    // sub도 daily/perMin/perDay와 같이 **문자열로 정규화**한다 — 입력이 문자열이라
    // (onInputChange가 e.target.value를 그대로 쓴다), draft가 숫자 그대로면 사용자가
    // 같은 값을 다시 타이핑했을 때 20(number) !== "20"(string)으로 오탐한다.
    var sub = {};
    Object.keys(l.sub || {}).forEach(function (k) { sub[k] = toInput(l.sub[k]); });
    return { daily: toInput(l.daily_usd), perMin: toInput(l.per_minute), perDay: toInput(l.per_day),
      action: l.action, sub: sub };
  }

  function renderAll() {
    if (S.loadErr) { renderLoadError(); return; }
    if (!S.data) return;
    renderStats();
    renderTable();
    renderDrawerFull();
  }
  function renderLoadError() {
    var un = S.loadErr.status === 401;
    $('ptable').innerHTML = '<div class="errbox"><div class="ti">' + (un ? '세션 만료' : '조회 실패') + '</div>' +
      '<div class="ds">' + (un ? '관리자 로그인 후 다시 조회합니다.' : ('연동 상태를 받지 못했습니다 — ' + esc(S.loadErr.message))) + '</div>' +
      (un ? '<a href="/admin/login.html">로그인</a>' : '<button type="button" data-action="retry">다시 시도</button>') + '</div>';
    $('stats').innerHTML = '';
  }

  // ── 통계 카드 ────────────────────────────────────────────────────
  function renderStats() {
    var c = S.data.counts;
    var defs = [
      ['설정됨', c.ok, 'env에 키 있음', 'var(--rv-green)'],
      ['확인 실패', c.fail, '키는 있으나 확인 실패', 'var(--rv-amber)'],
      ['미설정', c.unset, '키 항목 자체가 없음', '#8a8377'],
    ];
    $('stats').innerHTML = defs.map(function (d) {
      return '<div class="stat"><div class="row1"><span class="mark" style="color:' + d[3] + '">●</span>' +
        '<span class="lb">' + esc(d[0]) + '</span></div>' +
        '<div class="row2"><span class="v num">' + d[1] + '</span></div>' +
        '<div class="nt">' + esc(d[2]) + '</div></div>';
    }).join('');
  }

  // ── 프로바이더 표 ────────────────────────────────────────────────
  function chipHtml(state, label) {
    return '<span class="chip ' + state + '">' + (state === 'ok' ? '● ' : state === 'fail' ? '▲ ' : '○ ') + esc(label) + '</span>';
  }
  function renderTable() {
    $('ptable').innerHTML = S.data.providers.map(function (p) {
      var on = p.key === S.sel && S.drawerOpen;
      var limitTxt = p.limit.daily_usd === null ? '<span class="lim dim">미설정</span>' : '<span class="lim">' + fmtMoney(p.limit.daily_usd) + ' / 일</span>';
      var rateTxt = (p.limit.per_minute === null && p.limit.per_day === null) ? '—'
        : (fmtInt(p.limit.per_minute) + '/분 · ' + fmtInt(p.limit.per_day) + '/일');
      return '<div class="prow' + (on ? ' on' : '') + '" data-action="select-provider" data-key="' + esc(p.key) + '">' +
        '<span class="vend"><span class="dot" style="background:' + PROVIDER_DOT[p.key] + '"></span>' +
        '<span class="vn">' + esc(p.vendor) + '</span><span class="cp">' + esc(p.company) + '</span></span>' +
        '<span class="envk">' + esc(p.env_key) + '</span>' +
        '<span class="mdl">' + esc(p.model) + '</span>' +
        '<span>' + limitTxt + '</span>' +
        '<span class="rate">' + esc(rateTxt) + '</span>' +
        '<span class="stwrap">' + chipHtml(p.state, p.state_label) +
        '<span class="stnote">' + esc(p.state_note) + '</span></span></div>';
    }).join('');
  }

  // ── 드로어 ───────────────────────────────────────────────────────
  function select(key) {
    if (S.sel && diffOf().length) {
      toast('저장하지 않은 변경이 있습니다 — 저장하거나 되돌린 뒤 옮기세요', 'warn');
      return;
    }
    var p = findProvider(key);
    if (!p) return;
    S.sel = key; S.saved = cloneLimit(p.limit); S.draft = cloneLimit(p.limit);
    S.drawerOpen = true;
    $('backdrop').hidden = false; $('drawer').hidden = false;
    renderTable();
    renderDrawerFull();
  }
  function closeDrawer() {
    // 원안 onClose와 같은 동작: 저장하지 않은 편집은 조용히 버린다(경고 없음) — 그래서
    // 선택 자체도 완전히 지운다. sel만 남기고 draft를 안 지우면, 바로 다른 프로바이더를
    // 골랐을 때 "이미 닫은 드로어의 편집"이 새 선택을 막는 오탐이 생긴다.
    S.drawerOpen = false; S.sel = null; S.saved = null; S.draft = null;
    $('backdrop').hidden = true; $('drawer').hidden = true;
    renderTable();
  }

  /** true면 이 프로바이더에 저장된 한도가 하나도 없다("한도 초기화"가 지울 것도 없는 상태). */
  function isUnset(l) {
    if (!l) return true;
    if (l.daily !== '' || l.perMin !== '' || l.perDay !== '' || l.action) return false;
    var sub = l.sub || {};
    return Object.keys(sub).every(function (k) { return sub[k] === ''; });
  }

  function diffOf() {
    if (!S.sel || !S.saved || !S.draft) return [];
    var a = S.saved, b = S.draft, out = [];
    if (a.daily !== b.daily) out.push({ f: 'daily_usd', from: a.daily, to: b.daily,
      line: S.sel + '.daily_usd: ' + fmtMoney(parseNum(a.daily)) + ' → ' + fmtMoney(parseNum(b.daily)) });
    if (a.perMin !== b.perMin) out.push({ f: 'per_minute', from: a.perMin, to: b.perMin,
      line: S.sel + '.per_minute: ' + (a.perMin || '없음') + ' → ' + (b.perMin || '없음') });
    if (a.perDay !== b.perDay) out.push({ f: 'per_day', from: a.perDay, to: b.perDay,
      line: S.sel + '.per_day: ' + (a.perDay || '없음') + ' → ' + (b.perDay || '없음') });
    if (a.action !== b.action) out.push({ f: 'action', from: a.action, to: b.action,
      line: S.sel + '.action: ' + (a.action || '없음') + ' → ' + (b.action || '없음') });
    (S.data.tasks || []).forEach(function (t) {
      if (a.sub[t.key] !== b.sub[t.key]) out.push({ f: 'sub.' + t.key, from: a.sub[t.key], to: b.sub[t.key],
        line: S.sel + '.sub[' + t.label + ']: ' + fmtMoney(parseNum(a.sub[t.key])) + ' → ' + fmtMoney(parseNum(b.sub[t.key])) });
    });
    return out;
  }

  function renderDrawerFull() {
    if (!S.sel) return;
    var p = findProvider(S.sel);
    if (!p) { closeDrawer(); return; }
    $('dwDot').style.background = PROVIDER_DOT[p.key];
    $('dwVendor').textContent = p.vendor;
    $('dwCompany').textContent = p.company;
    $('dwState').className = 'chip ' + p.state;
    $('dwState').textContent = (p.state === 'ok' ? '● ' : p.state === 'fail' ? '▲ ' : '○ ') + p.state_label;
    $('dwEnvKey').textContent = p.env_key;
    $('dwCheckedAt').textContent = fmtTime(p.checked_at) + ' 확인';
    $('dwKeyNote').textContent = p.state_note;

    $('fDaily').value = S.draft.daily;
    $('fPerMin').value = S.draft.perMin;
    $('fPerDay').value = S.draft.perDay;

    $('dwSubList').innerHTML = (S.data.tasks || []).map(function (t) {
      return '<div class="subrow" data-task="' + esc(t.key) + '">' +
        '<span class="nm">' + esc(t.label) + '</span>' +
        '<span class="track"><span class="bar" id="bar-' + esc(t.key) + '"></span></span>' +
        '<span class="valwrap"><span class="pfx">$</span>' +
        '<input data-sub="' + esc(t.key) + '" value="' + esc(S.draft.sub[t.key]) + '" placeholder="0" inputmode="decimal"></span></div>';
    }).join('');

    $('dwActions').innerHTML = (S.data.actions || []).map(function (a) {
      var on = S.draft.action === a.key;
      return '<div class="actrow' + (on ? ' on' : '') + '" data-action="pick-action" data-key="' + esc(a.key) + '">' +
        '<span class="mk">' + (on ? '●' : '○') + '</span>' +
        '<span class="body"><span class="lb">' + esc(a.label) + '</span><span class="ds">' + esc(a.desc) + '</span></span></div>';
    }).join('');

    renderDrawerDynamic();
  }

  /** 입력값·되돌리기·선택 상태만 갱신한다 — input의 value는 건드리지 않는다(타이핑 중 커서 유지). */
  function renderDrawerDynamic() {
    if (!S.sel) return;
    var diffs = diffOf();
    var dirty = diffs.length > 0;
    var daily = parseNum($('fDaily').value);
    var subTotal = (S.data.tasks || []).reduce(function (sum, t) {
      var el = document.querySelector('[data-sub="' + t.key + '"]');
      var v = el ? parseNum(el.value) : parseNum(S.draft.sub[t.key]);
      return sum + (v || 0);
    }, 0);
    var overSub = daily !== null && subTotal > daily;
    var cap = daily || 1;

    (S.data.tasks || []).forEach(function (t) {
      var bar = $('bar-' + t.key);
      if (!bar) return;
      var el = document.querySelector('[data-sub="' + t.key + '"]');
      var v = el ? parseNum(el.value) : 0;
      bar.style.width = Math.max(0, Math.min(100, Math.round((v || 0) / cap * 100))) + '%';
      bar.style.background = overSub ? 'var(--rv-red)' : PROVIDER_DOT[S.sel];
    });

    $('dwSubSum').textContent = '합계 ' + fmtMoney(subTotal) + ' / 프로바이더 한도 ' + (daily === null ? '미설정' : fmtMoney(daily));
    $('dwSubSum').style.color = overSub ? 'var(--rv-red)' : '';
    $('dwSubNote').textContent = overSub
      ? '부분 한도 합계가 프로바이더 한도를 넘습니다 — 이대로 저장하면 400을 받습니다'
      : (daily === null ? '일 한도를 먼저 정하면 배분 여유가 표시됩니다'
        : '부분 한도는 프로바이더 한도 안에서만 배분됩니다 (남은 여유 ' + fmtMoney(daily - subTotal) + ')');
    $('dwSubNote').style.color = overSub ? 'var(--rv-red)' : '#8a8377';

    var owner = canWrite();
    var nothingSet = isUnset(S.saved);
    $('dwDiff').hidden = !dirty;
    if (dirty) {
      $('dwDiffLines').innerHTML = diffs.map(function (d) { return '<div class="line">' + esc(d.line) + '</div>'; }).join('');
    }
    $('dwRevert').disabled = !dirty;
    $('dwSave').disabled = !(owner && dirty);
    // 초기화는 "저장된" 정책을 지우는 동작이라 초안이 남아 있으면(dirty) 무엇을 지우는
    // 건지 애매해진다 — 먼저 저장하거나 되돌려 draft==saved로 맞춘 뒤에만 켠다.
    $('dwClear').disabled = !(owner && !dirty && !nothingSet);
    var note = $('dwFootNote');
    if (!owner) {
      note.textContent = '권한이 부족합니다 (필요: owner, 현재: ' + (S.me ? S.me.role : '로그인 필요') + ') — 연결 상태 조회만 가능합니다';
      note.className = 'note warn';
    } else if (dirty) {
      note.textContent = '저장하면 즉시 반영되고 이력에 남습니다';
      note.className = 'note';
    } else if (nothingSet) {
      note.textContent = '미설정 상태입니다';
      note.className = 'note';
    } else {
      note.textContent = '변경 사항이 없습니다';
      note.className = 'note';
    }
  }

  function onInputChange(e) {
    var field = e.target.getAttribute('data-field');   // 'daily' | 'perMin' | 'perDay'
    var sub = e.target.getAttribute('data-sub');
    if (field) S.draft[field] = e.target.value;
    if (sub) S.draft.sub[sub] = e.target.value;
    renderDrawerDynamic();
  }

  function pickAction(key) {
    if (!canWrite()) { toast('권한이 부족합니다 (필요: owner, 현재: ' + (S.me ? S.me.role : '로그인 필요') + ')', 'err'); return; }
    S.draft.action = key;
    Array.prototype.forEach.call(document.querySelectorAll('.actrow'), function (row) {
      var on = row.getAttribute('data-key') === key;
      row.classList.toggle('on', on);
      row.querySelector('.mk').textContent = on ? '●' : '○';
    });
    renderDrawerDynamic();
  }

  function doRevert() {
    if (!diffOf().length) { toast('되돌릴 변경이 없습니다', 'warn'); return; }
    // S.saved는 이미 입력형(cloneLimit 결과) — 그대로 복제해 draft에 되돌린다
    S.draft = { daily: S.saved.daily, perMin: S.saved.perMin, perDay: S.saved.perDay,
      action: S.saved.action, sub: Object.assign({}, S.saved.sub) };
    renderDrawerFull();
    toast('저장 전 상태로 되돌렸습니다', 'ok');
  }

  /** 저장된 한도를 미설정으로 되돌린다("되돌리기"와 다르다 — 저건 저장 전 초안을
   * 버리는 것이고, 이건 서버에 이미 저장된 정책 자체를 지우는 것이다). 전용 버튼 +
   * confirm() 확인을 거쳐야만 실행된다(입력칸을 비우고 저장하는 것만으로는 지워지지
   * 않는다 — 의도치 않은 삭제 방지, api/admin_ai_integration.py 모듈 docstring 참고). */
  function doClear() {
    if (!canWrite()) { toast('권한이 부족합니다 (필요: owner, 현재: ' + (S.me ? S.me.role : '로그인 필요') + ')', 'err'); return; }
    if (diffOf().length) { toast('저장하지 않은 변경이 있습니다 — 저장하거나 되돌린 뒤 초기화하세요', 'warn'); return; }
    if (isUnset(S.saved)) { toast('이미 미설정 상태입니다', 'warn'); return; }
    var p = findProvider(S.sel);
    var vendor = p ? p.vendor : S.sel;
    var ok = window.confirm(
      vendor + '의 한도를 모두 미설정으로 되돌립니다. 일 한도·호출 제한·작업별 부분 한도·' +
      '초과 시 동작이 함께 지워지며, 다시 쓰려면 값을 새로 입력해야 합니다. 계속할까요?');
    if (!ok) return;
    apiDelete('/api/admin/ai-integration/limits/' + encodeURIComponent(S.sel)).then(function (j) {
      // 진행 바(ui-progress.js)가 j.message를 이미 보여준다 — 값만 반영한다
      var pp = findProvider(S.sel);
      if (pp) pp.limit = j.limit;
      S.saved = cloneLimit(j.limit); S.draft = cloneLimit(j.limit);
      renderTable(); renderDrawerFull();
    }).catch(function () { /* ui-progress.js가 오류를 이미 표시한다 */ });
  }

  function doSave() {
    if (!canWrite()) { toast('권한이 부족합니다 (필요: owner, 현재: ' + (S.me ? S.me.role : '로그인 필요') + ')', 'err'); return; }
    var diffs = diffOf();
    if (!diffs.length) { toast('변경 사항이 없습니다', 'warn'); return; }
    var daily = parseNum(S.draft.daily);
    if (daily === null || daily <= 0) { toast('일 한도는 0보다 커야 합니다', 'err'); return; }
    var sub = {};
    (S.data.tasks || []).forEach(function (t) { sub[t.key] = parseNum(S.draft.sub[t.key]); });
    var subTotal = Object.keys(sub).reduce(function (s, k) { return s + (sub[k] || 0); }, 0);
    if (subTotal > daily) { toast('부분 한도 합계 $' + subTotal + '가 프로바이더 한도 $' + daily + '를 넘습니다', 'err'); return; }
    var body = { daily_usd: daily, per_minute: parseNum(S.draft.perMin), per_day: parseNum(S.draft.perDay),
      action: S.draft.action, sub: sub };
    apiPost('/api/admin/ai-integration/limits/' + encodeURIComponent(S.sel), body).then(function (j) {
      // 진행 바(ui-progress.js)가 j.message를 이미 보여준다 — 값만 반영한다
      var p = findProvider(S.sel);
      if (p) p.limit = j.limit;
      S.saved = cloneLimit(j.limit); S.draft = cloneLimit(j.limit);
      renderTable(); renderDrawerFull();
    }).catch(function () { /* ui-progress.js가 오류를 이미 표시한다 */ });
  }

  // ── 정적 바인딩 ──────────────────────────────────────────────────
  function bindStatic() {
    document.addEventListener('click', function (ev) {
      var sel = ev.target.closest('[data-action="select-provider"]');
      if (sel) { select(sel.getAttribute('data-key')); return; }
      var pick = ev.target.closest('[data-action="pick-action"]');
      if (pick) { pickAction(pick.getAttribute('data-key')); return; }
      if (ev.target.closest('[data-action="close-drawer"]')) { closeDrawer(); return; }
      if (ev.target.closest('[data-action="clear-limit"]')) { doClear(); return; }
      if (ev.target.closest('[data-action="revert"]')) { doRevert(); return; }
      if (ev.target.closest('[data-action="save"]')) { doSave(); return; }
      if (ev.target.closest('[data-action="retry"]')) { load(); return; }
      if (ev.target === $('backdrop')) { closeDrawer(); return; }
    });
    document.addEventListener('input', function (ev) {
      if (ev.target.matches('[data-field]') || ev.target.matches('[data-sub]')) onInputChange(ev);
    });
  }
  function renderFoot() { if (S.sel) renderDrawerDynamic(); }

  boot();
})();
</script>
{% endraw %}
{% endblock %}
