.stat .v{font:600 24px/1.15 var(--rv-mono);font-variant-numeric:tabular-nums}
.stat .nt{font:400 10.5px/1.4 var(--rv-font);color:var(--rv-dim)}

/* 프로바이더 표 */
.pwrap{flex:1;min-height:0;display:flex;flex-direction:column;padding:12px 18px 18px}
.phead{flex:none;display:grid;grid-template-columns:196px 176px 152px 116px 132px 1fr;gap:12px;
      align-items:center;padding:9px 14px;background:var(--rv-panel);border:1px solid rgba(0,0,0,.1);
      border-radius:7px 7px 0 0;font:600 10.5px/1 var(--rv-font);color:#7d7669}
