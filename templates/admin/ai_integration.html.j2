:root{ --dot-blue: oklch(0.5 0.12 250); }

.a2-hd .hint{font:400 11px/1 var(--rv-font);color:var(--rv-faint)}

/* ── 헤더 아래를 감싸는 relative 래퍼 — 드로어가 이 안에서 inset:0으로 덮인다(위 ④) ── */
.ai-body{flex:1;min-height:0;display:flex;flex-direction:column;position:relative;overflow:hidden}
.ai-scroll{flex:1;min-height:0;overflow:auto;display:flex;flex-direction:column}

/* 키 안내 배너 */
.keynote{flex:none;margin:12px 18px 0;border:1px solid rgba(0,0,0,.14);background:var(--rv-panel2);
