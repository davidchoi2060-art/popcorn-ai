     background:transparent;-webkit-tap-highlight-color:transparent}
.prow:last-child{border-bottom:none}
.prow:hover{background:rgba(0,0,0,.02)}
.prow.on{background:#f0ece1;border-left-color:var(--rv-ink)}
.prow .vend{display:flex;align-items:center;gap:9px;min-width:0}
.prow .dot{width:9px;height:9px;flex:none;border-radius:50%}
.prow .vn{font:600 12.5px/1.3 var(--rv-font)}
.prow .cp{font:400 11px/1.3 var(--rv-font);color:var(--rv-faint)}
.prow .envk{font:400 11px/1.3 var(--rv-mono);color:var(--rv-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.prow .mdl{font:400 10.5px/1.3 var(--rv-mono);color:var(--rv-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
