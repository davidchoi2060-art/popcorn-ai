        display:flex;align-items:center;gap:11px;flex-wrap:wrap}
.keynote .tag{font:600 11px/1 var(--rv-mono);color:var(--rv-muted);flex:none}
.keynote .main{font:600 11.5px/1.4 var(--rv-font)}
.keynote .main code{font-family:var(--rv-mono)}
.keynote .sub{font:400 10.5px/1.5 var(--rv-font);color:#5b564d;flex:1;min-width:260px}

/* 통계 카드 */
.stats{flex:none;padding:12px 18px 0;display:flex;gap:10px}
.stat{flex:1;background:var(--rv-card);border:1px solid rgba(0,0,0,.11);border-radius:8px;padding:9px 12px;min-width:0}
