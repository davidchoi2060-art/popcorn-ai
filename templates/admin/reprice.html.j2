{% block title %}판매가 재산정{% endblock %}

{% block head_extra %}
<style>
*{box-sizing:border-box}

.rp-page{flex:1;min-height:0;overflow-y:auto;padding:16px 18px 40px}

/* ── 권한 안내 ──────────────────────────────────────────────────── */
.rp-permnote{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;font:400 11.5px/1.6 var(--rv-font);
    color:var(--rv-muted);background:var(--rv-panel);border:1px solid rgba(0,0,0,.1);border-radius:7px;
    padding:9px 13px;margin-bottom:16px}
.rp-permnote-i{flex:none;font:600 10px/1 var(--rv-font);letter-spacing:.04em;color:var(--rv-faint);
    border:1px solid rgba(0,0,0,.16);border-radius:4px;padding:3px 6px}
.rp-permnote b{color:var(--rv-ink);font-weight:700}

/* ── 레이아웃 — 1a: 회차->범위->미리보기->실행 한 줄기, 위험 갈래는 우측 ─────────── */
.rp-layout{display:grid;grid-template-columns:1fr 336px;gap:16px;align-items:start}
.rp-main{display:flex;flex-direction:column;gap:16px;min-width:0}
.rp-aside{display:flex;flex-direction:column;gap:14px;min-width:0}

/* ── 카드 공통 ──────────────────────────────────────────────────── */
.rp-card{background:var(--rv-card);border:1px solid rgba(0,0,0,.1);border-radius:10px;padding:16px 18px;
    border-left:4px solid var(--rv-dim3)}
.rp-card-red{border-left-color:var(--rv-red)}
.rp-card-hd{display:flex;align-items:center;flex-wrap:wrap;gap:9px;margin-bottom:10px}
.rp-card-hd h2{margin:0;font:700 14.5px/1.3 var(--rv-font);color:var(--rv-ink)}
.rp-badge{font:600 10.5px/1 var(--rv-mono);color:var(--rv-muted);background:var(--rv-panel);
    border:1px solid rgba(0,0,0,.1);border-radius:6px;padding:5px 9px}
.rp-card-note2{margin:10px 0 0;font:400 11.3px/1.65 var(--rv-font);color:var(--rv-ink-soft)}
.rp-card-note2 code{font:500 10.5px/1 var(--rv-mono);background:rgba(0,0,0,.06);padding:1px 4px;
    border-radius:3px;color:var(--rv-ink-soft)}

/* ── 지난 회차 표 ───────────────────────────────────────────────── */
.rp-table-wrap{overflow-x:auto;border:1px solid rgba(0,0,0,.1);border-radius:8px}
.rp-round-table{width:100%;min-width:760px;border-collapse:collapse}
.rp-round-table th{text-align:left;font:600 10.3px/1.3 var(--rv-font);color:var(--rv-faint);
    background:var(--rv-panel2);padding:8px 10px;border-bottom:1px solid rgba(0,0,0,.1);white-space:nowrap}
.rp-round-table td{font:400 11.8px/1.5 var(--rv-font);color:var(--rv-ink);padding:9px 10px;
    border-bottom:1px solid rgba(0,0,0,.07);vertical-align:top}
.rp-round-table tr:last-child td{border-bottom:none}
.rp-round-table td.num{font-family:var(--rv-mono)}
.rp-c-round{white-space:nowrap}
.rp-round-no{margin-top:3px;font:500 10px/1 var(--rv-mono);color:var(--rv-faint)}
.rp-c-note{max-width:220px;word-break:break-word}
.rp-muted{color:var(--rv-faint);font-size:10.8px}
.rp-interval{display:inline-block;margin-top:2px;color:var(--rv-muted);font-size:10.8px}
.rp-badge-done{display:inline-block;font:600 9.5px/1 var(--rv-font);padding:3px 7px;border-radius:9px;
    background:oklch(0.94 0.05 165 / .55);color:oklch(0.38 0.11 165);border:1px solid oklch(0.55 0.11 165 / .4)}
.rp-badge-live{display:inline-block;font:600 9.5px/1 var(--rv-font);padding:3px 7px;border-radius:9px;
    background:oklch(0.95 0.05 70 / .6);color:oklch(0.5 0.13 62);border:1px solid oklch(0.6 0.13 62 / .4)}
.rp-row-err{margin-top:5px;font:400 10.3px/1.5 var(--rv-font);color:var(--rv-red);max-width:150px}
.rp-empty{padding:14px 4px;font:400 12px/1.6 var(--rv-font);color:var(--rv-faint)}

/* ── ① 범위 선택 ────────────────────────────────────────────────── */
.rp-scope-list{display:flex;flex-direction:column;gap:8px;margin-bottom:12px}
.rp-scope-opt{display:flex;align-items:baseline;gap:10px;padding:10px 12px;border:1px solid rgba(0,0,0,.12);
    border-radius:8px;cursor:pointer}
.rp-scope-opt.on{border-color:var(--rv-ink);background:var(--rv-panel2)}
.rp-scope-opt input{flex:none;margin:2px 0 0}
.rp-scope-name{font:700 12.5px/1.3 var(--rv-font);color:var(--rv-ink);flex:none}
.rp-scope-desc{font:400 11px/1.5 var(--rv-font);color:var(--rv-muted)}

/* ── 버튼 · 진행 표시(공용) ─────────────────────────────────────── */
.rp-actions{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-top:4px}
.rp-btn{font:600 11.5px/1 var(--rv-font);color:var(--rv-ink);background:var(--rv-card);
    border:1px solid rgba(0,0,0,.26);border-radius:6px;padding:9px 14px;cursor:pointer}
.rp-btn:disabled{color:var(--rv-dim2);border-color:rgba(0,0,0,.12);cursor:not-allowed;background:var(--rv-card)}
.rp-btn-primary{background:var(--rv-ink);color:var(--rv-canvas);border:none}
.rp-btn-primary:disabled{background:var(--rv-dim3);color:#f0ece2;cursor:not-allowed}
.rp-btn-danger{background:var(--rv-red);color:var(--rv-canvas);border:none}
.rp-btn-danger:disabled{background:var(--rv-dim3);color:#f0ece2;cursor:not-allowed}
.rp-btn-ghost{background:none;border:1px solid rgba(0,0,0,.18);color:var(--rv-muted)}
.rp-btn-sm{padding:6px 9px;font-size:10.8px}
.rp-busy{display:inline-flex;align-items:center;gap:7px;font:500 11.3px/1 var(--rv-font);color:var(--rv-muted)}
.rp-busy-sp{width:12px;height:12px;border:2px solid rgba(0,0,0,.16);border-top-color:var(--rv-ink);
    border-radius:50%;display:inline-block;animation:rpSpin .7s linear infinite}
@keyframes rpSpin{to{transform:rotate(360deg)}}

/* ── ② 미리보기 결과 ────────────────────────────────────────────── */
.rp-impact-scope{font:500 10.8px/1.4 var(--rv-font);color:var(--rv-faint);margin-bottom:8px}
.rp-impact-grid{display:grid;grid-template-columns:repeat(6,minmax(74px,1fr));gap:6px;margin-bottom:8px}
.rp-impact-cell{background:var(--rv-panel);border:1px solid rgba(0,0,0,.09);border-radius:7px;
    padding:8px 6px;text-align:center}
.rp-impact-cell.na{border-style:dashed}
.rp-impact-n{display:block;font:700 15px/1.2 var(--rv-mono);color:var(--rv-ink)}
.rp-impact-n.up{color:oklch(0.5 0.14 25)}
.rp-impact-n.down{color:var(--rv-link)}
.rp-impact-n.na{font-size:11px;color:var(--rv-dim2)}
.rp-impact-l{display:block;margin-top:3px;font:500 9.5px/1.3 var(--rv-font);color:var(--rv-muted)}
.rp-impact-sum{font:500 11px/1.6 var(--rv-mono);color:var(--rv-ink-soft);margin-bottom:8px}
.rp-impact-sum b.up{color:oklch(0.5 0.14 25)}
.rp-impact-sum b.down{color:var(--rv-link)}
.rp-impact-na-note{margin:0 0 10px;font:400 10.3px/1.55 var(--rv-font);color:var(--rv-faint)}
.rp-impact-na-note code{font:500 10.2px/1 var(--rv-mono);background:rgba(0,0,0,.06);padding:1px 4px;
    border-radius:3px;color:var(--rv-ink-soft)}
.rp-impact-empty{font:400 11px/1.6 var(--rv-font);color:var(--rv-faint);padding:8px 0}
.rp-impact-err{font:400 11px/1.6 var(--rv-font);color:var(--rv-red);padding:8px 0}
.rp-formula{margin:2px 0 10px;font:500 11.3px/1.6 var(--rv-mono);color:var(--rv-ink-soft);
    background:var(--rv-panel2);border-radius:6px;padding:8px 10px}
.rp-notice{border:1px solid rgba(0,0,0,.14);background:var(--rv-panel2);border-radius:7px;
    padding:9px 12px;margin:0 0 10px;font:400 11px/1.65 var(--rv-font);color:var(--rv-ink-soft)}
.rp-notice strong{font-weight:700;color:var(--rv-ink)}
.rp-warnbox{border:1.5px solid var(--rv-amber);background:oklch(0.95 0.04 70 / .5);border-radius:8px;
    padding:10px 12px;margin:0 0 10px;font:400 11.5px/1.6 var(--rv-font);color:oklch(0.4 0.1 62)}

/* ── 예시 목록 ──────────────────────────────────────────────────── */
.rp-examples{margin-top:6px;padding-top:10px;border-top:1px solid rgba(0,0,0,.08)}
.rp-ex-group{margin-bottom:10px}
.rp-ex-group:last-child{margin-bottom:0}
.rp-ex-title{font:600 10.8px/1.3 var(--rv-font);color:var(--rv-faint);margin-bottom:6px}
.rp-ex-row{display:grid;grid-template-columns:minmax(110px,1.4fr) minmax(90px,1fr) minmax(150px,1.2fr);
    gap:8px;align-items:baseline;padding:5px 0;border-bottom:1px solid rgba(0,0,0,.05)}
.rp-ex-row:last-child{border-bottom:none}
.rp-ex-name{font:500 11.3px/1.3 var(--rv-font);color:var(--rv-ink);overflow:hidden;text-overflow:ellipsis;
    white-space:nowrap}
.rp-ex-code{font:400 10.3px/1.3 var(--rv-mono);color:var(--rv-faint)}
.rp-ex-price{font:500 10.6px/1.3 var(--rv-mono);color:var(--rv-ink-soft);text-align:right;white-space:nowrap}

/* ── ③ 실행 ─────────────────────────────────────────────────────── */
.rp-field{margin-bottom:12px}
.rp-field-label{display:block;font:600 10.5px/1 var(--rv-font);color:var(--rv-faint);margin-bottom:6px}
.rp-input{width:100%;font:500 12.5px/1 var(--rv-font);color:var(--rv-ink);background:var(--rv-canvas);
    border:1px solid rgba(0,0,0,.26);border-radius:6px;padding:9px 10px;outline:none}
.rp-hint{margin-top:5px;font:400 10.6px/1.55 var(--rv-font);color:var(--rv-faint)}
.rp-safety{margin:9px 0 0;font:400 11.5px/1.6 var(--rv-font);color:var(--rv-ink-soft)}
.rp-safety b{font-weight:700;color:var(--rv-ink)}
.rp-safetybox{margin-top:9px;border:1px solid rgba(0,0,0,.16);background:var(--rv-panel);border-radius:8px;
    padding:11px 13px;font:400 11.5px/1.6 var(--rv-font);color:var(--rv-ink-soft)}
.rp-safetybox b{font-weight:700;color:var(--rv-ink)}
.rp-safetybox-detail{margin-top:6px;padding-top:6px;border-top:1px solid rgba(0,0,0,.08);color:var(--rv-faint);
