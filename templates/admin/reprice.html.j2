    font:400 10.6px/1.75 var(--rv-font);color:var(--rv-faint)}

@media (max-width:768px){
  .rp-page{padding:12px 12px 32px}
  .rp-layout{grid-template-columns:1fr}
  .rp-impact-grid{grid-template-columns:repeat(3,minmax(64px,1fr))}
  .rp-ex-row{grid-template-columns:1fr;row-gap:2px}
  .rp-ex-price{text-align:left}
}
</style>
{% endblock %}

{% block content %}
<div class="rp-page" data-screen-id="ADM-PRC-050" data-domain="reprice">

  <div class="rp-permnote">
    <span class="rp-permnote-i">권한</span>
    <span><b>미리보기</b>는 로그인한 운영자 누구나 조회할 수 있습니다 ·
      <b>실행·되돌리기</b>는 <b>관리자(owner)</b>만 할 수 있습니다.</span>
  </div>

  <div class="rp-layout">
    <div class="rp-main">

      <!-- 지난 회차 — 이 화면의 축. 경고 배너가 아니라 표다. -->
      <section class="rp-card" data-keep="1">
        <div class="rp-card-hd">
          <h2>지난 회차</h2>
          <span class="rp-badge" id="rpRoundBadge">불러오는 중…</span>
        </div>
        <div id="rpRoundsArea"></div>
        <p class="rp-card-note2">되돌림은 삭제가 아니라 <b>역방향 이력 행</b>입니다
          (<code>margin_policy_undo</code>) — 값이 원래대로 돌아가고 두 행이 함께 남습니다.</p>
      </section>

      <!-- ① 범위 -->
      <section class="rp-card" data-keep="1">
        <div class="rp-card-hd"><h2>① 범위를 고릅니다</h2></div>
        <div id="rpScopeArea"></div>
      </section>

      <!-- ② 미리보기 -->
      <section class="rp-card" data-keep="1">
        <div class="rp-card-hd"><h2>② 미리보기</h2></div>
        <div id="rpPreviewBody">
          <div class="rp-impact-empty">범위를 고르고 「미리보기」를 눌러 확인하십시오.</div>
        </div>
      </section>

      <!-- ③ 실행 -->
      <section class="rp-card rp-card-red" data-keep="1">
        <div class="rp-card-hd"><h2>③ 확인하고 실행</h2></div>
        <div id="rpExecBody">
          <div class="rp-impact-empty">먼저 위에서 미리보기를 하십시오.</div>
        </div>
      </section>

    </div>

    <aside class="rp-aside">
      <div class="rp-aside-card">
        <div class="rp-aside-t">위험 갈래</div>
        <div id="rpRisk"></div>
      </div>

      <div class="rp-aside-card">
        <div class="rp-aside-t">공식 · 안 바뀌는 것</div>
        <p class="rp-aside-p">제안가 = 매입가 × (1 + 카드수수료 + 마진) → 1,000원 단위 반올림. 분류별
          예외가 실제로 걸리는 유일한 경로가 이 화면의 재산정입니다.</p>
        <p class="rp-aside-p"><b>이미 만든 견적은 그대로입니다</b> — <code>quote_snapshots.items</code>를
          고치는 코드가 저장소 전체 0건입니다.</p>
        <p class="rp-aside-p">한 번에 반영하는 상한은 <b>20,000건</b>입니다(오름+내림 기준). 넘으면
          거부하지 않고 앞 20,000건만 반영한 뒤 남은 건수를 알립니다 — 자동 재처리는 없습니다.</p>
      </div>

      <div class="rp-aside-card">
        <div class="rp-aside-t">권한</div>
        <div class="rp-risk-row"><span class="k">미리보기</span><span class="v" style="font-family:var(--rv-font)">로그인한 운영자 누구나</span></div>
        <div class="rp-risk-row"><span class="k">실행 · 되돌리기</span><span class="v" style="font-family:var(--rv-font)">관리자(owner)만</span></div>
      </div>

      <div class="rp-aside-card">
        <div class="rp-aside-t">이 화면에서 안 하는 것</div>
        <div class="rp-risk-row"><span class="k">정책 정하기</span><span class="v" id="rpGoMargin" style="font-family:var(--rv-font)"></span></div>
        <div class="rp-risk-row"><span class="k">개별 상품 확정</span><span class="v" id="rpGoReview" style="font-family:var(--rv-font)"></span></div>
        <div class="rp-risk-row"><span class="k">예외 잡기 · 잠금</span><span class="v" id="rpGoSale" style="font-family:var(--rv-font)"></span></div>
        <div class="rp-risk-row"><span class="k">이력 읽기</span><span class="v" id="rpGoHistory" style="font-family:var(--rv-font)"></span></div>
        <div class="rp-risk-row"><span class="k">매입가 바꾸기</span><span class="v" style="font-family:var(--rv-font)">
          <span class="rp-link-off" title="아직 admin2 화면이 없습니다 — 구 화면(/admin/price-import.html)만 있습니다">단가표 일일 반영</span></span></div>
      </div>
    </aside>
  </div>

  <div class="rp-footnote">
    미리보기 요청에는 공용 진행 배너가 뜨지 않습니다 — 버튼 비활성 + 인라인 「미리보기 중…」 ·
    조회·실행·되돌리기 실패는 사유를 갈라 그대로 보입니다(401은 「세션이 만료됐습니다」) ·
    owner 미만이면 실행·되돌리기 버튼이 비활성이고 사유를 title로 병기합니다.
  </div>
</div>
{% endblock %}

{% block foot_extra %}
<script>
(function () {
  'use strict';

  var LINKS = {{ links_json | safe }};
  var ROUNDS = {{ rounds_json | safe }};

  // 서버 SCOPES(admin_reprice.py)의 캡션을 그대로 옮겼다 — 닫힌 3종 상수라서 화면이
  // 미리보기 전에도 라디오 캡션을 보여줘야 하는데, scope_label은 "미리본 그 범위"에만
  // 실려 온다(margin_policy.html.j2도 같은 이유로 같은 문자열을 하드코딩한 선례가 있다).
  var SCOPES = [
    { key: 'live', label: '판매중 · 재고 있음', desc: '판매 중이고 재고가 있는 상품만 — 기본값' },
    { key: 'selling', label: '판매중 전체', desc: '판매 상태인 상품 전체 — 재고 유무는 보지 않습니다' },
    { key: 'all', label: '전체', desc: '매입가가 있는 전 상품 — 품절 · 판매중지 포함' }
  ];

  var EX_META = {
    up: '오름 상위', down: '내림 상위',
    outlier: '이상치(매입가 2배 이상) 상위', negative: '역마진(판매가 낮음) 상위',
    locked: '잠김(바뀌지 않음) 상위'
  };

  var S = {
    scope: 'live',
    preview: null, previewErr: null, previewBusy: false,
    note: '',
    applyBusy: false, applyErr: null, applyErr409: null, applyOk: null,
    undoArmed: null, undoBusy: {}, undoErr: {}
  };

  function $(id) { return document.getElementById(id); }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  // 서버 note(admin_reprice.py::_summary)가 **볼드** 마크다운을 문자 그대로 담아 보낸다
  // (전수 확인 — 그 함수가 쓰는 마크다운 문법은 볼드 하나뿐, 기울임·코드·링크 없음).
  // esc()로 «전체»를 먼저 이스케이프해 이스케이프를 깨지 않은 채로 만든 뒤, 그 결과
  // 위에서 `**text**` 쌍만 <strong>으로 바꾼다 — 서버 문자열을 innerHTML에 직접 흘리지
  // 않으므로 <script> 등을 넣어도 계속 이스케이프된 채(&lt;script&gt;)로 남는다.
  function mdBold(s) {
    return esc(s).replace(/\*\*([^*]+?)\*\*/g, '<strong>$1</strong>');
  }
  function fmt(n) { return (n === null || n === undefined) ? '못 쟀음' : Number(n).toLocaleString('ko-KR'); }
  function fmtWon(n) { return (n === null || n === undefined) ? '—' : Number(n).toLocaleString('ko-KR') + '원'; }
  function pct(dec) {
    if (dec === null || dec === undefined) return '—';
    var p = Math.round(dec * 100 * 1000) / 1000;
    return p.toString();
  }
  function fmtAt(iso) {
    if (!iso) return '—';
    var d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    function p2(n) { return (n < 10 ? '0' : '') + n; }
    return d.getFullYear() + '-' + p2(d.getMonth() + 1) + '-' + p2(d.getDate()) + ' '
      + p2(d.getHours()) + ':' + p2(d.getMinutes()) + ':' + p2(d.getSeconds());
  }
  function fmtInterval(sec) {
    if (sec === null || sec === undefined) return null;
    if (sec < 60) return (Math.round(sec * 100) / 100) + '초';
    var m = Math.floor(sec / 60), s = Math.round((sec - m * 60) * 10) / 10;
    return m + '분 ' + s + '초';
  }

  function handle(res) {
    return res.clone().json().catch(function () { return null; }).then(function (j) {
      if (!res.ok) {
        var msg = (window.popcornProgress && window.popcornProgress.errText)
          ? window.popcornProgress.errText(j, res.status, '') : ('오류 ' + res.status);
        var e = new Error(msg); e.status = res.status; e.body = j; throw e;
      }
      return j;
    });
  }
  function apiGet(path) { return fetch(path, { credentials: 'same-origin' }).then(handle); }
  function apiSend(method, path, body) {
    return fetch(path, {
      method: method, credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {})
    }).then(handle);
  }
  function friendlyErr(err) {
    return err.status === 401 ? '세션이 만료됐습니다 — 다시 로그인해 주세요.' : err.message;
  }
  function canOwner() { return window.Admin2Shell.canWrite('owner'); }

  function linkHtml(key, label) {
    var t = LINKS[key];
    if (!t) return esc(label || key);
    var text = label || t.label;
    if (t.available) return '<a class="rp-link" href="' + t.href + '">' + esc(text) + ' →</a>';
    return '<span class="rp-link-off" title="' + esc(t.reason || '') + '">' + esc(text) + '</span>';
  }

  // ── 지난 회차 ────────────────────────────────────────────────────
  function roundRowHtml(r) {
    var badge = r.undone
      ? '<span class="rp-badge-done">되돌려짐</span>'
      : '<span class="rp-badge-live">적용 중</span>';

    var undoCell;
    if (r.undone) {
      undoCell = fmtAt(r.undo_at) + '<div class="rp-muted">' + esc(r.undo_operator || '—') + '</div>'
        + '<span class="rp-interval">되돌림까지 ' + esc(fmtInterval(r.interval_seconds) || '못 쟀음') + '</span>';
    } else {
      undoCell = '<span class="rp-muted">되돌리지 않음</span>';
    }

    var mu = r.margins_used || {};
    var muKeys = Object.keys(mu);
    var policyCell = '마진 ' + pct(r.margin_rate) + '% · 수수료 ' + pct(r.card_fee_rate) + '%';
    if (muKeys.length > 1) policyCell += '<div class="rp-muted">분류마다 다름(' + muKeys.length + '종)</div>';

    var actionCell;
    if (r.undone) {
      actionCell = '<span class="rp-muted">—</span>';
    } else if (S.undoBusy[r.log_id]) {
      actionCell = '<span class="rp-busy" role="status" aria-live="polite"><span class="rp-busy-sp"></span>되돌리는 중…</span>';
    } else if (S.undoArmed === r.log_id) {
      actionCell = '<button type="button" class="rp-btn rp-btn-danger rp-btn-sm" data-action="undo-confirm" data-log="'
        + r.log_id + '">정말 되돌립니까? 확인</button> '
        + '<button type="button" class="rp-btn rp-btn-ghost rp-btn-sm" data-action="undo-cancel">취소</button>';
    } else {
      var can = canOwner();
      actionCell = '<button type="button" class="rp-btn rp-btn-sm" data-action="undo-arm" data-log="' + r.log_id + '"'
        + (can ? '' : ' disabled title="관리자(owner)만 되돌릴 수 있습니다"') + '>되돌리기</button>';
    }
    var errHtml = S.undoErr[r.log_id] ? '<div class="rp-row-err">' + esc(S.undoErr[r.log_id]) + '</div>' : '';

    return '<tr>'
      + '<td class="rp-c-round">' + badge + '<div class="rp-round-no">#' + esc(r.log_id) + '</div></td>'
      + '<td>' + fmtAt(r.at) + '<div class="rp-muted">' + esc(r.operator || '—') + '</div></td>'
      + '<td>' + esc(r.scope_label) + '</td>'
      + '<td>' + policyCell + '</td>'
      + '<td class="num">' + fmt(r.changed) + '<div class="rp-muted">오름 ' + fmt(r.up) + ' · 내림 ' + fmt(r.down) + '</div></td>'
      + '<td>' + undoCell + '</td>'
      + '<td class="rp-c-note">' + (r.note ? esc(r.note) : '<span class="rp-muted">(메모 없음)</span>') + '</td>'
      + '<td>' + actionCell + errHtml + '</td>'
      + '</tr>';
  }

  function renderRounds() {
    var undoneCount = ROUNDS.filter(function (r) { return r.undone; }).length;
    $('rpRoundBadge').textContent = fmt(ROUNDS.length) + '건 · 되돌림 ' + fmt(undoneCount) + '건';

    var box = $('rpRoundsArea');
    if (!ROUNDS.length) {
      box.innerHTML = '<div class="rp-empty">아직 재산정을 실행한 적이 없습니다.</div>';
      return;
    }
    box.innerHTML = '<div class="rp-table-wrap"><table class="rp-round-table"><thead><tr>'
      + '<th>회차</th><th>일시 · 운영자</th><th>범위</th><th>정책</th><th>변동 건수</th>'
      + '<th>되돌림</th><th>메모</th><th>동작</th></tr></thead><tbody>'
      + ROUNDS.map(roundRowHtml).join('') + '</tbody></table></div>';
  }

  // ── ① 범위 ──────────────────────────────────────────────────────
  function renderScope() {
    var html = SCOPES.map(function (s) {
      return '<label class="rp-scope-opt' + (S.scope === s.key ? ' on' : '') + '">'
        + '<input type="radio" name="rpScope" value="' + s.key + '"' + (S.scope === s.key ? ' checked' : '') + '>'
        + '<span><span class="rp-scope-name">' + esc(s.label) + '</span><br>'
        + '<span class="rp-scope-desc">' + esc(s.desc) + '</span></span>'
        + '</label>';
    }).join('');
    html += '<div class="rp-actions"><button type="button" class="rp-btn rp-btn-primary" data-action="do-preview"'
      + (S.previewBusy ? ' disabled' : '') + '>미리보기</button>';
    if (S.previewBusy) {
      html += '<span class="rp-busy" role="status" aria-live="polite"><span class="rp-busy-sp"></span>미리보기 중…</span>';
    }
    html += '</div>';
    $('rpScopeArea').innerHTML = html;
  }

  // ── ② 미리보기 결과 ────────────────────────────────────────────
  function exampleRowHtml(item) {
    return '<div class="rp-ex-row">'
      + '<span class="rp-ex-name" title="' + esc(item.name || '') + '">' + esc(item.name || '') + '</span>'
      + '<span class="rp-ex-code">' + esc(item.product_code) + ' · ' + esc(item.part_label || '') + '</span>'
      + '<span class="rp-ex-price">' + fmt(item.purchase) + ' → ' + fmt(item.current) + ' → ' + fmt(item.proposed) + '원</span>'
      + '</div>';
  }
  function examplesHtml(examples) {
    if (!examples) return '';
    var out = '';
    ['up', 'down', 'outlier', 'negative', 'locked'].forEach(function (k) {
      var list = examples[k];
      if (!list || !list.length) return;
      out += '<div class="rp-ex-group"><div class="rp-ex-title">' + esc(EX_META[k]) + ' (예시 ' + list.length + '건)</div>'
        + list.map(exampleRowHtml).join('') + '</div>';
    });
    return out ? '<div class="rp-examples">' + out + '</div>' : '';
  }
  function renderPreview() {
    var box = $('rpPreviewBody');
    if (S.previewBusy && !S.preview && !S.previewErr) {
      box.innerHTML = '<div class="rp-impact-empty">불러오는 중…</div>';
      return;
    }
    if (S.previewErr) {
      box.innerHTML = '<div class="rp-impact-err">미리보기를 받지 못했습니다 — ' + esc(S.previewErr) + '</div>';
      return;
    }
    if (!S.preview) {
      box.innerHTML = '<div class="rp-impact-empty">범위를 고르고 「미리보기」를 눌러 확인하십시오.</div>';
      return;
    }
    var p = S.preview;
    var html = '<div class="rp-impact-scope">' + esc(p.scope_label) + ' 기준 · 저장된 정책으로 실제 계산한 값입니다'
      + (p.scope !== S.scope ? ' <span class="rp-muted">— 지금 고른 범위와 다릅니다. 다시 미리보기 하십시오.</span>' : '') + '</div>';
    html += '<div class="rp-impact-grid">';
    [['대상', fmt(p.target), ''], ['오름', fmt(p.up_count), 'up'], ['내림', fmt(p.down_count), 'down'],
     ['변화없음', fmt(p.same), ''], ['잠김', fmt(p.locked_count), '']].forEach(function (c) {
      html += '<div class="rp-impact-cell"><span class="rp-impact-n ' + c[2] + '">' + c[1] + '</span>'
        + '<span class="rp-impact-l">' + c[0] + '</span></div>';
    });
    html += '<div class="rp-impact-cell na"><span class="rp-impact-n na">못 셈</span><span class="rp-impact-l">해당 없음</span></div>';
    html += '</div>';
    html += '<div class="rp-impact-sum">오름 총액 <b class="up">+' + fmtWon(p.up_sum) + '</b> · 내림 총액 '
      + '<b class="down">' + fmtWon(p.down_sum) + '</b></div>';
    html += '<div class="rp-impact-na-note">「해당 없음」(공급처 0곳이라 정책을 바꿔도 안 움직이는 상품)은 이 API가'
      + ' 세지 않습니다 — <code>/reprice/preview</code>는 <code>product_supplier_prices</code>를 읽지 않고'
      + ' 매입가를 <code>products.purchase_price</code>에서 바로 씁니다. 대상(' + fmt(p.target) + ')은 이미'
      + ' 오름·내림·변화없음·잠김의 합과 같아(남는 몫 없음) 0으로 위장하지 않고 못 셈으로 둡니다.</div>';
    html += '<div class="rp-formula">' + esc(p.formula) + '</div>';
    if (p.note) html += '<div class="rp-notice">' + mdBold(p.note) + '</div>';
    if (p.changed > p.max_apply) {
      var dropped = p.changed - p.max_apply;
      html += '<div class="rp-warnbox">⚠ 상한 ' + fmt(p.max_apply) + '건을 넘습니다 — 이번 실행은 앞 '
        + fmt(p.max_apply) + '건만 반영되고 나머지 ' + fmt(dropped) + '건은 이번에 처리되지 않습니다.'
        + ' 자동 재처리는 없습니다 — 실행 후 새로 미리보기 하십시오.</div>';
    }
    html += examplesHtml(p.examples);
    box.innerHTML = html;
  }

  // ── ③ 실행 ──────────────────────────────────────────────────────
  function previewMatchesScope() { return !!S.preview && S.preview.scope === S.scope; }
  function canExecute() {
    return canOwner() && !S.applyBusy && previewMatchesScope() && S.preview.changed > 0;
  }
  function renderExecute() {
    var box = $('rpExecBody');
    if (!S.preview) {
      box.innerHTML = '<div class="rp-impact-empty">먼저 위에서 미리보기를 하십시오.</div>';
      return;
    }
    if (!previewMatchesScope()) {
      box.innerHTML = '<div class="rp-impact-empty">범위를 바꿨습니다 — 다시 미리보기 하십시오.</div>';
      return;
    }
    var p = S.preview;
    var html = '<div class="rp-field"><label class="rp-field-label" for="rpNoteInput">메모</label>'
      + '<input type="text" id="rpNoteInput" class="rp-input" maxlength="200" placeholder="예: 슬라이스 E 검증"'
      + ' value="' + esc(S.note) + '">'
      + '<div class="rp-hint">다음 사람이 왜 실행했는지 알 수 있도록 남깁니다 — 「지난 회차」 표의 메모 열에'
      + ' 그대로 남습니다(선택 입력이지만 남기기를 권합니다).</div></div>';

    if (p.changed === 0) {
      html += '<div class="rp-impact-empty">바뀔 것이 0건입니다 — 정책이 이미 반영돼 있습니다. 실행할 것이 없습니다.</div>';
      box.innerHTML = html;
      return;
    }

    var can = canExecute();
    var title = '';
    if (!canOwner()) title = '관리자(owner)만 실행할 수 있습니다';
    else if (S.applyBusy) title = '요청을 처리하는 중입니다';
    html += '<div class="rp-actions"><button type="button" class="rp-btn rp-btn-danger" data-action="do-apply"'
      + (can ? '' : ' disabled') + (title ? ' title="' + esc(title) + '"' : '') + '>'
      + fmt(p.changed) + '건 실행</button>';
    if (S.applyBusy) html += '<span class="rp-busy" role="status" aria-live="polite"><span class="rp-busy-sp"></span>실행하는 중…</span>';
    html += '</div>';
    html += '<p class="rp-safety">되돌릴 수 있지만 <b>그 사이에 나간 견적은 그 값으로 나갑니다.</b></p>';

    if (S.applyErr409) {
      html += '<div class="rp-safetybox"><b>미리보기 이후 값이 바뀌었습니다 — 다시 미리보기 하십시오.</b><br>'
        + '오류가 아니라 안전장치입니다 — 미리보기와 실행 사이에 다른 누군가(또는 다른 작업)가 값을 바꿨다는 뜻입니다.'
        + '<div class="rp-safetybox-detail">서버 응답: ' + esc(S.applyErr409) + '</div></div>';
    } else if (S.applyErr) {
      html += '<div class="rp-saveerr">' + esc(S.applyErr) + '</div>';
    }
    if (S.applyOk) html += '<div class="rp-savedok">' + esc(S.applyOk) + '</div>';
    box.innerHTML = html;
  }

  // ── aside: 위험 갈래 · 링크 ────────────────────────────────────
  function renderRisk() {
    var box = $('rpRisk');
    if (!S.preview) {
      box.innerHTML = '<div class="rp-impact-empty">미리보기를 하면 나타납니다.</div>';
      return;
    }
    var p = S.preview;
    box.innerHTML =
        '<div class="rp-risk-row"><span class="k">이상치(매입가 2배 이상)</span><span class="v">' + fmt(p.outlier_count) + '건</span></div>'
      + '<div class="rp-risk-row"><span class="k">역마진(판매가 낮음)</span><span class="v">' + fmt(p.negative_count) + '건</span></div>'
      + '<div class="rp-risk-row"><span class="k">잠김(운영자가 고정)</span><span class="v">' + fmt(p.locked_count) + '건</span></div>'
      + '<div class="rp-risk-row"><span class="k">해당 없음(공급처 0곳)</span><span class="v rp-na">못 셈</span></div>'
      + '<p class="rp-aside-p2">정책을 바꾸면 이 수가 달라집니다 — 왼쪽 「미리보기」 결과의 예시 목록에서 실제'
      + ' 상품을 확인하십시오. 실행에서 빼는 경로는 아직 없습니다(세는 데까지만).</p>';
  }
  function renderLinks() {
    $('rpGoMargin').innerHTML = linkHtml('margin_policy', '마진 정책');
    $('rpGoReview').innerHTML = linkHtml('price_review', '가격 검토 대기');
    $('rpGoSale').innerHTML = linkHtml('sale_price', '판매가 관리');
    $('rpGoHistory').innerHTML = linkHtml('price_history', '가격 이력');
  }

  function renderAll() {
    renderRounds();
    renderScope();
    renderPreview();
    renderExecute();
    renderRisk();
    renderLinks();
  }

  // ── 동작 ────────────────────────────────────────────────────────
  function doPreview() {
    if (S.previewBusy) return;
    S.previewBusy = true; S.previewErr = null; renderAll();
    apiGet('/api/admin/reprice/preview?scope=' + encodeURIComponent(S.scope)).then(function (j) {
      S.previewBusy = false; S.preview = j; S.previewErr = null;
      S.applyErr = null; S.applyErr409 = null; S.applyOk = null;
      renderAll();
    }).catch(function (err) {
      S.previewBusy = false; S.previewErr = friendlyErr(err);
      renderAll();
    });
  }
  function doApply() {
    if (!canExecute()) return;
    var p = S.preview;
    S.applyBusy = true; S.applyErr = null; S.applyErr409 = null; S.applyOk = null; renderAll();
    apiSend('POST', '/api/admin/reprice/apply',
      { scope: p.scope, expect_changed: p.changed, note: (S.note || '').trim() }).then(function (j) {
      S.applyBusy = false;
      S.applyOk = (j.verdict || '실행했습니다') + ' — 곧 새로고침해 「지난 회차」에 반영합니다…';
      renderAll();
      setTimeout(function () { location.reload(); }, 1500);
    }).catch(function (err) {
      S.applyBusy = false;
      if (err.status === 409) { S.applyErr409 = err.message; } else { S.applyErr = friendlyErr(err); }
      renderAll();
    });
  }
  function armUndo(logId) { S.undoArmed = logId; renderRounds(); }
  function cancelUndo() { S.undoArmed = null; renderRounds(); }
  function confirmUndo(logId) {
    if (!canOwner() || S.undoBusy[logId]) return;
    S.undoArmed = null; S.undoBusy[logId] = true; S.undoErr[logId] = null; renderRounds();
    apiSend('POST', '/api/admin/reprice/undo', { log_id: logId }).then(function (j) {
      $('rpRoundBadge').textContent = (j.verdict || '되돌렸습니다') + ' — 새로고침합니다…';
      setTimeout(function () { location.reload(); }, 1500);
    }).catch(function (err) {
      S.undoBusy[logId] = false; S.undoErr[logId] = friendlyErr(err);
      renderRounds();
    });
  }

  function bind() {
    document.addEventListener('click', function (ev) {
      var t = ev.target.closest('[data-action]');
      if (!t) return;
      var act = t.getAttribute('data-action');
      if (act === 'do-preview') doPreview();
      else if (act === 'do-apply') doApply();
      else if (act === 'undo-arm') { if (!t.disabled) armUndo(Number(t.getAttribute('data-log'))); }
      else if (act === 'undo-cancel') cancelUndo();
      else if (act === 'undo-confirm') confirmUndo(Number(t.getAttribute('data-log')));
    });
    document.addEventListener('change', function (ev) {
      if (ev.target.name === 'rpScope') {
        S.scope = ev.target.value;
        renderAll();
      }
    });
    document.addEventListener('input', function (ev) {
      if (ev.target.id === 'rpNoteInput') S.note = ev.target.value;
    });
  }

  function boot() {
    bind();
    renderAll();                                  // 회차·범위는 즉시(서버 렌더 데이터) — 권한 확인을 기다리지 않는다
    window.Admin2Shell.meReady.then(function () { renderAll(); });   // owner 여부가 정해지면 버튼 상태를 다시 그린다
  }

  boot();
})();
</script>
{% endblock %}
