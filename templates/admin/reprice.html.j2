.rp-aside-t{font:700 12.5px/1.4 var(--rv-font);color:var(--rv-ink);margin-bottom:8px}
.rp-aside-p{margin:0 0 8px;font:400 11.3px/1.65 var(--rv-font);color:var(--rv-ink-soft)}
.rp-aside-p:last-child{margin-bottom:0}
.rp-aside-p b{font-weight:700;color:var(--rv-ink)}
.rp-aside-p code{font:500 10.3px/1 var(--rv-mono);background:rgba(0,0,0,.06);padding:1px 4px;border-radius:3px;
