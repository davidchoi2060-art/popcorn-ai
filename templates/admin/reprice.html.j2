.rp-saveerr{margin-top:9px;font:400 11.2px/1.6 var(--rv-font);color:var(--rv-red)}
.rp-savedok{margin-top:9px;font:500 10.8px/1.5 var(--rv-font);color:oklch(0.4 0.1 165);
