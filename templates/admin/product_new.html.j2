        {% set stubs = [
          ("04", "image", "상품이미지 · 동영상", "대표 이미지 1건 · 추가 이미지 최대 9건 · 동영상 URL. 저장 표(product_media)는 마이그레이션 0081로 이미 만들어졌지만, 이 화면이 부르는 API에는 읽기·쓰기 엔드포인트가 없습니다."),
          ("05", "opt", "옵션 · 추가상품", "옵션 사용 여부 · 옵션 행(옵션명·옵션값·추가금액·재고) · 추가상품. 저장 표(product_options·product_addons)는 있지만 이 화면이 부르는 API에는 엔드포인트가 없습니다."),
          ("06", "desc", "상세설명", "상품 특징 · 사양 · 구성품 본문(마크다운). 저장 컬럼(products.description_html)은 있지만 이 화면이 부르는 API에는 엔드포인트가 없습니다."),
          ("07", "ship", "배송 · 반품/교환", "배송방법 · 배송비 · 무료배송 기준금액 · 반품/교환 배송비 · 반품/교환 안내 — 몰 반출용 값의 보관처입니다(본 시스템이 배송을 수행한다는 뜻이 아닙니다). 저장 표(product_shipping_policy)는 있지만 API 엔드포인트가 없습니다."),
          ("08", "tags", "검색 태그 · 채널 키워드", "공통 키워드 · 네이버 태그 · 쿠팡 검색어. 저장 표(product_channel_keywords)는 있지만 API 엔드포인트가 없습니다."),
          ("09", "notice", "상품정보제공고시 · A/S", "품목군 · 제조국 · 품질보증기준 · A/S 책임자 · A/S 연락처 · 특이사항. 저장 표(product_notice)는 있지만 API 엔드포인트가 없습니다."),
          ("10", "benefit", "구매 · 리뷰 혜택", "구매 적립 포인트 · 리뷰 적립 포인트. 저장 컬럼(products.point_buy·point_review)은 있지만 API 엔드포인트가 없습니다."),
          ("11", "channel", "노출 채널", "자사몰 · 네이버 스마트스토어 · 쿠팡 노출 설정 — 몰 반출 대상 채널을 고르는 자리입니다. 저장 표(product_channels)는 있지만 API 엔드포인트가 없습니다."),
        ] %}
        {% for num, key, label, note in stubs %}
        <section class="pn-card" id="pnSec-{{ key }}" data-open="n" data-sec="{{ key }}">
          <div class="pn-card-hd" data-action="toggle-section" data-sec="{{ key }}">
            <span class="pn-kicker">{{ num }}</span><h3>{{ label }}</h3>
            <span class="pn-badge-stub">API 미연결 — 향후 사용예정</span>
            <span class="pn-chev">▾</span>
          </div>
          <div class="pn-card-body">
            <div class="pn-stub-note">{{ note }}</div>
          </div>
        </section>
        {% endfor %}

      </div>

      <aside class="pn-aside">
        <div class="pn-card">
          <div class="pn-card-hd" style="cursor:default"><h3 id="pnAsideTitle">{{ crumb_now }}</h3></div>
          <div class="pn-card-body">
            <div class="pn-aside-meta" id="pnAsideMeta"></div>
            <div class="pn-lockline" id="pnLockLine" hidden></div>
            <div class="pn-result" id="pnResult" data-bind="result">
              <div class="top"><span class="code" id="pnResCode">—</span><span class="msg" id="pnResMsg">저장하면 여기에 서버 응답이 그대로 섭니다</span></div>
              <div class="nt" id="pnResNote">화면이 저장 결과를 지어내지 않습니다 — 서버가 준 사유를 그대로 표시합니다.</div>
              <div class="act" id="pnResAct"></div>
            </div>
            <button type="button" class="pn-btn pri pn-btn-block" id="pnSubmitBtn" data-action="submit">저장</button>
            <div style="display:flex;gap:8px" id="pnAsideBtns2"></div>
          </div>
        </div>

        <div class="pn-card pn-similar" id="pnSimilar" hidden>
          <div class="pn-card-hd" style="cursor:default"><h3 style="font-size:13px">이름이 거의 같은 상품</h3></div>
          <div class="pn-card-body">
            <div class="pn-sim-head" id="pnSimHead">이름이 거의 같은 상품이 이미 있습니다 — 같은 상품이면 등록 대신 기존 상품을 수정하세요.</div>
            <div class="pn-sim-list" id="pnSimList" data-repeat="similar-item"></div>
            <div class="pn-sim-actbtns">
              <button type="button" class="pn-btn pri" data-action="force-register">다른 상품으로 등록</button>
              <button type="button" class="pn-btn" data-action="cancel-similar">취소</button>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</div>
{% endblock %}

{% block foot_extra %}
{% raw %}
<script>
(function () {
  'use strict';

  var LOGIN = '/admin2/login';
  var API = '/api/admin';

  // EDITABLE(PATCH) 의 UI 키 -> DB 컬럼명(locked_fields 는 컬럼명으로 온다 — api/admin_products.py 실측)
  var COL_OF = { name: 'product_name', maker: 'maker', model_name: 'model_name',
    status: 'status', sale_price: 'sale_price', purchase_price: 'purchase_price', stock_qty: 'stock_qty' };

  var CODE = (new URLSearchParams(location.search).get('code') || '').trim();
  var MODE = CODE ? 'edit' : 'register';

  var S = {
    meta: null,          // GET /product-meta
    categories: null,    // GET /api/admin/categories (표시 전용 — 저장 불가)
    baseline: null,      // 수정 모드: GET /products/{code} 원본(diff 기준)
    partTypeTree: null,  // meta.part_choices (등록 전용 — 수정은 분류 비활성)
    partTypeSel: null,   // 현재 고른 part_type 코드(등록)
    similar: null,
    busy: false,
    sections: {}         // sec key -> open bool
  };

  function $(id) { return document.getElementById(id); }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function fmt(n) { return (n == null || isNaN(n)) ? '—' : Number(n).toLocaleString('ko-KR'); }
  function numOrNull(v) { var t = String(v == null ? '' : v).trim(); return t === '' ? null : Number(t); }

  // ── API — 실패를 삼키지 않는다. 401 은 status 로 갈라 세션 만료 안내로 간다 ──
  function handle(res) {
    return res.clone().json().catch(function () { return null; }).then(function (j) {
      if (!res.ok) {
        var msg = (window.popcornProgress && window.popcornProgress.errText)
          ? window.popcornProgress.errText(j, res.status, '') : ('오류 ' + res.status);
        var e = new Error(msg); e.status = res.status; e.body = j; throw e;
      }
      return j;
    });
  }
  function apiGet(url) { return fetch(url, { credentials: 'same-origin' }).then(handle); }
  function apiPost(url, body) {
    return fetch(url, { method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) }).then(handle);
  }
  function apiPatch(url, body) {
    return fetch(url, { method: 'PATCH', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) }).then(handle);
  }

  function writable() { return !!(window.Admin2Shell && window.Admin2Shell.canWrite('operator')); }
  function writeNote() { return 'viewer 등급은 상품을 등록·수정할 수 없습니다'; }

  // ── 초기 진입 화면 ──────────────────────────────────────────────────────
  function showInitError(html) {
    $('pnInitLoad').hidden = true;
    $('pnInitErr').hidden = false;
    $('pnInitErr').innerHTML = html;
    $('pnBody').hidden = true;
  }
  function showBody() {
    $('pnInitLoad').hidden = true;
    $('pnInitErr').hidden = true;
    $('pnBody').hidden = false;
  }

  // ── 섹션 접기/펼치기 ──────────────────────────────────────────────────
  function setSectionOpen(key, open) {
    var el = $('pnSec-' + key);
    if (!el) return;
    el.setAttribute('data-open', open ? 'y' : 'n');
  }
  document.addEventListener('click', function (e) {
    var t = e.target;
    var el;
    if ((el = t.closest('[data-action="toggle-section"]'))) {
      var sec = el.getAttribute('data-sec');
      var card = $('pnSec-' + sec);
      var open = card && card.getAttribute('data-open') === 'y';
      setSectionOpen(sec, !open);
      return;
    }
    if ((el = t.closest('[data-action="expand-all"]'))) {
      document.querySelectorAll('.pn-card[data-sec]').forEach(function (c) { c.setAttribute('data-open', 'y'); });
      return;
    }
    if ((el = t.closest('[data-action="collapse-all"]'))) {
      document.querySelectorAll('.pn-card[data-sec]').forEach(function (c) { c.setAttribute('data-open', 'n'); });
      return;
    }
    if ((el = t.closest('[data-action="submit"]'))) { if (!el.disabled) onSubmit(); return; }
    if ((el = t.closest('[data-action="reset-form"]'))) { resetForm(); return; }
    if ((el = t.closest('[data-action="force-register"]'))) { doRegister(true); return; }
    if ((el = t.closest('[data-action="cancel-similar"]'))) { hideSimilar(); return; }
    if ((el = t.closest('[data-action="goto-similar"]'))) {
      var code = el.getAttribute('data-code');
      if (code) location.href = '/admin2/product-new?code=' + encodeURIComponent(code);
      return;
    }
  });

  // ── 분류(part_type) 2단 선택 — taxonomy.choice_tree() 출력을 그대로 그린다 ──
  function findLeafGroup(tree, leafKey) {
    for (var i = 0; i < tree.length; i++) {
      if (tree[i].key === leafKey) return { top: tree[i], sub: null };
      if (tree[i].options) {
        for (var j = 0; j < tree[i].options.length; j++) {
          if (tree[i].options[j].key === leafKey) return { top: tree[i], sub: tree[i].options[j] };
        }
      }
    }
    return null;
  }
  function buildPartTypeSelect(tree, currentKey) {
    var host = $('pnPartTypeHost');
    var found = currentKey ? findLeafGroup(tree, currentKey) : null;
    var sel1 = document.createElement('select');
    sel1.className = 'pn-select'; sel1.id = 'pnPartType1'; sel1.setAttribute('aria-label', '분류(1단)');
    sel1.innerHTML = '<option value="">분류를 선택하세요</option>' + tree.map(function (t) {
      return '<option value="' + esc(t.key) + '"' + (found && found.top.key === t.key ? ' selected' : '') + '>' + esc(t.label) + '</option>';
    }).join('');
    var sel2 = document.createElement('select');
    sel2.className = 'pn-select'; sel2.id = 'pnPartType2'; sel2.setAttribute('aria-label', '분류(2단)');
    sel2.style.display = 'none';
    var wrap = document.createElement('div'); wrap.className = 'pn-2col';
    wrap.appendChild(sel1); wrap.appendChild(sel2);
    host.innerHTML = ''; host.appendChild(wrap);
    function sync() {
      var top = tree.filter(function (t) { return t.key === sel1.value; })[0];
      if (top && top.options) {
        sel2.style.display = '';
        sel2.innerHTML = top.options.map(function (o) {
          return '<option value="' + esc(o.key) + '"' + (found && found.sub && found.sub.key === o.key ? ' selected' : '') + '>' + esc(o.label) + '</option>';
        }).join('');
        S.partTypeSel = sel2.value || null;
      } else {
        sel2.style.display = 'none'; sel2.innerHTML = '';
        S.partTypeSel = top ? top.key : null;
      }
    }
    sel1.addEventListener('change', sync);
    sel2.addEventListener('change', function () { S.partTypeSel = sel2.value || null; });
    sync();
  }

  // ── 카테고리(표시 전용) — GET /api/admin/categories 를 한 번 읽어 들여쓴 select ──
  function buildCategoryOptions(items) {
    var byParent = {};
    items.forEach(function (it) {
      var p = it.parent_id == null ? 0 : it.parent_id;
      (byParent[p] = byParent[p] || []).push(it);
    });
    Object.keys(byParent).forEach(function (k) {
      byParent[k].sort(function (a, b) { return (a.sort_order || 0) - (b.sort_order || 0) || a.category_id - b.category_id; });
    });
    var out = [];
    function walk(parentId, depth) {
      (byParent[parentId] || []).forEach(function (it) {
        out.push('<option value="' + it.category_id + '">' + '　'.repeat(depth) + esc(it.name) + '</option>');
        walk(it.category_id, depth + 1);
      });
    }
    walk(0, 0);
    return out.join('');
  }

  // ── 필드 활성/비활성 — 모드별 실제 서버 저장 가능 여부(코드 실측, 머리말 표 참조) ──
  function applyModeGates() {
    var edit = MODE === 'edit';
    // 상품명 — 두 모드 모두 저장된다
    $('pnName').disabled = false;
    // SKU — 입력창 자체가 없다(자동 발번/표시 전용)
    $('pnSku').disabled = true;
    $('pnSkuNote').textContent = edit
      ? 'SKU는 수정할 수 없습니다(수정 가능 필드 목록 밖입니다).'
      : "등록하면 서버가 자동으로 발번합니다(형식 P-{일련번호}) — 이 화면에서 직접 입력하지 않습니다.";
    // 분류 — 등록만 가능, 수정은 별도 화면 소관
    if (edit) {
      $('pnPartTypeNote').hidden = false;
      $('pnPartTypeNote').className = 'pn-fnote warn';
      $('pnPartTypeNote').textContent = '분류 변경은 이 화면에서 지원하지 않습니다(별도 API — 담당 밖). 현재 값만 표시합니다.';
    } else {
      $('pnPartTypeNote').hidden = true;
    }
    // 제조사 — 두 모드 모두 저장된다
    $('pnMaker').disabled = false;
    // 브랜드 — 항상 비활성(머리말 표)
    $('pnBrand').disabled = true;
    // 모델명 — 등록 시 저장 안 됨, 수정 시 저장됨
    $('pnModel').disabled = !edit;
    $('pnModelNote').hidden = edit;
    if (!edit) $('pnModelNote').textContent = '등록 API가 이 값을 저장하지 않습니다 — 공급처 연결 등록에서만 쓰입니다. 등록 후 수정에서 입력하세요.';
    // 판매상태 — 등록은 '판매중' 고정, 수정은 선택 가능
    $('pnStatus').disabled = !edit || !S.meta;
    $('pnStatusNote').hidden = edit;
    if (!edit) $('pnStatusNote').textContent = "등록하면 '판매중'으로 고정됩니다(서버 정책) — 등록 후 수정에서 변경하세요.";
    // 카테고리 — 항상 비활성(머리말 표)
    $('pnCategory').disabled = true;
    // 판매가 — 등록 시 저장 안 됨(NULL 유지), 수정 시 저장됨
    $('pnSalePrice').disabled = !edit;
    $('pnSalePriceNote').hidden = edit;
    if (!edit) $('pnSalePriceNote').textContent = '등록 시 판매가는 비워진 상태로 시작합니다(서버 정책) — 등록 후 수정에서 입력하세요.';
    // 매입가 — 두 모드 모두 저장된다(등록은 cost_price 파라미터로)
    $('pnPurchasePrice').disabled = false;
    // 재고수량 — 등록 시 0 고정, 수정 시 저장됨
    $('pnStockQty').disabled = !edit;
    $('pnStockQtyNote').hidden = edit;
    if (!edit) $('pnStockQtyNote').textContent = '등록 시 재고수량은 0으로 시작합니다(서버 정책) — 등록 후 수정에서 입력하세요.';

    if (!writable()) {
      ['pnName', 'pnMaker', 'pnModel', 'pnStatus', 'pnSalePrice', 'pnPurchasePrice', 'pnStockQty'].forEach(function (id) {
        var el = $(id); el.disabled = true; el.title = writeNote();
      });
      if (S.partTypeSel !== undefined) {
        var s1 = $('pnPartType1'), s2 = $('pnPartType2');
        if (s1) { s1.disabled = true; s1.title = writeNote(); }
        if (s2) { s2.disabled = true; s2.title = writeNote(); }
      }
      $('pnSubmitBtn').disabled = true;
      $('pnSubmitBtn').title = writeNote();
    }
  }

  // ── product-meta 로드 — 분류·제조사·판매상태 선택지 원천(서버가 준다) ──
  function loadMeta() {
    return apiGet(API + '/product-meta').then(function (j) {
      S.meta = j;
      // 분류 선택 UI는 **등록 모드에서만** 만든다. 수정 모드는 PATCH 가 part_type 을
      // 받지 않는다(EDITABLE 밖 — 머리말 표) — 여기서 상호작용 가능한 select 를
      // 만들면 운영자가 분류를 바꿔 골라도 저장 시 조용히 버려진다("저장되는 것처럼
      // 가장하지 마라" 위반). 수정 모드는 fillFromBaseline() 이 이미 그린 정적
      // 텍스트(pn-static)를 그대로 둔다 — 여기서 건드리지 않는다.
      if (MODE === 'register') {
        var tree = j.part_choices || [];
        S.partTypeTree = tree;
        buildPartTypeSelect(tree, null);
      }
      var dl = $('pnMakerList');
      dl.innerHTML = (j.makers || []).map(function (m) { return '<option value="' + esc(m) + '">'; }).join('');
      var st = $('pnStatus');
      var opts = (j.status_options || []).map(function (s) { return '<option value="' + esc(s) + '">' + esc(s) + '</option>'; }).join('');
      st.innerHTML = opts || '<option value="">선택지 없음</option>';
      if (MODE === 'register') {
        // 서버가 항상 '판매중'으로 고정 — 실제 정책값을 그대로 보여준다(지어내지 않는다)
        if ((j.status_options || []).indexOf('판매중') >= 0) st.value = '판매중';
      } else if (S.baseline) {
        st.value = S.baseline.status || '';
      }
      applyModeGates();
    }).catch(function (e) {
      $('pnPartTypeHost').innerHTML = '<span class="pn-fnote err">분류 선택지를 불러오지 못했습니다 — ' + esc(e.message || '') + '</span>';
      $('pnMaker').disabled = true; $('pnMaker').title = '제조사 선택지를 불러오지 못했습니다';
      $('pnStatus').innerHTML = '<option value="">선택지 없음</option>';
      $('pnStatus').disabled = true; $('pnStatus').title = e.message || '';
      throw e;
    });
  }

  // ── 카테고리 — 표시 전용(저장 불가, 머리말 표 참조) ──
  function loadCategories() {
    var sel = $('pnCategory');
    return apiGet(API + '/categories').then(function (j) {
      S.categories = j;
      sel.innerHTML = '<option value="">표시 안 됨 — 조회 API에 카테고리 값이 없습니다</option>' + buildCategoryOptions(j.items || []);
    }).catch(function (e) {
      sel.innerHTML = '<option value="">카테고리 목록을 불러오지 못했습니다</option>';
      sel.title = e.message || '';
    });
  }

  // ── 잠금 표시 — locked_fields(DB 컬럼명)를 UI 필드에 매핑해 배지만 켠다 ──
  function renderLocks(locked) {
    var arr = locked || [];
    Object.keys(COL_OF).forEach(function (key) {
      var col = COL_OF[key];
      var cap = key.replace(/(^|_)([a-z])/g, function (_, p1, p2) { return (p1 ? '_' : '') + p2.toUpperCase(); });
      var id = 'pnLock' + cap;
      var badge = $(id);
      if (badge) badge.hidden = arr.indexOf(col) < 0;
    });
    var line = $('pnLockLine');
    if (arr.length) {
      line.hidden = false;
      line.innerHTML = '<span class="pn-fnote">서버 잠금 필드(다음 자동 적재가 안 덮음): <b>' + esc(arr.join(', ')) + '</b></span>';
    } else {
      line.hidden = true;
    }
  }

  // ── 등록 모드 ──────────────────────────────────────────────────────────
  function resetForm() {
    $('pnName').value = ''; $('pnMaker').value = ''; $('pnModel').value = '';
    $('pnSalePrice').value = ''; $('pnPurchasePrice').value = ''; $('pnStockQty').value = '';
    var s1 = $('pnPartType1'); if (s1) s1.value = '';
    var s2 = $('pnPartType2'); if (s2) { s2.value = ''; s2.style.display = 'none'; }
    S.partTypeSel = null;
    hideSimilar();
    clearResult();
  }
  function initAsideRegister() {
    $('pnAsideMeta').innerHTML = '<span>새 상품을 등록합니다. 저장하면 서버가 SKU·상품코드를 발번합니다.</span>';
    $('pnSubmitBtn').textContent = '등록';
    $('pnAsideBtns2').innerHTML =
      '<button type="button" class="pn-btn" data-action="reset-form" style="flex:1">입력 초기화</button>' +
      '<a class="pn-btn" href="/admin2/products" style="flex:1">상품 관리로 이동</a>';
  }
  function collectRegisterBody() {
    return {
      name: $('pnName').value.trim(),
      part_type: S.partTypeSel || null,
      maker: $('pnMaker').value.trim() || null,
      cost_price: numOrNull($('pnPurchasePrice').value)
    };
  }
  function onSubmit() {
    if (S.busy) return;
    if (MODE === 'register') checkSimilarThenRegister();
    else doPatch();
  }
  function checkSimilarThenRegister() {
    var body = collectRegisterBody();
    S.busy = true; $('pnSubmitBtn').disabled = true;
    var url = API + '/product-similar?name=' + encodeURIComponent(body.name)
      + '&part_type=' + encodeURIComponent(body.part_type || '');
    apiGet(url).then(function (j) {
      S.busy = false; $('pnSubmitBtn').disabled = !writable();
      if (j.items && j.items.length) { showSimilar(j.items, j.threshold); return; }
      doRegister(false);
    }).catch(function (e) {
      S.busy = false; $('pnSubmitBtn').disabled = !writable();
      showResult(resultFromError(e, '중복 확인'));
    });
  }
  function showSimilar(items, threshold) {
    S.similar = items;
    $('pnSimilar').hidden = false;
    $('pnSimHead').textContent = '이름이 거의 같은 상품이 ' + items.length + '건 있습니다(일치도 '
      + Math.round((threshold || 0.97) * 100) + '% 이상) — 같은 상품이면 등록 대신 기존 상품을 수정하세요.';
    $('pnSimList').innerHTML = items.map(function (it) {
      return '<div class="pn-sim-item">'
        + '<span class="pn-sim-name">' + esc(Admin2Text.stripHtml(it.name)) + '</span>'
        + '<span class="pn-sim-meta">' + esc(it.sku) + ' · 일치도 ' + Math.round(it.score * 100) + '%</span>'
        + '<button type="button" class="pn-btn" data-action="goto-similar" data-code="' + it.product_code + '">기존 상품 수정으로 이동</button>'
        + '</div>';
    }).join('');
  }
  function hideSimilar() { $('pnSimilar').hidden = true; S.similar = null; }
  function doRegister(confirmSimilar) {
    if (S.busy) return;
    var body = collectRegisterBody();
    body.confirm_similar = !!confirmSimilar;
    S.busy = true; $('pnSubmitBtn').disabled = true;
    apiPost(API + '/products', body).then(function (r) {
      S.busy = false; $('pnSubmitBtn').disabled = !writable();
      hideSimilar();
      showResult({
        tone: 'ok', code: '200', msg: r.note || ('등록 완료 — SKU ' + r.sku),
        note: 'SKU <b>' + esc(r.sku) + '</b> · 상품코드 <b>' + esc(String(r.product_code)) + '</b>. ' + esc(r.note || ''),
        act: '<a class="pn-btn pri" href="/admin2/product-new?code=' + r.product_code + '">방금 등록한 상품 수정 열기</a>'
          + '<a class="pn-btn" href="/admin2/products">상품 관리로 이동</a>'
      });
    }).catch(function (e) {
      S.busy = false; $('pnSubmitBtn').disabled = !writable();
      if (e.status === 409 && e.body && e.body.detail && e.body.detail.items) {
        showSimilar(e.body.detail.items, (S.meta && 0.97) || 0.97);
        return;
      }
      showResult(resultFromError(e, '등록'));
    });
  }

  // ── 수정 모드 ──────────────────────────────────────────────────────────
  function initAsideEdit() {
    $('pnSubmitBtn').textContent = '저장';
    $('pnAsideBtns2').innerHTML = '<a class="pn-btn pn-btn-block" href="/admin2/products">수정 취소 — 상품 관리로 복귀</a>';
  }
  function fillFromBaseline(d) {
    $('pnSku').value = d.sku || '';
    $('pnName').value = d.name || '';
    $('pnMaker').value = d.maker || '';
    $('pnModel').value = d.model_name || '';
    $('pnSalePrice').value = d.sale_price == null ? '' : d.sale_price;
    $('pnPurchasePrice').value = d.purchase_price == null ? '' : d.purchase_price;
    $('pnStockQty').value = d.stock_qty == null ? '' : d.stock_qty;
    $('pnPartTypeHost').innerHTML = '<span class="pn-static">' + esc(d.cat || d.part_type || '—') + '</span>';
    var meta = [];
    meta.push('상품코드 <b>' + esc(String(d.product_code)) + '</b>');
    meta.push('SKU <b>' + esc(d.sku || '—') + '</b>');
    if (d.origin) meta.push('데이터 출처 <b>' + esc(d.origin) + '</b>');
    $('pnAsideMeta').innerHTML = '<span>' + meta.join(' · ') + '</span>';
    var hd = $('pnHdMeta'); hd.hidden = false;
    hd.innerHTML = '코드 <b>' + esc(String(d.product_code)) + '</b> · SKU <b>' + esc(d.sku || '—') + '</b>';
    renderLocks(d.locked_fields);
  }
  function loadProduct() {
    return apiGet(API + '/products/' + encodeURIComponent(CODE)).then(function (j) {
      S.baseline = j;
      fillFromBaseline(j);
    });
  }
  function diffChanges() {
    var b = S.baseline || {};
    var changes = {};
    var name = $('pnName').value.trim();
    if (name !== (b.name || '')) changes.name = name;
    var maker = $('pnMaker').value.trim();
    if (maker !== (b.maker || '')) changes.maker = maker;
    var model = $('pnModel').value.trim();
    if (model !== (b.model_name || '')) changes.model_name = model;
    var status = $('pnStatus').value;
    if (status && status !== (b.status || '')) changes.status = status;
    var sp = $('pnSalePrice').value.trim();
    var spNum = sp === '' ? null : Number(sp);
    if (spNum !== (b.sale_price == null ? null : b.sale_price)) changes.sale_price = sp === '' ? '' : spNum;
    var pp = $('pnPurchasePrice').value.trim();
    var ppNum = pp === '' ? null : Number(pp);
    if (ppNum !== (b.purchase_price == null ? null : b.purchase_price)) changes.purchase_price = pp === '' ? '' : ppNum;
    var sq = $('pnStockQty').value.trim();
    if (sq !== '' && Number(sq) !== (b.stock_qty == null ? null : b.stock_qty)) changes.stock_qty = Number(sq);
    return changes;
  }
  function doPatch() {
    if (S.busy) return;
    var changes = diffChanges();
    S.busy = true; $('pnSubmitBtn').disabled = true;
    apiPatch(API + '/products/' + encodeURIComponent(CODE), { changes: changes, lock: true }).then(function (r) {
      S.busy = false; $('pnSubmitBtn').disabled = !writable();
      showResult({ tone: 'ok', code: '200', msg: r.note || ('저장 완료 — ' + r.changed + '건 변경'),
        note: '변경 <b>' + r.changed + '</b>건' + (r.fields && r.fields.length ? ' — ' + esc(r.fields.join(', ')) : '') + '.', act: '' });
      // baseline 을 저장 성공한 값으로 **먼저 직접 갱신**한다 — 뒤이은 재조회가 실패해도
      // 다음 diff 가 이번 저장을 기준으로 계산되게 하기 위해서다(재조회 실패로 baseline 이
      // 낡은 채 남으면 다음 저장이 이미 반영된 값을 다시 "변경"으로 잘못 판단한다).
      if (S.baseline) {
        Object.keys(changes).forEach(function (k) {
          S.baseline[k] = changes[k] === '' ? null : changes[k];
        });
        if (r.locked_fields) S.baseline.locked_fields = r.locked_fields;
        renderLocks(S.baseline.locked_fields);
      }
      // 서버의 온전한 최신 상태(다른 경로의 변경 포함)로 다시 맞춘다 — 실패해도 위에서
      // 이미 반영한 값이 있어 조용히 무너지지 않는다.
      loadProduct().catch(function () {});
    }).catch(function (e) {
      S.busy = false; $('pnSubmitBtn').disabled = !writable();
      showResult(resultFromError(e, '저장'));
    });
  }

  // ── 결과 표시 — 서버가 준 사유를 그대로(§CANON, if(!res.ok) return; 금지) ──
  function showResult(r) {
    var box = $('pnResult');
    box.className = 'pn-result ' + (r.tone || 'none');
    $('pnResCode').textContent = r.code || '—';
    $('pnResMsg').textContent = r.msg || '';
    $('pnResNote').innerHTML = r.note || '';
    $('pnResAct').innerHTML = r.act || '';
  }
  function clearResult() {
    showResult({ tone: 'none', code: '—', msg: '저장하면 여기에 서버 응답이 그대로 섭니다',
      note: '화면이 저장 결과를 지어내지 않습니다 — 서버가 준 사유를 그대로 표시합니다.', act: '' });
  }
  function resultFromError(e, where) {
    var st = e && e.status;
    var detail = (e && e.message) || '';
    if (st === 401) {
      return { tone: 'err', code: '401', msg: '세션이 만료됐습니다 — 다시 로그인 후 시도하십시오',
        note: '입력값은 서버에 닿지 않았습니다 — 저장되지 않았습니다.',
        act: '<a class="pn-btn" href="' + LOGIN + '">로그인 화면으로 이동</a>' };
    }
    if (st === 403) {
      return { tone: 'err', code: '403', msg: detail || '권한이 부족합니다', note: where + ' 실패 — 서버 사유 그대로.', act: '' };
    }
    if (st === 400) {
      return { tone: 'err', code: '400', msg: detail, note: '서버가 거부한 값입니다 — 해당 항목을 확인하십시오.', act: '' };
    }
    if (st === 404) {
      return { tone: 'err', code: '404', msg: detail, note: '조회 시점 이후 상태가 바뀌었을 수 있습니다.',
        act: '<a class="pn-btn" href="/admin2/products">상품 관리로 이동</a>' };
    }
    if (st === 409) {
      var taken = e.body && e.body.detail && e.body.detail.taken_by;
      return { tone: 'err', code: '409', msg: detail,
        note: taken ? '점유 상품코드 <b>' + esc(String(taken)) + '</b>' : '',
        act: taken ? '<a class="pn-btn" href="/admin2/product-new?code=' + taken + '">점유 상품으로 이동</a>' : '' };
    }
    if (st >= 500) {
      return { tone: 'err', code: String(st), msg: '서버 오류로 ' + where + '하지 못했습니다', note: '사유: ' + esc(detail), act: '' };
    }
    if (st === undefined) {
      return { tone: 'err', code: '연결 실패', msg: '서버에 닿지 못했습니다 — ' + (detail || '네트워크'),
        note: '입력값은 저장되지 않았습니다.', act: '' };
    }
    return { tone: 'err', code: String(st), msg: detail || ('오류 ' + st), note: '', act: '' };
  }

  // ── 시작 ───────────────────────────────────────────────────────────────
  function start() {
    clearResult();
    if (MODE === 'edit') {
      initAsideEdit();
      loadProduct().then(function () {
        showBody();
        return Promise.all([loadMeta().catch(function () {}), loadCategories()]);
      }).catch(function (e) {
        if (e && e.status === 404) {
          showInitError('상품이 없습니다 — 조회 시점 이후 삭제됐거나 잘못된 코드입니다.'
            + '<br><a href="/admin2/products">상품 관리로 이동</a>');
        } else if (e && e.status === 401) {
          showInitError('세션이 만료됐습니다.<br><a href="' + LOGIN + '">로그인 화면으로 이동</a>');
        } else {
          showInitError('상품을 불러오지 못했습니다 — ' + esc((e && e.message) || '알 수 없는 오류')
            + '<br><button type="button" data-action-inline="retry">다시 시도</button>');
          var btn = document.querySelector('[data-action-inline="retry"]');
          if (btn) btn.addEventListener('click', start);
        }
      });
    } else {
      initAsideRegister();
      showBody();
      Promise.all([loadMeta().catch(function () {}), loadCategories()]).catch(function () {});
    }
  }

  if (window.Admin2Shell && window.Admin2Shell.meReady) {
    window.Admin2Shell.meReady.then(function () { applyModeGates(); });
  }
  start();
})();
</script>
{% endraw %}
{% endblock %}
