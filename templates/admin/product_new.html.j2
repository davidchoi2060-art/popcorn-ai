              </div>
              <div class="pn-field">
                <label for="pnStatus">판매상태<span class="pn-lock" id="pnLockStatus" hidden title="다음 자동 적재가 이 값을 덮지 않습니다">잠김</span></label>
                <select id="pnStatus" class="pn-select" disabled data-bind="status">
                  <option value="">불러오는 중</option>
                </select>
                <div class="pn-fnote warn" id="pnStatusNote" hidden></div>
              </div>
            </div>
          </div>
        </section>

        <!-- 02 카테고리 -->
        <section class="pn-card" id="pnSec-cat" data-open="y" data-sec="cat">
