{#
  웹 사양 채움 (ADM-AI-020) — 2026-08-13, B안(전용 실행 화면) 사장님 확정

  제안서(docs/design/spec-fill-ui-direction-2026-08-13.md)는 A안(화면 신설 없음)을
  추천했다. 사장님이 B안을 택해 이 화면이 선다 — 대신 B의 단점(정본 복제)을 줄이려고
  **이 화면은 로직을 하나도 새로 짓지 않는다.** 계약 넷을 배선만 한다:

    실행   기존 대시보드 큐(POST /api/admin/dash/say, api/dash.py) — 새 실행 엔진 없음
    진행   신규 읽기 API 하나(GET /api/admin/spec-fill/status, 집계 SELECT만)
    미리보기 위 API의 페이지네이션 목록(전 행 반환 금지 규약)
    승인   여기서 하지 않는다 — 상품 사양 검수(ADM-PRD-020)로 필터 링크만(A-18 계약)

  숫자는 전부 서버 응답만 쓴다. 화면이 후보 수·건수·비율을 계산하지 않는다.

  ■ 2026-08-13 셸 통합 — LNB·헤더·팔레트는 admin2 공통 셸(`_admin2_shell.html.j2`)로
    옮겼다. 본문은 여전히 Phoenix(Bootstrap) 카드·표·폼이라 `head_extra`/`foot_extra`
    블록으로 그 벤더 CSS·JS를 함께 싣는다(본문까지 admin2 팔레트로 새로 짜는 것은
    이번 작업 범위 밖 — 제작 보고서 참조). `data-screen-id`/`data-domain`/빵부스러기는
    이제 라우트(`api/admin_ui_spec_fill.py`)가 컨텍스트로 준다.
#}
{% extends "admin/_admin2_shell.html.j2" %}

{% block title %}웹 사양 채움{% endblock %}

{% block head_extra %}
{# Phoenix(Bootstrap) 벤더 자산 — 본문 카드·표·폼이 여전히 이 컴포넌트에 의존한다. #}
<link rel="apple-touch-icon" sizes="180x180" href="/admin/assets/img/favicons/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/admin/assets/img/favicons/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/admin/assets/img/favicons/favicon-16x16.png">
<link rel="shortcut icon" type="image/x-icon" href="/admin/assets/img/favicons/favicon.ico">
<meta name="theme-color" content="#ffffff">
<script src="/admin/vendors/simplebar/simplebar.min.js"></script>
<script src="/admin/assets/js/config.js"></script>
<link href="/admin/vendors/simplebar/simplebar.min.css" rel="stylesheet">
<link href="/admin/vendors/choices/choices.min.css" type="text/css" rel="stylesheet">
<script src="/shared/ui-choices.js"></script>
<script src="/shared/ui-list.js"></script>
<link href="/admin/assets/css/theme.min.css" type="text/css" rel="stylesheet" id="style-default">
<link href="/admin/assets/css/user.min.css" type="text/css" rel="stylesheet" id="user-style-default">
<style>
  /* Phoenix가 읽는 서체 변수를 admin2 팔레트로 돌린다(옛 _layout.html.j2가
     tokens.css로 하던 일과 같은 방식 — 이제 admin2.css). */
  :root{ --phoenix-font-sans-serif: var(--font); }
  .card > .card-header, .card > .card-body { min-width: 0; }
</style>
{% endblock %}

{% block content %}
<div class="a2-content-pad">
<div class="d-flex flex-wrap justify-content-between align-items-end mb-3 gap-2">
  <div>
    <h2 class="mb-1">웹 사양 채움
      <span class="badge badge-phoenix badge-phoenix-warning align-middle fs-10">ADM-AI-020</span>
    </h2>
    <p class="text-body-tertiary mb-0">
      미충족 사양을 웹에서 찾아 검수 큐에 <b class="text-body-secondary">제안</b>으로만 올립니다.
      정본(<code>product_specs</code>)에는 이 화면이 쓰지 않습니다 — 반영은 사람이
      상품 사양 검수에서 승인해야 됩니다.
    </p>
  </div>
</div>

<div class="row g-3">
  <!-- ① 실행 -->
  <div class="col-12 col-xl-5">
    <div class="card h-100">
      <div class="card-header border-bottom border-translucent">
        <h5 class="mb-0">웹 사양 채움 실행</h5>
      </div>
      <div class="card-body">
        <p class="fs-9 text-body-tertiary">
          누르면 <b>작업 현황판 큐</b>에 실행 요청 메시지를 넣습니다 — 이 화면이 직접
          검색하지 않습니다. 감시자가 큐를 보고 세션을 깨우면, 그 세션이 채움 담당(스펙크롤러)을
          불러 처리합니다(<a href="/admin2/dash">작업 현황판</a>에서 진행을 볼 수 있습니다).
        </p>
        <div class="mb-2">
          <label class="form-label fs-9" for="sfField">대상 필드</label>
          <select id="sfField" class="form-select form-select-sm" aria-label="대상 필드">
            <option value="">불러오는 중…</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label fs-9" for="sfCount">건수</label>
          <input id="sfCount" type="number" class="form-control form-control-sm"
                 min="1" max="500" value="30" aria-label="건수">
        </div>
        <button type="button" class="btn btn-primary btn-sm" id="sfRun">웹 사양 채움 실행</button>
        <div class="mt-2" id="sfWatcherWarn" hidden>
          <span class="fs-9 text-danger">
            ⚠ 감시자가 꺼져 있으면 전달되지 않습니다 — <a href="/admin2/dash">작업 현황판</a>에서
            감시자 상태를 확인하세요.
          </span>
        </div>
        <div class="mt-2 fs-9" id="sfRunResult"></div>
      </div>
    </div>
  </div>

  <!-- ② 진행 -->
  <div class="col-12 col-xl-7">
    <div class="card h-100">
      <div class="card-header border-bottom border-translucent d-flex align-items-center">
        <h5 class="mb-0">진행</h5>
        <span class="fs-9 text-body-tertiary ms-auto" id="sfProgNote">불러오는 중…</span>
      </div>
      <div class="card-body">
        <div class="row g-3" id="sfProgKpi">
          <div class="col-12"><span class="fs-9 text-body-tertiary">불러오는 중…</span></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ③ 결과 미리보기 -->
<div class="card mt-3">
  <div class="card-header border-bottom border-translucent d-flex flex-wrap align-items-center gap-2">
    <h5 class="mb-0">결과 미리보기</h5>
    <span class="fs-9 text-body-tertiary" id="sfListNote"></span>
    <!-- ④ 적용(승인) — 승인 로직은 여기 없다. A-18 계약대로 검수 화면(ADM-PRD-020)으로
         필터 링크만 연결하는 것이 설계지만, 그 화면은 admin2에 아직 없다(2026-08-13
         P-09: 구 /admin/*.html은 백업용 동결 — 링크 연결 금지, review-queue.html로
         안내했다가 지적받은 전례). admin2/reviews가 서기 전까지는 비활성으로 둔다. -->
    <div class="ms-auto text-end">
      <button type="button" class="btn btn-phoenix-secondary btn-sm" id="sfApproveLink" disabled
              title="상품 사양 검수(admin2)가 아직 구축되지 않아 이동할 수 없습니다">
        검수 화면에서 승인하기
      </button>
      <div class="fs-9 text-body-tertiary mt-1">검수 화면(admin2) 구축 중</div>
    </div>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-sm align-middle fs-9 mb-0" style="min-width:820px;">
        <thead>
          <tr class="text-body-tertiary">
            <th>상품명</th>
            <th>필드</th>
            <th>제안값</th>
            <th>출처</th>
            <th class="text-end">확신도</th>
            <th>적용 시각</th>
            <th>검수 상태</th>
          </tr>
        </thead>
        <tbody id="sfRows">
          <tr><td colspan="7" class="text-center text-body-tertiary py-3">불러오는 중…</td></tr>
        </tbody>
      </table>
    </div>
  </div>
  <div class="card-footer d-flex align-items-center gap-2 py-2">
    <button type="button" class="btn btn-phoenix-secondary btn-sm" id="sfPrev" disabled>← 이전</button>
    <span class="fs-9 text-body-tertiary" id="sfPageNote">—</span>
    <button type="button" class="btn btn-phoenix-secondary btn-sm" id="sfNext" disabled>다음 →</button>
  </div>
</div>
</div>
{% endblock %}

{% block foot_extra %}
<script src="/admin/vendors/popper/popper.min.js"></script>
<script src="/admin/vendors/bootstrap/bootstrap.min.js"></script>
<script src="/admin/vendors/anchorjs/anchor.min.js"></script>
<script src="/admin/vendors/is/is.min.js"></script>
<script src="/admin/vendors/fontawesome/all.min.js"></script>
<script src="/admin/vendors/lodash/lodash.min.js"></script>
<script src="/admin/vendors/list.js/list.min.js"></script>
<script src="/admin/vendors/feather-icons/feather.min.js"></script>
<script src="/admin/vendors/dayjs/dayjs.min.js"></script>
<script src="/admin/vendors/choices/choices.min.js"></script>
<script src="/admin/assets/js/phoenix.js"></script>
<script src="/shared/admin-panel.js"></script>
<script src="/shared/admin-helper.js"></script>
<script src="/shared/su-icons.js"></script>
{% raw %}
<script>
(function () {
  'use strict';
  function esc(v) {
    return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) {
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }
  function hhmm(iso) {
    if (!iso) return '—';
    var d = new Date(iso);
    if (isNaN(d)) return '—';
    return d.getFullYear() + '-' + ('0'+(d.getMonth()+1)).slice(-2) + '-' + ('0'+d.getDate()).slice(-2)
         + ' ' + ('0'+d.getHours()).slice(-2) + ':' + ('0'+d.getMinutes()).slice(-2);
  }

  // ── ① 대상 필드 선택지 — 정본은 spec_field_defs (api/spec_fields.py), 여기서 다시
  //    정의하지 않는다. 기존 사양 항목 정의 API(GET /api/admin/spec-fields)를 그대로 읽는다.
  var DEFAULT_FIELD = 'cooler_tdp';
  function loadFields() {
    fetch('/api/admin/spec-fields', {credentials: 'same-origin'})
      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
      .then(function (j) {
        var items = j.items || [];
        var sel = document.getElementById('sfField');
        if (!items.length) {
          sel.innerHTML = '<option value="">사양 항목 없음</option>';
          return;
        }
        sel.innerHTML = items.map(function (f) {
          return '<option value="' + esc(f.field_key) + '">' + esc(f.label || f.field_key)
               + ' (' + esc(f.field_key) + ')</option>';
        }).join('');
        var has = items.some(function (f) { return f.field_key === DEFAULT_FIELD; });
        sel.value = has ? DEFAULT_FIELD : items[0].field_key;
      })
      .catch(function (e) {
        document.getElementById('sfField').innerHTML =
          '<option value="">필드 목록 조회 실패 — ' + esc(e.message) + '</option>';
      });
  }

  // ── ④ 승인 링크 — admin2/reviews가 서기 전까지 버튼은 비활성(disabled)이라
  //    href를 맞출 대상이 없다. 화면 쪽 마크업 참고.

  // ── 감시자 상태 — /api/admin/dash/state 의 watcher 필드만 쓴다(지어내지 않는다).
  function pollWatcher() {
    fetch('/api/admin/dash/state', {credentials: 'same-origin'})
      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
      .then(function (j) {
        var w = j.watcher || {};
        document.getElementById('sfWatcherWarn').hidden = !!w.alive;
      })
      .catch(function () { /* 조회 실패는 경고를 지우지 않는다 — 다음 폴링이 다시 시도 */ });
  }

  // ── ① 실행 — 새 실행 엔진을 만들지 않는다. 기존 대시보드 큐에 구조화된 메시지만 넣는다.
  var runBusy = false;
  document.getElementById('sfRun').addEventListener('click', function () {
    var btn = this, box = document.getElementById('sfRunResult');
    var field = (document.getElementById('sfField').value || '').trim();
    var count = parseInt(document.getElementById('sfCount').value, 10);
    if (!field) { box.innerHTML = '<span class="text-danger">대상 필드를 고르세요</span>'; return; }
    if (!count || count < 1) { box.innerHTML = '<span class="text-danger">건수를 확인하세요</span>'; return; }
    if (runBusy) return;
    runBusy = true; btn.disabled = true;
    var release = function () { runBusy = false; btn.disabled = false; };
    var guard = setTimeout(function () {
      release();
      box.innerHTML = '<span class="text-danger">응답 없음 · 재시도 필요</span>';
    }, 8000);
    var text = '스펙크롤러 배치 실행: ' + field + ' ' + count + '건';
    fetch('/api/admin/dash/say', {
      method: 'POST', credentials: 'same-origin',
      headers: {'Content-Type': 'application/json'}, body: JSON.stringify({text: text})
    })
      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
      .then(function (j) {
        clearTimeout(guard); release();
        if (j.ok) {
          box.innerHTML = '<span class="text-body-emphasis">' + esc(j.verdict || '전달 완료') + '</span>'
            + '<div class="text-body-tertiary">보낸 내용: ' + esc(text) + '</div>';
        } else {
          box.innerHTML = '<span class="text-danger">' + esc(j.verdict || '전달 실패') + '</span>';
        }
        pollWatcher();
      })
      .catch(function (e) {
        clearTimeout(guard); release();
        box.innerHTML = '<span class="text-danger">전송 실패 — '
          + esc(e.status === 401 ? '세션 만료 · 로그인 필요' : e.message) + '</span>';
      });
  });

  // ── ②③ 진행 · 결과 미리보기 — 단일 API(GET /api/admin/spec-fill/status), 서버 페이지네이션.
  var sfPage = 1, sfPages = 1;
  function loadStatus() {
    fetch('/api/admin/spec-fill/status?page=' + sfPage + '&size=20', {credentials: 'same-origin'})
      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
      .then(renderStatus)
      .catch(function (e) {
        document.getElementById('sfProgNote').textContent = '조회 실패';
        document.getElementById('sfProgNote').className = 'fs-9 text-danger ms-auto';
        document.getElementById('sfRows').innerHTML =
          '<tr><td colspan="7" class="text-center text-danger py-3">불러오기 실패 — '
          + esc(e.message) + '</td></tr>';
      });
  }

  function renderStatus(d) {
    if (d.ok === false) {
      document.getElementById('sfProgNote').textContent = d.reason || '조회 실패';
      document.getElementById('sfProgNote').className = 'fs-9 text-danger ms-auto';
      document.getElementById('sfProgKpi').innerHTML =
        '<div class="col-12"><span class="fs-9 text-danger">' + esc(d.reason || '조회 실패') + '</span></div>';
      document.getElementById('sfRows').innerHTML =
        '<tr><td colspan="7" class="text-center text-body-tertiary py-3">데이터 없음</td></tr>';
      return;
    }
    document.getElementById('sfProgNote').textContent = d.note || '';
    document.getElementById('sfProgNote').className = 'fs-9 text-body-tertiary ms-auto';

    document.getElementById('sfProgKpi').innerHTML = [
      ['제안 총 행 수', d.total.toLocaleString()],
      ['최근 채움 시각', hhmm(d.latest_fetched_at)],
      ['검수 대기 중인 제안', d.pending_review.toLocaleString() + '건']
    ].map(function (r) {
      return '<div class="col-6 col-md-4"><div class="fs-9 text-body-tertiary">' + esc(r[0]) + '</div>'
           + '<div class="fs-5 fw-bolder">' + esc(r[1]) + '</div></div>';
    }).join('');

    var items = d.items || [];
    document.getElementById('sfRows').innerHTML = items.length ? items.map(function (it) {
      var conf = it.confidence == null ? '—' : Math.round(it.confidence * 100) + '%';
      var src = it.source_url
        ? '<a href="' + esc(it.source_url) + '" target="_blank" rel="noopener noreferrer">'
          + esc(it.source_name || '출처 보기') + '</a>'
        : '<span class="text-body-tertiary">출처 없음</span>';
      var rs = it.review_status
        ? esc(it.review_status)
        : '<span class="text-body-tertiary">검수 행 없음</span>';
      return '<tr>'
        + '<td class="text-body-highlight">' + esc(it.name) + '<div class="fs-10 text-body-tertiary"><code>'
        +   esc(it.product_code) + '</code></div></td>'
        + '<td><code>' + esc(it.field) + '</code></td>'
        + '<td>' + esc(it.value) + '</td>'
        + '<td>' + src + '</td>'
        + '<td class="text-end">' + conf + '</td>'
        + '<td>' + hhmm(it.fetched_at) + '</td>'
        + '<td>' + rs + '</td>'
        + '</tr>';
    }).join('') : '<tr><td colspan="7" class="text-center text-body-tertiary py-3">제안 없음</td></tr>';

    sfPages = d.pages || 1;
    document.getElementById('sfListNote').textContent = '전체 ' + (d.total || 0).toLocaleString() + '건';
    document.getElementById('sfPageNote').textContent =
      (d.total ? (d.page + ' / ' + sfPages + ' 페이지') : '—');
    document.getElementById('sfPrev').disabled = sfPage <= 1;
    document.getElementById('sfNext').disabled = sfPage >= sfPages;
  }

  document.getElementById('sfPrev').addEventListener('click', function () {
    if (sfPage <= 1) return;
    sfPage -= 1; loadStatus();
  });
  document.getElementById('sfNext').addEventListener('click', function () {
    if (sfPage >= sfPages) return;
    sfPage += 1; loadStatus();
  });

  loadFields();
  pollWatcher();
  loadStatus();
  // 주기 폴링 — 실행 결과가 다른 사람 세션(하네스)에서 진행되므로 이 화면이 스스로 갱신돼야 한다.
  setInterval(pollWatcher, 15000);
  setInterval(loadStatus, 15000);
})();
</script>
{% endraw %}
{% endblock %}
