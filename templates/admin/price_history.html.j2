/* ── 변동 표 7열 ── */
.ph-tablewrap{background:var(--rv-card);border:1px solid rgba(0,0,0,.1);border-radius:9px;overflow:auto}
.ph-thead,.ph-row{display:grid;
  grid-template-columns:132px 60px minmax(88px,1fr) minmax(88px,1fr) minmax(88px,1fr) minmax(160px,1.6fr) 96px;
  gap:8px;min-width:800px;align-items:center}
