.ph-tagline{font:400 11.5px/1.4 var(--rv-font);color:var(--rv-faint)}

/* ── 루트 ── */
.ph-scroll{flex:1;min-height:0;overflow:auto;padding:14px 18px 22px;display:flex;flex-direction:column;gap:14px}
