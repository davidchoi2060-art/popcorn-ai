  background:var(--rv-panel2);border-radius:5px;padding:5px 8px;cursor:pointer}
.ph-move.off{color:var(--rv-muted);cursor:default}
.ph-move .tag{font:500 9px/1 var(--rv-font);background:rgba(0,0,0,.08);border-radius:3px;padding:2px 4px;margin-left:4px}
.ph-empty{padding:18px 6px;font:400 11.5px/1.6 var(--rv-font);color:var(--rv-faint)}
.ph-empty-sub{margin-top:4px}
.ph-linklike{display:inline-block;margin-top:8px;font:600 11px/1 var(--rv-font);color:var(--rv-link);
