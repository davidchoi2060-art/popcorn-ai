.ph-untranslated{display:inline-flex;align-items:center;gap:4px;font-size:10.5px}
.ph-untranslated .tag{font:600 8.5px/1 var(--rv-font);color:var(--rv-canvas);background:var(--rv-muted);
  border-radius:3px;padding:2px 4px;font-family:var(--rv-font)}
/* ── 이력 행의 NULL 배지 — "비움"(원장에 기록된 조작)과 "이전 값 없음"을
