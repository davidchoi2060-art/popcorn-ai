{% block foot_extra %}
{% raw %}
<script>
(function () {
  'use strict';

  var S = {
    data: null, err: null,
    dateFrom: '', dateTo: '',
    productCode: null,     // null = 서버 기본 선택(그 기간 상위 상품)에 맡긴다
    mode: 'kept',          // 'kept' | 'all'
    search: '',
    partType: null         // {code, label}
  };
  var lastListKey = null;  // 좌측 목록을 다시 그릴 필요가 있는지 판단하는 키(기간 조합)

  function $(id) { return document.getElementById(id); }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function fmt(n) { return (n == null) ? '0' : Number(n).toLocaleString('ko-KR'); }
  function won(n) { return (n == null) ? '—' : Number(n).toLocaleString('ko-KR') + '원'; }
  // ⚠ won(0)과 won(null)은 겹치지 않는다 — 확인함: won(0)='0원'(값), won(null)='—'
  // (값 없음). 다만 이력 행에서 won()의 '—'를 그대로 쓰면 "비웠다"(원장에 기록된
  // 조작)와 "화면이 못 받았다/자리가 없다"가 같은 글자로 보인다 — 아래 두 함수가
  // 이력 이벤트 전용으로 갈라 쓴다(모듈 docstring §new_price NULL("비움") 표기 참조).
  function priceEventHtml(n) {
    if (n == null) {
      return '<span class="ph-evt cleared" title="이 변경으로 값이 비워졌습니다 — 데이터가 없는 것이 아니라 원장에 기록된 조작입니다">비움</span>';
    }
    return esc(won(n));
  }
  function noPriorHtml() {
    return '<span class="ph-evt noprior" title="이 시점 이전에는 이 항목에 값이 없었습니다">이전 값 없음</span>';
  }
  function deltaWon(n) {
    if (n == null) return '신규';
    var sign = n > 0 ? '+' : (n < 0 ? '-' : '');
    return sign + Math.abs(n).toLocaleString('ko-KR') + '원';
  }
  function deltaCls(n) { return n == null ? 'flat' : (n > 0 ? 'up' : (n < 0 ? 'down' : 'flat')); }
  function fmtDT(iso) {
    if (!iso) return '—';
    try {
      var d = new Date(iso);
      if (isNaN(d.getTime())) return iso;
      var p = function (n) { return String(n).padStart(2, '0'); };
      return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
    } catch (e) { return iso; }
  }
  function fmtDShort(iso) {
    if (!iso || iso.length < 10) return '—';
    return iso.slice(5, 10);   // "08-05"
  }

  // ── API ──────────────────────────────────────────────────────────
  function handle(res) {
    return res.clone().json().catch(function () { return null; }).then(function (j) {
      if (!res.ok) {
        var msg = (window.popcornProgress && window.popcornProgress.errText)
          ? window.popcornProgress.errText(j, res.status, 'GET /api/admin/price-history') : ('오류 ' + res.status);
        var e = new Error(msg); e.status = res.status; e.body = j; throw e;
      }
      return j;
    });
  }
  function apiGet(path) { return fetch(path, { credentials: 'same-origin' }).then(handle); }

  function qs() {
    var p = [];
    if (S.productCode != null) p.push('product_code=' + encodeURIComponent(S.productCode));
    if (S.dateFrom) p.push('date_from=' + encodeURIComponent(S.dateFrom));
    if (S.dateTo) p.push('date_to=' + encodeURIComponent(S.dateTo));
    return p.length ? ('?' + p.join('&')) : '';
  }

  function load() {
    S.err = null;
    renderAll();
    return apiGet('/api/admin/price-history' + qs())
      .then(function (resp) { S.data = resp; afterLoad(); })
      .catch(function (err) {
        // 계약: 지정한 상품에 그 기간 이력이 없으면 404 — 목록에서 골랐던 선택이
        // 기간이 바뀌며 낡은 것이다. 오류로 놀라게 하지 않고 서버 기본 선택으로
        // 한 번 다시 시도한다(무한 루프 방지: productCode가 이미 null이면 재시도하지 않는다).
        if (err.status === 404 && S.productCode != null) {
          S.productCode = null;
          return load();
        }
        S.err = err;
        renderAll();
      });
  }

  function afterLoad() {
    var rangeKey = S.dateFrom + '|' + S.dateTo;
    var rebuildList = rangeKey !== lastListKey;
    lastListKey = rangeKey;
    S.partType = null;
    renderAll(rebuildList);
    loadPartType();
  }

  function loadPartType() {
    var p = S.data && S.data.product;
    if (!p) return;
    var code = p.product_code;
    fetch('/api/admin/products/' + encodeURIComponent(code), { credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (j) {
        if (!S.data || !S.data.product || S.data.product.product_code !== code) return; // 그 사이 선택이 바뀌었다
        S.partType = { code: code, label: (j && j.cat) ? j.cat : null };
        var el = $('phCardCat');
        if (el) el.textContent = S.partType.label || '부품 종류 확인 불가';
      })
      .catch(function () {
        if (!S.data || !S.data.product || S.data.product.product_code !== code) return;
        S.partType = { code: code, label: null };
        var el = $('phCardCat');
        if (el) el.textContent = '부품 종류 확인 불가';
      });
  }

  // ── 되돌림 짝짓기 — 서버 원본 사실(items)만으로 매 렌더 다시 계산한다 ──────────
  // 같은 상품(이미 items가 그 상품으로 좁혀져 있다) · 같은 field 안에서 시간순으로
  // 훑으며 "_undo"로 끝나는 사유를 그 직전 미매칭 원본 사유와 짝짓는다(스택 매칭).
  // 실제 DB 전수(28,993행)로 검증됨 — 제작 보고서 참조.
  function computeReverted(items) {
    var byField = {};
    items.forEach(function (it) { (byField[it.field] = byField[it.field] || []).push(it); });
    var reverted = {};
    Object.keys(byField).forEach(function (f) {
      var seq = byField[f].slice().sort(function (a, b) {
        if (a.at < b.at) return -1;
        if (a.at > b.at) return 1;
        return a.id - b.id;
      });
      var stack = [];
      seq.forEach(function (it) {
        var reason = it.reason || '';
        if (/_undo$/.test(reason)) {
          var base = reason.slice(0, -5);
          var idx = -1;
          for (var k = stack.length - 1; k >= 0; k--) {
            if (stack[k].reason === base) { idx = k; break; }
          }
          if (idx >= 0) {
            reverted[stack[idx].id] = true;
            reverted[it.id] = true;
            stack.splice(idx, 1);
          } else {
            reverted[it.id] = true;   // 되돌릴 원본이 없다(짝이 필터 밖에 있음) — 그래도 되돌리기 행 자체다
          }
        } else {
          stack.push(it);
        }
      });
    });
    return reverted;
  }

  function allItems() { return (S.data && S.data.items) || []; }
  function visibleItems() {
    var items = allItems();
    if (S.mode === 'all') return items;
    var reverted = computeReverted(items);
    return items.filter(function (it) { return !reverted[it.id]; });
  }

  // ── 빈 상태 — 세 가지를 구분한다 ─────────────────────────────────
  function emptyReasonHtml() {
    var d = S.data;
    if (!d) return '';
    if (!d.product) {
      return '<div>' + esc(d.note || '이 기간에는 가격 변동 이력이 없습니다.') + '</div>'
        + '<div class="ph-empty-sub">최근 며칠처럼 짧은 기간을 고르면 정당하게 빈 결과가 나올 수 있습니다(오류가 아닙니다).</div>';
    }
    var total = allItems().length;
    if (!total) {
      return '<div>이 상품에는 조회 조건에 해당하는 가격 이력이 없습니다.</div>';
    }
    if (S.mode === 'kept') {
      return '<div>이 조건에서는 지금 값에 기여한 이력이 없습니다 — ' + fmt(total) + '건이 모두 되돌려졌습니다.</div>'
        + '<div class="ph-empty-sub">걸러 보여주는 것과 삭제는 다릅니다 — 원장은 지우지 않습니다.</div>'
        + '<button type="button" class="ph-linklike" data-action="set-mode" data-mode="all">되돌림 포함 전체 보기 →</button>';
    }
    return '<div>표시할 이력이 없습니다.</div>';
  }

  // ── 필터 줄 우측 요약 ────────────────────────────────────────────
  function renderSummary() {
    var box = $('phGlobalSummary');
    var d = S.data;
    if (!d) { box.textContent = ''; return; }
    var prods = d.products || [];
    var total = prods.reduce(function (s, p) { return s + (p.count || 0); }, 0);
    box.textContent = '전체 이력 ' + fmt(total) + '건(상품 ' + fmt(prods.length) + '개) 중 '
      + '지금 값에 기여한 이력만 기본 표시';
  }

  // ── 좌측 상품 목록 ───────────────────────────────────────────────
  function renderList() {
    var box = $('phList');
    var prods = (S.data && S.data.products) || [];
    $('phProdCount').textContent = fmt(prods.length) + '개 상품';
    var term = S.search.trim().toLowerCase();
    var filtered = term ? prods.filter(function (p) {
      return (p.name || '').toLowerCase().indexOf(term) >= 0
        || String(p.sku || '').toLowerCase().indexOf(term) >= 0
        || String(p.product_code).indexOf(term) >= 0;
    }) : prods;
    if (!filtered.length) {
      box.innerHTML = '<div class="ph-empty">' + (term ? '검색 결과가 없습니다.' : '이 기간에 변동이 있던 상품이 없습니다.') + '</div>';
      return;
    }
    var curCode = S.data && S.data.product ? S.data.product.product_code : null;
    box.innerHTML = filtered.map(function (p) {
      var on = p.product_code === curCode;
      return '<button type="button" class="ph-item' + (on ? ' on' : '') + '" role="listitem"'
        + ' aria-current="' + (on ? 'true' : 'false') + '"'
        + ' data-action="select-product" data-code="' + p.product_code + '">'
        + '<span class="ph-item-info"><span class="nm">' + esc(p.name || '(상품명 없음)') + '</span>'
        + '<span class="cd num">' + esc(p.sku || String(p.product_code)) + '</span></span>'
        + '<span class="cnt num">' + fmt(p.count) + '건</span>'
        + '</button>';
    }).join('');
  }
  function updateListSelection() {
    var box = $('phList');
    var curCode = S.data && S.data.product ? S.data.product.product_code : null;
    Array.prototype.forEach.call(box.querySelectorAll('.ph-item'), function (btn) {
      var code = Number(btn.getAttribute('data-code'));
      var on = code === curCode;
      btn.classList.toggle('on', on);
      btn.setAttribute('aria-current', on ? 'true' : 'false');
    });
  }

  // ── 선택 상품 카드 ───────────────────────────────────────────────
  function renderCard() {
    var box = $('phCard');
    var p = S.data && S.data.product;
    if (!p) { box.innerHTML = '<div class="ph-empty">선택된 상품이 없습니다.</div>'; return; }
    // 부품 종류 — S.partType은 loadPartType()이 "상품코드"까지 함께 확인해 채우는 캐시다
    // ({code, label} — 위 state 선언 참조). 지금 상품과 코드가 일치하면 이미 아는 값이므로
    // 그대로 쓰고, 리렌더(예: setMode의 모드 토글)마다 "확인 중…"으로 되돌리지 않는다.
    // afterLoad()가 상품을 새로 고를 때마다 S.partType을 null로 비우므로, 코드가 다르거나
    // 아직 없을 때만 실제로 확인 중인 것이고 그때만 이 문구를 쓴다 — 값을 이미 아는데
    // 모른다고 말하지 않는다.
    var catText = (S.partType && S.partType.code === p.product_code)
      ? (S.partType.label || '부품 종류 확인 불가')
      : '확인 중…';
    box.innerHTML =
      '<div>'
      + '<div class="ph-card-name">' + esc(p.name || '(상품명 없음)') + '</div>'
      + '<div class="ph-card-sub"><span class="num">' + esc(p.sku || String(p.product_code)) + '</span>'
      + ' · <span id="phCardCat">' + esc(catText) + '</span></div>'
      + '</div>'
      + '<div class="ph-card-price">'
      + '<span>지금 판매가 <b class="num">' + esc(won(p.sale)) + '</b></span>'
      + '<span>매입가 <b class="num">' + esc(won(p.purchase)) + '</b></span>'
      + '</div>';
  }

  // ── 추이 막대 그래프 ────────────────────────────────────────────
  function seriesPoints(items) {
    var asc = items.slice().sort(function (a, b) {
      if (a.at < b.at) return -1;
      if (a.at > b.at) return 1;
      return a.id - b.id;
    });
    return asc.map(function (it) {
      // fieldLabel은 비움 여부와 무관하게 항상 "판매가/매입가"를 정확히 말한다(말풍선
      // 전용) — cat(막대 색·범례 묶음)과는 다른 축이라 따로 둔다.
      var fieldLabel = (it.field === 'sale') ? '판매가' : ('매입가' + (it.supplier ? ' · ' + it.supplier : ' · 출처 미기록'));
      var cat, label;
      if (it.new == null) {
        // 비움은 판매가·매입가·공급처 구분보다 먼저 본다 — 이 지점은 "어느 계열이
        // 얼마인가"가 아니라 "값이 없다"는 사실 자체를 그려야 한다.
        cat = 'cleared'; label = '비움(값 없음)';
      } else if (it.field === 'sale') {
        cat = 'sale'; label = '판매가';
      } else if (it.supplier) {
        cat = 'purchase:' + it.supplier; label = '매입가 · ' + it.supplier;
      } else {
        cat = 'purchase:none'; label = '매입가 · 출처 미기록';
      }
      return { it: it, cat: cat, label: label, fieldLabel: fieldLabel };
    });
  }
  function catCls(cat) {
    if (cat === 'cleared') return 'cleared';
    return cat === 'sale' ? 'sale' : (cat === 'purchase:none' ? 'pnone' : 'pknown');
  }
  function legendHtml(pts) {
    var seen = {}, out = [];
    pts.forEach(function (p) {
      if (seen[p.cat]) return;
      seen[p.cat] = true;
      out.push('<span class="ph-leg-item"><span class="ph-leg-sw ' + catCls(p.cat) + '"></span>' + esc(p.label) + '</span>');
    });
    return out.join('');
  }
  // "비움"이 이 조회 범위에 하나라도 있을 때만 설명을 보탠다 — 없는 상품에까지 매번
  // 보이면 잡음이 된다(§1b 참조 사실과 같은 조건부 안내 방식).
  function clearedNoteHtml(items) {
    var hasCleared = items.some(function (it) { return it.new == null; });
    if (!hasCleared) return '';
    return '<div class="ph-chart-sourcing">점선 원(비움) 표시와 표의 「비움」은 판매가·매입가를 값 없음으로 지운 조작이'
      + ' 원장에 남은 것입니다 — 값이 낮다는 뜻도, 화면이 데이터를 못 받아왔다는 뜻도 아닙니다.</div>';
  }
  function renderChart(items) {
    var wrap = $('phChartWrap');
    var pts = seriesPoints(items);
    if (!pts.length) {
      wrap.innerHTML = '<div class="ph-chart-empty">' + emptyReasonHtml() + '</div>';
      return;
    }
    var revertedMap = computeReverted(allItems());
    var max = pts.reduce(function (m, p) { return (p.it.new == null) ? m : Math.max(m, p.it.new); }, 1);
    var bars = pts.map(function (p) {
      var v = p.it.new;
      var cleared = (v == null);
      var dim = revertedMap[p.it.id] ? ' dim' : '';
      // 비움 지점은 높이 0%짜리 색 막대로 그리지 않는다 — min-height:2px와 겹쳐
      // "아주 싼 값"으로 오독될 수 있다. 대신 고정 크기 점선 원 마커로 "값이 없다"는
      // 사실 자체를 그린다(모듈 docstring §차트 참조) — 막대 계열과 모양부터 다르다.
      var barHtml = cleared
        ? '<div class="ph-bar cleared' + dim + '"></div>'
        : '<div class="ph-bar ' + catCls(p.cat) + dim + '" style="height:' + Math.max(2, Math.round(v * 100 / max)) + '%"></div>';
      var valueTxt = cleared ? '비움 — 이 시점에 값이 지워졌습니다' : won(v);
      var title = fmtDT(p.it.at) + ' · ' + p.fieldLabel + ' · ' + valueTxt + (revertedMap[p.it.id] ? ' · 되돌려진 변경입니다' : '');
      return '<div class="ph-bar-col" title="' + esc(title) + '">'
        + '<div class="ph-bar-track">' + barHtml + '</div>'
        + '<div class="ph-bar-lbl">' + esc(fmtDShort(p.it.at)) + '</div>'
        + '</div>';
    }).join('');
    wrap.innerHTML =
      '<div class="ph-chart"><div class="ph-chart-bars">' + bars + '</div></div>'
      + '<div class="ph-chart-legend">' + legendHtml(pts) + '</div>'
      + '<div class="ph-chart-note">구간 축은 고정 길이가 아닙니다 — 실데이터 구간을 그대로 그립니다.</div>'
      + clearedNoteHtml(items)
      + purchaseNoteHtml();
  }
  // 1b 참조 사실을 선택 상품 스코프로: "이 상품의 매입가 이력은 N건 · 그중 M건 공급처 미기록"
  function purchaseNoteHtml() {
    var purchaseItems = allItems().filter(function (it) { return it.field === 'purchase'; });
    if (!purchaseItems.length) return '';
    var noSup = purchaseItems.filter(function (it) { return !it.supplier; }).length;
    return '<div class="ph-chart-sourcing">이 상품의 매입가 이력은 ' + fmt(purchaseItems.length) + '건이고'
      + ' 그중 ' + fmt(noSup) + '건은 공급처 미기록입니다 — 실제 공급처인 것처럼 표시하지 않습니다.</div>';
  }

  // ── 변동 표 ──────────────────────────────────────────────────────
  function reasonCell(it) {
    var raw = it.reason || '';
    var label = (it.reason_label != null && it.reason_label !== '') ? it.reason_label : raw;
    var untranslated = (label === raw && raw !== '');
    if (untranslated) {
      return '<span class="ph-untranslated" title="서버가 이 사유 코드의 한글 라벨을 아직 주지 않습니다(번역 미비) — 화면이 임의로 번역해 넣지 않습니다">'
        + '<code>' + esc(raw) + '</code><span class="tag">번역 미비</span></span>';
    }
    return esc(label);
  }
  // margin_policy(_undo)는 두 화면(개별 승인 · 대량 재산정)에서 온다 — ref_id 유무로
  // PH_REASON_LINKS의 어느 버킷을 볼지만 고른다(위 모듈 docstring §margin_policy는 두
  // 화면에서 온다 참조). 텍스트를 새로 만들지 않는다 — 버킷은 서버가 이미 계산해 뒀다.
  var MOVE_BULK_KEY = {margin_policy: 'margin_policy_bulk', margin_policy_undo: 'margin_policy_bulk_undo'};
  function moveCell(it) {
    var links = window.PH_REASON_LINKS || {};
    var bulkKey = MOVE_BULK_KEY[it.reason];
    var key = (bulkKey && it.ref_id == null) ? bulkKey : it.reason;
    var target = links[key];
    if (!target) {
      return '<span class="ph-move off" title="이 사유는 이동 대상 화면 정보가 없습니다">이동<span class="tag">불가</span></span>';
    }
    if (target.available) {
      return '<a class="ph-move" href="' + esc(target.href) + '">이동 →</a>';
    }
    return '<span class="ph-move off" title="' + esc(target.reason || '') + '">이동<span class="tag">불가</span></span>';
  }
  function rowHtml(it) {
    var isUndo = /_undo$/.test(it.reason || '');
    var oldHtml = it.old == null ? noPriorHtml() : esc(won(it.old));
    var newHtml = priceEventHtml(it.new);
    // 비움(new==null)을 최우선으로 본다 — old 유무와 무관하게 이 행의 결과가 "값
    // 없음"이면 비움이다. old==null(이전 값 없음)은 new가 있을 때만 그다음으로 본다.
    // 서버 계약상 둘 다 NULL인 행은 없다(patch_product·catalog_ingest 모두 "값이 안
    // 바뀌면 남기지 않는다") — 그래도 방어적으로 비움을 먼저 확인한다(모듈 docstring
    // §증감 열의 결함 참조 — 예전 코드는 이 순서가 없어 "비움"을 "신규"라고 표시했다).
    var deltaTxt, dCls;
    if (it.new == null) { deltaTxt = '비움'; dCls = 'cleared'; }
    else if (it.old == null) { deltaTxt = '설정'; dCls = 'flat'; }
    else { deltaTxt = deltaWon(it.delta); dCls = deltaCls(it.delta); }
    return '<div class="ph-row' + (isUndo ? ' undo' : '') + '" role="row">'
      + '<span class="num" role="cell">' + esc(fmtDT(it.at)) + '</span>'
      + '<span role="cell">' + esc(it.field_label || it.field) + '</span>'
      + '<span class="num" role="cell">' + oldHtml + '</span>'
      + '<span class="num" role="cell">' + newHtml + '</span>'
      + '<span class="num ' + dCls + '" role="cell">' + esc(deltaTxt) + '</span>'
      + '<span role="cell">' + reasonCell(it) + '</span>'
      + '<span role="cell">' + moveCell(it) + '</span>'
      + '</div>';
  }
  function renderTable(items) {
    var box = $('phTable');
    if (!items.length) {
      box.innerHTML = '<div class="ph-empty">' + emptyReasonHtml() + '</div>';
      return;
    }
    var head = '<div class="ph-thead" role="row">'
      + '<span role="columnheader">시각</span>'
      + '<span role="columnheader">구분</span>'
      + '<span role="columnheader">이전</span>'
      + '<span role="columnheader">이후</span>'
      + '<span role="columnheader">증감</span>'
      + '<span role="columnheader">사유</span>'
      + '<span role="columnheader">이동</span>'
      + '</div>';
    box.innerHTML = head + items.map(rowHtml).join('');
  }

  // ── 하단 고지 ────────────────────────────────────────────────────
  function renderFoot() {
    $('phFoot').textContent =
      '기간을 바꾸면 좌측 상품 목록도 같은 기간으로 다시 계산됩니다 · 날짜 형식이 틀리면 400 · '
      + '그 기간에 이력이 없는 상품을 지정하면 404 · 최근 N일은 정당하게 빈 결과입니다(오류가 아닙니다).';
  }

  // ── 선택 상품 최신 이력(스코프를 선택 상품으로 명시 — 위 모듈 docstring 참조) ──
  function renderLatestNote() {
    var el = $('phLatestNote');
    var items = allItems();
    if (!items.length) { el.textContent = ''; return; }
    // items는 서버가 이미 "최신 우선"으로 정렬해 준다(최신순 — admin_price_history.py 확인)
    el.textContent = '선택 상품 최신 이력 ' + fmtDT(items[0].at).slice(0, 10);
  }

  // ── 전체 렌더 ─────────────────────────────────────────────────────
  function renderAll(rebuildList) {
    var loading = $('phLoading'), errBox = $('phErrBox'), body = $('phBody');
    if (S.err) {
      loading.hidden = true; body.hidden = true; errBox.hidden = false;
      $('phErrMsg').textContent = S.err.message;
      return;
    }
    if (!S.data) { loading.hidden = false; errBox.hidden = true; body.hidden = true; return; }
    loading.hidden = true; errBox.hidden = true; body.hidden = false;

    renderSummary();
    if (rebuildList !== false) renderList(); else updateListSelection();
    renderCard();
    renderLatestNote();
    var items = visibleItems();
    renderChart(items);
    renderTable(items);
    renderFoot();
  }

  // ── 조작 ─────────────────────────────────────────────────────────
  function applyRange() {
    var from = $('phFrom').value, to = $('phTo').value;
    var errBox = $('phRangeErr');
    if (from && to && from > to) {
      errBox.hidden = false; errBox.textContent = '시작일이 종료일보다 늦습니다.';
      return;
    }
    errBox.hidden = true; errBox.textContent = '';
    S.dateFrom = from; S.dateTo = to; S.productCode = null;
    load();
  }
  function resetRange() {
    $('phFrom').value = ''; $('phTo').value = '';
    $('phRangeErr').hidden = true;
    S.dateFrom = ''; S.dateTo = ''; S.productCode = null;
    load();
  }
  function selectProduct(code) {
    var n = Number(code);
    if (!isFinite(n)) return;
    S.productCode = n;
    load();
  }
  function setMode(mode) {
    if (mode !== 'kept' && mode !== 'all') return;
    S.mode = mode;
    Array.prototype.forEach.call(document.querySelectorAll('[data-action="set-mode"]'), function (b) {
      var on = b.getAttribute('data-mode') === S.mode;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    renderAll(false);
  }

  document.addEventListener('click', function (e) {
    var t = e.target.closest('[data-action]');
    if (!t) return;
    var act = t.getAttribute('data-action');
    if (act === 'retry') { load(); return; }
    if (act === 'apply-range') { applyRange(); return; }
    if (act === 'reset-range') { resetRange(); return; }
    if (act === 'set-mode') { setMode(t.getAttribute('data-mode')); return; }
    if (act === 'select-product') { selectProduct(t.getAttribute('data-code')); return; }
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && (e.target === $('phFrom') || e.target === $('phTo'))) applyRange();
  });
  document.addEventListener('input', function (e) {
    if (e.target === $('phSearch')) { S.search = e.target.value; renderList(); }
  });

  function boot() { load(); }
  boot();
})();
</script>
{% endraw %}
