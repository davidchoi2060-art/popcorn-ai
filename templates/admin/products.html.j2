{% block foot_extra %}
{# 쓰기 요청 자동 진행·완료 표시(전 admin2 공통, CLAUDE.md "쓰기 요청은 자동으로 진행·완료를
   표시한다"). 멱등 가드(window.__pcProgress)가 있어 셸이 이미 로드했어도 중복 부작용이
   없다 — 그래도 이 화면이 실제로 의존하므로 명시적으로 싣는다(부르기 전에 있는지 보는 것과
   같은 이유로, 있는 줄 가정하지 않는다). #}
<script src="/shared/ui-progress.js"></script>
<script>{% raw %}
(function(){
  "use strict";
  var API = "/api/admin";

  function esc(v){
    return String(v == null ? "" : v).replace(/[&<>"]/g, function(c){
      return {"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;"}[c];
    });
  }
  function fmtWon(n){ return n == null ? "—" : n.toLocaleString("ko-KR") + "원"; }
  function fmtDate(s){ return s ? String(s).slice(0,16).replace("T"," ") : "—"; }
  function fmtDateShort(s){ return s ? String(s).slice(0,10) : "—"; }
  // 몰이 준 순위(0=1순위, 0066 마이그레이션 주석)를 사람이 읽는 "N위"로 바꿀 뿐,
  // 값 자체는 서버가 준 mall_rank 그대로다 — 화면이 순위를 새로 매기지 않는다.
  function fmtRank(mr){ return mr == null ? "—" : (mr + 1) + "위"; }
  function errText(j, status){
    return window.popcornProgress ? window.popcornProgress.errText(j, status, "") : ("오류 " + status);
  }
  function asJson(r){
    return r.json().catch(function(){ return null; }).then(function(j){ return {ok:r.ok, status:r.status, j:j}; });
  }

  /* ══════════════════════ 메타(선택지) — 서버가 준다 ══════════════════════ */
  var META = null, SPEC_FIELDS = null, SUPPLIERS = null;

  // 분류를 고르면 **그 분류의 제조사만** 받는다(요청 36 · 2026-08-31). 전에는 항상
  // 전체를 받아, 메인보드를 고르고 메인보드를 안 파는 제조사를 고를 수 있었다 —
  // 결과 0건이 나오고 운영자는 "상품이 없다"고 읽는다.
  // 분류 선택지(used_parts)는 «전체» 기준을 유지한다 — 좁힌 목록으로 다시 그리면
  // 지금 고른 분류만 남아 다른 분류로 못 옮긴다.
  function loadMeta(pt){
    var url = API + "/product-meta" + (pt ? "?part_type=" + encodeURIComponent(pt) : "");
    return fetch(url).then(function(r){ return r.ok ? r.json() : null; })
      .then(function(m){
        if(!m) return;
        if(META && pt) { META.makers = m.makers; }   // 제조사만 갈아 끼운다
        else { META = m; }
        fillFilterSelects(); fillBulkStatusSelect();
      })
      .catch(function(){});
  }
  function loadSpecFields(){
    return fetch(API + "/spec-fields").then(function(r){ return r.ok ? r.json() : null; })
      .then(function(j){ SPEC_FIELDS = (j && j.items) || []; })
      .catch(function(){ SPEC_FIELDS = []; });
  }
  function loadSuppliers(){
    return fetch(API + "/suppliers").then(function(r){ return r.ok ? r.json() : null; })
      .then(function(j){ SUPPLIERS = (j && j.items) || []; })
      .catch(function(){ SUPPLIERS = []; });
  }
  function fillFilterSelects(){
    var cats = (META && META.used_parts) || [];
    var mfrs = (META && META.makers) || [];
    var selCat = document.getElementById("fcat");
    if(selCat){
      // ⚠ innerHTML 을 다시 쓰면 **고른 값이 풀린다.** 제조사만 갈아 끼우려고
      //   loadMeta 를 다시 부르는 경로(요청 36)가 생겨서, 되그린 뒤 선택을 돌려놓는다.
      var keep = selCat.value;
      selCat.innerHTML = '<option value="all">분류 전체 (' + cats.length + '종)</option>'
        + cats.map(function(c){ return '<option value="' + esc(c.part_type) + '">' + esc(c.label) + '</option>'; }).join("");
      if(keep) selCat.value = keep;
    }
    var dl = document.getElementById("fmfrList");
    if(dl) dl.innerHTML = mfrs.map(function(m){ return '<option value="' + esc(m) + '">'; }).join("");
  }
  function fillBulkStatusSelect(){
    var sel = document.getElementById("bulkStatus");
    if(!sel || !META) return;
    sel.innerHTML = (META.status_options || []).map(function(o){
      return '<option value="' + esc(o) + '">' + esc(o) + '</option>'; }).join("");
  }
  function specLabel(key){
    var f = (SPEC_FIELDS || []).filter(function(x){ return x.field_key === key; })[0];
    return f ? f.label : key;
  }
  function fieldsForPartType(pt){
    return (SPEC_FIELDS || []).filter(function(f){
      return !f.part_types || !f.part_types.length || f.part_types.indexOf(pt) >= 0;
    }).map(function(f){
      return Object.assign({}, f, {required: (f.required_for || []).indexOf(pt) >= 0});
    }).sort(function(a,b){ return (a.sort_order || 0) - (b.sort_order || 0); });
  }

  /* 2단 선택 — taxonomy.choice_tree() 가 준 트리를 그대로 그린다(무엇이 접히는지는
     화면이 모른다 — CANON: 부품 어휘는 taxonomy.py 단일 원천). */
  function findLeafGroup(tree, leafKey){
    for(var i=0;i<tree.length;i++){
      if(tree[i].key === leafKey) return {top:tree[i], sub:null};
      if(tree[i].options){
        for(var j=0;j<tree[i].options.length;j++){
          if(tree[i].options[j].key === leafKey) return {top:tree[i], sub:tree[i].options[j]};
        }
      }
    }
    return null;
  }
  function buildChoiceSelect(host, tree, currentKey, onChange){
    var found = currentKey ? findLeafGroup(tree, currentKey) : null;
    var sel1 = document.createElement("select");
    sel1.setAttribute("aria-label", "분류(1단)");
    sel1.innerHTML = '<option value="">분류를 선택하세요</option>' + tree.map(function(t){
      return '<option value="' + esc(t.key) + '"' + (found && found.top.key===t.key ? " selected" : "") + '>' + esc(t.label) + '</option>';
    }).join("");
    var sel2 = document.createElement("select");
    sel2.setAttribute("aria-label", "분류(2단)");
    sel2.style.marginLeft = "6px";
    host.innerHTML = "";
    host.appendChild(sel1);
    host.appendChild(sel2);
    function syncSel2(){
      var top = tree.filter(function(t){ return t.key === sel1.value; })[0];
      if(top && top.options){
        sel2.style.display = "";
        sel2.innerHTML = top.options.map(function(o){
          return '<option value="' + esc(o.key) + '"' + (found && found.sub && found.sub.key===o.key ? " selected" : "") + '>' + esc(o.label) + '</option>';
        }).join("");
        onChange(sel2.value || null);
      } else {
        sel2.style.display = "none"; sel2.innerHTML = "";
        onChange(top ? top.key : null);
      }
    }
    sel1.onchange = syncSel2;
    sel2.onchange = function(){ onChange(sel2.value || null); };
    syncSel2();
  }

  /* ══════════════════════ 목록 — 상태 5종 ══════════════════════ */
  var STATUS_TABS = [
    {key:"all", label:"전체", param:""},
    {key:"ok", label:"추천 가능", param:"ok"},
    {key:"review", label:"검수 대기", param:"review"},
    {key:"oos", label:"재고 없음", param:"oos"},
    {key:"price", label:"가격 검토", param:"price"}
  ];
  var ST = {
    ok:{label:"추천 가능", cls:"pp-badge-ok"},
    review:{label:"검수 대기", cls:"pp-badge-warn"},
    oos:{label:"재고 없음", cls:"pp-badge-bad"},
    price:{label:"가격 검토", cls:"pp-badge-warn"}
  };

  var PAGE=1, SIZE=100, TOTAL=0, PAGES=1, STATE="loading", FAIL_MSG="", DATA=[], KPIS=null;
  var cur="all", q="", fcat="all", fmfr="all";
  var sortKey=null, sortDir=1;
  var SEL = {};
  // 2026-09-10 개편 — 재고상태 필터(req-products.md ⑤-B B-7 "부분가능"). 서버에
  // stockState라는 별도 파라미터가 없다 — 「재고 없음」은 상태 탭 "재고 없음"(status=oos)과
  // **완전히 같은 서버 판정**이므로 새 축을 만들지 않고 cur 값 자체를 공유한다("oos"이면
  // 이 select도 "oos"를 보이고, 반대로 이 select에서 "oos"를 고르면 cur를 "oos"로 바꾼다).
  // 두 컨트롤이 같은 값을 다르게 말하는 상태(④-B4가 경고하는 "한 화면 두 원천")를
  // 구조적으로 없앤다. "재고 있음"·"10개 이하"는 서버에 조회 조건 자체가 없어(신설
  // 대상) <option disabled>로만 두고 고를 수 없게 한다.
  // 요청 #28 추가(2026-09-02) — 분류 관리 화면(product_category.html.j2)에서 "분류에
  // 묶인 상품 수"를 눌러 넘어올 때 쓰는 축. products.category_id(판매 분류)이고 위
  // fcat(part_type, 부품 종류)과는 다른 축이라 별개 상태로 둔다 — 섞으면 카테고리
  // 필터가 걸린 채로 부품 종류를 바꿨을 때 어느 쪽이 이겼는지 알 수 없다.
  // catId=0 = 무필터. catName은 칩에 보여줄 이름 — /api/admin/categories를 한 번
  // 불러 채운다(URL로 이름을 실어 보내면 위조·인코딩 문제가 생긴다 — 지시서 원문).
  // null이면 아직 못 불러온 것, 빈 문자열이 아니라 null로 "모름"을 구분한다.
  var catId=0, includeDesc=0, catName=null;

  function fromApi(it){
    return {product_code:String(it.product_code), sku:it.sku, name:it.name, cat:it.cat,
      maker: it.maker || "—", spec_done:it.spec_done, spec_total:it.spec_total,
      spec_row_missing:it.spec_row_missing, stock:it.stock, sale_price:it.sale_price,
      status_key:it.status_key};
  }

  function load(){
    var tab = STATUS_TABS.filter(function(t){ return t.key===cur; })[0] || STATUS_TABS[0];
    var url = API + "/products?page=" + PAGE + "&size=" + SIZE
      + "&q=" + encodeURIComponent(q || "")
      + "&part_type=" + encodeURIComponent(fcat==="all" ? "" : fcat)
      + "&maker=" + encodeURIComponent(fmfr==="all" ? "" : fmfr)
      + "&status=" + encodeURIComponent(tab.param);
    // 요청 #28 추가(2026-09-02) — 분류 관리에서 넘어온 category_id 축. fcat(part_type)과는
    // 별개라 항상 함께 보낸다(catId=0이면 서버도 무필터로 본다 — api/admin_products.py).
    if(catId){ url += "&category_id=" + catId + "&include_desc=" + includeDesc; }
    fetch(url).then(function(r){
      if(r.status===401){ STATE="fail401"; DATA=[]; renderAll(); return null; }
      if(!r.ok){
        return asJson(r).then(function(res){ STATE="failOther"; DATA=[]; FAIL_MSG=errText(res.j,res.status); renderAll(); return null; });
      }
      return r.json();
    }).then(function(d){
      if(!d) return;
      STATE="ok"; TOTAL=d.total; PAGES=Math.max(1,d.pages); SIZE=d.size; KPIS=d.kpis;
      DATA = d.items.map(fromApi);
      renderAll();
    }).catch(function(){
      STATE="failNet"; DATA=[]; renderAll();
    });
  }

  function renderAll(){ renderTabs(); renderTable(); renderPager(); }

  function renderTabs(){
    var host = document.getElementById("tabs"); if(!host) return;
    var known = STATE==="ok";
    host.innerHTML = STATUS_TABS.map(function(t){
      var n = known ? (t.key==="all" ? KPIS.total : (KPIS[t.key]||0)) : "—";
      var on = t.key===cur;
      return '<button type="button" class="pp-tab' + (on?" on":"") + '" data-k="' + t.key + '"'
        + ' role="tab" aria-selected="' + (on?"true":"false") + '">'
        + '<span>' + t.label + '</span><span class="n">' + (typeof n==="number"?n.toLocaleString("ko-KR"):n) + '</span></button>';
    }).join("") + '<span class="pp-tabs-note">탭 클릭 = 서버 재조회 — 배지와 행 수가 항상 일치합니다</span>';
    host.querySelectorAll("[data-k]").forEach(function(b){
      b.onclick = function(){ if(cur===b.dataset.k) return; cur=b.dataset.k; PAGE=1; syncStockSelect(); load(); };
    });
    syncStockSelect();
  }
  // 2026-09-10 개편 — 재고상태 필터와 상태 탭이 "재고 없음"을 같은 값(cur==="oos")으로
  // 공유한다는 사실을 화면에도 반영한다: 탭에서 [재고 없음]을 누르면 이 select도
  // "재고 없음"을 보이고, 다른 탭으로 가면 select는 "전체"로 돌아간다.
  function syncStockSelect(){
    var sel = document.getElementById("fstock"); if(!sel) return;
    sel.value = (cur==="oos") ? "oos" : "";
  }

  var SORT_GETTERS = {
    name: function(p){ return (p.name||"").toLowerCase(); },
    cat: function(p){ return p.cat||""; },
    spec: function(p){ return p.spec_total ? p.spec_done/p.spec_total : -1; },
    stock: function(p){ return p.stock; },
    price: function(p){ return p.sale_price==null ? -1 : p.sale_price; },
    status: function(p){ return p.status_key||""; }
  };
  function applySort(list){
    if(!sortKey) return list;
    var g=SORT_GETTERS[sortKey], dir=sortDir;
    return list.slice().sort(function(a,b){
      var av=g(a), bv=g(b);
      if(av<bv) return -1*dir; if(av>bv) return 1*dir; return 0;
    });
  }

  function specBadge(p){
    if(!p.spec_total) return '<span class="pp-dim-text">—</span>';
    if(p.spec_row_missing) return '<span class="pp-badge pp-badge-bad">사양 미등록</span>';
    var ok = p.spec_done===p.spec_total;
    return '<span class="pp-badge ' + (ok?"pp-badge-ok":"pp-badge-warn") + '">'
      + (ok?"확인 완료":"미확인 " + (p.spec_total-p.spec_done)) + '</span> '
      + '<span class="pp-dim-text">' + p.spec_done + '/' + p.spec_total + '</span>';
  }
  function rowHtml(p){
    var st = ST[p.status_key] || {label:p.status_key||"—", cls:"pp-badge-ok"};
    var skuLine = (p.sku && String(p.sku)!==p.product_code) ? ("SKU " + esc(p.sku)) : esc(p.product_code);
    // 몰 원문 HTML 태그(<font>·<P> 등)가 글자로 새지 않도록 표시 직전에만 벗긴다 —
    // p.name(원본)은 그대로 둔다(2026-08-27, 사장님 발견 결함). 편집 입력값(BASIC_FIELDS)에는
    // 쓰지 않는다 — 여기는 목록의 읽기 전용 행이다.
    var nm = Admin2Text.stripHtml(p.name);
    return '<div class="pp-row" data-pc="' + p.product_code + '">'
      + '<span><input type="checkbox" class="pp-chk" data-pc="' + p.product_code + '"'
        + (SEL[p.product_code]?" checked":"") + ' aria-label="선택"></span>'
      + '<span class="pp-code">' + p.product_code + '</span>'
      + '<span class="pp-name-wrap"><button type="button" class="pp-name" data-open="' + p.product_code + '" title="' + esc(nm) + '">' + esc(nm) + '</button>'
        + '<span class="pp-sku">' + skuLine + '</span></span>'
      + '<span class="pp-cat">' + esc(p.cat) + '</span>'
      + '<span>' + specBadge(p) + '</span>'
      + '<span class="pp-right' + (p.stock===0?" pp-stock zero":"") + '">' + p.stock + '</span>'
      + '<span class="pp-price">' + fmtWon(p.sale_price) + '</span>'
      + '<span><span class="pp-badge ' + st.cls + '">' + esc(st.label) + '</span></span>'
      + '<button type="button" class="pp-menu-btn" data-open="' + p.product_code + '" title="상세 보기" aria-label="상세 보기">⋯</button>'
      + '</div>';
  }
  function renderTable(){
    var host = document.getElementById("rows"); if(!host) return;
    if(STATE!=="ok"){
      var msg = STATE==="loading" ? "불러오는 중…"
        : STATE==="fail401" ? "세션이 만료됐습니다 — 다시 로그인해 주세요."
        : STATE==="failNet" ? "서버에 연결되지 않아 불러오지 못했습니다."
        : ("불러오지 못했습니다" + (FAIL_MSG ? (" — " + FAIL_MSG) : ""));
      host.innerHTML = '<div class="pp-empty">' + esc(msg) + '</div>';
      return;
    }
    var list = applySort(DATA);
    if(!list.length){
      // 2026-09-10 개편 — req-products.md B-16 "가능"·⑦-A 빈 결과 2종 요구.
      // 서버가 준 TOTAL(이 조회 조건의 전체 건수)이 0이고 **조회 조건이 전부 기본값**일
      // 때만 "등록된 상품이 없습니다" — 그 밖(필터가 걸려 있는데 0건)은 "조회 조건에
      // 맞는 상품이 없습니다". 두 문구 다 서버 TOTAL만 근거로 하고 화면이 수를 세지 않는다.
      var noFilter = cur==="all" && q==="" && fcat==="all" && fmfr==="all" && !catId;
      var msg = (TOTAL===0 && noFilter) ? "등록된 상품이 없습니다." : "조회 조건에 맞는 상품이 없습니다.";
      host.innerHTML = '<div class="pp-empty">' + esc(msg) + '</div>';
      return;
    }
    host.innerHTML = list.map(rowHtml).join("");
    syncHeadCheckbox();
  }
  function syncHeadCheckbox(){
    var head = document.getElementById("chkAll"); if(!head) return;
    var list = applySort(DATA);
    var total = list.length, sel = list.filter(function(p){ return SEL[p.product_code]; }).length;
    head.checked = total>0 && sel===total;
    head.indeterminate = sel>0 && sel<total;
  }
  // 2026-09-10 개편 — req-products.md B-13 "가능"(API size 이미 있음, 상한 500).
  // 원안(v6)의 10/20/50은 그 화면의 데모 규모 기준이라 그대로 옮기지 않는다(⑥-B
  // 경고 — 원안 수치를 그대로 옮기면 안 된다). 이 카탈로그는 23,151건 규모라
  // 그 규모에 맞는 값(50/100/200/500)으로 고른다 — API 상한도 500이다.
  var PAGE_SIZE_CHOICES = [50, 100, 200, 500];
  function renderPager(){
    var foot = document.getElementById("pgBar"); if(!foot) return;
    if(STATE!=="ok"){ foot.innerHTML=""; return; }
    var from = TOTAL ? ((PAGE-1)*SIZE+1) : 0;
    var to = Math.min(PAGE*SIZE, TOTAL);
    foot.innerHTML =
      '<span class="cnt">전체 <b>' + TOTAL.toLocaleString("ko-KR") + '</b>건 중 ' + from + '–' + to + '</span>'
      + '<label class="visually-hidden" for="fsize">페이지당 건수</label>'
      + '<select id="fsize" class="pp-select" aria-label="페이지당 건수">'
      + PAGE_SIZE_CHOICES.map(function(n){
          return '<option value="' + n + '"' + (n===SIZE?" selected":"") + '>' + n + '건씩</option>';
        }).join("")
      + '</select>'
      + '<div class="pp-pager">'
      + '<button type="button" id="pgPrev"' + (PAGE<=1?" disabled":"") + '>‹ 이전</button>'
      + '<span class="pp-pages">' + PAGE + ' / ' + PAGES + '</span>'
      + '<button type="button" id="pgNext"' + (PAGE>=PAGES?" disabled":"") + '>다음 ›</button>'
      + '</div>';
    var pv=document.getElementById("pgPrev"), nx=document.getElementById("pgNext");
    if(pv) pv.onclick=function(){ if(PAGE>1){ PAGE--; load(); } };
    if(nx) nx.onclick=function(){ if(PAGE<PAGES){ PAGE++; load(); } };
    var sz=document.getElementById("fsize");
    if(sz) sz.onchange=function(e){ SIZE=Number(e.target.value)||100; PAGE=1; load(); };
  }

  /* ══════════════════════ 분류 필터 칩(요청 #28, 2026-09-02) ══════════════════════ */
  // 상품 분류 관리(product_category.html.j2)의 트리·서랍에서 "분류에 묶인 상품 수"를
  // 눌러 넘어올 때 이 화면이 그 category_id로 걸러진 목록을 보여주는 자리다.
  function readCategoryFromUrl(){
    var sp = new URLSearchParams(window.location.search);
    var cid = parseInt(sp.get("category_id"), 10);
    catId = (!isNaN(cid) && cid > 0) ? cid : 0;
    // include_desc는 catId가 있을 때만 뜻이 있다 — catId=0인데 include_desc만 켜져
    // 있으면(URL을 손으로 만진 경우) 아무 필터도 걸지 않는다.
    includeDesc = (catId && sp.get("include_desc")==="1") ? 1 : 0;
  }
  function loadCategoryName(){
    if(!catId) return;
    // 이름은 목록 API 하나로 찾는다 — 새 엔드포인트를 만들지 않는다(정본은
    // admin_categories.categories 하나뿐). URL로 이름을 실어 보내지 않는 이유는
    // 지시서 원문: 위조·인코딩 문제. 실패해도 catId 필터 자체는 이미 load()에
    // 걸려 있으므로, 이름만 "분류 #<id>"로 대신한다(renderCatChip의 폴백).
    fetch(API + "/categories").then(function(r){ return r.ok ? r.json() : null; })
      .then(function(j){
        var hit = j && j.items && j.items.filter(function(c){ return c.category_id===catId; })[0];
        catName = hit ? hit.name : null;
        renderCatChip();
      })
      .catch(function(){ renderCatChip(); });   // 네트워크 실패도 같은 폴백 — 필터는 그대로 산다
  }
  function renderCatChip(){
    var chip=document.getElementById("catChip"), lb=document.getElementById("catChipLabel");
    if(!chip || !lb) return;
    if(!catId){ chip.hidden=true; return; }
    chip.hidden = false;
    lb.textContent = "분류: " + (catName || ("분류 #" + catId));
  }
  function clearCategoryFilter(){
    catId=0; includeDesc=0; catName=null;
    renderCatChip();
    // URL에서도 지운다(history.replaceState) — 새로고침해도 필터가 되살아나지
    // 않게. 이 두 키만 지운다 — 다른 querystring은 건드리지 않는다(지시서 원문).
    var u = new URL(window.location.href);
    u.searchParams.delete("category_id");
    u.searchParams.delete("include_desc");
    window.history.replaceState(null, "", u.pathname + u.search + u.hash);
    PAGE=1; load();
  }

  // 2026-09-10 개편 — req-products.md B-12 "가능(화면 배선만)". 조회 조건 전부를
  // 기본값으로 되돌린다(⑥-A "조회 조건이 기본값이면 비활성" 요구는 클릭할 때마다
  // 항상 안전하게 두 번 눌러도 무해하므로, 별도 disabled 계산 없이 항상 활성으로 둔다
  // — 계산이 틀려 "눌러도 안 된다"가 되는 것보다 "이미 기본값인데 한 번 더 눌러도
  // 그대로"인 편이 안전하다).
  function resetFilters(){
    cur="all"; q=""; fcat="all"; fmfr="all"; PAGE=1;
    var qEl=document.getElementById("q"); if(qEl) qEl.value="";
    var catEl=document.getElementById("fcat"); if(catEl) catEl.value="all";
    var mfrEl=document.getElementById("fmfr"); if(mfrEl) mfrEl.value="";
    clearCategoryFilter();   // load()까지 함께 호출한다 — 아래 별도 load() 불필요
    loadMeta();
    syncStockSelect();
  }

  /* ══════════════════════ 일괄 상태 변경 + 되돌리기 ══════════════════════ */
  var MAX_BULK_HINT = 2000;   // 서버 상한(admin_products.MAX_BULK) — 문구 표시에만 쓴다, 클라이언트가 막지 않는다
  var BULK_UNDO_ID = null;

  function selCount(){ return Object.keys(SEL).length; }
  function syncBulk(){
    var active=document.getElementById("bulkActive"), hint=document.getElementById("bulkHintWrap");
    var c=selCount();
    if(active) active.hidden = c===0;
    if(hint) hint.hidden = c!==0;
    var sc=document.getElementById("selCount"); if(sc) sc.textContent=c.toLocaleString("ko-KR");
  }
  function setBulkResult(text, bad){
    var el=document.getElementById("bulkResult"); if(!el) return;
    el.textContent = text || "";
    el.style.color = bad ? "var(--error)" : "";
  }
  // 2026-09-10 개편 — req-products.md B-15. 되돌리기 버튼과 [닫기]는 짝이다 — 방금
  // 일괄 변경의 결과 안내(bulkResult)와 되돌릴 수단을 함께 보였다가, [닫기]는 되돌리지
  // 않고 안내만 지운다(취소 아님 — 이미 반영된 변경은 그대로 둔다).
  function showUndo(v){
    var b=document.getElementById("btnUndo"); if(b) b.hidden=!v;
    var d=document.getElementById("btnDismissUndo"); if(d) d.hidden=!v;
  }
  function dismissUndo(){
    BULK_UNDO_ID = null;
    setBulkResult("", false);
    showUndo(false);
  }

  function bulkApply(){
    var codes = Object.keys(SEL).map(Number);
    if(!codes.length) return;
    var st = document.getElementById("bulkStatus").value;
    if(!st){ window.alert("바꿀 상태를 고르세요"); return; }
    if(!window.confirm(codes.length.toLocaleString("ko-KR") + "건을 '" + st + "'(으)로 바꿉니다. 계속할까요?")) return;
    fetch(API + "/products/bulk-status", {method:"POST", headers:{"Content-Type":"application/json"},
      body: JSON.stringify({product_codes:codes, status:st})})
      .then(asJson).then(function(res){
        if(!res.ok){ setBulkResult(errText(res.j, res.status), true); return; }
        BULK_UNDO_ID = res.j.log_id;
        SEL = {};
        setBulkResult(res.j.verdict || "완료됐습니다", false);
        showUndo(true);
        syncBulk();
        load();
      })
      .catch(function(err){ setBulkResult("바꾸지 못했습니다 — " + (err && err.message || "네트워크 오류"), true); });
  }
  function bulkUndo(){
    if(!BULK_UNDO_ID) return;
    fetch(API + "/products/bulk-status/undo", {method:"POST", headers:{"Content-Type":"application/json"},
      body: JSON.stringify({log_id: BULK_UNDO_ID})})
      .then(asJson).then(function(res){
        if(!res.ok){ setBulkResult(errText(res.j, res.status), true); return; }
        setBulkResult(res.j.verdict || "되돌렸습니다", false);
        BULK_UNDO_ID = null; showUndo(false);
        load();
      })
      .catch(function(err){ setBulkResult("되돌리지 못했습니다 — " + (err && err.message || "네트워크 오류"), true); });
  }

  /* ══════════════════════ 상세/편집 서랍 ══════════════════════ */
  // 몰 관리자 상품 수정 페이지 — URL은 이 한 자리에서만 만든다(§단일 원천). pd_no ==
  // products.product_code(실측 확인, api/mall.py:15 주석 · CANON §3). 고객용 URL
  // (api/mall.py의 BASE+DETAIL = /shop/product_detail.html?pd_no=)은 별개 경로라 여기
  // 두지 않는다 — 필요해지면 이 상수 옆에 나란히 추가한다. 비로그인 접근은 몰이 로그인
  // 화면으로 리다이렉트하고 로그인 후 이 상품으로 되돌린다(하네스 실측, 2026-08-23).
  var MALL_ADMIN_BASE = "https://popcornpc.co.kr";
  var MALL_ADMIN_EDIT_PATH = "/adm_cate/product_insert.php?pd_no=%s&atype=modify";
  function mallAdminEditUrl(code){
    return MALL_ADMIN_BASE + MALL_ADMIN_EDIT_PATH.replace("%s", encodeURIComponent(code));
  }
  var DR_TABS = [["basic","기본 정보"],["spec","사양"],["supplier","공급처"],["parttype","분류 변경"]];
  var DRAWER = {
    code:null, data:null, activeTab:"basic",
    editing:{basic:false, spec:false, supplier:false, parttype:false},
    partSel:null, partPreview:null,
    // 탭을 옮겼다 돌아와도 입력 중이던 값이 안 사라지게 하는 임시 버퍼(결함 ⓐ-2).
    // null이면 "이 편집 회차에서 아직 버퍼를 안 채움" — 그때만 basicTabHtml/
    // specTabHtml이 서버 값(d)으로 한 번 채운다. 새로 [수정]을 누르거나 취소·
    // 저장하면 비워서 다음 편집은 항상 최신 서버 값에서 다시 시작한다.
    editDraft:{basic:null, spec:null},
    // 분류 변경 미리보기(preview:true) 요청이 진행 중인가(결함 ⓐ-4). 공용 진행
    // 배너는 preview:true 본문엔 뜨지 않으므로(ui-progress.js가 스스로 제외 — ㉯
    // 확정) 이 화면이 자기 자리에서 진행을 보여준다: 클릭 즉시 버튼 비활성 + 인라인
    // "미리보기 중…". renderDrawerFooter가 이 값을 읽는다.
    previewBusy:false,
    // 결함 5건 수정(2026-09-11, 확인자 실측 — if(!res.ok) return; 로 조용히 삼키던 자리
    // 다섯 곳: 기본/사양 저장·분류 확정·공급처 추가). 넷은 서로 다른 탭의 버튼이라
    // 동시에 눌릴 수 없어(한 번에 한 탭만 보인다) 하나로 충분하다. 실패해도 강제로
    // false로 되돌리지 않는다 — 버튼을 다시 누를 수 있어야 한다.
    saveBusy:false,
    // 공급처 삭제가 진행 중인 psp_id(행마다 버튼이 따로 있어 saveBusy와 분리한다).
    // 대상이 없으면 null.
    delBusyId:null,
    // 서랍 내 인라인 오류(결함 5건 수정) — 탭별 맵 {basic,spec,supplier,parttype} → 문자열|null.
    // editing 상태와 같은 모양(탭별)으로 둔다 — 서로 다른 탭이 각자 편집 중일 수 있어
    // (예: 기본 정보 저장 실패로 편집 유지 중에 사양 탭도 편집을 시작하는 경우) 값 하나만
    // 두면 나중 실패가 먼저 실패를 덮어써 사라진다. 전역 진행 배너(ui-progress.js)를
    // 놓쳐도 서랍만 보고 있으면 실패 사유를 알 수 있게 한다 — renderDrawerFooter가
    // activeTab의 값만 그린다.
    err:{basic:null, spec:null, supplier:null, parttype:null},
    // [공급처] 탭에서 연락처·리베이트를 펼친 행(psp_id -> true). 서랍을 새로 열면
    // 비운다 — 다른 상품의 펼침 상태가 새 상품에 남으면 안 된다.
    supExpanded:{}
  };

  function showVeilDrawer(v){
    var veil=document.getElementById("veil"), dr=document.getElementById("drawer");
    if(veil) veil.hidden = !v;
    if(dr) dr.hidden = !v;
  }
  function openDrawer(code){
    DRAWER.code=String(code); DRAWER.data=null; DRAWER.activeTab="basic";
    DRAWER.editing={basic:false, spec:false, supplier:false, parttype:false};
    DRAWER.partSel=null; DRAWER.partPreview=null;
    DRAWER.editDraft={basic:null, spec:null};
    DRAWER.previewBusy=false;
    DRAWER.saveBusy=false; DRAWER.delBusyId=null;
    DRAWER.err={basic:null, spec:null, supplier:null, parttype:null};
    DRAWER.supExpanded={};
    showVeilDrawer(true);
    renderDrawerLoading();
    fetchDrawerData();
    var closeBtn=document.getElementById("drClose"); if(closeBtn) closeBtn.focus();
  }
  function closeDrawer(){
    DRAWER.code=null; DRAWER.data=null;
    showVeilDrawer(false);
  }
  function renderDrawerLoading(){
    document.getElementById("drTitle").textContent = "불러오는 중…";
    document.getElementById("drStatusBadge").hidden = true;
    // 이전 상품의 몰 관리자 링크가 다음 상품 로딩 중에도 남아 있으면 옛 코드로 안내하는
    // 사고가 된다 — 로딩을 그릴 때마다 즉시 숨기고 href를 지운다(renderDrawer가 새
    // DRAWER.code로 다시 세운다).
    var mallLinkL = document.getElementById("drMallLink");
    if(mallLinkL){ mallLinkL.hidden = true; mallLinkL.removeAttribute("href"); }
    document.getElementById("drSub").innerHTML = "";
    document.getElementById("drTabs").innerHTML = "";
    document.getElementById("drBody").innerHTML = '<div class="pp-empty">불러오는 중…</div>';
    document.getElementById("drFoot").innerHTML = "";
  }
  function renderDrawerError(msg){
    document.getElementById("drBody").innerHTML = '<div class="pp-empty">' + esc(msg) + '</div>';
    document.getElementById("drFoot").innerHTML = '<button type="button" class="pp-btn-line" id="drCloseErr">닫기</button>';
    var b=document.getElementById("drCloseErr"); if(b) b.onclick=closeDrawer;
  }
  function fetchDrawerData(){
    var code = DRAWER.code;
    fetch(API + "/products/" + encodeURIComponent(code)).then(function(r){
      if(r.status===401){ if(DRAWER.code===code) renderDrawerError("세션이 만료됐습니다 — 다시 로그인해 주세요."); return null; }
      if(!r.ok){ return asJson(r).then(function(res){ if(DRAWER.code===code) renderDrawerError(errText(res.j, res.status)); return null; }); }
      return r.json();
    }).then(function(d){
      if(!d || DRAWER.code !== code) return;   // 그 사이 닫혔거나 다른 상품을 열었으면 버린다
      DRAWER.data = d;
      renderDrawer();
    }).catch(function(){});
  }

  function renderDrawer(){
    var d = DRAWER.data; if(!d) return;
    var t = document.getElementById("drTitle");
    var drNm = Admin2Text.stripHtml(d.name);   // 몰 HTML 태그 표시 방지(d.name 원본은 그대로)
    t.textContent = drNm; t.title = drNm;
    // 몰 관리자 링크 — DRAWER.code는 openDrawer()가 이 상품을 열 때 이미 채워 놓았고
    // (fetchDrawerData의 "DRAWER.code !== code" 가드로 다른 상품 응답은 여기까지 오지
    // 않는다), 코드가 없으면(방어적) 빈 pd_no로 링크를 내밀지 않고 숨긴다.
    var mallLink = document.getElementById("drMallLink");
    if(mallLink){
      if(DRAWER.code){ mallLink.href = mallAdminEditUrl(DRAWER.code); mallLink.hidden = false; }
      else { mallLink.hidden = true; mallLink.removeAttribute("href"); }
    }
    var badge = document.getElementById("drStatusBadge");
    // 목록 배지와 같은 신호(status_key, derive_status 단일 원천) — 결함 ⓐ-3.
    // review_pending(검수 큐 실행 건수)은 살아있는 신호가 아니다: 신규 등록은
    // 검수행을 아예 안 만들고, 사양 편집을 되돌려도 닫힌 검수행은 안 열린다.
    // 그래서 review_pending=0인데 실제로는 검수 대기인 상품이 생긴다(실측 6건).
    if(d.status_key === "review"){ badge.hidden=false; badge.className="pp-badge pp-badge-warn"; badge.textContent="검수 대기"; }
    else if(d.in_pool){ badge.hidden=false; badge.className="pp-badge pp-badge-ok"; badge.textContent="추천 가능"; }
    else { badge.hidden=false; badge.className="pp-badge pp-badge-bad"; badge.textContent="추천 제외"; }
    document.getElementById("drSub").innerHTML = [d.product_code, d.sku, d.cat, d.maker||"제조사 미상"]
      .map(function(s){ return '<span>' + esc(s) + '</span>'; }).join("");
    var tabHost = document.getElementById("drTabs");
    tabHost.innerHTML = DR_TABS.map(function(tt){
      var extra = tt[0]==="spec" ? (" " + d.spec_done + "/" + d.spec_total)
        : tt[0]==="supplier" ? (" " + (d.suppliers ? d.suppliers.length : 0)) : "";
      var on = DRAWER.activeTab===tt[0];
      return '<button type="button" class="pp-dr-tab' + (on?" on":"") + '" data-tab="' + tt[0] + '"'
        + ' role="tab" aria-selected="' + (on?"true":"false") + '">' + tt[1] + extra + '</button>';
    }).join("");
    tabHost.querySelectorAll("[data-tab]").forEach(function(b){
      b.onclick = function(){ DRAWER.activeTab=b.dataset.tab; renderDrawerBody(); renderDrawerFooter(); renderDrawer_tabsOnly(); };
    });
    renderDrawerBody();
    renderDrawerFooter();
  }
  // 탭 버튼 자체의 on/aria-selected 만 다시 칠한다(본문 재조회 없이) — 전체 renderDrawer()를
  // 다시 부르면 탭 목록이 통째로 새로 그려져 방금 붙인 onclick도 다시 붙어야 해서 낭비다.
  function renderDrawer_tabsOnly(){
    var tabHost = document.getElementById("drTabs");
    tabHost.querySelectorAll("[data-tab]").forEach(function(b){
      var on = b.dataset.tab === DRAWER.activeTab;
      b.classList.toggle("on", on);
      b.setAttribute("aria-selected", on ? "true" : "false");
    });
  }

  function renderDrawerBody(){
    var host = document.getElementById("drBody"); if(!host) return;
    var d = DRAWER.data;
    if(DRAWER.activeTab==="basic") host.innerHTML = basicTabHtml(d);
    else if(DRAWER.activeTab==="spec") host.innerHTML = specTabHtml(d);
    else if(DRAWER.activeTab==="supplier") host.innerHTML = supplierTabHtml(d);
    else host.innerHTML = partTypeTabHtml(d);
    wireDrawerBody();
  }

  // supplier(공급처 원문)는 products의 자유 텍스트 한 칸이다 — [공급처] 탭의
  // 공급처별 매입가 표(product_supplier_prices)와는 다른 값이라 라벨을 "(원문)"으로
  // 구분한다(둘을 같은 자리에 나란히 두면 헷갈린다 — 합치지 않는다).
  // 요청 37(2026-09-01) — 상품코드·SKU 를 뺀 나머지를 고칠 수 있게 넓혔다.
  // 뒤 셋(모델명·다나와 코드·시장가)은 그동안 읽기 전용이라 아래 infoRows 에만
  // 있었다 — 편집으로 옮기면서 «두 곳에 같은 값이 뜨지 않도록» infoRows 에서 뺀다.
  // ⚠ 시장가는 검수 승인 경로(admin_reviews.PRODUCT_FIELD_CAST)도 건드리는 값이다.
  //   여기서 고치면 잠기고, 그 뒤로는 적재도 검수도 덮지 않는다.
  var BASIC_FIELDS = [
    ["name","상품명","text","product_name"], ["maker","제조사","text","maker"],
    ["supplier","공급처(원문)","text","supplier"],
    ["sale_price","판매가","number","sale_price"], ["purchase_price","매입가","number","purchase_price"],
    ["stock_qty","재고","number","stock_qty"], ["status","상태","select","status"],
    ["model_name","모델명","text","model_name"],
    ["danawa_code","다나와 코드","text","danawa_code"],
    ["market_price","시장가","number","market_price"]
  ];
  function basicTabHtml(d){
    var editing = DRAWER.editing.basic;
    // 편집 중 값은 DRAWER.editDraft.basic 버퍼에서 온다(결함 ⓐ-2) — 이 편집 회차에서
    // 처음 그리는 것이면(버퍼가 비어 있으면) 서버 값으로 한 번 채운다. 탭을 옮겼다
    // 돌아와도 이 버퍼가 그대로라 입력하던 값이 안 사라진다.
    if(editing && !DRAWER.editDraft.basic){
      DRAWER.editDraft.basic = {};
      BASIC_FIELDS.forEach(function(f){ DRAWER.editDraft.basic[f[0]] = d[f[0]]; });
    }
    var draft = DRAWER.editDraft.basic;
    var locked = d.locked_fields || [];
    var rows = BASIC_FIELDS.map(function(f){
      var key=f[0], label=f[1], type=f[2], col=f[3];
      var raw = editing ? draft[key] : d[key];
      var lockMark = locked.indexOf(col)>=0 ? '<span class="lock" title="잠김 — 다음 적재가 덮지 않습니다">🔒 잠김</span>' : "";
      var valHtml;
      if(editing){
        if(type==="select"){
          valHtml = '<select data-f="' + key + '">' + (d.status_options||[]).map(function(o){
            return '<option value="' + esc(o) + '"' + (o===raw?" selected":"") + '>' + esc(o) + '</option>'; }).join("") + '</select>';
        } else if(type==="number"){
          valHtml = '<input type="number" data-f="' + key + '" value="' + (raw==null?"":raw) + '" min="0">';
        } else {
          var ph = key==="supplier" ? ' placeholder="공급처 원문(선택)"' : '';
          valHtml = '<input type="text" data-f="' + key + '" value="' + esc(raw==null?"":raw) + '"' + ph + '>';
        }
      } else {
        if(key==="sale_price" || key==="purchase_price") valHtml = '<span class="val' + (raw==null?" dim":"") + '">' + fmtWon(raw) + '</span>';
        else if(key==="stock_qty") valHtml = '<span class="val">' + (raw==null?0:raw) + '개</span>';
        // 읽기 전용 표시만 태그를 벗긴다(name·supplier 등 — 몰 원문에 <font>가 섞일 수
        // 있다). 위 편집(editing) 분기의 <input value=...>는 원본 그대로 둔다 —
        // 고치지 않고 저장해도 DB가 조용히 바뀌면 안 되기 때문이다.
        else valHtml = '<span class="val' + (raw==null||raw===""?" dim":"") + '">' + esc(raw==null||raw===""?"—":Admin2Text.stripHtml(raw)) + '</span>';
      }
      // supplier는 [공급처] 탭(product_supplier_prices, 구조화된 매입가 표)과 다른
      // 값이다 — 라벨 옆 물음표 없이도 구분되게 title 툴팁으로 근거를 남긴다.
      var lbTitle = key==="supplier" ? ' title="몰 CSV 원문 값 — [공급처] 탭의 매입가 표와는 다른 필드입니다"' : '';
      return '<div class="pp-field"><span class="lb"' + lbTitle + '>' + label + '</span>' + valHtml + '<span class="lock">' + lockMark + '</span></div>';
    }).join("");

    var gate = d.gate || [];
    var gateHtml = '<div class="pp-gate"><div class="pp-gate-note">' + esc(d.gate_note||"") + '</div>'
      + '<div class="pp-gate-list">' + gate.map(function(g){
          return '<div class="pp-gate-item ' + (g.ok?"ok":"bad") + '"><span class="pp-gate-dot"></span>'
            + '<span class="k">' + esc(g.label) + '</span><span class="v">' + esc(g.value) + '</span></div>';
        }).join("") + '</div></div>';

    // 모델명·다나와 코드·시장가는 위 BASIC_FIELDS 로 «옮겼다»(요청 37) — 여기 남겨
    // 두면 같은 값이 한 탭에 두 번 뜨고, 하나는 고쳐지는데 하나는 안 고쳐져
    // 어느 쪽이 진짜인지 알 수 없게 된다.
    var infoRows = [
      ["데이터 출처", d.origin==="real"?"실데이터":(d.origin==="demo"?"데모":(d.origin||"—"))],
      ["사양 원문", d.spec_source_text||"—"],
      ["등록일", fmtDate(d.created_at)],
      ["수정일", fmtDate(d.updated_at)]
    ].map(function(r){
      // "사양 원문"(spec_source_text)에 몰 HTML 태그가 섞일 수 있다 — 읽기 전용 정보이므로
      // 표시 직전에 벗긴다(다른 행은 이미 가공된 값이라 영향 없음).
      return '<div class="pp-field"><span class="lb">' + r[0] + '</span><span class="val dim">' + esc(Admin2Text.stripHtml(r[1])) + '</span><span></span></div>';
    }).join("");

    return gateHtml + rows + infoRows + '<div class="pp-dr-hint">' + (editing
      ? "고친 필드는 저장하면 잠깁니다 — 다음 적재가 덮어쓰지 않습니다."
      : "읽기 전용입니다. [수정]을 누르면 이 탭이 그 자리에서 편집으로 바뀌고, 저장하면 읽기로 복귀합니다.") + '</div>';
  }

  function specValText(f, v){
    if(v==null || v==="") return "—";
    if(f.data_type==="BOOLEAN") return (v===true || v==="true") ? "예" : "아니오";
    if(f.data_type==="JSONB") return Array.isArray(v) ? v.join(", ") : String(v);
    return String(v) + (f.unit ? " " + f.unit : "");
  }
  // [data-sf] 입력 요소 → 저장용 타입 변환. 저장(onDrSaveClick)과 편집 버퍼 동기화
  // (결함 ⓐ-2)가 같은 규칙을 써야 다시 그렸을 때 값이 안 바뀐다.
  function specElValue(el){
    var v = el.value;
    if(el.dataset.json){ return v.trim() ? v.split(",").map(function(s){ return s.trim(); }).filter(Boolean) : null; }
    if(el.tagName==="SELECT"){ return v===""? null : (v==="true"); }
    if(el.type==="number"){ return v===""? null : Number(v); }
    return v===""? null : v;
  }
  function specTabHtml(d){
    var editing = DRAWER.editing.spec;
    var fields = fieldsForPartType(d.part_type);
    var specs = d.specs || {};
    var locked = d.locked_fields || [];
    if(!fields.length) return '<div class="pp-empty">이 분류에 등록된 사양 항목이 없습니다.</div>';
    // 기본 정보 탭과 같은 이유로 편집 버퍼를 쓴다(결함 ⓐ-2) — 이 편집 회차 첫 렌더면
    // 서버 값으로 채운다.
    if(editing && !DRAWER.editDraft.spec){
      DRAWER.editDraft.spec = {};
      fields.forEach(function(f){ DRAWER.editDraft.spec[f.field_key] = specs[f.field_key]; });
    }
    var draft = DRAWER.editDraft.spec;
    var head = '<div class="pp-dr-hint">필수 사양 ' + d.spec_done + '/' + d.spec_total + '</div>';
    var rows = fields.map(function(f){
      var v = editing ? draft[f.field_key] : specs[f.field_key];
      var lockMark = locked.indexOf(f.field_key)>=0 ? '<span class="lock" title="잠김">🔒 잠김</span>' : "";
      var reqMark = f.required ? '<span class="pp-badge pp-badge-warn" style="margin-right:5px">필수</span>' : "";
      var valHtml;
      if(editing){
        if(f.data_type==="BOOLEAN"){
          valHtml = '<select data-sf="' + f.field_key + '">'
            + '<option value=""' + (v==null?" selected":"") + '>—</option>'
            + '<option value="true"' + (v===true?" selected":"") + '>예</option>'
            + '<option value="false"' + (v===false?" selected":"") + '>아니오</option></select>';
        } else if(f.data_type==="JSONB"){
          valHtml = '<input type="text" data-sf="' + f.field_key + '" data-json="1" value="' + esc(Array.isArray(v)?v.join(", "):(v||"")) + '" placeholder="쉼표로 구분 — 예: AM4, AM5">';
        } else if(f.data_type==="INTEGER" || f.data_type==="NUMERIC"){
          valHtml = '<input type="number" data-sf="' + f.field_key + '" value="' + (v==null?"":v) + '"' + (f.data_type==="NUMERIC"?' step="0.1"':'') + '>';
        } else {
          valHtml = '<input type="text" data-sf="' + f.field_key + '" value="' + esc(v==null?"":v) + '">';
        }
      } else {
        valHtml = '<span class="val' + (v==null?" dim":"") + '">' + reqMark + esc(specValText(f,v)) + '</span>';
      }
      return '<div class="pp-field"><span class="lb">' + esc(f.label) + '</span>' + valHtml + '<span class="lock">' + lockMark + '</span></div>';
    }).join("");
    // ── 사양을 채울 «근거»를 같은 화면에 둔다 (요청 38 · 2026-09-01) ─────────
    //   사양 값은 상품명·사양 원문을 읽어서 넣는데, 그것이 [기본 정보] 탭에만 있어
    //   운영자가 탭을 오가며 외워 옮겨야 했다 — 그 사이에 값을 잘못 옮기면
    //   «지어낸 사양»이 정본에 들어간다(A-18 이 막으려는 바로 그것).
    //   ⚠ 읽기 전용이다. 여기서 고치게 하지 않는다 — 기본 정보는 [기본 정보] 탭이
    //     단일 원천이고, 두 자리에서 고치면 어느 쪽이 맞는지 알 수 없게 된다.
    //   ⚠ 값을 지어내지 않는다: 빈 값은 «—» 로 두고 채워진 척하지 않는다.
    var srcRows = [
      ["상품명", d.name || "—"],
      ["제조사", d.maker || "—"],
      ["모델명", d.model_name || "—"],
      ["사양 원문", d.spec_source_text || "—"]
    ].map(function (r) {
      // 사양 원문에 몰 HTML 태그가 섞여 온다 — 기본 정보 탭과 «같은» 함수로 벗긴다.
      return '<div class="pp-field"><span class="lb">' + r[0] + '</span>'
        + '<span class="val dim">' + esc(Admin2Text.stripHtml(r[1])) + '</span><span></span></div>';
    }).join("");
    var srcHtml = '<div class="pp-specsrc">'
      + '<div class="pp-specsrc-h">채울 때 보는 값 — 읽기 전용</div>' + srcRows + '</div>';

    return head + rows + srcHtml + '<div class="pp-dr-hint">' + (editing
      ? "값을 저장하면 그 필드가 잠기고, 채워진 필드의 검수 대기가 함께 해소됩니다."
      : "읽기 전용입니다. [수정]으로 이 부품 종류에서 쓰는 사양을 채웁니다.") + '</div>';
  }

  // 공급처 한 행 + (펼치면) 연락처·리베이트 줄. 연락처·발주번호를 표 칸에 다 펼치면
  // 넘친다(열이 이미 7개) — 그래서 "상세" 토글로 뺐다(2026-08-26 A-114 후속, 판단은
  // 제작자가 함 — 지시서가 방식을 명시하지 않고 판단하라고 남겼다).
  function supplierRowHtml(s, editing){
    var oos = (s.state && s.state !== "가능");   // 품절·문의 — "가능"만 실제 구매 가능
    // 리베이트는 "값이 있을 때만" — 실측 대부분이 0(2026-08-26 확인, rebate_price
    // 전량 0)이라 0/null을 똑같이 "없음"으로 본다. 0을 보여주면 "리베이트 0원"이라는
    // 없는 사실을 지어내는 것과 같다.
    var hasRebate = (s.rebate_pct != null && s.rebate_pct !== 0)
      || (s.rebate_price != null && s.rebate_price !== 0);
    var hasDetail = !!(s.contact_name || s.contact_phone || s.order_phone || hasRebate);
    var expanded = hasDetail && !!DRAWER.supExpanded[s.psp_id];
    var timeTxt = s.fetched_at ? ("몰 " + fmtDateShort(s.fetched_at))
      : (s.at ? ("갱신 " + fmtDateShort(s.at)) : "—");
    var timeTitle = s.fetched_at ? ("몰 수집 " + fmtDate(s.fetched_at))
      : (s.at ? ("마지막 갱신 " + fmtDate(s.at)) : "");
    var nameCell = esc(s.supplier)
      + (oos ? ('<span class="pp-badge pp-badge-bad pp-sup-badge-oos">' + esc(s.state) + '</span>') : "");
    var toggleCell = hasDetail
      ? ('<button type="button" class="pp-sup-toggle" data-sup-toggle="' + s.psp_id + '"'
         + ' aria-expanded="' + (expanded ? "true" : "false") + '" title="연락처·리베이트 보기">'
         + (expanded ? "▾" : "▸") + '</button>')
      : "";
    var row = '<div class="pp-sup-row' + (oos ? " oos" : "") + '">'
      + '<span class="pp-sup-rank">' + fmtRank(s.mall_rank) + '</span>'
      + '<span>' + nameCell + '</span>'
      + '<span class="pp-right">' + fmtWon(s.cost_price) + '</span>'
      + '<span>' + esc(s.state || "—") + '</span>'
      + '<span class="pp-dim-text" title="' + esc(timeTitle) + '">' + esc(timeTxt) + '</span>'
      + '<span>' + toggleCell + '</span>'
      + '<span>' + (editing ? ('<button type="button" class="pp-row-del" data-del-sup="' + s.supplier_id + '">삭제</button>') : "") + '</span>'
      + '</div>';
    if(!expanded) return row;
    var parts = [
      "담당자 " + (s.contact_name ? esc(s.contact_name) : "—"),
      "전화 " + (s.contact_phone ? esc(s.contact_phone) : "—"),
      "발주번호 " + (s.order_phone ? esc(s.order_phone) : "—")
    ];
    var rebateParts = [];
    if(s.rebate_pct != null && s.rebate_pct !== 0) rebateParts.push(s.rebate_pct + "%");
    if(s.rebate_price != null && s.rebate_price !== 0) rebateParts.push(fmtWon(s.rebate_price));
    var detail = parts.join(" · ")
      + (rebateParts.length ? (' · 리베이트 <b>' + rebateParts.join(" · ") + '</b>') : "")
      + (s.contact_fetched_at ? (' · 연락처 확인 ' + fmtDateShort(s.contact_fetched_at)) : "");
    return row + '<div class="pp-sup-detail">' + detail + '</div>';
  }

  function supplierTabHtml(d){
    var editing = DRAWER.editing.supplier;
    var sups = d.suppliers || [];
    // "살 수 있는 최저가" — 서버가 이미 품절·문의를 뺀 값을 골라 준다(cheapest_available).
    // 화면은 그 값을 그대로 쓴다 — 여기서 sups를 다시 훑어 최저가를 만들지 않는다.
    var banner = "";
    if(sups.length){
      banner = d.cheapest_available
        ? ('<div class="pp-sup-banner">살 수 있는 최저가 <b>' + fmtWon(d.cheapest_available.cost_price)
           + '</b> <span class="pp-dim-text">(' + esc(d.cheapest_available.supplier) + ')</span></div>')
        : ('<div class="pp-sup-banner warn">판매 가능한 공급처가 없습니다 — 아래 가격은 전부 품절·문의 상태입니다.</div>');
    }
    var rows = '<div class="pp-sup-row head"><span>순위</span><span>공급처</span><span class="pp-right">매입가</span>'
        + '<span>상태</span><span>잰 시각</span><span></span><span></span></div>'
      + (sups.length ? sups.map(function(s){ return supplierRowHtml(s, editing); }).join("")
         : '<div class="pp-empty" style="padding:20px 0">등록된 공급처가 없습니다.</div>');
    var addForm = editing ? (
        '<div class="pp-sup-add">'
        + '<label class="visually-hidden" for="supAddSel">공급처 선택</label><select id="supAddSel" aria-label="공급처 선택"></select>'
        + '<label class="visually-hidden" for="supAddCost">매입가</label><input id="supAddCost" type="number" min="0" placeholder="매입가" style="width:110px">'
        + '<label class="visually-hidden" for="supAddState">공급 상태</label><select id="supAddState" aria-label="공급 상태"><option value="가능">가능</option><option value="품절">품절</option></select>'
        + '<button type="button" class="pp-btn-line" id="btnSupAdd">추가</button>'
        + '</div>'
      ) : "";
    return banner + rows + addForm + '<div class="pp-dr-hint">' + (editing
      ? "같은 공급처를 다시 추가하면 매입가가 갱신됩니다. 순위·리베이트·연락처는 몰 수집 도구가 채웁니다(이 화면에서 입력하지 않습니다)."
      : "읽기 전용입니다. [수정]으로 매입가를 추가·삭제합니다. ▸는 연락처·리베이트를 펼칩니다. 몰 순위·가격은 매일 바뀔 수 있습니다.") + '</div>';
  }

  function partTypeTabHtml(d){
    var editing = DRAWER.editing.parttype;
    if(!editing){
      return '<div class="pp-field"><span class="lb">현재 분류</span><span class="val">' + esc(d.cat) + '</span><span></span></div>'
        + '<div class="pp-dr-hint">[수정]으로 분류를 바꿉니다. 바꾸기 전에 영향(필요 사양·추천 후보 변화)을 먼저 보여줍니다.</div>';
    }
    var treeHtml = '<div class="pp-field"><span class="lb">새 분류</span><span id="ptChoiceHost"></span><span></span></div>';
    var previewHtml = "";
    if(DRAWER.partPreview){
      var im = DRAWER.partPreview.impact;
      var addList = (im.required_add && im.required_add.length) ? im.required_add.map(specLabel).join(", ") : null;
      var dropList = (im.required_drop && im.required_drop.length) ? im.required_drop.map(specLabel).join(", ") : null;
      previewHtml = '<div class="pp-impact"><b>' + esc(im.from.label) + ' → ' + esc(im.to.label) + '</b><br>' + esc(im.note)
        + (addList ? ('<br>새로 필요한 사양: ' + esc(addList)) : "")
        + (dropList ? ('<br>더는 쓰지 않는 사양: ' + esc(dropList)) : "")
        + '</div>';
    }
    return treeHtml + previewHtml;
  }

  function wireDrawerBody(){
    // 편집 버퍼 동기화(결함 ⓐ-2) — 타이핑·선택할 때마다 버퍼를 갱신해 둬야
    // 다른 탭을 봤다 돌아와도 그 값으로 다시 그릴 수 있다.
    if(DRAWER.activeTab==="basic" && DRAWER.editing.basic){
      document.querySelectorAll("#drBody [data-f]").forEach(function(el){
        var sync = function(){ if(DRAWER.editDraft.basic) DRAWER.editDraft.basic[el.dataset.f] = el.value; };
        el.addEventListener("input", sync);
        el.addEventListener("change", sync);
      });
    }
    if(DRAWER.activeTab==="spec" && DRAWER.editing.spec){
      document.querySelectorAll("#drBody [data-sf]").forEach(function(el){
        var sync = function(){ if(DRAWER.editDraft.spec) DRAWER.editDraft.spec[el.dataset.sf] = specElValue(el); };
        el.addEventListener("input", sync);
        el.addEventListener("change", sync);
      });
    }
    if(DRAWER.activeTab==="parttype" && DRAWER.editing.parttype){
      var host = document.getElementById("ptChoiceHost");
      if(host) buildChoiceSelect(host, (META && META.all_choices) || [], DRAWER.partSel || DRAWER.data.part_type,
        function(pt){ DRAWER.partSel = pt; });
    }
    if(DRAWER.activeTab==="supplier"){
      // 연락처·리베이트 펼침 토글 — 읽기 모드에서도 동작한다(편집과 무관, 발주 때
      // 조회만 하는 경우가 더 흔하다).
      document.querySelectorAll("#drBody [data-sup-toggle]").forEach(function(b){
        b.onclick = function(){
          var id = b.dataset.supToggle;
          DRAWER.supExpanded[id] = !DRAWER.supExpanded[id];
          renderDrawerBody();
        };
      });
    }
    if(DRAWER.activeTab==="supplier" && DRAWER.editing.supplier){
      var sel = document.getElementById("supAddSel");
      if(sel){
        var actives = (SUPPLIERS||[]).filter(function(s){ return s.status==="활성"; });
        sel.innerHTML = actives.length ? actives.map(function(s){ return '<option value="' + s.id + '">' + esc(s.name) + '</option>'; }).join("")
          : '<option value="">활성 공급처가 없습니다</option>';
      }
      var btn = document.getElementById("btnSupAdd");
      if(btn) btn.onclick = supplierAdd;
      document.querySelectorAll("#drBody [data-del-sup]").forEach(function(b){
        b.onclick = function(){ supplierDelete(b.dataset.delSup, b); };
      });
    }
  }

  function renderDrawerFooter(){
    var host = document.getElementById("drFoot"); if(!host) return;
    var d = DRAWER.data, tab = DRAWER.activeTab;
    // 배지와 같은 신호를 쓴다(결함 ⓐ-3) — review_pending>0만 보면, 검수행이 아직
    // 없는 신규 등록·검수행이 재오픈 안 된 되돌리기 케이스에서 이 바로가기가
    // 정작 필요할 때 사라진다.
    var reviewBtn = (d.status_key === "review") ? '<a class="pp-btn-line" href="/admin2/reviews">검수 큐로 →</a>' : "";
    var note="", buttons="";
    // 결함 5건 수정(2026-09-11) — 서랍 내 인라인 오류. 지금 보고 있는 탭에 해당하는
    // 실패만 보여준다(다른 탭에서 난 지난 실패가 여기로 새지 않는다).
    var errHtml = DRAWER.err[tab] ? ('<div class="pp-dr-err" role="alert">' + esc(DRAWER.err[tab]) + '</div>') : "";
    if(tab==="basic" || tab==="spec"){
      if(DRAWER.editing[tab]){
        var busy = !!DRAWER.saveBusy;
        note = busy ? "저장하는 중입니다…" : "고친 값은 저장 후 잠깁니다.";
        buttons = '<button type="button" class="pp-btn-line" id="drCancel"'
            + (busy ? ' disabled title="저장하는 중입니다"' : '') + '>취소</button>'
          + '<button type="button" class="pp-btn-primary" id="drSave"'
            + (busy ? ' disabled title="저장하는 중입니다"' : '') + '>저장</button>';
      } else {
        note = "검수 승인·반려는 상품 사양 검수 소관";
        buttons = '<button type="button" class="pp-btn-primary" id="drEdit">수정</button>';
      }
    } else if(tab==="supplier"){
      var supBusy = !!DRAWER.saveBusy || DRAWER.delBusyId!=null;
      note = supBusy ? "처리하는 중입니다…" : "공급처별 매입가는 등록·삭제가 즉시 반영됩니다.";
      buttons = DRAWER.editing.supplier
        ? ('<button type="button" class="pp-btn-primary" id="drEdit"'
            + (supBusy ? ' disabled title="처리하는 중입니다"' : '') + '>완료</button>')
        : '<button type="button" class="pp-btn-primary" id="drEdit">수정</button>';
    } else {
      if(!DRAWER.editing.parttype){
        note = "분류 변경은 영향을 먼저 보여준 뒤 확정합니다.";
        buttons = '<button type="button" class="pp-btn-primary" id="drEdit">수정</button>';
      } else if(!DRAWER.partPreview){
        var pBusy = !!DRAWER.previewBusy;
        note = "새 분류를 고르고 미리보기를 확인하세요.";
        // preview:true 요청엔 공용 배너가 안 뜬다 — 클릭 즉시 버튼을 비활성하고
        // 인라인 "미리보기 중…"을 낸다(결함 ⓐ-4). 저장류(preview:false)는 배너가
        // 그대로 뜨므로 여기서 손대지 않는다.
        buttons = '<button type="button" class="pp-btn-line" id="drCancel"'
            + (pBusy ? ' disabled title="요청을 처리하는 중입니다"' : '') + '>취소</button>'
          + '<button type="button" class="pp-btn-primary" id="drPreview"'
            + (pBusy ? ' disabled title="요청을 처리하는 중입니다"' : '') + '>미리보기</button>'
          + (pBusy ? '<span class="pp-inline-busy" role="status" aria-live="polite">'
                     + '<span class="pp-inline-busy-sp"></span>미리보기 중…</span>' : '');
      } else {
        var cBusy = !!DRAWER.saveBusy;
        note = cBusy ? "확정하는 중입니다…" : "확정하면 분류가 즉시 바뀝니다.";
        buttons = '<button type="button" class="pp-btn-line" id="drReselect"'
            + (cBusy ? ' disabled title="확정하는 중입니다"' : '') + '>다시 선택</button>'
          + '<button type="button" class="pp-btn-primary" id="drConfirm"'
            + (cBusy ? ' disabled title="확정하는 중입니다"' : '') + '>확정 변경</button>';
      }
    }
    host.innerHTML = errHtml + '<span class="note">' + esc(note) + '</span>' + reviewBtn + buttons;
    var e;
    if((e=document.getElementById("drEdit"))) e.onclick=onDrEditClick;
    if((e=document.getElementById("drCancel"))) e.onclick=onDrCancelClick;
    if((e=document.getElementById("drSave"))) e.onclick=onDrSaveClick;
    if((e=document.getElementById("drPreview"))) e.onclick=onDrPreviewClick;
    if((e=document.getElementById("drReselect"))) e.onclick=function(){ DRAWER.partPreview=null; renderDrawerBody(); renderDrawerFooter(); };
    if((e=document.getElementById("drConfirm"))) e.onclick=onDrConfirmClick;
  }

  function onDrEditClick(){
    var tab = DRAWER.activeTab;
    DRAWER.err[tab] = null;   // 결함 5건 수정 — 새 편집 회차를 시작하면 지난 실패 표시를 지운다
    if(tab==="supplier" && DRAWER.editing.supplier){ DRAWER.editing.supplier=false; }
    else {
      DRAWER.editing[tab]=true;
      if(tab==="parttype"){ DRAWER.partSel=null; DRAWER.partPreview=null; DRAWER.previewBusy=false; }
      // 새로 시작하는 편집은 항상 최신 서버 값에서 — 이전 편집을 취소하고 다시
      // 열었을 때 옛 버퍼가 남아 있으면 안 된다(결함 ⓐ-2).
      if(tab==="basic" || tab==="spec"){ DRAWER.editDraft[tab] = null; }
    }
    renderDrawerBody(); renderDrawerFooter();
  }
  function onDrCancelClick(){
    var tab = DRAWER.activeTab;
    DRAWER.editing[tab] = false;
    DRAWER.err[tab] = null;   // 결함 5건 수정 — 취소하면 그 탭의 지난 실패 표시도 지운다
    if(tab==="parttype"){ DRAWER.partSel=null; DRAWER.partPreview=null; DRAWER.previewBusy=false; }
    // 취소는 서버 값으로 되돌아간다는 뜻 — 편집 버퍼도 함께 비운다(결함 ⓐ-2).
    if(tab==="basic" || tab==="spec"){ DRAWER.editDraft[tab] = null; }
    renderDrawerBody(); renderDrawerFooter();
  }

  function collectBasicChanges(){
    var out = {};
    document.querySelectorAll("#drBody [data-f]").forEach(function(el){
      var k=el.dataset.f, v=el.value;
      if(k==="sale_price" || k==="purchase_price"){ out[k] = v===""? "" : Number(v); }
      else if(k==="stock_qty"){ out[k] = v===""? 0 : Number(v); }
      else { out[k]=v; }
    });
    return out;
  }
  // 실패 시 전역 진행 바(ui-progress.js)가 배너로 사유를 잠깐 보여주지만, 서랍 자체
  // 안에는 아무 표시가 없어 저장 버튼이 눌린 채로 굳는 결함이 있었다(확인자 실측,
  // 2026-09-11). 다섯 지점(이 함수의 두 분기 + onDrConfirmClick·supplierAdd·
  // supplierDelete) 전부 같은 모양으로 고친다: (a) 실패해도 editing 상태를 false로
  // 만들지 않는다(재시도 가능) (b) renderDrawerFooter()로 버튼을 반드시 되살린다
  // (c) DRAWER.err로 서랍 안에 사유를 남긴다 — 배너를 놓쳐도 서랍만 보면 안다.
  function onDrSaveClick(){
    var tab = DRAWER.activeTab, code = DRAWER.code;
    if(tab!=="basic" && tab!=="spec") return;
    if(DRAWER.saveBusy) return;   // 중복 클릭 — 이미 요청 중
    DRAWER.saveBusy = true; DRAWER.err[tab] = null;
    renderDrawerFooter();
    if(tab==="basic"){
      fetch(API + "/products/" + encodeURIComponent(code), {method:"PATCH", headers:{"Content-Type":"application/json"},
        body: JSON.stringify({changes: collectBasicChanges(), lock:true})})
        .then(asJson).then(function(res){
          DRAWER.saveBusy = false;
          if(!res.ok){
            DRAWER.err.basic = "저장 실패 — " + errText(res.j, res.status);
            renderDrawerFooter();
            return;
          }
          DRAWER.editing.basic=false;
          DRAWER.editDraft.basic=null;   // 저장 성공 — 다음 편집은 새 서버 값에서(결함 ⓐ-2)
          fetchDrawerData(); load();
        }).catch(function(){
          DRAWER.saveBusy = false;
          DRAWER.err.basic = "저장 실패 — 서버에 닿지 못했습니다(네트워크)";
          renderDrawerFooter();
        });
    } else if(tab==="spec"){
      var values = {};
      document.querySelectorAll("#drBody [data-sf]").forEach(function(el){ values[el.dataset.sf] = specElValue(el); });
      fetch(API + "/products/" + encodeURIComponent(code) + "/specs", {method:"PATCH", headers:{"Content-Type":"application/json"},
        body: JSON.stringify({values:values, lock:true})})
        .then(asJson).then(function(res){
          DRAWER.saveBusy = false;
          if(!res.ok){
            DRAWER.err.spec = "저장 실패 — " + errText(res.j, res.status);
            renderDrawerFooter();
            return;
          }
          DRAWER.editing.spec=false;
          DRAWER.editDraft.spec=null;    // 저장 성공 — 다음 편집은 새 서버 값에서(결함 ⓐ-2)
          fetchDrawerData(); load();
        }).catch(function(){
          DRAWER.saveBusy = false;
          DRAWER.err.spec = "저장 실패 — 서버에 닿지 못했습니다(네트워크)";
          renderDrawerFooter();
        });
    }
  }
  function onDrPreviewClick(){
    if(!DRAWER.partSel){ window.alert("분류를 선택하세요"); return; }
    if(DRAWER.previewBusy) return;   // 중복 클릭 — 이미 요청 중
    // preview:true 요청엔 공용 진행 배너가 안 뜬다(ui-progress.js가 본문을 읽고
    // 스스로 제외 — ㉯ 확정 2026-08-15). 그래서 응답을 기다리지 않고 클릭 즉시
    // 이 화면이 직접 버튼을 비활성하고 인라인 "미리보기 중…"을 그린다(결함 ⓐ-4).
    // v_recommendation_candidates를 두 번 훑는 요청이라 몇 초 걸릴 수 있는데,
    // 아무 반응이 없으면 운영자가 다시 누르거나 "안 된다"고 신고하게 된다.
    DRAWER.previewBusy = true;
    renderDrawerFooter();
    fetch(API + "/products/" + encodeURIComponent(DRAWER.code) + "/part-type", {method:"POST",
      headers:{"Content-Type":"application/json"}, body: JSON.stringify({part_type:DRAWER.partSel, preview:true})})
      .then(asJson).then(function(res){
        DRAWER.previewBusy = false;
        // preview:true는 성공이든 실패든 전역 배너 대상이 아니다 — 여기서 새 실패
        // 표시를 만들지는 않는다(이 화면의 다른 쓰기 동작과 같은 관례: 되풀이하지
        // 않는다). 버튼을 다시 누를 수 있는 상태로 되돌리는 것까지가 ⓐ-4의 범위다.
        if(!res.ok){ renderDrawerFooter(); return; }
        DRAWER.partPreview = res.j;
        renderDrawerBody(); renderDrawerFooter();
      }).catch(function(){ DRAWER.previewBusy = false; renderDrawerFooter(); });
  }
  function onDrConfirmClick(){
    if(DRAWER.saveBusy) return;   // 중복 클릭 — 이미 요청 중
    DRAWER.saveBusy = true; DRAWER.err.parttype = null;
    renderDrawerFooter();
    fetch(API + "/products/" + encodeURIComponent(DRAWER.code) + "/part-type", {method:"POST",
      headers:{"Content-Type":"application/json"}, body: JSON.stringify({part_type:DRAWER.partSel, preview:false})})
      .then(asJson).then(function(res){
        DRAWER.saveBusy = false;
        if(!res.ok){
          // 실패 — 미리보기(partPreview)·선택(partSel)을 그대로 둔다: 다시
          // [확정 변경]을 누를 수 있어야 한다(결함 5건 수정).
          DRAWER.err.parttype = "확정 실패 — " + errText(res.j, res.status);
          renderDrawerFooter();
          return;
        }
        DRAWER.editing.parttype=false; DRAWER.partPreview=null; DRAWER.partSel=null;
        fetchDrawerData(); load();
      }).catch(function(){
        DRAWER.saveBusy = false;
        DRAWER.err.parttype = "확정 실패 — 서버에 닿지 못했습니다(네트워크)";
        renderDrawerFooter();
      });
  }
  function supplierAdd(){
    var sel=document.getElementById("supAddSel"), cost=document.getElementById("supAddCost"), st=document.getElementById("supAddState");
    if(!sel || !sel.value){ window.alert("공급처를 고르세요"); return; }
    if(!cost || cost.value===""){ window.alert("매입가를 입력하세요"); return; }
    if(DRAWER.saveBusy || DRAWER.delBusyId!=null) return;   // 다른 쓰기가 이미 진행 중
    DRAWER.saveBusy = true; DRAWER.err.supplier = null;
    // 버튼만 직접 비활성화한다 — renderDrawerBody()를 다시 부르면 addForm이 통째로
    // 새로 그려져 방금 고른 공급처·입력한 매입가가 지워진다(결함 5건 수정 중 새로
    // 만들지 않을 부작용). renderDrawerFooter()는 인라인 오류 자리를 갱신한다.
    var btn = document.getElementById("btnSupAdd");
    if(btn){ btn.disabled = true; btn.title = "추가하는 중입니다"; }
    renderDrawerFooter();
    fetch(API + "/products/" + encodeURIComponent(DRAWER.code) + "/suppliers", {method:"POST",
      headers:{"Content-Type":"application/json"},
      body: JSON.stringify({supplier_id:Number(sel.value), cost_price:Number(cost.value), state:st.value})})
      .then(asJson).then(function(res){
        DRAWER.saveBusy = false;
        if(!res.ok){
          // 실패 — 공급처 편집 상태·입력값을 그대로 둔다(재시도 가능, 결함 5건 수정).
          var b = document.getElementById("btnSupAdd");
          if(b){ b.disabled = false; b.title = ""; }
          DRAWER.err.supplier = "공급처 추가 실패 — " + errText(res.j, res.status);
          renderDrawerFooter();
          return;
        }
        fetchDrawerData(); load();
      }).catch(function(){
        DRAWER.saveBusy = false;
        var b = document.getElementById("btnSupAdd");
        if(b){ b.disabled = false; b.title = ""; }
        DRAWER.err.supplier = "공급처 추가 실패 — 서버에 닿지 못했습니다(네트워크)";
        renderDrawerFooter();
      });
  }
  function supplierDelete(supplierId, btn){
    if(!window.confirm("이 공급처 매입가를 삭제할까요?")) return;
    if(DRAWER.saveBusy || DRAWER.delBusyId!=null) return;   // 다른 쓰기가 이미 진행 중
    DRAWER.delBusyId = supplierId; DRAWER.err.supplier = null;
    // 이 행의 삭제 버튼만 직접 비활성화한다 — body를 다시 그리면 행 목록 전체가
    // 새로 그려져도 상관없을 것 같지만, 아직 응답 전이라 행이 그대로 있어야
    // 「실패해도 그 자리에서 다시 누를 수 있다」가 성립한다(결함 5건 수정).
    if(btn){ btn.disabled = true; btn.title = "삭제하는 중입니다"; }
    renderDrawerFooter();
    fetch(API + "/products/" + encodeURIComponent(DRAWER.code) + "/suppliers/" + encodeURIComponent(supplierId), {method:"DELETE"})
      .then(asJson).then(function(res){
        DRAWER.delBusyId = null;
        if(!res.ok){
          // 실패 — 행을 지우지 않고 그대로 둔다(재시도 가능, 결함 5건 수정).
          if(btn){ btn.disabled = false; btn.title = ""; }
          DRAWER.err.supplier = "공급처 삭제 실패 — " + errText(res.j, res.status);
          renderDrawerFooter();
          return;
        }
        fetchDrawerData();
      }).catch(function(){
        DRAWER.delBusyId = null;
        if(btn){ btn.disabled = false; btn.title = ""; }
        DRAWER.err.supplier = "공급처 삭제 실패 — 서버에 닿지 못했습니다(네트워크)";
        renderDrawerFooter();
      });
  }

  /* ══════════════════════ 초기 배선(한 번만) ══════════════════════ */
  var typing=null, typingM=null;
  document.getElementById("q").addEventListener("input", function(e){
    q = e.target.value.trim();
    clearTimeout(typing);
    typing = setTimeout(function(){ PAGE=1; load(); }, 300);
  });
  document.getElementById("fcat").addEventListener("change", function(e){
    fcat=e.target.value; PAGE=1;
    // 분류가 바뀌면 제조사 선택지를 그 분류 것으로 다시 받는다(요청 36).
    // 이미 고른 제조사가 새 분류에 없으면 결과가 0건이 되므로 함께 푼다 —
    // 화면이 "그 제조사 상품이 없다"고 말하는 대신 필터를 정직하게 되돌린다.
    var pt = (fcat==="all" ? "" : fcat);
    loadMeta(pt).then(function(){
      var mf = document.getElementById("fmfr");
      if(mf && fmfr!=="all" && (!META || (META.makers||[]).indexOf(fmfr)<0)){
        mf.value=""; fmfr="all";
      }
      load();
    });
  });
  document.getElementById("fmfr").addEventListener("input", function(e){
    var v=e.target.value.trim();
    fmfr = v===""? "all" : v;
    clearTimeout(typingM);
    typingM = setTimeout(function(){ PAGE=1; load(); }, 300);
  });
  document.getElementById("catChipClear").addEventListener("click", clearCategoryFilter);
  // 2026-09-10 개편 — 재고상태 필터. "재고 없음"을 고르면 상태 탭과 같은 축(cur="oos")을
  // 그대로 쓴다(위 var 선언부 주석 참조) — 별도 파라미터를 만들지 않는다.
  document.getElementById("fstock").addEventListener("change", function(e){
    var v = e.target.value;
    cur = (v==="oos") ? "oos" : "all";
    PAGE=1; load();
  });
  document.getElementById("btnReset").addEventListener("click", resetFilters);
  document.querySelectorAll("#thead [data-sort]").forEach(function(el){
    function doSort(){
      var k=el.dataset.sort;
      if(sortKey===k) sortDir=-sortDir; else { sortKey=k; sortDir=1; }
      renderTable();
    }
    el.addEventListener("click", doSort);
    el.addEventListener("keydown", function(ev){ if(ev.key==="Enter" || ev.key===" "){ ev.preventDefault(); doSort(); } });
  });
  document.getElementById("chkAll").addEventListener("change", function(ev){
    var on = ev.target.checked;
    applySort(DATA).forEach(function(p){ if(on) SEL[p.product_code]=true; else delete SEL[p.product_code]; });
    renderTable(); syncBulk();
  });
  // #rows 는 매 load()/정렬마다 다시 그려지지만 이 리스너는 #rows(고정 컨테이너)에
  // 한 번만 붙는다 — 위임(delegation)이라 자식이 바뀌어도 다시 붙일 필요가 없다.
  document.getElementById("rows").addEventListener("change", function(ev){
    var cb = ev.target.closest && ev.target.closest(".pp-chk");
    if(!cb) return;
    var pc = cb.dataset.pc;
    if(cb.checked) SEL[pc]=true; else delete SEL[pc];
    syncBulk(); syncHeadCheckbox();
  });
  document.getElementById("rows").addEventListener("click", function(ev){
    var t = ev.target.closest && ev.target.closest("[data-open]");
    if(t) openDrawer(t.dataset.open);
  });
  document.getElementById("btnBulk").addEventListener("click", bulkApply);
  document.getElementById("btnUndo").addEventListener("click", bulkUndo);
  document.getElementById("btnDismissUndo").addEventListener("click", dismissUndo);
  document.getElementById("veil").addEventListener("click", function(){ closeDrawer(); });
  document.getElementById("drClose").addEventListener("click", closeDrawer);
  document.addEventListener("keydown", function(e){
    if(e.key==="Escape"){ closeDrawer(); }
  });

  // 요청 전 상태
  renderAll();
  // 요청 #28 추가(2026-09-02) — load() 가 catId 를 읽기 전에 URL부터 반영해야 한다.
  // renderCatChip()은 이름이 오기 전에도 "분류 #<id>"로 즉시 보여준다(폴백 우선 표시,
  // loadCategoryName()이 끝나면 실제 이름으로 다시 그린다).
  readCategoryFromUrl();
  renderCatChip();
  loadCategoryName();
  loadMeta();
  loadSpecFields();
  loadSuppliers();
  load();
})();
{% endraw %}</script>
{% endblock %}
