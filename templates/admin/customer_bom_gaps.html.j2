{% extends "admin/_admin2_shell.html.j2" %}
{% block title %}고객 화면 부품 정보 확인{% endblock %}
{% block head_extra %}<style>
.bg{display:grid;gap:14px}
.bg-card{background:var(--rv-card);border:1px solid var(--rv-dim4);border-radius:9px;padding:12px}
.bg-card h2{font-size:11pt;margin:0 0 6px}
.bg-card p{margin:4px 0;color:var(--rv-muted);font-size:9.5pt}
.bg-steps{margin:6px 0 0;padding-left:18px;font-size:9.5pt;line-height:1.7}
.bg-bar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:8px 0}
.bg-scroll{overflow-x:auto}
.bg table{width:100%;border-collapse:collapse;font-size:9.5pt}
.bg th,.bg td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--rv-dim4);vertical-align:top}
.bg td small{display:block;color:var(--rv-muted);margin-top:2px}
.bg td.num,.bg th.num{text-align:right;white-space:nowrap}
.bg-state{font-weight:700}
.bg-state[data-kind="operator"]{color:var(--rv-red)}
.bg-state[data-kind="confirmed"]{color:var(--rv-green)}
.bg-confirm{display:flex;gap:4px;flex-wrap:wrap}
.bg-confirm input{width:110px}
@media(max-width:850px){.bg thead{display:none}.bg tr{display:grid;gap:2px;padding:8px 0;border-bottom:1px solid var(--rv-dim4)}.bg td{border:0;padding:0}}
</style>{% endblock %}
{% block content %}
<main class="bg">
<header class="pm-heading"><div><h1>고객 화면 부품 정보 확인</h1>
<p>고객 상세 화면에서 「가격 확인 중」이나 「부품 구성 정보는 아직 연결되지 않았어요」로 보이는 항목입니다. 추측 값으로 채우지 않습니다.</p></div></header>
<section class="bg-card" aria-label="확인 순서"><h2>확인 순서</h2>
<ol class="bg-steps"><li>기존 데이터 — 공급처 표에 「가능」 공급처가 있으면 고객 화면에 가격이 보입니다.</li>
<li>팝콘PC 공개 페이지 — 「팝콘PC에서 다시 확인」을 누르면 손님용 상품 페이지를 읽어, 판매중이고 우리 판매가와 같으면 근거로 남깁니다.</li>
<li>운영자 확인 — 그래도 안 되는 항목은 아래 「운영자 확인 필요」입니다. 팝콘PC에서 직접 확인한 뒤 판매가를 입력해 「확인 완료」를 누르세요. 판매가가 다르면 상품 관리에서 먼저 고칩니다.</li></ol>
<p>확인 근거는 {{ evidence_days }}일 동안 유효하고, 판매가가 바뀌면 바로 무효가 됩니다.</p></section>
<section class="bg-card" aria-labelledby="bg-parts-h"><h2 id="bg-parts-h">부품 가격 「가격 확인 중」 <b id="bg-parts-count">-</b></h2>
<div class="bg-bar"><button class="primary" id="bg-check">팝콘PC에서 다시 확인</button><label><input type="checkbox" id="bg-only" checked> 운영자 확인 필요만</label></div>
<p id="bg-msg" role="status" aria-live="polite"></p>
<div class="bg-scroll"><table><thead><tr><th>부품</th><th>원인</th><th class="num">판매가</th><th class="num">쓰는 PC</th><th>마지막 확인</th><th>상태 · 할 일</th></tr></thead><tbody id="bg-parts"></tbody></table></div></section>
<section class="bg-card" aria-labelledby="bg-nobom-h"><h2 id="bg-nobom-h">구성표 없는 고객 추천 PC <b id="bg-nobom-count">-</b></h2>
<p>구성표는 공개 페이지로 채울 수 없습니다(부품 설명·고객 문구·공개 승인 필요). <a href="/admin2/pc-configurations">조립PC 제품군</a>에서 등록합니다.</p>
<div class="bg-scroll"><table><thead><tr><th>상품번호</th><th>상품</th><th class="num">판매가</th><th>할 일</th></tr></thead><tbody id="bg-nobom"></tbody></table></div></section>
</main>
{% endblock %}
{% block foot_extra %}<script>
(function(){
  const $=id=>document.getElementById(id),esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const won=v=>Number.isInteger(v)?v.toLocaleString('ko-KR')+'원':'-';
  async function api(path,body){const r=await fetch('/api/admin/customer-bom-gaps'+path,{credentials:'same-origin',method:body?'POST':'GET',headers:body?{'Content-Type':'application/json'}:{},body:body?JSON.stringify(body):undefined});let d;try{d=await r.json();}catch{throw Error('서버 응답 확인 필요');}if(!r.ok)throw Error(typeof d.detail==='string'?d.detail:'입력 내용 또는 로그인 상태 확인 필요');return d;}
  const OUT={same:'판매중 · 같은 가격',held:'가격 다름 · 근거 아님',stale:'팝콘PC도 품절',failed:'읽지 못함'};
  function row(p){
    const code=p.part_code||p.explanation_code,last=p.last_check;
    const confirm=p.status==='operator'&&p.part_code?'<div class="bg-confirm"><input type="number" min="1" inputmode="numeric" aria-label="확인한 판매가" data-price="'+code+'" placeholder="판매가"><button data-confirm="'+code+'">확인 완료</button></div>':'';
    return '<tr><td>'+esc(p.slot)+' · '+esc(p.name||'(판매 상품 없음)')+'<small>상품번호 '+esc(code)+'</small></td><td>'+esc(p.cause)+'</td><td class="num">'+won(p.sale_price)+'</td>'+
      '<td class="num">'+esc(p.pc_count)+'대<small>'+esc((p.pc_examples||[]).join(', '))+'</small></td>'+
      '<td>'+(last?esc(last.checked_at)+'<small>'+esc(OUT[last.outcome]||last.outcome)+(last.mall_price?' · '+won(last.mall_price):'')+'</small>':'-')+'</td>'+
      '<td><span class="bg-state" data-kind="'+esc(p.status)+'">'+(p.status==='operator'?'운영자 확인 필요':'확인됨')+'</span><small>'+esc(p.todo)+'</small>'+confirm+'</td></tr>';
  }
  async function load(){
    $('bg-msg').textContent='불러오는 중';
    try{
      const d=await api($('bg-only').checked?'?status=operator':'');
      $('bg-parts-count').textContent=d.counts.parts_operator+'건 운영자 확인 필요 · '+d.counts.parts_confirmed+'건 확인됨';
      $('bg-parts').innerHTML=d.parts.length?d.parts.map(row).join(''):'<tr><td colspan="6">해당 항목이 없어요.</td></tr>';
      $('bg-nobom-count').textContent=d.counts.pcs_without_bom+'대';
      $('bg-nobom').innerHTML=d.pcs_without_bom.length?d.pcs_without_bom.map(x=>'<tr><td>'+esc(x.product_code)+'</td><td>'+esc(x.name)+'</td><td class="num">'+won(x.sale_price)+'</td><td><span class="bg-state" data-kind="operator">운영자 확인 필요</span><small>'+esc(x.todo)+'</small></td></tr>').join(''):'<tr><td colspan="4">해당 항목이 없어요.</td></tr>';
      $('bg-msg').textContent=d.note;
    }catch(e){$('bg-msg').textContent='목록을 불러오지 못했어요 · '+e.message;}
  }
  $('bg-only').addEventListener('change',load);
  $('bg-check').addEventListener('click',async e=>{
    e.target.disabled=true;$('bg-msg').textContent='팝콘PC 공개 페이지를 읽는 중이에요(부품당 몇 초)';
    try{const d=await api('/check',{});$('bg-msg').textContent=d.checked+'건 확인 · '+d.confirmed+'건 근거 남김 · '+d.operator+'건 운영자 확인 필요';await load();}
    catch(err){$('bg-msg').textContent='확인하지 못했어요 · '+err.message;}finally{e.target.disabled=false;}
  });
  $('bg-parts').addEventListener('click',async e=>{
    const code=e.target.dataset?.confirm;if(!code)return;
    const price=Number(document.querySelector('[data-price="'+code+'"]').value);
    if(!Number.isInteger(price)||price<=0){$('bg-msg').textContent='팝콘PC에서 확인한 판매가를 숫자로 넣어 주세요.';return;}
    try{await api('/parts/'+code+'/confirm',{price});$('bg-msg').textContent='확인 완료로 남겼어요. 고객 화면에 가격이 보입니다.';await load();}
    catch(err){$('bg-msg').textContent=err.message;}
  });
  load();
})();
</script>{% endblock %}
