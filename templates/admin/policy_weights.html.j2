  };
  var LOCK_TITLE = '배분율·티어 정렬 기준 편집은 향후 사용예정입니다 — 값을 코드에서 DB로' +
    " 옮기고 '바꿔도 이미 만든 견적은 그대로'라는 원칙(용도 하한과 동일)을 새 API에 적용해야 합니다.";

  function $(id) { return document.getElementById(id); }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function label(t) { return LABELS[t] || t; }
  function fmtInt(v) { return (v === null || v === undefined) ? '못 쟀음' : Number(v).toLocaleString('ko-KR'); }
  function fmtPct(v) {
    var n = Number(v);
    return (Math.round(n * 10) % 10 === 0 ? n.toFixed(0) : n.toFixed(1)) + '%';
  }

  function handle(res) {
    return res.clone().json().catch(function () { return null; }).then(function (j) {
      if (!res.ok) {
        var msg = (window.popcornProgress && window.popcornProgress.errText)
          ? window.popcornProgress.errText(j, res.status, '') : ('오류 ' + res.status);
        var e = new Error(msg); e.status = res.status; e.body = j; throw e;
      }
      return j;
    });
  }
  function apiGet(path) { return fetch(path, { credentials: 'same-origin' }).then(handle); }

  function boot() {
    load();
  }

  function load() {
    $('refreshBtn').disabled = true;
    apiGet('/api/admin/engine-rules')
      .then(function (j) { S.data = j; S.loadErr = null; render(); })
      .catch(function (err) { S.data = null; S.loadErr = err; render(); })
      .then(function () { $('refreshBtn').disabled = false; });
  }

  function render() {
    if (S.loadErr) { renderError(); renderPoolHeader(null); return; }
    if (!S.data) return;
    var d = S.data;
    renderPoolHeader(d);
    $('pwScroll').innerHTML = tplBanner(d) + tplTiers(d) +
      '<div class="pw-lower">' +
      '<div class="pw-lower-l">' + tplBudget(d) + '</div>' +
      '<div class="pw-lower-r">' + tplTags(d) + tplFacts(d) + '</div>' +
      '</div>' + tplFoot();
  }

  function renderPoolHeader(d) {
    var el = $('poolInfo');
    if (!d || !d.tiers) { el.textContent = '추천 후보 풀 조회 실패'; return; }
    el.innerHTML = '추천 후보 풀 <b class="num">' + fmtInt(d.tiers.pool_size) + '</b>개(재고&gt;0)에 이 기준이 얹힙니다';
  }

  function renderError() {
    var un = S.loadErr.status === 401;
    $('pwScroll').innerHTML = '<div class="errbox"><div class="ti">' + (un ? '세션 만료' : '조회 실패') + '</div>' +
      '<div class="ds">' + (un ? '관리자 로그인 후 다시 조회합니다.' : ('추천 기준을 받지 못했습니다 — ' + esc(S.loadErr.message))) + '</div>' +
      (un ? '<a href="/admin2/login">로그인</a>' : '<button type="button" data-action="retry">다시 시도</button>') + '</div>';
  }

  // ── 상단 배너 ────────────────────────────────────────────────────
  function tplBanner(d) {
    var n = (d.weights && d.weights.rows) ? d.weights.rows.length : 0;
    return '<div class="pw-banner"><span class="tag">▲ 가중치 아님</span>' +
      '<div class="pw-bannertext">' +
      '<div class="main">지금 추천은 「가중치」가 아닙니다</div>' +
      '<div class="sub">policy_weights 표는 실존하지만 <code>' + n + '행</code>입니다 —' +
      ' <b>추천 엔진(recommend.py)이 이 값을 읽지 않습니다.</b> 지금 이 표를 읽는 코드는' +
      ' 이 화면의 조회 API뿐입니다(그 사실을 보여주려고 조회합니다 — 견적에는 반영하지 않습니다).' +
      ' ' + n + '행은 오류가 아니라 지금의 정상 상태입니다 — 이 화면은 표가 비어 있다는 사실 자체를' +
      ' 결과로 보여줍니다. 추천은 실제로 이 넷이 결정합니다 — 티어별 정렬 규칙 · 총액 가지치기 ·' +
      ' 예산 배분율 · 태그 스코프.</div>' +
      '<div class="name">화면 이름을 「추천 기준 보기」로 표시합니다 — 지금 이 화면에서 바꿀 수 있는' +
      ' 값은 하나도 없습니다(전부 코드 상수). 좌측 메뉴의 정본 라벨은 사장님 확정 전이라' +
      ' 「추천 기준 설정」 그대로입니다.</div>' +
      '</div></div>';
  }

  // ── 티어 3열 대조 ────────────────────────────────────────────────
  function tplTiers(d) {
    var rules = (d.tiers && d.tiers.rules) || [];
    var head = rules.map(function (r) {
      return '<th scope="col"><span class="tn">' + esc(r.label) + '</span>' +
        '<code class="tk">' + esc(r.key) + '</code></th>';
    }).join('');
    function row(rowLabel, get) {
      return '<tr><th scope="row">' + esc(rowLabel) + '</th>' +
        rules.map(function (r) { return '<td>' + get(r) + '</td>'; }).join('') + '</tr>';
    }
    var body =
      row('정렬 기준', function (r) { return esc(r.order); }) +
      row('예산 상한', function (r) {
        return '<span class="capword">' + esc(r.cap) + '</span><div class="capnote">' + esc(r.note) + '</div>';
      }) +
      row('총액 처리', function (r) { return esc(r.total_handling || '—'); });
    return '<div class="pw-card"><div class="pw-cardhd"><span class="t">티어별 정렬 · 예산 상한 · 총액 처리</span>' +
      '<span class="src">GET /api/admin/engine-rules → tiers</span></div>' +
      '<div class="pw-tablewrap"><table class="pw-tiertable"><thead><tr>' +
      '<th scope="col" class="lbl"><span class="pw-vh">구분</span></th>' + head + '</tr></thead>' +
      '<tbody>' + body + '</tbody></table></div>' +
      '<div class="pw-cardnote">' + esc((d.tiers && d.tiers.tie_break) || '') + ' · ' +
      esc((d.tiers && d.tiers.performance_proxy) || '') + '</div>' +
      '</div>';
  }

  // ── 부품별 예산 배분율 ──────────────────────────────────────────
  function tplBudget(d) {
    var alloc = ((d.budget && d.budget.alloc) || []).slice().sort(function (a, b) { return b.pct - a.pct; });
    var max = alloc.reduce(function (m, a) { return Math.max(m, a.pct); }, 0) || 1;
    var rows = alloc.map(function (a, i) {
      var w = Math.max(2, a.pct / max * 100);
      return '<div class="pw-barrow"><span class="nm">' + esc(label(a.part_type)) +
        (i === 0 ? '<span class="top">가장 큰 몫</span>' : '') + '</span>' +
        '<span class="track"><span class="fill" style="width:' + w + '%"></span></span>' +
        '<span class="pct num">' + fmtPct(a.pct) + '</span></div>';
    }).join('');
    return '<div class="pw-card"><div class="pw-cardhd"><span class="t">부품별 예산 배분율</span>' +
      '<span class="pw-lock" title="' + esc(LOCK_TITLE) + '">편집 — 향후 사용예정</span></div>' +
      '<div class="pw-bars">' + rows + '</div>' +
      '<div class="pw-cardnote">' + esc((d.budget && d.budget.note) || '') + '</div></div>';
  }

  // ── 태그 조건 스코프 ─────────────────────────────────────────────
  function tplTags(d) {
    var scopes = (d.budget && d.budget.tag_scope) || [];
    var body = scopes.map(function (s) {
      var names = (s.scope || []).map(label).join(' · ');
      return '<div class="pw-tagrow"><div class="hd"><span class="nm">' + esc(s.tag) + '</span>' +
        '<code class="fk">' + esc(s.field) + '</code></div>' +
        '<div class="scope">적용 범위 — ' + esc(names || '(대상 없음)') + '</div>' +
        '<div class="ft">' + esc(TAG_FOOTNOTE[s.field] || '') + '</div></div>';
    }).join('');
    return '<div class="pw-card"><div class="pw-cardhd"><span class="t">태그 조건이 적용되는 범위</span></div>' +
      body + '<div class="pw-cardnote">' + esc((d.budget && d.budget.tag_note) || '') + '</div></div>';
  }

  // ── 이 화면이 밝히는 사실 ────────────────────────────────────────
  function tplFacts(d) {
    var n = (d.weights && d.weights.rows) ? d.weights.rows.length : 0;
    var items = [
      '동률이면 상품코드 오름차순으로 정합니다 — 같은 입력·같은 재고면 항상 같은 결과입니다(재현성).',
      '벤치마크 원천이 없어 가격을 성능의 대리 지표로 씁니다 — 부품 등급 축이 엔진에 연결되면 교체될 예정입니다.',
      '가성비형에서 최소 구성이 예산을 넘으면 세 티어 전부 불성립입니다 — 성립한 척하지 않습니다.',
      'policy_weights는 ' + n + '행이며 추천 엔진이 읽지 않습니다 — 오류가 아니라 지금의 정상 상태입니다.',
      '배분율은 예산 상한이 있는 견적에만 적용됩니다 — 숫자 없는 예산 표현에는 적용되지 않습니다.'
    ];
    return '<div class="pw-card"><div class="pw-cardhd"><span class="t">이 화면이 밝히는 사실</span></div>' +
      '<ol class="pw-facts">' + items.map(function (t) { return '<li>' + esc(t) + '</li>'; }).join('') + '</ol></div>';
  }

  // ── 하단 고지 ────────────────────────────────────────────────────
  function tplFoot() {
    return '<div class="pw-foot">마진율 · 카드 수수료(pricing)는 같은 API 응답에 있어도 <b>「판매가」</b>' +
      ' 그룹 소관입니다 · 호환 규칙(compat)은 <b>「조립 호환 규칙」</b> 소관입니다 · 부품 등급' +
      '(part_grades)은 아직 엔진에 연결되지 않았습니다 · 조회 실패 시 사유를 그대로 밝힙니다.</div>';
  }

  document.addEventListener('click', function (ev) {
    if (ev.target.closest('[data-action="refresh"]')) { load(); return; }
    if (ev.target.closest('[data-action="retry"]')) { load(); return; }
  });

  boot();
})();
</script>
{% endraw %}
{% endblock %}
