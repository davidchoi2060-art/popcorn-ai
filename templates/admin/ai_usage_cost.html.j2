{% block foot_extra %}
{% raw %}
<script>
(function () {
  'use strict';

  var S = { period: 'today', provider: null, model: null, menu: null, data: null, loadErr: null };

  function $(id) { return document.getElementById(id); }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function fmtInt(v) { return (v === null || v === undefined) ? '—' : Number(v).toLocaleString('en-US'); }
  function fmtUsd(v) { return (v === null || v === undefined) ? '$—' : ('$' + Number(v).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })); }
  function fmtTime(iso) {
    if (!iso) return '—';
    try {
      var d = new Date(iso);
      return d.toLocaleString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
    } catch (e) { return iso; }
  }

  function handle(res) {
    return res.clone().json().catch(function () { return null; }).then(function (j) {
      if (!res.ok) {
        var msg = (window.popcornProgress && window.popcornProgress.errText)
          ? window.popcornProgress.errText(j, res.status, '') : ('오류 ' + res.status);
        var e = new Error(msg); e.status = res.status; e.body = j; throw e;
      }
      return j;
    });
  }
  function apiGet(path) { return fetch(path, { credentials: 'same-origin' }).then(handle); }
  function toast(msg, kind) { window.Admin2Shell && window.Admin2Shell.toast(msg, kind); }

  function qstr(obj) {
    var parts = [];
    Object.keys(obj).forEach(function (k) {
      var v = obj[k];
      if (v === '' || v === null || v === undefined) return;
      parts.push(encodeURIComponent(k) + '=' + encodeURIComponent(v));
    });
    return parts.join('&');
  }

  function boot() {
    document.addEventListener('click', onDocClick);
    load();
  }

  function load() {
    $('refreshBtn').disabled = true;
    apiGet('/api/admin/ai-usage-cost/summary?' + qstr({ period: S.period, provider: S.provider, model: S.model }))
      .then(function (j) { S.data = j; S.loadErr = null; render(); })
      .catch(function (err) { S.data = null; S.loadErr = err; render(); })
      .then(function () { $('refreshBtn').disabled = false; });
  }

  function render() {
    if (S.loadErr) { renderError(); return; }
    if (!S.data) return;
    var d = S.data;
    $('lastAt').textContent = '마지막 조회 ' + fmtTime(d.generated_at);
    $('auScroll').innerHTML = tplBanner(d) + tplFilterBar(d) + tplKpis(d) + tplGauge(d) +
      tplBreakdowns(d) + tplTrend(d) + tplBottom(d);
    bindMenus();
  }
  function renderError() {
    var un = S.loadErr.status === 401;
    $('auScroll').innerHTML = '<div class="errbox"><div class="ti">' + (un ? '세션 만료' : '조회 실패') + '</div>' +
      '<div class="ds">' + (un ? '관리자 로그인 후 다시 조회합니다.' : ('집계를 받지 못했습니다 — ' + esc(S.loadErr.message))) + '</div>' +
      (un ? '<a href="/admin/login.html">로그인</a>' : '<button type="button" data-action="retry">다시 시도</button>') + '</div>';
  }

  // ── 배너(원천 없음 — rows==0일 때만) ─────────────────────────────
  function tplBanner(d) {
    if (d.source.api_cost_logs_rows > 0) return '';
    return '<div class="srcband"><span class="tag">▲ 원천 없음</span>' +
      '<span class="main">비용이 쌓이는 경로 자체가 아직 없습니다 — 접속 문제가 아닙니다</span>' +
      '<span class="sub">' + esc(d.source.reason) + ' 실측 <code>api_cost_logs ' + d.source.api_cost_logs_rows +
      '행 · cost_thresholds ' + d.source.cost_thresholds_rows + '행</code> — ' + esc(d.source.built_at) +
      ' 구축 시점부터 ' + d.source.weeks_since_build + '주째 그대로입니다.</span></div>';
  }

  // ── 필터 바 ──────────────────────────────────────────────────────
  function tplFilterBar(d) {
    var periods = (d.periods || []).map(function (p) {
      return '<span class="' + (S.period === p.key ? 'on' : '') + '" data-action="set-period" data-v="' + esc(p.key) + '">' + esc(p.label) + '</span>';
    }).join('');
    var provLabel = S.provider ? ('프로바이더: ' + (d.filters.providers.filter(function (x) { return x.key === S.provider; })[0] || {}).label) : '프로바이더: 전체';
    var modelLabel = S.model ? ('모델: ' + S.model) : '모델: 전체';
    return '<div class="filterbar" data-keep="1">' +
      '<span class="pillgroup">' + periods + '</span>' +
      filterDropdown('prov', provLabel, !!S.provider, provItems(d)) +
      filterDropdown('model', modelLabel, !!S.model, modelItems(d)) +
      '<span class="scope">' + esc(d.scope_note) + '</span></div>';
  }
  function provItems(d) {
    return [{ v: '', label: '전체' }].concat((d.filters.providers || []).map(function (p) { return { v: p.key, label: p.label }; }));
  }
  function modelItems(d) {
    return [{ v: '', label: '전체' }].concat((d.filters.models || []).map(function (m) { return { v: m.key, label: m.label }; }));
  }
  function filterDropdown(key, label, on, items) {
    var open = S.menu === key;
    return '<span class="filter-group" data-keep="1">' +
      '<span class="pill-filter' + (on ? ' on' : '') + '" data-action="toggle-menu" data-menu="' + key + '">' +
      '<span>' + esc(label) + '</span><span class="car">▼</span></span>' +
      '<div class="dmenu" ' + (open ? '' : 'hidden') + '>' +
      items.map(function (i) {
        return '<div class="dmenu-item" data-action="set-' + key + '" data-v="' + esc(i.v) + '">' + esc(i.label) + '</div>';
      }).join('') + '</div></span>';
  }

  // ── KPI ──────────────────────────────────────────────────────────
  function tplKpis(d) {
    return '<div class="kpis">' + d.kpis.map(function (k) {
      var real = k.kind === 'value';
      var val = real ? fmtUsd(k.value) : esc(k.value);
      return '<div class="kpi"><div class="lb">' + esc(k.label) + '</div>' +
        '<div class="valrow"><span class="val' + (real ? ' real' : '') + '">' + val + '</span>' +
        (k.unit && !real ? '<span class="unit">' + esc(k.unit) + '</span>' : '') + '</div>' +
        '<div class="botrow">' +
        (real ? '' : '<span class="kpichip ' + k.kind + '">' + esc(k.value) + '</span>') +
        '<span class="note">' + esc(k.note) + '</span></div></div>';
    }).join('') + '</div>';
  }

  // ── 게이지 ───────────────────────────────────────────────────────
  function tplGauge(d) {
    var g = d.gauge;
    var chip = g.available
      ? ('<span class="kpichip ' + (g.pct > 100 ? 'nosource' : 'value') + '">' + g.pct + '%</span>')
      : '<span class="kpichip nosource">원천 없음</span>';
    var track;
    if (g.available) {
      var over = g.pct > 100;
      track = '<div class="gtrack"><span class="fill' + (over ? ' over' : '') + '" style="width:' + Math.min(100, g.pct) + '%"></span></div>';
    } else {
      track = '<div class="gtrack"><span class="msg">' + esc(g.note) + '</span></div>';
    }
    var foot = g.available
      ? ('<span>' + fmtUsd(g.used_usd) + '</span><span>한도 ' + fmtUsd(g.limit_usd) + ' / 일</span>')
      : ('<span>' + (g.used_usd !== null ? fmtUsd(g.used_usd) : '$—') + '</span>' +
         '<span>' + (g.limit_usd !== null ? ('한도 ' + fmtUsd(g.limit_usd) + ' / 일') : '일 한도 미설정') + '</span>');
    return '<div class="gaugebox"><div class="head"><span class="t">일 한도 대비 오늘 사용률</span>' +
      '<span class="src">cost_thresholds · api_cost_logs</span><span class="chip">' + chip + '</span></div>' +
      track + '<div class="gfoot">' + foot + '</div></div>';
  }

  // ── 분해 ─────────────────────────────────────────────────────────
  function tplBreakdowns(d) {
    var prov = d.breakdowns.provider, task = d.breakdowns.task;
    return '<div class="breakdowns">' + bpanel('프로바이더별 분해', prov.source, prov.available, prov.reason, prov.rows, false) +
      bpanel('작업 종류별 분해', task.source, false, task.reason, task.rows, true) + '</div>';
  }
  function bpanel(title, source, available, reason, rows, schema) {
    var chip = available ? '' : ('<span class="kpichip ' + (schema ? 'noschema' : 'nosource') + '">' +
      (schema ? '스키마 없음' : '원천 없음') + '</span>');
    var body = rows.map(function (r) {
      var tok = (available && r.tokens !== null && r.tokens !== undefined) ? fmtInt(r.tokens) : '—';
      var cost = (available && r.cost !== null && r.cost !== undefined) ? fmtUsd(r.cost) : '$—';
      return '<div class="brow"><span class="nm">' +
        (r.key ? '<span class="dot" style="background:' + dotColor(r.key) + '"></span>' : '') +
        '<span class="name">' + esc(r.name) + '</span>' +
        (r.sub ? '<span class="sub">' + esc(r.sub) + '</span>' : '') + '</span>' +
        '<span class="tok' + (available ? ' real' : '') + '">' + tok + '</span>' +
        '<span class="cost' + (available ? ' real' : '') + '">' + cost + '</span></div>';
    }).join('');
    return '<div class="bpanel"><div class="bhd"><span class="t">' + esc(title) + '</span>' +
      '<span class="src">' + esc(source || '') + '</span>' + (chip ? '<span class="chip">' + chip + '</span>' : '') +
      '</div><div>' + body + '</div>' +
      (reason ? ('<div class="bfoot' + (schema ? ' schema' : '') + '">' + esc(reason) + '</div>') : '') +
      '</div>';
  }
  function dotColor(key) {
    return key === 'codex' ? 'var(--dot-blue,oklch(0.5 0.12 250))' : key === 'claude' ? 'var(--rv-amber)' : key.indexOf('task.') === 0 ? '#d3cec2' : 'var(--rv-green)';
  }

  // ── 추이 ─────────────────────────────────────────────────────────
  function tplTrend(d) {
    var t = d.trend;
    var chip = t.available ? '' : '<span class="kpichip nosource">원천 없음</span>';
    var max = 0;
    if (t.available) t.points.forEach(function (p) { if (p.cost !== null && p.cost > max) max = p.cost; });
    var bars = (t.points || []).map(function (p) {
      if (!t.available || p.cost === null) return '<div class="tbar" title="' + esc(p.date) + '"></div>';
      var h = max > 0 ? Math.max(4, Math.round(p.cost / max * 100)) : 4;
      return '<div class="tbar real" style="height:' + h + '%" title="' + esc(p.date) + ' · ' + fmtUsd(p.cost) + '"></div>';
    }).join('');
    var axis = t.available && max > 0
      ? ('<span>' + fmtUsd(max) + '</span><span>' + fmtUsd(max / 2) + '</span><span>$0</span>')
      : '<span>$—</span><span>$—</span><span>$—</span>';
    var overlay = t.available ? '' : '<div class="overlay">' + esc(t.note) + '</div>';
    return '<div class="trendbox"><div class="head"><span class="t">최근 ' + esc(t.period_label) + ' 추이</span>' +
      '<span class="src">api_cost_logs.created_at</span>' + (chip ? '<span class="chip">' + chip + '</span>' : '') + '</div>' +
      '<div class="tchart"><div class="taxis">' + axis + '</div><div class="tbars">' + bars + '</div>' + overlay + '</div></div>';
  }

  // ── 하단 2단(범례 + Claude Code 세션) ────────────────────────────
  function tplBottom(d) {
    var legend = d.legend.map(function (l) {
      return '<div class="leg-item"><span class="kpichip ' + legendKind(l.chip) + '">' + esc(l.chip) + '</span>' +
        '<span class="desc">' + esc(l.desc) + '</span></div>';
    }).join('');
    var cc = d.claude_code_session;
    var ccrows = cc.rows.map(function (r) {
      return '<div class="ccrow"><span class="nm">' + esc(r.name) + '</span>' +
        '<span class="tok">' + esc(r.tokens_label) + '</span><span class="cost">' + esc(r.cost_label) + '</span></div>';
    }).join('');
    return '<div class="bottom2">' +
      '<div class="legpanel"><div class="cap">빈 값 표기 규칙 — "0"과 "원천 없음"은 다르다</div>' + legend + '</div>' +
      '<div class="ccpanel"><div class="head"><span class="t">Claude Code 세션 비용 (별도 구역)</span>' +
      '<span class="cctag">다른 종류의 비용</span></div>' +
      '<div class="desc">' + esc(cc.note) + '</div>' + ccrows +
      '<div class="note2">' + esc(cc.note2) + '</div></div></div>';
  }
  function legendKind(chip) { return chip === '0' ? 'value' : chip === '스키마 없음' ? 'noschema' : 'nosource'; }

  // ── 이벤트 ───────────────────────────────────────────────────────
  function bindMenus() {
    // 메뉴는 매 render()마다 새로 그려지므로 별도 바인딩이 필요 없다(위임 클릭으로 처리)
  }
  function onDocClick(ev) {
    var t = ev.target;
    var per = t.closest('[data-action="set-period"]');
    if (per) { S.period = per.getAttribute('data-v'); S.menu = null; load(); return; }
    var tog = t.closest('[data-action="toggle-menu"]');
    if (tog) { var m = tog.getAttribute('data-menu'); S.menu = (S.menu === m) ? null : m; render(); return; }
    var sp = t.closest('[data-action="set-prov"]');
    if (sp) { S.provider = sp.getAttribute('data-v') || null; S.menu = null; load(); return; }
    var sm = t.closest('[data-action="set-model"]');
    if (sm) { S.model = sm.getAttribute('data-v') || null; S.menu = null; load(); return; }
    if (t.closest('[data-action="refresh"]')) { load(); return; }
    if (t.closest('[data-action="retry"]')) { load(); return; }
    if (S.menu && !t.closest('[data-keep]')) { S.menu = null; render(); }
  }

  boot();
})();
</script>
{% endraw %}
{% endblock %}
