{#
  게임 사양 등급 (ADM-TLK-021 · 가칭) — 2026-10-11 신설

  고객이 게임 이름을 말하면 견적은 그 게임의 사양 등급(game_grade_assignments)으로
  사양 하한을 정한다. 이 화면에서 게임마다 등급을 바꾸고(이유 필수 · 대표만),
  해상도별 사양 단계를 함께 보고, 바꾼 기록에서 되돌린다.
  데이터 = `GET /api/admin/game-grades` · 기록 `GET /api/admin/game-grades/history`
  · 저장 `PUT /api/admin/game-grades/{game_id}` · 되돌리기 `POST /api/admin/game-grades/undo/{log_id}`
  (`api/admin_game_grades.py`).

  ■ 머리말은 공통 셸이 `api/admin_page_intro.py` 로 그린다.
  ■ 팔레트는 셸 `admin2.css` 의 `--rv-*` 만 쓴다. 외부 자원 0.
  ■ 서버가 준 문자열은 textContent 로만 넣는다(innerHTML 금지).
#}
{% extends "admin/_admin2_shell.html.j2" %}

{% block title %}게임 사양 등급{% endblock %}

{% block head_extra %}
<style>
.gg-wrap{padding:16px 24px 32px;display:flex;flex-direction:column;gap:14px}
.gg-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.gg-kpi{background:var(--rv-card);border:1px solid var(--rv-dim4);border-radius:8px;padding:12px 14px}
.gg-kpi b{display:block;font-family:var(--rv-mono);font-size:22px;color:var(--rv-ink)}
.gg-kpi span{font-size:12.5px;color:var(--rv-muted)}
.gg-note{font-size:12.5px;color:var(--rv-muted);margin:0}
.gg-side{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.gg-box{background:var(--rv-card);border:1px solid var(--rv-dim4);border-radius:8px;padding:10px 14px;font-size:13px}
.gg-box h2{font-size:13.5px;margin:0 0 6px;color:var(--rv-ink-soft)}
.gg-chip{display:inline-block;border:1px solid var(--rv-dim3);border-radius:10px;padding:0 7px;margin:0 3px 3px 0;font-size:12px;color:var(--rv-ink-soft);background:var(--rv-canvas)}
.gg-chip.flag{border-color:var(--rv-amber-line);background:var(--rv-amber-bg);color:var(--rv-ink)}
.gg-chip.bad{border-color:var(--rv-red);color:var(--rv-red)}
.gg-bar{display:flex;gap:12px;align-items:center;flex-wrap:wrap;font-size:13px;color:var(--rv-ink-soft)}
.gg-bar label{display:flex;gap:6px;align-items:center;cursor:pointer}
.gg-bar select{font:inherit;border:1px solid var(--rv-dim3);border-radius:6px;padding:3px 6px;background:var(--rv-card);color:var(--rv-ink)}
.gg-table{background:var(--rv-card);border:1px solid var(--rv-dim4);border-radius:8px;overflow-x:auto}
.gg-table table{width:100%;border-collapse:collapse;font-size:13.5px;min-width:820px}
.gg-table th{background:var(--rv-panel);text-align:left;font-weight:600;color:var(--rv-ink-soft);padding:9px 12px;border-bottom:1px solid var(--rv-dim4);white-space:nowrap}
.gg-table td{padding:9px 12px;border-bottom:1px solid var(--rv-panel2);vertical-align:top;color:var(--rv-ink)}
.gg-table tbody tr{cursor:pointer}
.gg-table tbody tr:hover,.gg-table tbody tr[aria-selected="true"]{background:var(--rv-panel2)}
.gg-muted{color:var(--rv-faint)}
.gg-at{font-family:var(--rv-mono);white-space:nowrap}
.gg-pager{display:flex;gap:8px;align-items:center;justify-content:flex-end;font-size:13px}
.gg-pager button,.gg-drawer button{border:1px solid var(--rv-dim3);background:var(--rv-card);border-radius:6px;padding:5px 12px;font:inherit;cursor:pointer}
.gg-pager button:disabled{opacity:.45;cursor:default}
.gg-empty{padding:28px;text-align:center;color:var(--rv-muted)}
.gg-drawer{position:fixed;top:0;right:0;bottom:0;width:min(520px,100vw);background:var(--rv-card);border-left:1px solid var(--rv-dim3);box-shadow:-8px 0 24px rgb(0 0 0 / .08);display:flex;flex-direction:column;z-index:40}
.gg-drawer[hidden]{display:none}
.gg-drawer header{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid var(--rv-dim4)}
.gg-drawer header h2{font-size:16px;margin:0}
.gg-body{overflow-y:auto;padding:14px 16px;display:flex;flex-direction:column;gap:10px;font-size:13.5px}
.gg-lbl{font-size:12px;color:var(--rv-muted)}
.gg-say{background:var(--rv-panel);border-radius:6px;padding:8px 10px;margin:0;white-space:pre-wrap}
.gg-body textarea{width:100%;box-sizing:border-box;min-height:64px;font:inherit;border:1px solid var(--rv-dim3);border-radius:6px;padding:8px 10px;background:var(--rv-card);color:var(--rv-ink)}
.gg-status{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.gg-status label{display:flex;gap:5px;align-items:center;cursor:pointer}
.gg-same{border:1px solid var(--rv-dim4);border-radius:8px;padding:8px 10px}
.gg-msg{color:var(--rv-muted)}
.gg-msg.err{color:var(--rv-red)}
@media (max-width:768px){
  .gg-wrap{padding:12px 16px 24px}
  .gg-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}
  .gg-side{grid-template-columns:1fr}
}
.gg-grade{display:inline-block;min-width:22px;text-align:center;font-family:var(--rv-mono);font-weight:600;border:1px solid var(--rv-dim3);border-radius:6px;padding:0 6px;background:var(--rv-canvas)}
.gg-grade.none{color:var(--rv-faint);font-family:inherit;font-weight:400}
.gg-tiers{border-collapse:collapse;font-size:13px;width:100%}
.gg-tiers td,.gg-tiers th{border:1px solid var(--rv-dim4);padding:5px 8px;text-align:left}
.gg-tiers th{background:var(--rv-panel);font-weight:600;color:var(--rv-ink-soft)}
.gg-body select{font:inherit;border:1px solid var(--rv-dim3);border-radius:6px;padding:5px 8px;background:var(--rv-card);color:var(--rv-ink)}
.gg-hist{display:flex;flex-direction:column;gap:6px}
.gg-hist div{display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-size:12.5px;border-bottom:1px solid var(--rv-panel2);padding-bottom:6px}
</style>
{% endblock %}

{% block content %}
<div class="gg-wrap" data-keep="1">
  <section class="gg-kpis" aria-label="요약">
    <div class="gg-kpi"><b id="kAll">—</b><span>전체 게임</span></div>
    <div class="gg-kpi"><b id="kSet">—</b><span>등급 있음</span></div>
    <div class="gg-kpi"><b id="kNone">—</b><span>미배정</span></div>
    <div class="gg-kpi"><b id="kHist">—</b><span>최근 바꾼 기록</span></div>
  </section>
  <p class="gg-note" id="ggNote">등급은 견적의 사양 하한을 정합니다. 바꾸면 다음 상담부터 반영됩니다. 미배정 게임은 견적에서 등급 없이 다룹니다.</p>
  <div class="gg-bar">
    <label>게임 <input id="ggQ" type="search" maxlength="40" placeholder="이름으로 검색" style="font:inherit;border:1px solid var(--rv-dim3);border-radius:6px;padding:3px 8px"></label>
    <label>등급 <select id="ggGrade"><option value="">전체</option></select></label>
  </div>
  <div class="gg-table">
    <table>
      <thead><tr>
        <th scope="col">게임</th><th scope="col">장르</th><th scope="col">등급</th>
        <th scope="col">기계 제안</th><th scope="col">메모</th>
      </tr></thead>
      <tbody id="ggRows"><tr><td colspan="5" class="gg-empty">불러오는 중입니다.</td></tr></tbody>
    </table>
  </div>
  <div class="gg-pager">
    <span id="ggPage" class="gg-muted"></span>
    <button type="button" id="ggPrev">이전</button><button type="button" id="ggNext">다음</button>
  </div>
  <section class="gg-box">
    <h2>최근 바꾼 기록</h2>
    <div class="gg-hist" id="ggHist"><span class="gg-muted">불러오는 중입니다.</span></div>
  </section>
</div>
<aside class="gg-drawer" id="ggDrawer" hidden data-keep="1" aria-label="등급 바꾸기">
  <header><h2 id="ggDTitle">등급 바꾸기</h2><button type="button" id="ggClose">닫기</button></header>
  <div class="gg-body" id="ggDBody"></div>
</aside>
<script>
(function(){
  var API = '/api/admin/game-grades';
  var st = {offset:0, limit:50, grades:[], canWrite:false, picked:null};
  var $ = function(id){ return document.getElementById(id); };
  function el(tag, cls, txt){ var e=document.createElement(tag); if(cls) e.className=cls; if(txt!=null) e.textContent=txt; return e; }
  function when(s){ return s ? new Date(s).toLocaleString('ko-KR',{month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'}) : '—'; }
  function gradeOf(k){ for (var i=0;i<st.grades.length;i++) if (st.grades[i].grade===k) return st.grades[i]; return null; }
  function gradeText(k){ var g=gradeOf(k); return k ? (k+(g?' · '+g.label:'')) : '미배정'; }
  function badge(k){ return el('span','gg-grade'+(k?'':' none'), k||'미배정'); }
  function qs(){
    var p=['offset='+st.offset];
    var q=$('ggQ').value.trim(); if (q) p.push('q='+encodeURIComponent(q));
    if ($('ggGrade').value) p.push('grade='+encodeURIComponent($('ggGrade').value));
    return '?'+p.join('&');
  }
  function emptyRow(msg){ var b=$('ggRows'); b.textContent=''; var tr=el('tr'); var td=el('td','gg-empty',msg); td.colSpan=5; tr.appendChild(td); b.appendChild(tr); }
  function fillGradeFilter(){
    var s=$('ggGrade'); if (s.options.length>1) return;
    st.grades.forEach(function(g){ var o=el('option',null,g.grade+' · '+g.label); o.value=g.grade; s.appendChild(o); });
    var n=el('option',null,'미배정'); n.value='none'; s.appendChild(n);
  }
  function load(first){
    fetch(API+qs()).then(function(r){ if(!r.ok) throw new Error('게임 목록을 불러오지 못했습니다'); return r.json(); })
    .then(function(d){
      st.limit=d.limit; st.grades=d.grades; st.canWrite=d.can_write; fillGradeFilter();
      var all=0, none=d.counts.none||0; Object.keys(d.counts).forEach(function(k){ all+=d.counts[k]; });
      $('kAll').textContent=all; $('kSet').textContent=all-none; $('kNone').textContent=none;
      if (!d.can_write) $('ggNote').textContent='등급은 견적의 사양 하한을 정합니다. 이 계정은 보기만 할 수 있습니다. 바꾸기는 대표 권한만 할 수 있습니다.';
      if (!d.items.length){ emptyRow('조건에 맞는 게임이 없습니다.'); }
      else {
        var b=$('ggRows'); b.textContent='';
        d.items.forEach(function(it){
          var tr=el('tr'); tr.setAttribute('data-g', it.game_id);
          if (st.picked===it.game_id) tr.setAttribute('aria-selected','true');
          tr.appendChild(el('td',null,it.name));
          tr.appendChild(el('td',it.genre?null:'gg-muted',it.genre||'—'));
          var td=el('td'); td.appendChild(badge(it.grade)); tr.appendChild(td);
          var sg=it.suggestion; tr.appendChild(el('td',sg?null:'gg-muted', sg?((sg.grade||'판정 못 함')+(sg.confidence?' · '+sg.confidence:'')):'—'));
          tr.appendChild(el('td','gg-muted',it.note||''));
          tr.addEventListener('click',function(){ open(it); });
          b.appendChild(tr);
        });
      }
      var from=d.total?d.offset+1:0, to=d.offset+d.items.length;
      $('ggPage').textContent='전체 '+d.total+'건 중 '+from+'–'+to;
      $('ggPrev').disabled=d.offset<=0; $('ggNext').disabled=to>=d.total;
      if (first) hist();
    }).catch(function(e){ emptyRow(e.message); if (first) hist(); });
  }
  function hist(){
    fetch(API+'/history').then(function(r){ if(!r.ok) throw new Error('기록을 불러오지 못했습니다'); return r.json(); })
    .then(function(d){
      var h=$('ggHist'); h.textContent=''; $('kHist').textContent=d.items.length;
      if (!d.items.length){ h.appendChild(el('span','gg-muted','아직 바꾼 기록이 없습니다.')); return; }
      d.items.forEach(function(it){
        var row=el('div');
        row.appendChild(el('span','gg-at',when(it.at)));
        row.appendChild(el('span',null,(it.game||('게임 '+it.game_id))+' : '+(it.before||'미배정')+' → '+(it.after||'미배정')));
        row.appendChild(el('span','gg-muted',(it.is_undo?'되돌림':'이유: '+(it.reason||''))+(it.operator?' · '+it.operator:'')));
        if (it.undone) row.appendChild(el('span','gg-chip','되돌려짐'));
        else if (!it.is_undo && st.canWrite){
          var btn=el('button',null,'되돌리기'); btn.type='button';
          btn.addEventListener('click',function(){
            btn.disabled=true;
            fetch(API+'/undo/'+it.log_id,{method:'POST'})
            .then(function(r){ return r.json().then(function(x){ return {ok:r.ok,d:x}; }); })
            .then(function(x){ if(!x.ok) throw new Error((x.d&&x.d.detail)||'되돌리지 못했습니다'); load(); hist(); })
            .catch(function(e){ btn.disabled=false; row.appendChild(el('span','gg-msg err',e.message)); });
          });
          row.appendChild(btn);
        }
        h.appendChild(row);
      });
    }).catch(function(e){ $('ggHist').textContent=e.message; });
  }
  function tierTable(k){
    var g=gradeOf(k), t=el('table','gg-tiers');
    var hr=el('tr'); ['해상도','그래픽 단계','CPU 단계'].forEach(function(x){ hr.appendChild(el('th',null,x)); }); t.appendChild(hr);
    if (!g || !g.tiers.length){ var r=el('tr'); var c=el('td','gg-muted','미배정이면 등급으로 정하는 사양 하한이 없습니다.'); c.colSpan=3; r.appendChild(c); t.appendChild(r); return t; }
    g.tiers.forEach(function(x){
      var r=el('tr'); r.appendChild(el('td',null,x.resolution));
      r.appendChild(el('td',null,(x.gpu_tier||'—')+(x.gpu_tier_name?' '+x.gpu_tier_name:'')));
      r.appendChild(el('td',null,x.cpu_tier?(x.cpu_tier+(x.cpu_tier_name?' '+x.cpu_tier_name:'')):'그래픽 단계와 같음'));
      t.appendChild(r);
    });
    return t;
  }
  function line(b, label, value){ b.appendChild(el('span','gg-lbl',label)); b.appendChild(el('p','gg-say',value||'—')); }
  function open(it){
    st.picked=it.game_id;
    Array.prototype.forEach.call(document.querySelectorAll('#ggRows tr'),function(r){ r.toggleAttribute('aria-selected', r.getAttribute('data-g')==String(it.game_id)); });
    $('ggDTitle').textContent=it.name;
    var b=$('ggDBody'); b.textContent='';
    line(b,'지금 등급',gradeText(it.grade)+(it.grade&&!it.is_confirmed?' (확정 전)':''));
    if (it.note) line(b,'메모',it.note);
    if (it.suggestion) line(b,'기계 제안 (참고)',(it.suggestion.grade||'판정 못 함')+(it.suggestion.confidence?' · '+it.suggestion.confidence:'')+(it.suggestion.reason?'\n'+it.suggestion.reason:''));
    b.appendChild(el('span','gg-lbl','바꿀 등급'));
    var sel=el('select'); sel.disabled=!st.canWrite;
    st.grades.forEach(function(g){ var o=el('option',null,g.grade+' · '+g.label); o.value=g.grade; o.selected=g.grade===it.grade; sel.appendChild(o); });
    var n=el('option',null,'미배정'); n.value=''; n.selected=!it.grade; sel.appendChild(n);
    b.appendChild(sel);
    var ex=el('p','gg-note'); b.appendChild(ex);
    var tw=el('div'); b.appendChild(tw);
    function preview(){ var g=gradeOf(sel.value); ex.textContent=g?((g.example_titles?'같은 등급 예: '+g.example_titles+'. ':'')+(g.note||'')):''; tw.textContent=''; tw.appendChild(tierTable(sel.value)); }
    sel.addEventListener('change',preview); preview();
    b.appendChild(el('span','gg-lbl','바꾸는 이유 (필수)'));
    var ta=el('textarea'); ta.maxLength=300; ta.placeholder='예: 공식 권장사양이 GTX 1060 급이라 경쟁 이스포츠 등급이 맞음'; ta.disabled=!st.canWrite; b.appendChild(ta);
    var save=el('button',null,'저장'); save.type='button'; save.disabled=!st.canWrite;
    var msg=el('span','gg-msg', st.canWrite?'':'이 계정은 보기만 할 수 있습니다. 바꾸기는 대표 권한만 할 수 있습니다.');
    var ln=el('div','gg-status'); ln.appendChild(save); ln.appendChild(msg); b.appendChild(ln);
    save.addEventListener('click',function(){
      if (!ta.value.trim()){ msg.className='gg-msg err'; msg.textContent='바꾸는 이유를 적어 주세요.'; return; }
      save.disabled=true; msg.className='gg-msg'; msg.textContent='저장하는 중입니다.';
      fetch(API+'/'+it.game_id,{method:'PUT',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({grade:sel.value||null, reason:ta.value})})
      .then(function(r){ return r.json().then(function(d){ return {ok:r.ok,d:d}; }); })
      .then(function(x){ if(!x.ok) throw new Error((x.d&&x.d.detail)||'저장하지 못했습니다'); msg.textContent=x.d.note; save.disabled=false; it.grade=sel.value||null; it.is_confirmed=!!it.grade; load(); hist(); })
      .catch(function(e){ msg.className='gg-msg err'; msg.textContent=e.message; save.disabled=false; });
    });
    $('ggDrawer').hidden=false;
  }
  $('ggClose').addEventListener('click',function(){ $('ggDrawer').hidden=true; st.picked=null; });
  var timer=null;
  $('ggQ').addEventListener('input',function(){ clearTimeout(timer); timer=setTimeout(function(){ st.offset=0; load(); },250); });
  $('ggGrade').addEventListener('change',function(){ st.offset=0; load(); });
  $('ggPrev').addEventListener('click',function(){ st.offset=Math.max(0,st.offset-st.limit); load(); });
  $('ggNext').addEventListener('click',function(){ st.offset+=st.limit; load(); });
  load(true);
})();
</script>
{% endblock %}
