{#
  쇼핑몰 가격 반영 (ADM-PRC-070 · 가칭) — 2026-10-11 신설

  두 겹 안전장치를 한 화면에서 본다.
    1겹 배치    파일 올리기 · 자동 갱신 하루 2회(api/mall_price_auto) · 지금 실행
    2겹 실시간  장바구니에 넣는 순간 · 결제로 넘어가는 순간
  데이터 = `api/admin_mall_price.py` · 반영 규칙 = `api/mall_price.py`.

  ■ 팔레트는 셸 `admin2.css` 의 `--rv-*` 만 쓴다. 외부 자원 0.
  ■ 서버가 준 문자열은 textContent 로만 넣는다(innerHTML 금지).
#}
{% extends "admin/_admin2_shell.html.j2" %}

{% block title %}쇼핑몰 가격 반영{% endblock %}

{% block head_extra %}
<style>
.mp-wrap{padding:16px 24px 32px;display:flex;flex-direction:column;gap:14px;max-width:1180px}
.mp-card{background:var(--rv-card);border:1px solid var(--rv-dim4);border-radius:8px;padding:14px 16px;display:flex;flex-direction:column;gap:10px}
.mp-card h2{font-size:15px;margin:0}
.mp-note{font-size:12.5px;color:var(--rv-muted);margin:0}
.mp-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;font-size:13px}
.mp-row label{display:flex;gap:6px;align-items:center;cursor:pointer}
.mp-row button{border:1px solid var(--rv-dim3);background:var(--rv-card);border-radius:6px;padding:5px 14px;font:inherit;cursor:pointer}
.mp-row button.pri{background:var(--rv-ink);color:var(--rv-card);border-color:var(--rv-ink)}
.mp-row button:disabled{opacity:.45;cursor:default}
.mp-msg{font-size:13px;color:var(--rv-muted)}
.mp-msg.err{color:var(--rv-red)}
.mp-stats{display:flex;gap:8px;flex-wrap:wrap}
.mp-stat{border:1px solid var(--rv-dim3);border-radius:6px;padding:6px 10px;font-size:12.5px;color:var(--rv-ink-soft);background:var(--rv-canvas)}
.mp-stat b{font-family:var(--rv-mono);font-size:14px;color:var(--rv-ink);margin-right:4px}
.mp-tbl-wrap{overflow-x:auto}
.mp-tbl{width:100%;border-collapse:collapse;font-size:12.5px}
.mp-tbl th,.mp-tbl td{border-bottom:1px solid var(--rv-dim4);padding:6px 8px;text-align:left;white-space:nowrap}
.mp-tbl td.num,.mp-tbl th.num{text-align:right;font-family:var(--rv-mono)}
.mp-tbl td.name{white-space:normal;min-width:220px}
.up{color:var(--rv-red)}
.down{color:var(--rv-green)}
.mp-tag{font-size:11.5px;border-radius:9px;padding:1px 7px;border:1px solid var(--rv-amber-line);background:var(--rv-amber-bg);color:var(--rv-ink)}
.mp-filter{display:flex;gap:6px;flex-wrap:wrap}
.mp-filter button{border:1px solid var(--rv-dim3);background:var(--rv-card);border-radius:14px;padding:3px 12px;font:inherit;font-size:12.5px;cursor:pointer}
.mp-filter button.on{background:var(--rv-ink);color:var(--rv-card);border-color:var(--rv-ink)}
@media (max-width:768px){.mp-wrap{padding:12px 16px 24px}}
</style>
{% endblock %}

{% block content %}
<div class="mp-wrap" data-keep="1">
  <p class="mp-note">고객 카드 가격은 쇼핑몰 판매가를 따릅니다. 가격은 두 겹으로 맞춥니다. 1겹은 배치(파일 올리기 · 자동 갱신), 2겹은 고객이 장바구니에 넣거나 결제로 넘어가는 순간의 확인입니다. 바뀐 가격은 모두 가격 이력에 남고, 배치는 실행 단위로 되돌릴 수 있습니다.</p>


  <section class="mp-card" id="mpAuto">
    <h2>자동 갱신</h2>
    <p class="mp-note" id="mpAutoHow">불러오는 중입니다.</p>
    <div class="mp-stats" id="mpAutoStats"></div>
    <div class="mp-row">
      <button class="pri" id="mpAutoBtn">지금 실행</button>
      <span class="mp-msg" id="mpAutoMsg"></span>
    </div>
  </section>

  <section class="mp-card" id="mpUpload">
    <h2>파일로 반영</h2>
    <p class="mp-note">쇼핑몰 관리자 「상품관리 → 상품리스트 → 상품엑셀」로 내려받은 파일(xlsx · csv · xls 표)을 올립니다. 상품코드는 「자체상품코드」, 가격은 「일반회원」 열을 읽습니다. 판매가가 잠긴 상품은 바꾸지 않습니다.</p>
    <div class="mp-row">
      <input type="file" id="mpFile" accept=".xlsx,.csv,.xls,.htm,.html">
      <label><input type="checkbox" id="mpParts"> 부품 판매가도 반영</label>
      <button id="mpPreviewBtn">미리보기</button>
      <span class="mp-msg" id="mpMsg"></span>
    </div>
    <div id="mpPreview" hidden>
      <div class="mp-stats" id="mpStats"></div>
      <div class="mp-row" style="margin-top:8px">
        <button class="pri" id="mpApplyBtn">이대로 반영</button>
        <span class="mp-msg" id="mpApplyMsg"></span>
      </div>
      <div class="mp-tbl-wrap">
        <table class="mp-tbl">
          <thead><tr><th>상품코드</th><th>상품명</th><th class="num">지금 판매가</th><th class="num">쇼핑몰 가격</th><th class="num">차이</th><th></th></tr></thead>
          <tbody id="mpRows"></tbody>
        </table>
      </div>
      <p class="mp-note" id="mpMore"></p>
    </div>
  </section>

  <section class="mp-card">
    <h2>실행 기록</h2>
    <div class="mp-tbl-wrap">
      <table class="mp-tbl">
        <thead><tr><th>시작</th><th>방식</th><th>결과</th><th class="num">읽음</th><th class="num">바꿈</th><th class="num">오름</th><th class="num">내림</th><th class="num">보류</th><th class="num">잠금</th><th>실행자</th><th></th></tr></thead>
        <tbody id="mpRuns"><tr><td colspan="11">불러오는 중입니다.</td></tr></tbody>
      </table>
    </div>
  </section>

  <section class="mp-card">
    <h2>가격 확인 기록</h2>
    <div class="mp-filter" id="mpMoments">
      <button data-m="" class="on">전체</button>
      <button data-m="file">파일 올리기</button>
      <button data-m="auto">자동 갱신</button>
      <button data-m="manual">바로 실행</button>
      <button data-m="cart">장바구니</button>
      <button data-m="checkout">결제 이동</button>
    </div>
    <div class="mp-tbl-wrap">
      <table class="mp-tbl">
        <thead><tr><th>시각</th><th>시점</th><th>상품코드</th><th>상품명</th><th class="num">우리 값</th><th class="num">쇼핑몰 값</th><th class="num">차이</th><th>결과</th><th>메모</th></tr></thead>
        <tbody id="mpChecks"><tr><td colspan="9">불러오는 중입니다.</td></tr></tbody>
      </table>
    </div>
    <div class="mp-row"><button id="mpPrev">이전</button><span class="mp-msg" id="mpPage"></span><button id="mpNext">다음</button></div>
  </section>
</div>
<script>
(function(){
  var API = '/api/admin/mall-price';
  function $(id){ return document.getElementById(id); }
  function el(tag, cls, txt){ var e=document.createElement(tag); if(cls) e.className=cls; if(txt!=null) e.textContent=txt; return e; }
  function won(v){ return v==null ? '-' : Number(v).toLocaleString('ko-KR'); }
  function signed(v){ return v==null ? '-' : (v>0?'+':'') + Number(v).toLocaleString('ko-KR'); }
  function when(s){ return s ? new Date(s).toLocaleString('ko-KR') : '-'; }
  function td(txt, cls){ return el('td', cls, txt); }
  function errOf(r, d){ return (d && d.detail && (typeof d.detail==='string' ? d.detail : JSON.stringify(d.detail))) || ('오류 ' + r.status); }
  function call(url, opt){
    return fetch(url, opt).then(function(r){ return r.json().catch(function(){return {};}).then(function(d){ if(!r.ok) throw new Error(errOf(r,d)); return d; }); });
  }

  // ── 파일로 반영 ──
  var staged = null;
  $('mpPreviewBtn').addEventListener('click', function(){
    var f = $('mpFile').files[0];
    if(!f){ $('mpMsg').className='mp-msg err'; $('mpMsg').textContent='파일을 고르세요.'; return; }
    var fd = new FormData(); fd.append('file', f); fd.append('include_parts', $('mpParts').checked ? 'true' : 'false');
    $('mpMsg').className='mp-msg'; $('mpMsg').textContent='읽는 중입니다.'; $('mpPreviewBtn').disabled=true;
    call(API + '/preview', {method:'POST', body:fd}).then(function(d){
      staged = d; showPreview(d);
      $('mpMsg').textContent = d.file_name + ' · ' + d.file.rows.toLocaleString('ko-KR') + '줄 읽음 (상품코드 「' + d.file.columns.code + '」 · 가격 「' + d.file.columns.price + '」)';
    }).catch(function(e){ $('mpMsg').className='mp-msg err'; $('mpMsg').textContent=e.message; $('mpPreview').hidden=true; })
      .then(function(){ $('mpPreviewBtn').disabled=false; });
  });

  function stat(n, label){ var s=el('span','mp-stat'); s.appendChild(el('b',null,won(n))); s.appendChild(document.createTextNode(label)); return s; }
  function showPreview(d){
    var st = $('mpStats'); st.textContent='';
    st.appendChild(stat(d.change_count,'건 바뀜'));
    st.appendChild(stat(d.up,'건 오름'));
    st.appendChild(stat(d.down,'건 내림'));
    st.appendChild(stat(d.big,'건 큰 변동(30% 이상)'));
    st.appendChild(stat(d.same,'건 같음'));
    st.appendChild(stat(d.locked_count,'건 잠금이라 제외'));
    st.appendChild(stat(d.not_found_count,'건 우리에게 없는 상품'));
    if(!d.include_parts) st.appendChild(stat(d.out_of_scope,'건 부품이라 제외'));
    var tb = $('mpRows'); tb.textContent='';
    d.changes.forEach(function(c){
      var tr = el('tr');
      tr.appendChild(td(String(c.product_code)));
      tr.appendChild(td(c.name || '', 'name'));
      tr.appendChild(td(won(c.old), 'num'));
      tr.appendChild(td(won(c.new), 'num'));
      tr.appendChild(td(signed(c.diff), 'num ' + (c.diff>0?'up':c.diff<0?'down':'')));
      var t = td(''); if(c.big) t.appendChild(el('span','mp-tag','큰 변동')); tr.appendChild(t);
      tb.appendChild(tr);
    });
    $('mpMore').textContent = d.change_count > d.changes.length ? ('차이가 큰 순서로 ' + d.changes.length + '건만 보여 줍니다. 반영은 ' + d.change_count + '건 전부 합니다.') : '';
    $('mpApplyBtn').disabled = d.change_count === 0;
    $('mpApplyMsg').className='mp-msg'; $('mpApplyMsg').textContent = d.change_count === 0 ? '바꿀 판매가가 없습니다.' : '';
    $('mpPreview').hidden = false;
  }

  $('mpApplyBtn').addEventListener('click', function(){
    if(!staged) return;
    if(!confirm('판매가 ' + staged.change_count + '건을 쇼핑몰 가격으로 바꿉니다. 실행 기록에서 되돌릴 수 있습니다.')) return;
    var fd = new FormData(); fd.append('staging_id', staged.staging_id); fd.append('token', staged.token);
    fd.append('include_parts', staged.include_parts ? 'true' : 'false');
    $('mpApplyBtn').disabled = true; $('mpApplyMsg').textContent='반영하는 중입니다.';
    call(API + '/apply', {method:'POST', body:fd}).then(function(d){
      $('mpApplyMsg').className='mp-msg'; $('mpApplyMsg').textContent = d.note; staged = null; loadRuns(); loadChecks();
    }).catch(function(e){ $('mpApplyMsg').className='mp-msg err'; $('mpApplyMsg').textContent=e.message; $('mpApplyBtn').disabled=false; });
  });

  // ── 실행 기록 ──
  function loadRuns(){
    call(API + '/runs').then(function(d){
      var tb = $('mpRuns'); tb.textContent='';
      if(!d.items.length){ var tr=el('tr'); var c=td('아직 실행 기록이 없습니다.'); c.colSpan=11; tr.appendChild(c); tb.appendChild(tr); return; }
      d.items.forEach(function(r){
        var tr = el('tr');
        tr.appendChild(td(when(r.started_at)));
        tr.appendChild(td(r.moment_label + (r.file_name ? ' · ' + r.file_name : '')));
        var res = r.ok === null ? '진행 중이거나 끝나지 못함' : r.ok ? '성공' : '실패: ' + (r.fail_reason || '');
        if(r.undone_at) res += ' · 되돌림 ' + when(r.undone_at);
        tr.appendChild(td(res, r.ok === false ? 'up' : ''));
        [r.seen, r.changed, r.up, r.down, r.held, r.locked].forEach(function(v){ tr.appendChild(td(won(v), 'num')); });
        tr.appendChild(td(r.operator_name || (r.moment === 'auto' ? '자동' : '-')));
        var act = td('');
        if(r.can_undo){
          var b = el('button', null, '되돌리기'); b.style.cssText='border:1px solid var(--rv-dim3);background:var(--rv-card);border-radius:6px;padding:2px 10px;font:inherit;cursor:pointer';
          b.addEventListener('click', function(){
            if(!confirm('이 실행에서 바꾼 판매가 ' + r.changed + '건을 이전 값으로 되돌립니다.')) return;
            b.disabled = true;
            call(API + '/runs/' + r.run_id + '/undo', {method:'POST'}).then(function(x){ alert(x.note); loadRuns(); loadChecks(); })
              .catch(function(e){ alert(e.message); b.disabled=false; });
          });
          act.appendChild(b);
        }
        tr.appendChild(act);
        tb.appendChild(tr);
      });
    }).catch(function(e){ var tb=$('mpRuns'); tb.textContent=''; var tr=el('tr'); var c=td(e.message); c.colSpan=11; tr.appendChild(c); tb.appendChild(tr); });
  }
  window.mpReloadRuns = function(){ loadRuns(); loadChecks(); loadAuto(); };

  // ── 자동 갱신 ──
  var autoTimer = null;
  function autoLine(label, r){
    var s = el('span', 'mp-stat');
    s.appendChild(el('b', null, label));
    if(!r){ s.appendChild(document.createTextNode('기록 없음')); return s; }
    var res = r.ok === null ? '진행 중' : r.ok ? '성공 · 바꿈 ' + won(r.changed) + '건 · 보류 ' + won(r.held) + '건' : '실패 · ' + (r.fail_reason || '');
    s.appendChild(document.createTextNode(when(r.started_at) + ' · ' + r.moment_label + ' · ' + res));
    if(r.ok === false) s.classList.add('up');
    return s;
  }
  function loadAuto(){
    call(API + '/auto').then(function(d){
      $('mpAutoHow').textContent = d.schedule + ' 쇼핑몰 판매가를 읽어 완제품 PC 판매가에 반영합니다. ' +
        (d.source === 'export' ? '쇼핑몰 관리자로 로그인해 상품엑셀을 내려받아 읽습니다.' :
         '지금은 공개 상품 페이지를 하나씩 읽습니다(1.5초 간격). 관리자 상품엑셀로 읽으려면 서버 설정 ' + d.settings.names.slice(0,3).join(' · ') + ' 이 필요합니다.') +
        ' 30% 넘게 움직인 상품은 바꾸지 않고 보류합니다.';
      var st = $('mpAutoStats'); st.textContent = '';
      st.appendChild(autoLine('마지막 실행 ', d.last));
      if(d.last && d.last_ok && d.last.run_id !== d.last_ok.run_id) st.appendChild(autoLine('마지막 성공 ', d.last_ok));
      var running = d.last && d.last.ok === null;
      $('mpAutoBtn').disabled = running;
      clearTimeout(autoTimer);
      if(running) autoTimer = setTimeout(function(){ loadAuto(); loadRuns(); }, 10000);
    }).catch(function(e){ $('mpAutoHow').textContent = e.message; });
  }
  $('mpAutoBtn').addEventListener('click', function(){
    if(!confirm('지금 쇼핑몰 가격을 읽어 완제품 PC 판매가에 반영합니다.')) return;
    $('mpAutoBtn').disabled = true; $('mpAutoMsg').className='mp-msg'; $('mpAutoMsg').textContent='';
    call(API + '/auto/run', {method:'POST'}).then(function(d){ $('mpAutoMsg').textContent = d.note; loadAuto(); loadRuns(); })
      .catch(function(e){ $('mpAutoMsg').className='mp-msg err'; $('mpAutoMsg').textContent=e.message; $('mpAutoBtn').disabled=false; });
  });

  // ── 가격 확인 기록 ──
  var moment = '', page = 1, size = 50, total = 0;
  Array.prototype.forEach.call($('mpMoments').querySelectorAll('button'), function(b){
    b.addEventListener('click', function(){
      Array.prototype.forEach.call($('mpMoments').querySelectorAll('button'), function(x){ x.classList.toggle('on', x===b); });
      moment = b.getAttribute('data-m'); page = 1; loadChecks();
    });
  });
  $('mpPrev').addEventListener('click', function(){ if(page>1){ page--; loadChecks(); } });
  $('mpNext').addEventListener('click', function(){ if(page*size<total){ page++; loadChecks(); } });
  function loadChecks(){
    call(API + '/checks?moment=' + encodeURIComponent(moment) + '&page=' + page + '&size=' + size).then(function(d){
      total = d.total;
      var tb = $('mpChecks'); tb.textContent='';
      if(!d.items.length){ var tr=el('tr'); var c=td('기록이 없습니다.'); c.colSpan=9; tr.appendChild(c); tb.appendChild(tr); }
      d.items.forEach(function(r){
        var tr = el('tr');
        tr.appendChild(td(when(r.checked_at)));
        tr.appendChild(td(r.moment_label));
        tr.appendChild(td(String(r.product_code)));
        tr.appendChild(td(r.product_name || '', 'name'));
        tr.appendChild(td(won(r.our_price), 'num'));
        tr.appendChild(td(won(r.mall_price), 'num'));
        tr.appendChild(td(signed(r.diff), 'num ' + (r.diff>0?'up':r.diff<0?'down':'')));
        tr.appendChild(td(r.outcome_label));
        tr.appendChild(td(r.note || '', 'name'));
        tb.appendChild(tr);
      });
      $('mpPage').textContent = '전체 ' + total.toLocaleString('ko-KR') + '건 중 ' + page + '쪽';
    }).catch(function(e){ var tb=$('mpChecks'); tb.textContent=''; var tr=el('tr'); var c=td(e.message); c.colSpan=9; tr.appendChild(c); tb.appendChild(tr); });
  }
  loadRuns(); loadChecks(); loadAuto();
})();
</script>
{% endblock %}
