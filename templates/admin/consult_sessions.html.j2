.tc-name{font:600 11.5px/1.3 var(--rv-font);flex:1;min-width:0}
.tc-badge{font:600 9px/1 var(--rv-font);background:var(--rv-ink);color:var(--rv-canvas);border-radius:4px;padding:3px 6px}
.tc-total{font:600 15px/1.2 var(--rv-mono)}
.tc-parts{font:400 10.5px/1.3 var(--rv-font);color:var(--rv-muted);margin-top:3px}

.partsbox{border:1px solid rgba(0,0,0,.1);border-radius:7px;overflow:hidden}
.partrow{display:grid;grid-template-columns:96px 1fr 116px;gap:8px;padding:8px 11px;align-items:center;
        border-bottom:1px solid rgba(0,0,0,.06);background:var(--rv-card)}
.partrow:last-child{border-bottom:none}
.partrow.head{background:var(--rv-panel);font:600 10px/1 var(--rv-font);color:var(--rv-muted)}
.partrow .pc{font:500 10.5px/1.3 var(--rv-font);color:var(--rv-muted)}
.partrow .pn{font:400 11px/1.35 var(--rv-font);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
