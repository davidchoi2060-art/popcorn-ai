    errDetail: document.getElementById("cr-error-detail"),
    retryBtn: document.getElementById("cr-retry-btn"),
    overlay: document.getElementById("cr-overlay"),
    drawer: document.getElementById("cr-drawer"),
    drawerKey: document.getElementById("cr-drawer-key"),
    drawerSentence: document.getElementById("cr-drawer-sentence"),
    drawerRaw: document.getElementById("cr-drawer-raw"),
    drawerLoadBadge: document.getElementById("cr-drawer-loadbadge"),
    drawerLoadBox: document.getElementById("cr-drawer-loadbox"),
    drawerLoadTitle: document.getElementById("cr-drawer-loadtitle"),
    drawerLoadDetail: document.getElementById("cr-drawer-loaddetail"),
    fieldlist: document.getElementById("cr-fieldlist"),
    editSlot: document.getElementById("cr-edit-slot"),
    editField: document.getElementById("cr-edit-field"),
    editOp: document.getElementById("cr-edit-op"),
    editRefSlot: document.getElementById("cr-edit-refslot"),
    editRefField: document.getElementById("cr-edit-reffield"),
    editParts: document.getElementById("cr-edit-parts"),
    editOrder: document.getElementById("cr-edit-order"),
    drawerClose: document.getElementById("cr-drawer-close")
  };

  // 1b - 탭 줄 + 「필수 사양」 구역(spec-compat-required.md). 같은 GET /api/admin/engine-rules
  // 응답의 compat.required · compat.required_note를 읽는다 - 별도 fetch를 만들지 않는다.
  els.tabCompat = document.getElementById("cr-tab-compat");
  els.tabCompatLabel = document.getElementById("cr-tab-compat-label");
  els.tabRequired = document.getElementById("cr-tab-required");
  els.tabBadge = document.getElementById("cr-tab-badge");
  els.panelCompat = document.getElementById("cr-panel-compat");
  els.panelRequired = document.getElementById("cr-panel-required");
  els.reqStLoading = document.getElementById("cr-req-state-loading");
  els.reqStError = document.getElementById("cr-req-state-error");
  els.reqErrMsg = document.getElementById("cr-req-error-msg");
  els.reqErrDetail = document.getElementById("cr-req-error-detail");
  els.reqRetryBtn = document.getElementById("cr-req-retry-btn");
  els.reqBody = document.getElementById("cr-req-body");
  els.reqTotalEmpty = document.getElementById("cr-req-total-empty");
  els.reqDatasections = document.getElementById("cr-req-datasections");
  els.reqBannerWarn = document.getElementById("cr-req-banner-warn");
  els.reqBTotal = document.getElementById("cr-req-b-total");
  els.reqBUnread = document.getElementById("cr-req-b-unread");
  els.reqBannerOk = document.getElementById("cr-req-banner-ok");
  els.reqOkTotal = document.getElementById("cr-req-ok-total");
  els.reqProblemCount = document.getElementById("cr-req-problem-count");
  els.reqCommonNote = document.getElementById("cr-req-common-note");
  els.reqProblemTable = document.getElementById("cr-req-problem-table");
  els.reqProblemRows = document.getElementById("cr-req-problem-rows");
  els.reqProblemEmpty = document.getElementById("cr-req-problem-empty");
  els.reqInterp = document.getElementById("cr-req-interp");
  els.reqGroupCount = document.getElementById("cr-req-group-count");
  els.reqGroups = document.getElementById("cr-req-groups");

  var lastSlots = [];
  var lastRows = [];   // 파싱된 표시용 행(원본 checks가 아니라 화면이 이미 나눈 대상/연산/비교대상)
  var lastFocusEl = null;

  function fmtNum(n){
    if (n === null || n === undefined) return "확인 불가";
    return Number(n).toLocaleString("ko-KR");
  }

  // API가 미리 합쳐 준 "SLOT.field op REF.ref_field" 문자열을 표 칸으로 도로 나눈다.
  // 서버가 준 값을 그대로 쓰는 것이지 새 값을 지어내는 것이 아니다 - slot/field에는
  // 공백이 없으므로(식별자) 공백 기준 분리가 안전하다. 연산 기호(=·≥·≤·포함)는 서버
  // OP_KO가 이미 한글로 바꿔 rule 문자열에 넣어 보낸다 - 예전엔 "contains"만 OP_KO에
  // 없어(2026-08-14까지) 여기서 dispOp()로 "포함"을 보정해 땜질했는데, 2026-08-15
  // 서버 OP_KO에 "contains":"포함"이 보강돼 이제 서버가 이미 번역해 보낸다(실측:
  // GET /api/admin/engine-rules의 rule 필드가 "CASE.form_factor_list 포함 MB.form_factor"
  // 처럼 온다). 클라이언트 patch는 중복이라 걷어냈다(API 제작자 지적).
  function parseRule(ruleStr){
    var parts = (ruleStr || "").trim().split(/\s+/);
    if (parts.length !== 3) {
      return { target: ruleStr || "", op: "", ref: "" };
    }
    return { target: parts[0], op: parts[1], ref: parts[2] };
  }

  function resetKpis(text){
    els.kpiTotal.textContent = text;
    els.kpiTotalNote.textContent = "";
    els.kpiWarn.textContent = text;
    els.kpiPool.textContent = text;
    els.kpiLoad.textContent = text;
    els.kpiLoadNote.textContent = "";
    els.kpiLoadCard.classList.remove("cr-kpi--gap");
  }

  function setState(kind, info){
    els.stLoading.hidden = kind !== "loading";
    els.stEmpty.hidden = kind !== "empty";
    els.stError.hidden = kind !== "error";
    // 필수 사양 탭은 같은 fetch 하나를 공유한다 - 조회 실패는 이 화면 다른 구역과
    // 같은 에러 경로를 쓴다(spec-compat-required.md ⑦, 이 구역만 따로 만들지 않는다).
    // 로딩·오류는 두 탭 공통이고, 성공 이후의 내용은 renderRequired()가 채운다.
    els.reqStLoading.hidden = kind !== "loading";
    els.reqStError.hidden = kind !== "error";
    els.reqBody.hidden = (kind === "loading" || kind === "error");
    if (kind === "loading") {
      resetKpis("…");
      els.skipBanner.hidden = true;
      els.tabBadge.hidden = true;
      els.tabCompatLabel.textContent = "호환 규칙";
    }
    if (kind === "error") {
      resetKpis("확인 불가");
      els.skipBanner.hidden = true;
      els.tabBadge.hidden = true;
      els.tabCompatLabel.textContent = "호환 규칙";
      info = info || {};
      if (info.kind === "auth") {
        els.errMsg.innerHTML = "로그인이 필요합니다 - " +
          "<a href=\"" + LOGIN_URL + "\" style=\"text-decoration:underline\">로그인 화면으로 이동</a>";
        els.errDetail.hidden = true;
        els.reqErrMsg.innerHTML = els.errMsg.innerHTML;
        els.reqErrDetail.hidden = true;
      } else if (info.kind === "network") {
        els.errMsg.textContent = "네트워크 오류 - 서버에 연결할 수 없습니다";
        els.errDetail.hidden = false;
        els.errDetail.textContent = info.detail || "";
        els.reqErrMsg.textContent = els.errMsg.textContent;
        els.reqErrDetail.hidden = false;
        els.reqErrDetail.textContent = els.errDetail.textContent;
      } else {
        els.errMsg.textContent = "서버 오류로 규칙을 불러오지 못했습니다";
        els.errDetail.hidden = false;
        els.errDetail.textContent = info.detail || "";
        els.reqErrMsg.textContent = els.errMsg.textContent;
        els.reqErrDetail.hidden = false;
        els.reqErrDetail.textContent = els.errDetail.textContent;
      }
    }
  }

  function detailFromBody(status, body){
    if (body && body.detail) {
      return typeof body.detail === "string" ? body.detail : JSON.stringify(body.detail);
    }
    return "상태 코드 " + status;
  }

  function buildRow(check, ord, total){
    var parsed = parseRule(check.rule);
    var partTypes = Array.isArray(check.part_types) ? check.part_types : [];
    return {
      ord: ord, total: total, key: check.key, label: check.label,
      target: parsed.target, op: parsed.op, ref: parsed.ref,
      partTypes: partTypes,
      partDisp: partTypes.length ? partTypes.join(", ") : "슬롯 전체",
      blocking: !!check.blocking, active: !!check.active,
      // UX-28(2026-08-15) - load_skipped가 boolean이 아니면(옛 캐시·API 변경 등)
      // false로 단정하지 않는다. 지어내면 실제로 건너뛴 규칙을 "정상"으로 오인시킬
      // 수 있다 - 그럴 땐 null로 남겨 "확인 불가"를 그대로 보여준다.
      loadSkipped: (typeof check.load_skipped === "boolean") ? check.load_skipped : null,
      loadSkipReason: check.load_skip_reason || null
    };
  }

  // 로드 배지 - false(정상)면 조용히 아무것도 보여주지 않는다(지금 9건 전부 false라
  // 정상 시나리오에서는 배지가 하나도 안 뜨는 게 맞다). true(건너뜀)일 때만 사유와
  // 함께 경고 배지가 뜬다 - "나쁜 규칙이 들어오면 즉시 배지가 뜨는" 구조.
  function loadBadgeInfo(row){
    if (row.loadSkipped === null) {
      return { text: "확인 불가", cls: "cr-badge cr-badge--unknown",
        title: "엔진 로드 성공 여부를 응답에서 찾지 못했습니다" };
    }
    if (row.loadSkipped) {
      return { text: "건너뜀", cls: "cr-badge cr-badge--skip",
        title: row.loadSkipReason || "탐색 순서 위반으로 엔진이 이 규칙을 건너뜁니다" };
    }
    return { text: "", cls: "", title: "" };
  }

  function renderRows(rows){
    els.rows.innerHTML = "";
    rows.forEach(function(row){
      var frag = els.rowTpl.content.cloneNode(true);
      var rootBtn = frag.querySelector(".cr-row");
      var loadSuffix = row.loadSkipped === true ? ", 로드 건너뜀(" + (row.loadSkipReason || "사유 없음") + ")"
        : row.loadSkipped === null ? ", 로드 확인 불가" : "";
      rootBtn.setAttribute("aria-label",
        row.ord + "번째 규칙 " + row.key + " 자세히 보기 - 판정 " +
        (row.blocking ? "막음" : "경고") + ", 활성 " + (row.active ? "켜짐" : "꺼짐") + loadSuffix);
      rootBtn.addEventListener("click", function(){ openDrawer(row); });

      frag.querySelector('[data-f="ord"]').textContent = row.ord;
      frag.querySelector('[data-f="key"]').textContent = row.key;
      frag.querySelector('[data-f="target"]').textContent = row.target;
      frag.querySelector('[data-f="target"]').title = row.target;
      frag.querySelector('[data-f="op"]').textContent = row.op;
      frag.querySelector('[data-f="ref"]').textContent = row.ref;
      frag.querySelector('[data-f="ref"]').title = row.ref;

      var partEl = frag.querySelector('[data-f="part"]');
      partEl.textContent = row.partDisp;
      if (row.partTypes.length) partEl.classList.add("cr-part--limited");

      var blockEl = frag.querySelector('[data-f="block"]');
      blockEl.textContent = row.blocking ? "막음" : "경고";
      blockEl.className = "cr-badge " + (row.blocking ? "cr-badge--block" : "cr-badge--warn");

      var activeEl = frag.querySelector('[data-f="active"]');
      activeEl.textContent = row.active ? "켜짐" : "꺼짐";
      activeEl.className = "cr-badge " + (row.active ? "cr-badge--on" : "cr-badge--off");

      var loadInfo = loadBadgeInfo(row);
      var loadEl = frag.querySelector('[data-f="load"]');
      loadEl.textContent = loadInfo.text;
      loadEl.className = loadInfo.cls;
      if (loadInfo.title) loadEl.title = loadInfo.title;

      els.rows.appendChild(frag);
    });
  }

  function setToggle(name, val){
    var opts = els.drawer.querySelectorAll('[data-toggle="' + name + '"]');
    opts.forEach(function(btn){
      btn.classList.toggle("cr-toggle-opt--on", btn.getAttribute("data-val") === val);
    });
  }

  function fillSlotSelect(sel, current){
    sel.innerHTML = "";
    var opts = lastSlots.length ? lastSlots : [current];
    opts.forEach(function(s){
      var o = document.createElement("option");
      o.value = s; o.textContent = s;
      if (s === current) o.selected = true;
      sel.appendChild(o);
    });
  }

  // 서랍의 "로드 진단" 자리 - false(정상)면 조용한 중립 문구, true(건너뜀)면 경고
  // 배지 + 서버가 준 사유(load_skip_reason)를 그대로 보여준다. 지어내지 않는다.
  function renderLoadDiagnosis(row){
    if (row.loadSkipped === null) {
      els.drawerLoadBadge.hidden = false;
      els.drawerLoadBadge.textContent = "확인 불가";
      els.drawerLoadBadge.className = "cr-badge cr-badge--unknown";
      els.drawerLoadBadge.title = "엔진 로드 성공 여부를 응답에서 찾지 못했습니다";
      els.drawerLoadBox.className = "cr-note-box cr-note-box--warn";
      els.drawerLoadTitle.textContent = "로드 진단 - 확인 불가";
      els.drawerLoadDetail.textContent =
        "이 규칙의 load_skipped 값을 응답에서 찾지 못했습니다 - 지어내지 않고 확인 불가로 남깁니다.";
      return;
    }
    if (row.loadSkipped) {
      els.drawerLoadBadge.hidden = false;
      els.drawerLoadBadge.textContent = "건너뜀";
      els.drawerLoadBadge.className = "cr-badge cr-badge--skip";
      els.drawerLoadBadge.title = row.loadSkipReason || "탐색 순서 위반";
      els.drawerLoadBox.className = "cr-note-box cr-note-box--warn";
      els.drawerLoadTitle.textContent = "▲ 로드에서 건너뜁니다";
      els.drawerLoadDetail.textContent = row.loadSkipReason ||
        "탐색 순서(ref_slot이 slot보다 앞이어야 함) 위반으로 엔진이 이 규칙을 건너뜁니다.";
      return;
    }
    els.drawerLoadBadge.hidden = true;
    els.drawerLoadBox.className = "cr-note-box cr-note-box--neutral";
    els.drawerLoadTitle.textContent = "로드 진단 - 정상";
    els.drawerLoadDetail.textContent =
      "이 규칙은 탐색 순서 조건(ref_slot이 slot보다 앞)을 만족해 엔진에 정상 로드됩니다" +
      "(recommend.load_compat_rules()와 같은 판정 - UX-28).";
  }

  function openDrawer(row){
    lastFocusEl = document.activeElement;
    els.drawerKey.textContent = row.key;
    els.drawerSentence.textContent = row.label || "";
    els.drawerRaw.textContent = row.target + " " + row.op + " " + row.ref +
      " · part_types=" + JSON.stringify(row.partTypes) +
      " · 현재 순서 " + row.ord + "/" + row.total;
    renderLoadDiagnosis(row);

    var targetParts = row.target.split(".");
    var refParts = row.ref.split(".");
    fillSlotSelect(els.editSlot, targetParts[0] || "");
    els.editField.value = targetParts[1] || "";
    els.editOp.value = row.op || "=";
    fillSlotSelect(els.editRefSlot, refParts[0] || "");
    els.editRefField.value = refParts[1] || "";
    els.editOrder.value = row.ord;

    els.editParts.innerHTML = "";
    if (row.partTypes.length) {
      row.partTypes.forEach(function(pt){
        var chip = document.createElement("button");
        chip.type = "button";
        chip.className = "cr-chip cr-chip--on";
        chip.textContent = pt;
        chip.addEventListener("click", function(){ chip.classList.toggle("cr-chip--on"); });
        els.editParts.appendChild(chip);
      });
      var hint = document.createElement("span");
      hint.className = "cr-chip-hint";
      hint.textContent = "비우면 슬롯 전체";
      els.editParts.appendChild(hint);
    } else {
      var hint2 = document.createElement("span");
      hint2.className = "cr-chip-hint";
      hint2.textContent = "슬롯 전체 적용 중 - 비어 있습니다";
      els.editParts.appendChild(hint2);
    }

    setToggle("block", row.blocking ? "block" : "warn");
    setToggle("active", row.active ? "on" : "off");

    var fieldNames = [];
    if (targetParts[1]) fieldNames.push({ tag: "이 규칙 필드", val: targetParts[1] });
    if (refParts[1] && refParts[1] !== targetParts[1]) fieldNames.push({ tag: "비교 필드", val: refParts[1] });
    els.fieldlist.innerHTML = "";
    fieldNames.forEach(function(f){
      var r = document.createElement("div");
      r.className = "cr-fieldlist-row";
      var tag = document.createElement("span");
      tag.className = "cr-fieldlist-tag"; tag.textContent = f.tag;
      var val = document.createElement("span");
      val.className = "cr-fieldlist-val"; val.textContent = f.val;
      r.appendChild(tag); r.appendChild(val);
      els.fieldlist.appendChild(r);
    });

    els.overlay.hidden = false;
    els.drawer.hidden = false;
    els.drawerClose.focus();
  }

  function closeDrawer(){
    els.overlay.hidden = true;
    els.drawer.hidden = true;
    if (lastFocusEl && typeof lastFocusEl.focus === "function") lastFocusEl.focus();
  }

  document.addEventListener("click", function(ev){
    var trigger = ev.target.closest && ev.target.closest('[data-action="close-drawer"]');
    if (trigger) closeDrawer();
  });
  document.addEventListener("keydown", function(ev){
    if (ev.key === "Escape" && !els.drawer.hidden) closeDrawer();
  });
  els.drawer.querySelectorAll('[data-toggle]').forEach(function(btn){
    btn.addEventListener("click", function(){
      setToggle(btn.getAttribute("data-toggle"), btn.getAttribute("data-val"));
    });
  });
  els.retryBtn.addEventListener("click", load);
  els.reqRetryBtn.addEventListener("click", load);

  // 탭 전환 - 「호환 규칙」(기존, 손대지 않음) <-> 「필수 사양」(신설). 데이터는 이미
  // 한 번의 fetch로 둘 다 받아 두었으므로 전환은 hidden만 뒤집는다(재조회 없음).
  function switchTab(tab){
    var toRequired = tab === "required";
    els.tabCompat.classList.toggle("on", !toRequired);
    els.tabCompat.setAttribute("aria-selected", toRequired ? "false" : "true");
    els.tabRequired.classList.toggle("on", toRequired);
    els.tabRequired.setAttribute("aria-selected", toRequired ? "true" : "false");
    els.panelCompat.hidden = toRequired;
    els.panelRequired.hidden = !toRequired;
  }
  document.addEventListener("click", function(ev){
    var tabTrigger = ev.target.closest && ev.target.closest('[data-action="cr-switch-tab"]');
    if (tabTrigger) switchTab(tabTrigger.getAttribute("data-tab"));
  });

  // 필수 사양 탭 - compat.required를 그대로 읽고 total·unread·groupCount는 이 응답에서
  // 센다(spec-compat-required.md ⑥⑦ · 「표를 하드코딩하지 마라」). 「그래서 무슨 일이
  // 생기나」 열·해석 문장은 옮기지 않는다(계약 §디자인에서 빼는 것) - 공통 문장 한 줄만
  // 두고, 부품군별 해석은 응답을 센 결과로만 만든다.
  function renderRequired(compat){
    var required = Array.isArray(compat.required) ? compat.required : [];
    var groupCount = required.length;
    var totalFields = 0;
    var problemRows = [];
    var perGroupUnread = [];

    required.forEach(function(g){
      var fields = Array.isArray(g.fields) ? g.fields : [];
      var unreadInGroup = 0;
      fields.forEach(function(f){
        totalFields += 1;
        var usedBy = Array.isArray(f.used_by) ? f.used_by : [];
        if (usedBy.length === 0) {
          unreadInGroup += 1;
          problemRows.push({ partLabel: g.part_label, fieldLabel: f.label, key: f.key });
        }
      });
      if (unreadInGroup > 0) perGroupUnread.push({ label: g.part_label, count: unreadInGroup });
    });

    var unreadCount = problemRows.length;

    els.tabBadge.hidden = unreadCount === 0;
    if (unreadCount > 0) els.tabBadge.textContent = fmtNum(unreadCount);

    els.reqTotalEmpty.hidden = totalFields !== 0;
    els.reqDatasections.hidden = totalFields === 0;
    if (totalFields === 0) return;

    var showDanger = unreadCount > 0;
    els.reqBannerWarn.hidden = !showDanger;
    els.reqBannerOk.hidden = showDanger;
    if (showDanger) {
      els.reqBTotal.textContent = fmtNum(totalFields);
      els.reqBUnread.textContent = fmtNum(unreadCount);
    } else {
      els.reqOkTotal.textContent = fmtNum(totalFields);
    }

    els.reqProblemCount.textContent = fmtNum(unreadCount) + "개";
    els.reqCommonNote.hidden = unreadCount === 0;
    els.reqProblemTable.hidden = unreadCount === 0;
    els.reqProblemEmpty.hidden = unreadCount !== 0;
    renderProblemRows(problemRows);

    if (unreadCount > 0) {
      var maxCount = 0;
      perGroupUnread.forEach(function(p){ if (p.count > maxCount) maxCount = p.count; });
      var top = perGroupUnread.filter(function(p){ return p.count === maxCount; });
      var names = top.map(function(p){ return p.label; }).join("·");
      els.reqInterp.textContent = top.length > 1
        ? ("가장 많이 걸린 부품군은 " + names + "(각 " + fmtNum(maxCount) + "개)입니다.")
        : ("가장 많이 걸린 부품군은 " + names + "(" + fmtNum(maxCount) + "개)입니다.");
      els.reqInterp.hidden = false;
    } else {
      els.reqInterp.hidden = true;
    }

    els.reqGroupCount.textContent = fmtNum(groupCount);
    renderGroups(required);
  }

  function renderProblemRows(rows){
    els.reqProblemRows.innerHTML = "";
    rows.forEach(function(row){
      var r = document.createElement("div");
      r.className = "cr-req-row";
      var part = document.createElement("span");
      part.className = "part"; part.textContent = row.partLabel;
      var field = document.createElement("span");
      field.textContent = row.fieldLabel;
      var key = document.createElement("span");
      key.className = "key"; key.textContent = row.key;
      var used = document.createElement("span");
      used.className = "cr-req-none"; used.textContent = "없음 ✕";
      r.appendChild(part); r.appendChild(field); r.appendChild(key); r.appendChild(used);
      els.reqProblemRows.appendChild(r);
    });
  }

  // 「전체 목록」 - 부품군 전부를 펼쳐서 보여준다(접기 없음). part_label은 서버 값
  // 그대로(다시 정의하지 않는다) - used_by가 비면 "없음 ✕"를 텍스트로 병기한다(색만으로
  // 말하지 않는다 - 이 저장소 규약).
  function renderGroups(required){
    els.reqGroups.innerHTML = "";
    required.forEach(function(g){
      var card = document.createElement("div");
      card.className = "cr-req-group";
      var name = document.createElement("div");
      name.className = "cr-req-group-name";
      name.textContent = g.part_label;
      card.appendChild(name);

      var list = document.createElement("div");
      list.className = "cr-req-group-fields";
      (Array.isArray(g.fields) ? g.fields : []).forEach(function(f){
        var row = document.createElement("div");
        row.className = "cr-req-field-row";
        var label = document.createElement("span");
        label.className = "cr-req-field-label";
        label.textContent = f.label;
        var key = document.createElement("span");
        key.className = "cr-req-field-key";
        key.textContent = f.key;
        var used = document.createElement("span");
        var usedBy = Array.isArray(f.used_by) ? f.used_by : [];
        if (usedBy.length) {
          used.className = "cr-req-field-used";
          used.textContent = usedBy.join(", ");
        } else {
          used.className = "cr-req-field-used cr-req-field-used--none";
          used.textContent = "없음 ✕";
        }
        row.appendChild(label); row.appendChild(key); row.appendChild(used);
        list.appendChild(row);
      });
      card.appendChild(list);
      els.reqGroups.appendChild(card);
    });
  }

  function applyData(data){
    var compat = data.compat || {};
    var checks = Array.isArray(compat.checks) ? compat.checks : [];
    lastSlots = Array.isArray(compat.slots) ? compat.slots : [];

    var total = checks.length;
    var activeCount = checks.filter(function(c){ return !!c.active; }).length;
    var warnCount = checks.filter(function(c){ return !c.blocking; }).length;
    var skipRows = checks.filter(function(c){ return c.load_skipped === true; });
    var unknownCount = checks.filter(function(c){ return typeof c.load_skipped !== "boolean"; }).length;
    var poolSize = (data.tiers && data.tiers.pool_size != null) ? data.tiers.pool_size : null;

    els.zeroBanner.hidden = activeCount !== 0;
    renderSkipBanner(skipRows, total);

    if (compat.note) {
      els.principleText.textContent = compat.note;
      els.principle.hidden = false;
    } else {
      els.principle.hidden = true;
    }

    els.kpiTotal.textContent = fmtNum(total);
    els.kpiTotalNote.textContent = "활성 " + fmtNum(activeCount) + "건 · 경고전용 " + fmtNum(warnCount) + "건";
    els.kpiWarn.textContent = fmtNum(warnCount);
    els.kpiPool.textContent = fmtNum(poolSize);
    renderLoadKpi(total, skipRows.length, unknownCount);

    lastRows = checks.map(function(c, i){ return buildRow(c, i + 1, total); });
    renderRows(lastRows);

    if (total === 0) {
      setState("empty");
    } else {
      setState("none");
    }

    // 탭 1 라벨 - "9종" 같은 개수는 지어내지 않는다. cr-kpi-total과 같은 원천
    // (compat.checks.length)에서 그대로 센다.
    els.tabCompatLabel.textContent = "호환 규칙 " + fmtNum(total) + "종";
    renderRequired(compat);
  }

  // 로드 성공 규칙 KPI - 값이 응답에 없을 때(unknownCount)는 "확인 불가"로 정직하게
  // 남긴다(전부 모를 때만). 건너뛴 규칙이 있으면 빨간 강조(cr-kpi--gap)로 바꾼다 -
  // 나쁜 규칙이 들어오면 이 카드가 즉시 경고로 바뀌는 구조.
  function renderLoadKpi(total, skipCount, unknownCount){
    if (unknownCount === total && total > 0) {
      els.kpiLoad.textContent = "확인 불가";
      els.kpiLoadNote.textContent = "API 응답에 load_skipped 값이 없습니다";
      els.kpiLoadCard.classList.remove("cr-kpi--gap");
      return;
    }
    var okCount = total - skipCount - unknownCount;
    els.kpiLoad.textContent = fmtNum(okCount) + " / " + fmtNum(total);
    if (skipCount > 0) {
      els.kpiLoadNote.textContent = fmtNum(skipCount) + "건 건너뜀 - 아래 표에서 확인";
      els.kpiLoadCard.classList.add("cr-kpi--gap");
    } else if (unknownCount > 0) {
      els.kpiLoadNote.textContent = fmtNum(unknownCount) + "건 확인 불가(응답에 값 없음)";
      els.kpiLoadCard.classList.remove("cr-kpi--gap");
    } else {
      els.kpiLoadNote.textContent = "전부 정상 로드";
      els.kpiLoadCard.classList.remove("cr-kpi--gap");
    }
  }

  // 상단 위험 배너 - 건너뛴 규칙이 하나도 없으면(지금 9건 전부 그렇다) 조용히 숨는다.
  function renderSkipBanner(skipRows, total){
    els.skipBanner.hidden = skipRows.length === 0;
    if (!skipRows.length) return;
    els.skipBannerTitle.textContent = "로드에서 건너뛴 규칙 " + skipRows.length + "건 / " + total + "건";
    els.skipBannerText.textContent = skipRows.map(function(c){
      return c.key + " - " + (c.load_skip_reason || "사유 없음");
    }).join(" · ");
  }

  function load(){
    setState("loading");
    fetch(API_URL, { credentials: "same-origin" }).then(function(res){
      if (res.status === 401) {
        setState("error", { kind: "auth" });
        return null;
      }
      if (!res.ok) {
        return res.json().catch(function(){ return null; }).then(function(body){
          setState("error", { kind: "server", detail: detailFromBody(res.status, body) });
          return null;
        });
      }
      return res.json();
    }).then(function(data){
      if (data) applyData(data);
    }).catch(function(err){
      setState("error", { kind: "network", detail: (err && err.message) || String(err) });
    });
  }

  load();
})();
</script>
{% endblock %}
