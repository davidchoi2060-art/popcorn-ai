{% extends 'admin/_admin2_shell.html.j2' %}
{% block title %}신규 조립PC 생성{% endblock %}
{% block head_extra %}<link rel="stylesheet" href="/shared/pc-builder.css?v=20261002-redesign3">
<style>#builder-estimate[hidden]{display:none}.builder-release{margin-top:22px}.release-title{font-size:20px;margin:0 0 4px}.builder-release ul{font-size:12px;line-height:1.7;padding-left:18px}.builder-release h3{font-size:13px;margin:12px 0 4px}.builder-release .builder-bom td:last-child,.builder-release .builder-bom th:last-child{width:auto;white-space:nowrap;text-align:right}.builder-release .builder-actions a{border:1px solid var(--rv-dim4);border-radius:7px;padding:9px 13px;background:var(--rv-card);color:var(--rv-ink);text-decoration:none;font-size:12px}</style>{% endblock %}
{% block content %}
<main class="pc-builder">
 <header class="builder-top"><div><small>조립PC 제품군 / 신규 생성</small><h1>신규 조립PC 생성</h1><p>부품 선택부터 구성 확인까지, 한 화면에서 준비합니다.</p></div><a href="/admin2/pc-configurations">제품군 목록</a></header>
 <nav class="builder-steps" aria-label="신규 생성 단계"><button data-step="1">1 부품 선택</button><button data-step="2">2 구성·가격 확인</button><span>3 검토 대기 등록</span></nav>
 <p id="builder-attach" class="builder-note" hidden></p>
 <p id="builder-message" role="status" aria-live="polite"></p>
 <section id="builder-screen"></section>
 <section id="release-screen" class="builder-release" aria-live="polite"></section>
 <p class="builder-note">대표 이미지·영상은 구성 확정과 호환 검토 후 별도로 생성합니다. 검토 대기 등록은 재고 예약·차감 또는 고객 공개·추천 승인이 아닙니다.</p>
</main>
{% endblock %}
{% block foot_extra %}<script src="/shared/assembly-fee.js"></script><script src="/shared/pc-builder.js?v=20261011-attach"></script><script src="/shared/pc-release.js?v=20261011-release"></script>{% endblock %}
