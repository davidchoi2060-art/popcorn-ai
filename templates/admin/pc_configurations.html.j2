{% extends "admin/_admin2_shell.html.j2" %}
{% block title %}조립PC 제품군 목록{% endblock %}
{% block head_extra %}
<link rel="stylesheet" href="/shared/part-explanations.css">
<link rel="stylesheet" href="/shared/pc-configurations.css">
<link rel="stylesheet" href="/shared/pc-configuration-detail.css">
<link rel="stylesheet" href="/shared/pc-description-editor.css">
<link rel="stylesheet" href="/shared/pc-parts-editor.css"><link rel="stylesheet" href="/shared/pc-review-editor.css">
{% endblock %}
{% block content %}
<main class="catalog">
  <div class="catalog-heading"><div><h1>조립PC 제품군 목록</h1><p>구성과 부품 정보를 확인하고 제품군을 관리합니다.</p></div>
    <div class="catalog-actions"><button id="catalog-refresh" type="button">최신 상태 조회</button><button id="catalog-export" type="button"><img src="/shared/icons/su/ft-file-text.svg" alt="">엑셀 내려받기</button></div>
  </div>
  <div id="catalog-queues" class="catalog-queues" role="group" aria-label="추천 분류별 목록"></div>
  <p class="catalog-workflow-note">후보 분류와 추천 승인은 별도입니다. 부품 구성 → 상품 설명 → 검토 기록 순서로 확인합니다. 새 제품군은 기존 구성의 ‘부품 구성 변경’에서 저장할 수 있습니다.</p>
  <form id="catalog-filters" class="catalog-filters" role="search">
    <div class="catalog-search-line"><label class="catalog-search"><span class="catalog-sr">상품명·구성 ID·부품명·부품 코드 검색</span><img src="/shared/icons/su/ft-search.svg" alt=""><input id="catalog-q" type="search" maxlength="100" autocomplete="off" aria-describedby="catalog-search-help" placeholder="상품명, 구성 ID 또는 부품명으로 검색 · 예: RTX4060 32GB"></label><button id="catalog-clear-search" type="button">검색어 지우기</button><button class="catalog-primary" type="submit">검색</button></div>
    <p id="catalog-search-help" class="catalog-search-help">띄어쓰기로 조건을 함께 입력하세요. 입력 순서와 영문 대소문자에 관계없이 모든 검색어가 포함된 구성을 찾습니다.</p>
    <div id="catalog-recent" class="catalog-recent" aria-label="최근 검색어" hidden></div>
    <label><span class="catalog-sr">등록 출처</span><select id="catalog-source"><option value="">등록 출처 : 전체</option><option value="신규">신규 구성</option><option value="기존">기존 판매 상품</option></select></label>
    <label><span class="catalog-sr">정보 검토</span><select id="catalog-review"><option value="">정보 검토 : 전체</option><option value="needs_review">확인 필요</option><option value="ready">정보 변경 없음</option></select></label>
    <label><span class="catalog-sr">공개 상태</span><select id="catalog-visibility"><option value="">공개 상태 : 전체</option><option value="private">비공개</option><option value="public">공개</option></select></label>
    <label><span class="catalog-sr">추천 분류</span><select id="catalog-queue"><option value="">추천 분류 : 전체</option><option value="ready">추천 가능 후보</option><option value="conditional">조건부 추천 후보</option><option value="hold">추천 전 보완</option><option value="excluded">우선 제외</option></select></label>
    <label><span class="catalog-sr">가격·판매 확인</span><select id="catalog-changes"><option value="">가격·판매 : 전체</option><option value="changed">가격·판매 확인 필요</option></select></label>
    <label><span class="catalog-sr">냉각 방식</span><select id="catalog-cooling"><option value="">냉각 방식 : 전체</option><option value="bundled_air">기본 공랭</option><option value="air">별도 공랭</option><option value="liquid">수랭</option><option value="unknown">냉각 방식 확인 필요</option></select></label>
    <button id="catalog-reset" type="button">검색 조건 초기화</button>
  </form>
  <p id="catalog-message" role="status" class="catalog-message"></p>
  <p id="catalog-checked" class="catalog-note"></p>
  <details id="catalog-issues" class="catalog-issue-groups"><summary>공통 보완 항목</summary><div id="catalog-issue-content"></div></details>
  <div class="catalog-layout">
    <section class="catalog-list" aria-label="조립PC 제품군 목록">
      <div class="catalog-section-title"><h2 id="catalog-count" aria-live="polite">불러오는 중</h2><label class="catalog-page-size">표시 개수 <select id="catalog-limit" aria-label="페이지당 상품 수"><option value="10">10개씩</option><option value="20">20개씩</option><option value="30">30개씩</option></select><small>다음 방문에도 유지</small></label></div>
      <div class="catalog-table-wrap"><table class="catalog-table"><thead><tr><th>선택</th><th>이미지</th><th>구성 ID / 상품명</th><th>주요 사양</th><th>기준 가격</th><th>등록 출처 / 상태</th></tr></thead><tbody id="catalog-rows"></tbody></table></div>
      <footer class="catalog-pagination"><span id="catalog-range"></span><nav id="catalog-pages" aria-label="목록 페이지"></nav><label><span class="catalog-sr">페이지당 상품 수 (하단)</span><select id="catalog-limit-bottom"><option value="10">10개씩</option><option value="20">20개씩</option><option value="30">30개씩</option></select></label></footer>
    </section>
    <aside class="catalog-inspector" aria-label="선택한 제품군 요약"><div class="catalog-section-title"><h2>제품군 상세 정보</h2><div class="catalog-arrows"><button id="catalog-previous-product" type="button" aria-label="이전 상품" disabled><img src="/shared/icons/su/ms-chevron_right.svg" alt=""></button><button id="catalog-next-product" type="button" aria-label="다음 상품" disabled><img src="/shared/icons/su/ms-chevron_right.svg" alt=""></button></div></div><div id="catalog-summary"><p class="catalog-empty">목록에서 상품을 선택해 주세요.</p></div><button class="catalog-primary catalog-detail-button" id="catalog-detail" type="button" disabled><img src="/shared/icons/su/ft-file-text.svg" alt="">전체 구성·부품 보기</button></aside>
  </div>
</main>
<dialog id="catalog-dialog" aria-labelledby="catalog-dialog-title"><div class="catalog-dialog-header"><div><span id="catalog-dialog-id"></span><h2 id="catalog-dialog-title">전체 구성·부품</h2></div><button id="catalog-dialog-close" type="button" aria-label="상세 닫기"><img src="/shared/icons/admin/x.svg" alt=""></button></div><div id="catalog-dialog-body"></div></dialog>
{% endblock %}
{% block foot_extra %}<script src="/shared/part-explanations.js"></script><script src="/shared/pc-description-editor.js"></script><script src="/shared/pc-parts-editor.js"></script><script src="/shared/pc-quote-assembly.js"></script><script src="/shared/pc-review-editor.js"></script><script src="/shared/pc-configuration-detail.js"></script><script src="/shared/pc-configurations.js"></script>{% endblock %}
