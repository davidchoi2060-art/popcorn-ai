{% block title %}AI 작업 설정{% endblock %}

{% block head_extra %}
<style>
*{box-sizing:border-box}
a{color:inherit;text-decoration:none}
button{font-family:inherit}
input{font-family:var(--rv-mono)}
::-webkit-scrollbar{width:7px;height:7px}
::-webkit-scrollbar-thumb{background:rgba(0,0,0,.16);border-radius:4px}

/* ── 좌측 메뉴·헤더 뼈대·팔레트는 admin2 공용 셸이 그린다 — 여기는 이 화면 본문만. ── */

.ats-tabsbar{flex:none;height:38px;border-bottom:1px solid rgba(0,0,0,.1);background:var(--rv-card);
  display:flex;align-items:stretch;padding:0 18px;gap:18px;z-index:4}
.ats-tab{display:flex;align-items:center;gap:7px;font:400 12.5px/1 var(--rv-font);color:var(--rv-faint);
  border-bottom:2px solid transparent;cursor:pointer;padding:0 2px;background:none;border-top:0;border-left:0;border-right:0}
.ats-tab.on{font-weight:600;color:var(--rv-ink);border-bottom-color:var(--rv-ink)}
.ats-tab .cnt{font:500 10.5px/1 var(--rv-mono);color:var(--rv-dim);background:var(--rv-panel2);border-radius:4px;padding:3px 5px}
.ats-tab.on .cnt{color:var(--rv-muted)}

.ats-view{flex:1;min-height:0;display:none;flex-direction:column}
.ats-view.on{display:flex}

.ats-banner{flex:none;margin:12px 18px 0;border:1px solid var(--rv-amber-line);background:var(--rv-amber-bg);
  border-left:3px solid var(--rv-amber);border-radius:7px;padding:10px 13px;display:flex;align-items:center;gap:11px}
.ats-banner .mk{font:600 11px/1 var(--rv-mono);color:oklch(0.5 0.14 55)}
.ats-banner .hd{font:600 11.5px/1.4 var(--rv-font)}
.ats-banner .ds{font:400 10.5px/1.5 var(--rv-font);color:var(--rv-ink-soft);flex:1;min-width:0}

.ats-notready{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;padding:40px;text-align:center}
