.ats-cf .r1{display:flex;align-items:baseline;gap:7px}
.ats-cf .dt{font:600 10.5px/1 var(--rv-mono);color:var(--rv-faint)}
.ats-cf .ti{font:600 11.5px/1.3 var(--rv-font);flex:1;min-width:0}
.ats-cf .bd{font:600 10px/1 var(--rv-font);border-radius:4px;padding:4px 7px;white-space:nowrap}
.ats-cf.adopted .bd{color:var(--rv-canvas);background:var(--rv-ink)}
.ats-cf:not(.adopted) .bd{color:var(--rv-muted);background:var(--rv-panel2);border:1px solid rgba(0,0,0,.12)}
.ats-cf .ds{font:400 10.5px/1.55 var(--rv-font);color:var(--rv-ink-soft);margin-top:4px}
.ats-conflict-note{font:400 10.5px/1.6 var(--rv-font);color:var(--rv-ink-soft);margin-top:10px;padding-top:9px;border-top:1px solid rgba(0,0,0,.1)}

