.ats-notready .ds{font:400 11.5px/1.6 var(--rv-font);color:var(--rv-dim);max-width:420px}

.ats-body{flex:1;min-height:0;display:flex;gap:14px;padding:12px 18px 18px}
.ats-left{width:392px;flex:none;display:flex;flex-direction:column;gap:12px;min-height:0;overflow:auto}

.ats-taskbox{flex:none;background:var(--rv-card);border:1px solid rgba(0,0,0,.11);border-radius:8px;overflow:hidden;position:relative}
.ats-taskbox-hd{height:34px;border-bottom:1px solid rgba(0,0,0,.09);display:flex;align-items:center;padding:0 12px;background:var(--rv-panel)}
