.ats-dethd .nm{font:600 14.5px/1.3 var(--rv-font)}
.ats-dethd .k{font:400 11px/1 var(--rv-mono);color:var(--rv-faint)}
.ats-modeswitch{display:flex;align-items:center;border:1px solid rgba(0,0,0,.16);border-radius:5px;overflow:hidden}
.ats-modeswitch span{font:500 10.5px/1 var(--rv-font);padding:7px 10px;cursor:pointer;user-select:none}
.ats-modeswitch span.on{color:var(--rv-canvas);background:var(--rv-ink)}
.ats-modeswitch span:not(.on){color:var(--rv-muted);background:var(--rv-card)}
.ats-delbtn{font:500 11px/1 var(--rv-font);border-radius:5px;padding:7px 10px;cursor:pointer;background:var(--rv-card);border:1px solid}

.ats-detbody{flex:1;min-height:0;overflow:auto;padding:15px 16px;display:flex;flex-direction:column;gap:15px}
