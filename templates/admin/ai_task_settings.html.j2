.ats-addbtn{font:600 11px/1 var(--rv-font);color:var(--rv-canvas);background:var(--rv-ink);border-radius:5px;padding:7px 11px;cursor:pointer;user-select:none}
.ats-addbtn.dis{color:var(--rv-panel2);background:var(--rv-dim3)}
.ats-dmenu{position:absolute;left:12px;right:12px;bottom:46px;z-index:30;background:var(--rv-card);border:1px solid rgba(0,0,0,.2);
  border-radius:7px;box-shadow:0 10px 26px rgba(38,35,30,.16);padding:4px}
.ats-dmenu[hidden]{display:none}
.ats-dmenu-item{display:flex;align-items:center;gap:8px;font:400 11.5px/1.3 var(--rv-font);color:var(--rv-ink);
  padding:7px 9px;border-radius:5px;cursor:pointer}
.ats-dmenu-item:hover{background:var(--rv-panel)}
.ats-dmenu-item .k{font:400 10px/1 var(--rv-mono);color:var(--rv-dim)}
.ats-dmenu-item.dis{color:var(--rv-dim2);cursor:default}
