.ats-trow.on{background:var(--rv-panel2);border-left-color:var(--rv-ink)}
.ats-trow .r1{display:flex;align-items:center;gap:8px;margin-bottom:4px}
.ats-trow .nm{font:500 12.5px/1.3 var(--rv-font);flex:1;min-width:0}
.ats-trow .dirty{font:600 10px/1 var(--rv-font);color:var(--rv-canvas);background:var(--rv-ink);border-radius:4px;padding:4px 6px}
.ats-trow .mode{font:600 10px/1 var(--rv-font);border-radius:4px;padding:4px 7px;white-space:nowrap;border:1px solid}
.ats-trow .r2{display:flex;align-items:center;gap:6px}
.ats-trow .sm{font:400 10.5px/1.3 var(--rv-mono);color:var(--rv-muted);flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ats-trow .un{font:500 10px/1 var(--rv-font);color:var(--rv-faint);background:var(--rv-panel2);border-radius:4px;padding:3px 6px}
.ats-empty-mini{padding:26px 16px;text-align:center}
.ats-empty-mini .ti{font:600 12.5px/1.5 var(--rv-font);color:var(--rv-muted)}
.ats-empty-mini .ds{font:400 11px/1.6 var(--rv-font);color:var(--rv-dim);margin-top:5px}
