.cm-recent-row{padding:10px 13px;border-bottom:1px solid rgba(0,0,0,.06);display:flex;flex-direction:column;gap:5px}
.cm-recent-row .r1{display:flex;align-items:center;gap:8px}
.cm-recent-row .at{font:400 10px/1.3 var(--rv-mono);color:var(--rv-faint)}
.cm-recent-row .lg{font:400 10px/1.3 var(--rv-mono);color:var(--rv-dim)}
.cm-recent-row .what{font:400 10.5px/1.55 var(--rv-font);color:var(--rv-ink-soft)}
.cm-undone-b{font:600 9.5px/1 var(--rv-font);color:var(--rv-faint);background:var(--rv-panel2);
  border-radius:3px;padding:3px 5px;white-space:nowrap}
.cm-undo-a{font:500 10px/1 var(--rv-font);color:var(--rv-ink);background:var(--rv-card);
  border:1px solid rgba(0,0,0,.2);border-radius:4px;padding:5px 7px;cursor:pointer;white-space:nowrap}
.cm-undo-a:disabled{color:var(--rv-dim2);border-color:rgba(0,0,0,.1);cursor:not-allowed}
.cm-recent-empty{padding:18px 13px;font:400 10.5px/1.6 var(--rv-font);color:var(--rv-dim);text-align:center}

/* ── 루트 ── */
.cm-root{flex:1;min-height:0;display:flex;flex-direction:column;position:relative}
.cm-loading,.cm-errbox{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;padding:40px}
.cm-loading[hidden],.cm-errbox[hidden]{display:none}
.cm-errbox .ti{font:600 14px/1.4 var(--rv-font);color:var(--rv-muted)}
.cm-errbox .ds{font:400 12px/1.6 var(--rv-font);color:var(--rv-dim);text-align:center;max-width:420px}
.cm-errbox button{padding:8px 18px;border-radius:6px;background:var(--rv-ink);color:var(--rv-canvas);
  font:500 12px/1 var(--rv-font);border:0;cursor:pointer}
.cm-body{flex:1;min-height:0;display:flex;flex-direction:column}
.cm-body[hidden]{display:none}

/* ── 경계 배너 ── */
.cm-banner{flex:none;margin:12px 18px 0;border:1px solid rgba(0,0,0,.13);background:var(--rv-panel2);
  border-left:3px solid var(--rv-faint);border-radius:7px;padding:10px 13px;display:flex;align-items:center;gap:11px;flex-wrap:wrap}
.cm-banner .mk{font:600 11px/1 var(--rv-mono);color:var(--rv-muted);white-space:nowrap}
.cm-banner .hd{font:600 11.5px/1.4 var(--rv-font);white-space:nowrap}
.cm-banner .ds{font:400 10.5px/1.55 var(--rv-font);color:var(--rv-ink-soft);flex:1;min-width:220px}
.cm-banner .meta{font:400 10px/1.5 var(--rv-mono);color:var(--rv-faint);white-space:nowrap}

/* ── 탭 ── */
.cm-tabs{flex:none;padding:12px 18px 0;display:flex;align-items:stretch;gap:8px;flex-wrap:wrap}
.cm-tab{flex:1;min-width:150px;text-align:left;background:var(--rv-panel2);border:1px solid rgba(0,0,0,.11);
  border-radius:8px;padding:9px 12px;cursor:pointer;user-select:none}
.cm-tab.on{background:var(--rv-card);border:1px solid var(--rv-ink);box-shadow:inset 0 -3px 0 var(--rv-ink)}
.cm-tab.dim{cursor:pointer}
.cm-tab .row1{display:flex;align-items:center;gap:6px}
.cm-tab .mark{font:600 10px/1 var(--rv-mono)}
.cm-tab .lbl{font:600 11px/1 var(--rv-font);white-space:nowrap}
.cm-tab .openbadge{font:600 9.5px/1 var(--rv-font);color:var(--rv-ink-soft);background:#e6e0d2;
  border-radius:3px;padding:3px 5px;white-space:nowrap}
.cm-tab .row2{display:flex;align-items:baseline;gap:6px;margin-top:4px}
.cm-tab .val{font:600 21px/1.15 var(--rv-mono);font-variant-numeric:tabular-nums}
.cm-tab .val.small{font-size:17px}
.cm-tab .note{font:400 10px/1.4 var(--rv-font);color:var(--rv-dim);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* ── 필터 바 ── */
.cm-filters{flex:none;padding:10px 18px 0;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.cm-search{width:268px;font:400 11.5px/1.3 var(--rv-font);color:var(--rv-ink);background:var(--rv-card);
  border:1px solid rgba(0,0,0,.18);border-radius:5px;padding:8px 11px;outline:none}
.cm-partbox{position:relative}
.cm-partbtn{display:flex;align-items:center;gap:7px;font:400 11.5px/1.3 var(--rv-font);color:var(--rv-ink);
  background:var(--rv-card);border:1px solid rgba(0,0,0,.18);border-radius:5px;padding:8px 11px;
  cursor:pointer;user-select:none;min-width:158px}
.cm-partbtn.set{border-color:rgba(0,0,0,.28)}
.cm-partbtn .car{font-size:8px;opacity:.55;margin-left:auto}
.cm-partdrop{position:absolute;top:36px;left:0;width:196px;max-height:264px;overflow:auto;
  background:var(--rv-card);border:1px solid rgba(0,0,0,.2);border-radius:7px;
  box-shadow:0 10px 26px rgba(38,35,30,.16);padding:4px;z-index:30}
.cm-partdrop[hidden]{display:none}
.cm-partopt{font:400 11px/1.3 var(--rv-font);padding:7px 9px;border-radius:5px;cursor:pointer}
.cm-partopt.on{font-weight:600;background:#f0ece1}
.cm-stockbtn{display:flex;align-items:center;gap:7px;font:500 11px/1 var(--rv-font);color:var(--rv-ink-soft);
