.cm-stockbtn .mk{font:600 10px/1 var(--rv-mono);color:var(--rv-dim)}
.cm-stockbtn[aria-checked="true"] .mk{color:var(--rv-green)}
.cm-resetlink{font:500 10.5px/1 var(--rv-font);color:var(--rv-dim2);background:transparent;
  border:1px solid rgba(0,0,0,.08);border-radius:5px;padding:8px 10px;cursor:pointer;user-select:none}
.cm-resetlink.active{color:var(--rv-ink-soft);border-color:rgba(0,0,0,.16)}
.cm-filternote{margin-left:auto;font:400 10.5px/1.5 var(--rv-font);color:var(--rv-faint);text-align:right;max-width:420px}

/* ── 본문 분할 ── */
.cm-split{flex:1;min-height:0;display:flex;gap:14px;padding:10px 18px 0}

/* 트리 */
.cm-tree{width:300px;flex:none;display:flex;flex-direction:column;background:var(--rv-card);
  border:1px solid rgba(0,0,0,.11);border-radius:8px;overflow:hidden}
.cm-tree-hd{flex:none;padding:10px 12px;border-bottom:1px solid rgba(0,0,0,.09);background:var(--rv-panel);
  display:flex;flex-direction:column;gap:8px}
.cm-tree-hd .row1{display:flex;align-items:center;gap:8px}
.cm-tree-hd .lbl{font:600 10.5px/1 var(--rv-font);color:var(--rv-muted);flex:1}
.cm-tree-hd .ro{font:400 10px/1 var(--rv-mono);color:var(--rv-dim)}
.cm-modes{display:flex;align-items:center;border:1px solid rgba(0,0,0,.16);border-radius:5px;overflow:hidden}
.cm-mode{flex:1;text-align:center;font:500 10.5px/1 var(--rv-font);color:var(--rv-muted);background:var(--rv-card);
  padding:7px 6px;cursor:pointer;user-select:none;border:0}
.cm-mode.on{color:var(--rv-canvas);background:var(--rv-ink)}
.cm-tree-note{font:400 10px/1.55 var(--rv-font);color:var(--rv-faint)}
.cm-tree-body{flex:1;min-height:0;overflow:auto}
.cm-tree-row{display:flex;align-items:center;gap:6px;padding:7px 11px;border-bottom:1px solid rgba(0,0,0,.05);
  cursor:pointer;background:transparent;border-left:3px solid transparent;width:100%;text-align:left;border-top:0;border-right:0}
.cm-tree-row.top{background:#faf7f0}
.cm-tree-row.on{background:#f0ece1;border-left-color:var(--rv-ink)}
.cm-tree-row .indent{flex:none}
.cm-tree-row .caret{flex:none;width:13px;text-align:center;font:500 10px/1 var(--rv-mono);color:var(--rv-muted);
  cursor:pointer;background:none;border:0;padding:0}
.cm-tree-row .caret.leaf{color:var(--rv-dim4);cursor:default}
.cm-tree-row .name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:var(--rv-font)}
.cm-tree-row .name.top{font:600 11.5px/1.3 var(--rv-font)}
.cm-tree-row .name.sub{font:400 11px/1.3 var(--rv-font)}
.cm-tree-row .viol{font:600 9.5px/1 var(--rv-font);color:var(--rv-amber);white-space:nowrap}
.cm-tree-row .cnt{font:400 10px/1.3 var(--rv-mono);color:var(--rv-faint);white-space:nowrap}
.cm-tree-empty,.cm-tree-err{padding:24px 14px;text-align:center;font:400 10.5px/1.6 var(--rv-font);color:var(--rv-dim)}
.cm-tree-retry{text-decoration:underline;cursor:pointer;color:var(--rv-link)}

/* 목록 */
.cm-listcol{flex:1;min-width:0;display:flex;flex-direction:column}
/* 결함2 재수정(2026-08-14, 확인자 재측정으로 두 번째 시도) — 세 가지가 함께 필요했다.
   appearance는 원인이 아니었다(1차 수정 — appearance:none을 넣은 뒤에도 헤더/행 폭이
   9px 그대로 벌어져 있었다, 확인자 재측정으로 반려됨).
   ① 컨테이너 폭 불일치(9px): scrollbar-gutter:stable은 그 축의 overflow가 실제로
      스크롤바를 만들 수 있는 auto/scroll일 때만 거터를 예약하고 hidden(스크롤바가
      절대 안 생기는 값)에는 효과가 없다. .cm-tbody(overflow:auto)는 세로축 거터를
      늘 예약해(스크롤 유무 무관 — stable의 정의) .cm-row 가용폭이 9px 줄어드는데
      .cm-thead(옛 overflow:hidden)는 거터가 전혀 안 걸려 있었다 — 그래서 세로만
      auto로 바꿨다(가로는 hidden 유지, 라운드 코너 클리핑 그대로). 이 수정만으로는
      **부족했다**(아래 실측 참고) — .cm-thead·.cm-tbody 의 offsetWidth/clientWidth는
      맞아떨어지지만 그 안의 그리드 정렬은 따로 어긋나 있었다. 형제 화면
      product_category.html.j2 의 .pc-thead 도 overflow:hidden 그대로라 같은 결함을
      안고 있을 수 있다(읽기만 했다 — 담당 밖이라 고치지 않음, 제작 보고서에 남김).
   ② 시작 위치 3px 오차: .cm-row 는 border-left:3px solid transparent(선택 강조용,
      :313)를 쓰는데 .cm-thead 에는 대응하는 여백이 없어 0열이 3px 어긋났다. 테두리
      선을 늘리면 헤더 카드 윤곽선이 달라지므로(오른쪽 테두리까지 손대야 해서 안
      좋음) **테두리 대신 padding-left 를 13->16 으로 3px 늘려** 시각적으로 티 안 나게
      맞췄다(getBoundingClientRect 로 0열·1열 시작 x 가 정확히 같아짐을 확인).
   ③ 1fr 트랙 자체가 안 맞음(2차 수정, 이후 폐기): ①②를 다 넣어도 .cm-thead 자신의
      grid-template-columns 계산값(1fr 트랙)이 실제 가용폭·뷰포트 변화와 무관하게
      굳어 있는 사례를 Playwright 로 직접 재현했다(폭을 700px 로 강제해도 같은 값이
      나왔다 — .cm-thead 가 grid 인 동시에 .cm-listcol 의 stretch 되는 flex 항목인
      조합에서 생기는 렌더링 현상으로 보인다). 그때는 CSS만으로 못 잡아 JS로 실제
      행의 계산값을 헤더에 복사하는 `syncTheadCols()` 를 넣었었다 — **그런데 이 조치가
      결함3을 낳았다**: 순수 1fr(최소폭 없음)라 어긋남을 없애는 방향이 결국 이름 열을
      헤더·행 양쪽 다 0px 로 접는 쪽으로 수렴해, "정렬은 맞는데 상품명이 안 보이는"
      상태로 통과 보고를 냈다(확인자가 잡음). 원인은 어긋남이 아니라애초에 618(고정폭
      합)+70(간격)+26(패딩)=714 가 709~718 폭보다 커서 1fr 에 줄 자리가 없었던 것.
   ④ 결함3 수정(2026-08-14, 3차) — 이름 열에 최소폭을 주고 넘치면 가로 스크롤:
      `grid-template-columns` 의 `1fr` 을 **`minmax(180px,1fr)`** 로 바꿨다(.cm-thead·
      .cm-row 둘 다, :317·:327). 180px 근거 — 1440px(이 화면이 기준으로 삼은 폭)에서
      순수 1fr 이 자연히 갖던 값이 152px 였다(실측, 확인자가 산수로 추정한 "약 160px"과
      근접) → 그보다 작은 값(120~160px)은 실제 상품명 표본(중앙값 34자, "(휴먼그리고)
      모니터 받침대 MT600 화이트 /모니터주변기기" 등)에서 모델번호가 채 안 보이는
      지점(예 152px="…MT6", 160px="…MT60")에서 끊겼다. 180px 은 "…MT600 화"까지
      보여줘 모델번호 전체가 읽힌다(Canvas measureText 로 실측: 23자). 그 대신 1440
      에서도(자연폭 152<180) 가로 스크롤이 생긴다 — "원안 그대로"가 항상 스크롤 0 을
      뜻하진 않는다고 판단했다(1920px 처럼 실제로 넉넉한 폭에서는 632px 로 펴져
      스크롤이 없다, 실측 확인). `.cm-row` 는 `min-width:min-content` 를 추가해(:328)
      `width:100%` 가 그리드의 최소 요구폭보다 좁아지지 못하게 막았다 — 그래야
      `.cm-tbody`(overflow:auto)가 진짜로 가로 스크롤을 인식한다. **`syncTheadCols()`
      는 이번에 제거했다**: minmax 로 트랙에 바닥값을 준 뒤로는 ③의 "굳어버림" 현상이
      재현되지 않았다(뷰포트 1024·1280·1440·1920, 스크롤 있음/없음, 라이브 리사이즈
      양방향 전부 어긋남 0px 를 함수 없이 실측 확인) — CSS만으로 풀리는데 매 렌더·
      리사이즈마다 도는 JS 보정을 남겨 두면 그 자체가 다음 결함의 씨앗이 된다(확인자
      지시). 헤더는 `overflow-x:hidden` 이라 자체 스크롤 막대는 없지만 내부 그리드는
      행과 똑같이 넓어서 잘려 있을 뿐이다 — 본문 스크롤과 같은 위치를 보여주려면
      `#cmTbody` 의 `scroll` 이벤트에서 헤더의 `scrollLeft` 를 맞춰야 한다(하단 스크립트,
      "가로 스크롤 동기화" 참고). **열 구성·순서·고정폭 값(30·116·92·176·84·54·66)은
      그대로다** — 바뀐 것은 이름 열의 하한뿐이다. */
.cm-thead{flex:none;display:grid;grid-template-columns:30px minmax(180px,1fr) 116px 92px 176px 84px 54px 66px;gap:10px;
  align-items:center;padding:9px 13px 9px 16px;background:var(--rv-panel);border:1px solid rgba(0,0,0,.1);
  border-radius:7px 7px 0 0;font:600 10.5px/1 var(--rv-font);color:var(--rv-faint);
  overflow-x:hidden;overflow-y:auto;scrollbar-gutter:stable}
.cm-tbody{flex:1;min-height:0;background:var(--rv-card);border:1px solid rgba(0,0,0,.1);border-top:none;
  overflow:auto;scrollbar-gutter:stable}
.cm-selectbar{display:flex;align-items:center;gap:9px;padding:9px 13px;background:#f6f2e8;border-bottom:1px solid rgba(0,0,0,.08)}
.cm-selectbar .tx{font:400 10.5px/1.4 var(--rv-font);color:var(--rv-ink-soft);flex:1;min-width:0}
.cm-selectbar button{font:600 10.5px/1 var(--rv-font);color:var(--rv-ink);background:var(--rv-card);
  border:1px solid rgba(0,0,0,.22);border-radius:5px;padding:7px 10px;cursor:pointer;white-space:nowrap}
.cm-row{display:grid;grid-template-columns:30px minmax(180px,1fr) 116px 92px 176px 84px 54px 66px;gap:10px;align-items:center;
  padding:8px 13px;border-bottom:1px solid rgba(0,0,0,.05);cursor:pointer;background:transparent;
  border-left:3px solid transparent;width:100%;min-width:min-content;text-align:left;border-top:0;border-right:0;border-radius:0}
.cm-row.on{background:#f6f2e8}
.cm-row.flag{border-left-color:var(--rv-amber)}
.cm-check{flex:none;width:15px;height:15px;border-radius:3px;display:flex;align-items:center;justify-content:center;
  font:600 9px/1 var(--rv-mono);color:var(--rv-canvas);background:var(--rv-card);border:1px solid rgba(0,0,0,.28);
  cursor:pointer;padding:0}
.cm-check.on{background:var(--rv-ink);border-color:var(--rv-ink)}
.cm-row .nm{font:500 11.5px/1.3 var(--rv-font);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cm-row .cd{font:400 10.5px/1.3 var(--rv-mono);color:var(--rv-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cm-row .pt{font:400 10.5px/1.3 var(--rv-font);color:var(--rv-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cm-row .pt.etc{color:var(--rv-link)}
.cm-row .ct{display:flex;align-items:center;gap:5px;font:400 10.5px/1.3 var(--rv-font);color:var(--rv-ink-soft);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cm-row .ct.warn{color:var(--rv-amber)}
.cm-row .pr{font:400 10.5px/1.3 var(--rv-mono);color:var(--rv-ink-soft);text-align:right;font-variant-numeric:tabular-nums}
.cm-row .sk{font:400 10.5px/1.3 var(--rv-mono);text-align:right;font-variant-numeric:tabular-nums;color:var(--rv-dim)}
.cm-row .sk.has{color:var(--rv-ink-soft)}
.cm-row .st{font:500 9.5px/1 var(--rv-font);color:var(--rv-muted);background:var(--rv-panel2);
  border:1px solid rgba(0,0,0,.1);border-radius:3px;padding:4px 6px;white-space:nowrap;justify-self:start}
.cm-row .st.live{color:var(--rv-green);background:oklch(0.95 0.03 165)}
.cm-listempty{padding:44px 20px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:8px}
.cm-listempty[hidden]{display:none}
.cm-listempty .ti{font:600 12.5px/1.4 var(--rv-font)}
.cm-listempty .ds{font:400 10.5px/1.7 var(--rv-font);color:var(--rv-dim);max-width:460px}
