{% block foot_extra %}
{% raw %}
<script>
(function () {
  'use strict';

  var VALID_SCOPES = ['unmapped', 'violation', 'unclassified', 'category', 'subtree', 'all'];
  var GREEN = 'var(--rv-green)', AMBER = 'var(--rv-amber)';

  var S = {
    tree: null, treeErr: null,
    list: null, listErr: null,
    scope: 'unmapped', catId: null, treeMode: 'subtree',
    q: '', part: null, inStock: false, page: 1, pageSize: 100,
    sel: {}, selectAllScope: false, remainder: 0,
    target: null,
    moves: [],
    collapsed: {},
    partOpen: false, targetOpen: false, recentOpen: false,
    busy: false
  };
  var searchDebounce = null;

  function $(id) { return document.getElementById(id); }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function fmt(n) { return (n == null) ? '—' : Number(n).toLocaleString('ko-KR'); }

  // ── API ──────────────────────────────────────────────────────────
  function handle(res) {
    return res.clone().json().catch(function () { return null; }).then(function (j) {
      if (!res.ok) {
        var msg = (window.popcornProgress && window.popcornProgress.errText)
          ? window.popcornProgress.errText(j, res.status, '') : ('오류 ' + res.status);
        var e = new Error(msg); e.status = res.status; e.body = j; throw e;
      }
      return j;
    });
  }
  function apiGet(path) { return fetch(path, { credentials: 'same-origin' }).then(handle); }
  function apiPost(path, body) {
    return fetch(path, { method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) }).then(handle);
  }

  function owner() { return window.Admin2Shell.canWrite('operator'); }
  function toast(msg, kind, action, onAction) { window.Admin2Shell.toast(msg, kind, action, onAction); }
  function guard() {
    if (!owner()) {
      var me = window.Admin2Shell.getMe();
      toast('권한이 부족합니다 (필요: operator, 현재: ' + (me ? me.role : '(로그인 필요)') + ')', 'err');
      return false;
    }
    return true;
  }
  function permText() {
    var me = window.Admin2Shell.getMe();
    return '권한이 부족합니다 (필요: operator, 현재: ' + (me ? me.role : '(로그인 필요)') + ')';
  }

  // ── 트리 헬퍼(/api/admin/categories) ────────────────────────────────
  function treeItems() { return (S.tree && S.tree.items) || []; }
  function nodeById(id) {
    var arr = treeItems();
    for (var i = 0; i < arr.length; i++) if (arr[i].category_id === id) return arr[i];
    return null;
  }
  function childrenOf(pid) {
    return treeItems().filter(function (n) { return n.parent_id === pid; })
      .sort(function (a, b) { return (a.sort_order - b.sort_order) || String(a.name).localeCompare(String(b.name)); });
  }
  function catPath(id) {
    var n = nodeById(id);
    if (!n) return '(알 수 없음)';
    var p = n.parent_id == null ? null : nodeById(n.parent_id);
    return (p ? p.name + ' / ' : '') + n.name;
  }
  function violUnder(id) {
    var n = nodeById(id);
    var total = (n && n.violations) || 0;
    childrenOf(id).forEach(function (c) { total += violUnder(c.category_id); });
    return total;
  }
  // ETC 전용 소분류 판정 — **코드값만** 본다(라벨 문자열 금지, taxonomy.py 라벨 변경에 안전).
  function isEtcOnlyCat(n) {
    return !!(n && n.allowed_part_types && n.allowed_part_types.length === 1 && n.allowed_part_types[0] === 'ETC');
  }
  // ETC 표시 라벨 — taxonomy.py(PART_LABELS)가 정본이다. 문자열을 이 파일에 다시
  // 박지 않고 서버가 매 응답에 실어 보내는 선택지(part_types)에서 코드 'ETC'의
  // label을 그대로 끌어온다. 형제 화면 product_category.html.j2의 etcLabel()(:578)과
  // 같은 방식 — 그쪽은 S.data.part_types, 이 화면은 S.list.part_types에서 읽는다.
  function etcLabel() {
    var opts = (S.list && S.list.part_types) || [];
    for (var i = 0; i < opts.length; i++) { if (opts[i].key === 'ETC') return opts[i].label; }
    return 'ETC';   // part_types 응답에 ETC 키가 없을 때만(폴백 — 라벨을 지어내지 않는다)
  }

  // ── scope 매핑 — UI 5탭 개념 ↔ 서버 실제 scope 6종 ───────────────────
  function apiScopeFor(uiScope, treeMode) { return uiScope === 'category' ? treeMode : uiScope; }
  function activeApiScope() { return apiScopeFor(S.scope, S.treeMode); }
  function activeCategoryId() { return S.scope === 'category' ? S.catId : null; }

  function buildListUrl(p) {
    var sp = new URLSearchParams();
    sp.set('scope', p.scope);
    if (p.category_id != null) sp.set('category_id', String(p.category_id));
    if (p.q) sp.set('q', p.q);
    if (p.part_type) sp.set('part_type', p.part_type);
    if (p.in_stock) sp.set('in_stock', 'true');
    sp.set('page', String(p.page || 1));
    sp.set('size', String(p.size || S.pageSize));
    return '/api/admin/category-mapping?' + sp.toString();
  }
  function fetchListRaw(p) { return apiGet(buildListUrl(p)); }

  function fetchCurrent(page) {
    return fetchListRaw({
      scope: activeApiScope(), category_id: activeCategoryId(),
      q: S.q, part_type: S.part, in_stock: S.inStock, page: page || (S.list && S.list.page) || 1, size: S.pageSize
    });
  }

  function collectCodes(limit) {
    var codes = [];
    function next(page) {
      return fetchListRaw({
        scope: activeApiScope(), category_id: activeCategoryId(),
        q: S.q, part_type: S.part, in_stock: S.inStock, page: page, size: 500
      }).then(function (resp) {
        (resp.items || []).forEach(function (it) { if (codes.length < limit) codes.push(it.product_code); });
        var items = resp.items || [];
        if (codes.length >= limit || page >= resp.pages || items.length === 0) {
          return { codes: codes, total: resp.total };
        }
        return next(page + 1);
      });
    }
    return next(1);
  }

  // ── 딥링크 ───────────────────────────────────────────────────────
  function parseUrlParams() {
    var sp = new URLSearchParams(location.search);
    var rawScope = sp.get('scope');
    var out = { q: (sp.get('q') || '').trim(), partType: sp.get('part_type') || null,
      inStock: sp.get('in_stock') === '1' || sp.get('in_stock') === 'true',
      fromUrl: false, invalidReason: null, scope: null, catId: null, treeMode: 'subtree' };
    if (!rawScope) return out;
    if (VALID_SCOPES.indexOf(rawScope) < 0) {
      out.invalidReason = '알 수 없는 범위(scope=' + rawScope + ')입니다';
      return out;
    }
    var needsCat = (rawScope === 'category' || rawScope === 'subtree');
    if (needsCat) {
      var catRaw = sp.get('category_id');
      if (!catRaw || !/^\d+$/.test(catRaw)) {
        out.invalidReason = 'scope=' + rawScope + '인데 category_id가 없습니다';
        return out;
      }
      out.catId = Number(catRaw);
      out.treeMode = rawScope;
      out.scope = 'category';
    } else {
      out.scope = rawScope;
    }
    out.fromUrl = true;
    return out;
  }
  function syncUrl() {
    var sp = new URLSearchParams();
    sp.set('scope', activeApiScope());
    var cid = activeCategoryId();
    if (cid != null) sp.set('category_id', String(cid));
    if (S.q) sp.set('q', S.q);
    if (S.part) sp.set('part_type', S.part);
    if (S.inStock) sp.set('in_stock', '1');
    var qs = sp.toString();
    history.replaceState(null, '', location.pathname + (qs ? '?' + qs : ''));
  }

  // ── 로드 ─────────────────────────────────────────────────────────
  function loadTree() {
    return apiGet('/api/admin/categories').then(function (j) { S.tree = j; S.treeErr = null; })
      .catch(function (err) { S.treeErr = err; });
  }

  function applyListResponse(resp) {
    S.list = resp; S.listErr = null;
    S.sel = {}; S.selectAllScope = false;
  }

  function boot() {
    renderAll();
    window.Admin2Shell.meReady.then(renderRail);
    loadTree().then(function () {
      var parsed = parseUrlParams();
      var notices = [];
      var wantScope = null, wantCatId = null, wantTreeMode = 'subtree';

      if (parsed.invalidReason) {
        notices.push('요청한 조건을 이해할 수 없어 기본 범위로 엽니다 — ' + parsed.invalidReason);
      } else if (parsed.fromUrl) {
        if (S.treeErr) {
          notices.push('카테고리 목록을 불러오지 못해 요청한 범위(category_id ' + parsed.catId + ')를 확인할 수 없습니다 — 기본 범위로 엽니다');
        } else if (parsed.catId != null && !nodeById(parsed.catId)) {
          notices.push('요청한 카테고리(id ' + parsed.catId + ')를 찾을 수 없어 기본 범위로 엽니다');
        } else {
          wantScope = parsed.scope; wantCatId = parsed.catId; wantTreeMode = parsed.treeMode;
        }
      }

      S.q = parsed.q; S.inStock = parsed.inStock;
      var provScope = wantScope || 'unmapped';
      var provTreeMode = wantScope ? wantTreeMode : S.treeMode;
      var provCatId = wantScope ? wantCatId : null;

      fetchListRaw({
        scope: apiScopeFor(provScope, provTreeMode), category_id: provScope === 'category' ? provCatId : null,
        q: S.q, part_type: parsed.partType, in_stock: S.inStock, page: 1, size: S.pageSize
      }).then(function (resp) {
        var okPart = !parsed.partType || (resp.part_types || []).some(function (t) { return t.key === parsed.partType; });
        if (parsed.partType && !okPart) notices.push('요청한 부품 종류(' + parsed.partType + ')를 찾을 수 없어 필터를 해제했습니다');
        var finalPart = okPart ? parsed.partType : null;
        var finalScope = wantScope || resp.open_at;
        var needRefetch = (!wantScope && resp.open_at !== provScope) || (parsed.partType && !okPart);

        function finish(finalResp) {
          S.scope = finalScope; S.treeMode = provTreeMode; S.catId = provCatId; S.part = finalPart;
          applyListResponse(finalResp);
          syncUrl(); renderAll();
          notices.forEach(function (n) { toast(n, 'warn'); });
        }
        if (needRefetch) {
          fetchListRaw({
            scope: apiScopeFor(finalScope, provTreeMode), category_id: finalScope === 'category' ? provCatId : null,
            q: S.q, part_type: finalPart, in_stock: S.inStock, page: 1, size: S.pageSize
          }).then(finish).catch(function (err) { S.listErr = err; renderAll(); });
        } else {
          finish(resp);
        }
      }).catch(function (err) { S.listErr = err; renderAll(); });
    });
  }

  function reloadKeepView(page) {
    S.listErr = null;
    return fetchCurrent(page).then(function (resp) {
      applyListResponse(resp);
      syncUrl(); renderAll();
    }).catch(function (err) { S.listErr = err; renderAll(); });
  }

  // ── 상태 전환 ────────────────────────────────────────────────────
  function setScope(scope, catId) {
    S.scope = scope;
    if (catId !== undefined) S.catId = catId;
    S.page = 1; S.sel = {}; S.selectAllScope = false; S.target = null; S.targetOpen = false; S.remainder = 0;
    reloadKeepView(1);
  }
  function setTreeMode(m) {
    if (S.treeMode === m) return;
    S.treeMode = m;
    if (S.scope === 'category') { S.page = 1; S.sel = {}; S.selectAllScope = false; S.remainder = 0; reloadKeepView(1); }
    else { renderAll(); }
  }

  // ── 렌더 ─────────────────────────────────────────────────────────
  function renderAll() {
    var loading = $('cmLoading'), errBox = $('cmErrBox'), body = $('cmBody');
    if (S.listErr) {
      loading.hidden = true; body.hidden = true; errBox.hidden = false;
      $('cmErrMsg').textContent = S.listErr.message;
      return;
    }
    if (!S.list) { loading.hidden = false; errBox.hidden = true; body.hidden = true; return; }
    loading.hidden = true; errBox.hidden = true; body.hidden = false;

    var counts = S.list.counts || {};
    $('cmBannerMeta').textContent = '전체 ' + fmt(counts.all_products) + '건';

    renderTabs(counts);
    renderFilters();
    renderTree();
    renderTable();
    renderPager();
    renderBar();
    renderRail();
  }

  function tabIsActive(key) {
    if (key === 'category') return S.scope === 'category';
    return S.scope === key;
  }
  function tabValueFor(key, counts) {
    if (key === 'category') return (S.scope === 'category' && S.list) ? S.list.total : null;
    if (tabIsActive(key) && S.list) return S.list.total;
    var map = { unmapped: 'unmapped', violation: 'violation', unclassified: 'unclassified', all: 'all_products' };
    return counts[map[key]];
  }

  function renderTabs(counts) {
    var openAt = S.list.open_at;
    var etcOnlyN = treeItems().filter(isEtcOnlyCat).length;
    var TABS = [
      { key: 'unmapped', mark: '○', label: '미매핑', note: 'category_id 없음' },
      { key: 'violation', mark: '▲', label: '허용 종류 위반', note: '막지 않고 알리기만' },
      { key: 'unclassified', mark: '◆', label: etcLabel(), note: "part_type = 'ETC' 기준 · 카테고리 축과 다름" },
      { key: 'category', mark: '●', label: '카테고리',
        note: S.catId == null ? '트리에서 고르세요' : catPath(S.catId) + (S.treeMode === 'subtree' ? ' · 하위 포함' : ' · 직속') },
      { key: 'all', mark: '·', label: '전체', note: '상품 전량' }
    ];
    $('cmTabs').innerHTML = TABS.map(function (t) {
      var on = tabIsActive(t.key);
      var dim = t.key === 'category' && S.catId == null;
      var v = tabValueFor(t.key, counts);
      var small = t.key === 'category';
      return '<button type="button" class="cm-tab' + (on ? ' on' : '') + (dim ? ' dim' : '') +
        '" data-action="pick-tab" data-scope="' + t.key + '" aria-pressed="' + (on ? 'true' : 'false') + '">' +
        '<div class="row1"><span class="mark">' + t.mark + '</span><span class="lbl">' + esc(t.label) + '</span>' +
        (openAt === t.key ? '<span class="openbadge">기본</span>' : '') + '</div>' +
        '<div class="row2"><span class="val' + (small ? ' small' : '') + '">' + (v == null ? '—' : fmt(v)) + '</span>' +
        '<span class="note" title="' + esc(t.note) + '">' + esc(t.note) + '</span></div></button>';
    }).join('');
    // 미분류 탭 근처 노트에 ETC 전용 소분류 수를 실측으로 붙인다(하드코딩 금지 — 트리에서 직접 센다).
    var uc = $('cmTabs').querySelector('[data-scope="unclassified"] .note');
    if (uc && etcOnlyN) uc.title += ' · 허용 종류가 ' + etcLabel() + '뿐인 소분류 ' + etcOnlyN + '개는 이 판정으로 서로 구분되지 않습니다';
  }

  function renderFilters() {
    var searchEl = $('cmSearch');
    if (document.activeElement !== searchEl) searchEl.value = S.q;
    var partTypes = (S.list && S.list.part_types) || [];
    var curLabel = '전체(' + partTypes.length + '종)';
    if (S.part) {
      var found = partTypes.filter(function (t) { return t.key === S.part; })[0];
      curLabel = found ? found.label : S.part;
    }
    $('cmPartLabel').textContent = '부품 종류 · ' + curLabel;
    $('cmPartBtn').classList.toggle('set', !!S.part);
    $('cmPartBtn').setAttribute('aria-expanded', S.partOpen ? 'true' : 'false');
    $('cmPartDrop').hidden = !S.partOpen;
    if (S.partOpen) {
      var opts = [{ key: null, label: '전체(' + partTypes.length + '종)' }].concat(partTypes);
      $('cmPartDrop').innerHTML = opts.map(function (o) {
        return '<div class="cm-partopt' + (S.part === o.key ? ' on' : '') + '" role="option" aria-selected="' +
          (S.part === o.key ? 'true' : 'false') + '" data-action="pick-part" data-k="' + esc(o.key || '') + '">' +
          esc(o.label) + '</div>';
      }).join('');
    }
    $('cmStockBtn').setAttribute('aria-checked', S.inStock ? 'true' : 'false');
    $('cmStockMark').textContent = S.inStock ? '●' : '○';
    var narrowed = !!(S.q || S.part || S.inStock);
    $('cmResetBtn').classList.toggle('active', narrowed);
    $('cmFilterNote').textContent = narrowed
      ? '지금 열린 범위(' + fmt(S.list.total) + '건)에는 이 필터가 반영됩니다 — 다른 탭의 배지 숫자는 검색어·부품 종류·재고 필터와 무관하게 항상 전체 기준입니다.'
      : '탭 배지는 페이지가 아니라 각 범위 전체 기준입니다 · 목록은 서버 페이지네이션';
  }

  function renderTree() {
    $('cmModeCat').classList.toggle('on', S.treeMode === 'category');
    $('cmModeCat').setAttribute('aria-pressed', S.treeMode === 'category' ? 'true' : 'false');
    $('cmModeSub').classList.toggle('on', S.treeMode === 'subtree');
    $('cmModeSub').setAttribute('aria-pressed', S.treeMode === 'subtree' ? 'true' : 'false');
    $('cmTreeNote').textContent = S.treeMode === 'subtree'
      ? '노드를 누르면 그 분류와 하위 전체(scope=subtree)를 봅니다.'
      : '노드를 누르면 그 분류 직속만(scope=category) 봅니다.';

    var box = $('cmTreeBody');
    if (S.treeErr) {
      box.innerHTML = '<div class="cm-tree-err">불러오지 못했습니다 — ' + esc(S.treeErr.message) +
        '<br><span class="cm-tree-retry" data-action="retry-tree">다시 시도</span></div>';
      return;
    }
    if (!S.tree) { box.innerHTML = '<div class="cm-tree-empty">불러오는 중…</div>'; return; }
    if (!treeItems().length) { box.innerHTML = '<div class="cm-tree-empty">분류가 없습니다 — "상품 분류 관리"에서 먼저 만드세요.</div>'; return; }

    var rows = [];
    function walk(pid, depth) {
      childrenOf(pid).forEach(function (n) {
        var kids = childrenOf(n.category_id);
        var isCol = !!S.collapsed[n.category_id];
        var on = S.scope === 'category' && S.catId === n.category_id;
        var viol = violUnder(n.category_id);
        var cnt = S.treeMode === 'subtree' ? n.subtree_count : n.product_count;
        rows.push(
          '<button type="button" class="cm-tree-row' + (depth === 0 ? ' top' : '') + (on ? ' on' : '') +
          '" data-action="pick-node" data-id="' + n.category_id + '">' +
            '<span class="indent" style="width:' + (depth * 14) + 'px"></span>' +
            '<span class="caret' + (kids.length ? '' : ' leaf') + '"' +
              (kids.length ? ' data-action="toggle-collapse" data-id="' + n.category_id + '" role="button" aria-label="하위 분류 ' + (isCol ? '펼치기' : '접기') + '"' : '') + '>' +
              (kids.length ? (isCol ? '▸' : '▾') : '·') + '</span>' +
            '<span class="name ' + (depth === 0 ? 'top' : 'sub') + '">' + esc(n.name) + '</span>' +
            (viol ? '<span class="viol">▲' + viol + '</span>' : '') +
            '<span class="cnt num">' + fmt(cnt) + '</span>' +
          '</button>'
        );
        if (!isCol) walk(n.category_id, depth + 1);
      });
    }
    walk(null, 0);
    box.innerHTML = rows.join('');
  }

  function renderTable() {
    var head = $('cmHeadCheck');
    var items = (S.list && S.list.items) || [];
    var pageSelected = items.length > 0 && items.every(function (p) { return S.selectAllScope || S.sel[p.product_code]; });
    head.classList.toggle('on', pageSelected);
    head.setAttribute('aria-checked', pageSelected ? 'true' : 'false');
    head.textContent = pageSelected ? '✓' : '';

    var box = $('cmTbody');
    var html = '';
    var total = S.list.total || 0;
    if (items.length > 0 && total > items.length) {
      html += '<div class="cm-selectbar">' +
        '<span class="tx">' + (S.selectAllScope
          ? '이 조건 전체 ' + fmt(total) + '건을 선택했습니다 — 상한 ' + fmt(S.list.max_move) + '건을 넘는 만큼은 이번에 옮기지 않습니다.'
          : '이 페이지 ' + fmt(items.length) + '건만 보입니다 — 조건 전체는 ' + fmt(total) + '건입니다.') + '</span>' +
        '<button type="button" data-action="toggle-scope-sel">' +
          (S.selectAllScope ? '전체 선택 해제' : '조건 전체 ' + fmt(total) + '건 선택') + '</button></div>';
    }
    if (!items.length) {
      var em = emptyStateFor();
      html += '<div class="cm-listempty"><div class="ti">' + esc(em[0]) + '</div><div class="ds">' + esc(em[1]) + '</div>' +
        (em[2] ? '<button type="button" data-action="go-open-at">' + esc(em[2]) + '</button>' : '') + '</div>';
    } else {
      html += items.map(function (p) {
        var on = S.selectAllScope || !!S.sel[p.product_code];
        var bad = !!p.violates || p.category_id == null;
        var etc = p.part_type === 'ETC';
        var statusLive = p.status === '판매중';
        // 몰 원문 HTML 태그(<font>·<P> 등)가 글자로 새지 않도록 표시 직전에만 벗긴다 —
        // p.name(원본)은 그대로 둔다(2026-08-27, 사장님 발견 결함).
        var nm = Admin2Text.stripHtml(p.name);
        return '<button type="button" class="cm-row' + (on ? ' on' : '') + (bad ? ' flag' : '') +
          '" data-action="toggle-row" data-code="' + p.product_code + '" role="checkbox" aria-checked="' + (on ? 'true' : 'false') +
          '" aria-label="' + esc(nm) + ' 선택">' +
          '<span class="cm-check' + (on ? ' on' : '') + '" aria-hidden="true">' + (on ? '✓' : '') + '</span>' +
          '<span class="nm">' + esc(nm) + '</span>' +
          '<span class="cd num">' + esc(p.product_code) + '</span>' +
          '<span class="pt' + (etc ? ' etc' : '') + '"' + (etc ? ' title="부품 종류 축: ' + esc(etcLabel()) + ' (part_type=ETC)"' : '') + '>' + esc(p.part_label) + '</span>' +
          '<span class="ct' + (bad ? ' warn' : '') + '">' + esc(p.category_id == null ? '(없음)' : p.category) +
            (p.violates ? ' <span title="이 카테고리의 허용 부품 종류와 다릅니다">▲</span>' : '') + '</span>' +
          '<span class="pr num">' + fmt(p.sale_price) + '</span>' +
          '<span class="sk num' + (p.stock_qty ? ' has' : '') + '">' + fmt(p.stock_qty) + '</span>' +
          '<span class="st' + (statusLive ? ' live' : '') + '">' + esc(p.status) + '</span>' +
        '</button>';
      }).join('');
    }
    box.innerHTML = html;
  }

  function emptyStateFor() {
    var openAt = S.list.open_at;
    var etcOnlyN = treeItems().filter(isEtcOnlyCat).length;
    var byScope = {
      unmapped: ['미매핑이 0건입니다', '이 범위에 남은 일이 없다는 뜻일 뿐, 처리할 일이 전혀 없다는 뜻은 아닙니다 — 다른 범위(위반·' + etcLabel() + ')에 남아 있을 수 있습니다.'],
      violation: ['허용 종류 위반이 0건입니다', '지금 조건에서 이 카테고리들의 허용 부품 종류를 어기는 매핑이 없습니다.' +
        (etcOnlyN ? ' 허용 종류가 ' + etcLabel() + '뿐인 소분류가 ' + etcOnlyN + '개 있습니다 — 그 안에서는 이 판정으로 서로 구분되지 않습니다.' : '')],
      unclassified: [etcLabel() + '가 0건입니다', "part_type='ETC'인 상품이 지금 조건에 없습니다."],
      category: [S.catId == null ? '카테고리를 고르지 않았습니다' : '이 분류에 상품이 없습니다',
        S.catId == null ? '왼쪽 트리에서 분류를 누르면 그 분류의 상품을 봅니다.'
          : (S.treeMode === 'subtree' ? '하위 전체 기준입니다 — 직속만 보려면 트리 위 토글을 바꾸세요.' : '직속 기준입니다 — 하위까지 보려면 트리 위 토글을 바꾸세요.')],
      all: ['조건에 맞는 상품이 없습니다', '검색어·부품 종류·재고 필터를 지우면 다시 보입니다.']
    };
    var em = byScope[S.scope] || byScope.all;
    if (S.scope !== openAt) {
      var lbl = { unmapped: '미매핑', violation: '허용 종류 위반', unclassified: etcLabel(), all: '전체' }[openAt] || openAt;
      return [em[0], em[1], '기본 범위(' + lbl + ')로 가기'];
    }
    return [em[0], em[1], ''];
  }

  function renderPager() {
    var total = S.list.total || 0, size = S.list.size || S.pageSize, page = S.list.page || 1, pages = S.list.pages || 1;
    $('cmPageRange').textContent = total ? (((page - 1) * size + 1).toLocaleString('ko-KR') + '–' +
      Math.min(page * size, total).toLocaleString('ko-KR') + ' / ' + fmt(total)) : '0 / 0';
    $('cmPageNote').textContent = '서버 페이지네이션 · ' + size + '건/페이지';
    $('cmPageLabel').textContent = page + ' / ' + pages;
    $('cmPrevBtn').disabled = page <= 1;
    $('cmPrevBtn').title = page <= 1 ? '첫 페이지입니다' : '';
    $('cmNextBtn').disabled = page >= pages;
    $('cmNextBtn').title = page >= pages ? '마지막 페이지입니다' : '';
  }

  function selCount() {
    if (S.selectAllScope) return Math.min(S.list.total || 0, S.list.max_move || Infinity);
    return Object.keys(S.sel).filter(function (k) { return S.sel[k]; }).length;
  }
  function selCountRaw() { return S.selectAllScope ? (S.list.total || 0) : selCount(); }

  function renderBar() {
    var canWrite = owner();
    var sc = selCount();
    var maxMove = S.list.max_move;
    var bar = $('cmBar');
    bar.classList.toggle('active', sc > 0);
    $('cmSelCount').textContent = fmt(sc) + '건 선택';
    var overLimit = selCountRaw() > maxMove;
    $('cmLimitNote').textContent = overLimit
      ? '상한 ' + fmt(maxMove) + '건 초과 — 이번에는 ' + fmt(maxMove) + '건만 옮기고 나머지 ' + fmt(selCountRaw() - maxMove) + '건은 남습니다'
      : '한 번에 ' + fmt(maxMove) + '건까지';
    $('cmLimitNote').classList.toggle('over', overLimit);
    $('cmClearSelBtn').hidden = sc === 0;

    var target = S.target == null ? null : nodeById(S.target);
    var tbtn = $('cmTargetBtn');
    tbtn.disabled = !canWrite;
    tbtn.title = canWrite ? '' : permText();
    tbtn.classList.toggle('set', !!target);
    tbtn.setAttribute('aria-expanded', S.targetOpen ? 'true' : 'false');
    $('cmTargetLabel').textContent = target ? catPath(target.category_id) : '대상 분류 선택';
    $('cmTargetWarn').textContent = target
      ? (target.allowed_labels && target.allowed_labels.length ? '허용 ' + target.allowed_labels.join(' · ') : '제한 없음') : '';
    $('cmTargetDrop').hidden = !S.targetOpen;
    if (S.targetOpen) {
      var opts = treeItems().filter(function (x) { return x.parent_id != null; })
        .sort(function (a, b) { return catPath(a.category_id).localeCompare(catPath(b.category_id)); });
      $('cmTargetDrop').innerHTML = opts.map(function (o) {
        var types = o.allowed_labels && o.allowed_labels.length ? o.allowed_labels.join(', ') : '제한 없음';
        return '<div class="cm-targetopt' + (S.target === o.category_id ? ' on' : '') + '" role="option" aria-selected="' +
          (S.target === o.category_id ? 'true' : 'false') + '" data-action="pick-target" data-id="' + o.category_id + '">' +
          '<span class="lb">' + esc(catPath(o.category_id)) + '</span><span class="ty">' + esc(types) + '</span></div>';
      }).join('');
    }

    var mbtn = $('cmMoveBtn');
    var canMove = canWrite && sc > 0 && target;
    mbtn.disabled = !canMove;
    mbtn.textContent = target ? (target.name + '(으)로 이동') : '이동';
    mbtn.title = !canWrite ? permText() : (sc === 0 ? '옮길 상품을 먼저 선택하세요' : (!target ? '대상 분류를 먼저 고르세요' : ''));

    var remBox = $('cmRemainder');
    remBox.hidden = !S.remainder;
    if (S.remainder) $('cmRemainderN').textContent = fmt(S.remainder);

    var blocked = $('cmBlockedNote');
    blocked.hidden = canWrite;
    if (!canWrite) blocked.textContent = permText() + ' — 조회는 되지만 이동·되돌리기는 막힙니다.';
  }

  function renderRail() {
    var btn = $('cmRecentBtn');
    btn.classList.toggle('open', S.recentOpen);
    btn.setAttribute('aria-expanded', S.recentOpen ? 'true' : 'false');
    $('cmRecentCount').textContent = S.moves.length ? String(S.moves.length) : '';
    var pop = $('cmRecentPop');
    pop.hidden = !S.recentOpen;
    if (!S.recentOpen) return;
    if (!S.moves.length) {
      pop.innerHTML = '<div class="hd">최근 이동 · 되돌리기</div>' +
        '<div class="cm-recent-empty">이 세션에서 옮긴 것이 없습니다.<br>이 화면은 세션 중 실행한 이동만 보여줍니다.</div>';
      return;
    }
    var canWrite = owner();
    pop.innerHTML = '<div class="hd">최근 이동 · 되돌리기</div>' + S.moves.map(function (m) {
      return '<div class="cm-recent-row"><div class="r1"><span class="at num">' + esc(m.at) + '</span>' +
        '<span class="lg num">log_id ' + m.logId + '</span><span style="flex:1"></span>' +
        (m.undone ? '<span class="cm-undone-b">되돌려짐</span>' : '') +
        '<button type="button" class="cm-undo-a" data-action="undo-move" data-lid="' + m.logId + '"' +
          ((m.undone || !canWrite) ? ' disabled title="' + esc(m.undone ? '이미 되돌린 기록입니다' : permText()) + '"' : '') +
          '>되돌리기</button></div>' +
        '<div class="what">' + esc(m.what) + '</div></div>';
    }).join('');
  }

  // ── 동작 ─────────────────────────────────────────────────────────
  function closePopovers() { S.partOpen = false; S.targetOpen = false; S.recentOpen = false; }

  function doMove() {
    if (!guard()) return;
    var sc = selCount();
    if (sc === 0) { toast('옮길 상품을 선택해야 합니다', 'err'); return; }
    if (S.target == null) { toast('대상 분류를 고르세요', 'err'); return; }
    var maxMove = S.list.max_move;

    var codesPromise = S.selectAllScope
      ? collectCodes(maxMove)
      : Promise.resolve({ codes: Object.keys(S.sel).filter(function (k) { return S.sel[k]; }).map(Number), total: sc });

    codesPromise.then(function (r) {
      var codes = r.codes;
      var remainder = Math.max(0, (r.total || codes.length) - codes.length);
      if (!codes.length) { toast('옮길 상품을 선택해야 합니다', 'err'); return; }
      apiPost('/api/admin/category-mapping/move', { product_codes: codes, category_id: S.target }).then(function (res) {
        var at = new Date().toISOString().slice(0, 16).replace('T', ' ');
        S.moves.unshift({ logId: res.log_id, at: at, undone: false, what: res.verdict });
        S.selectAllScope = false; S.sel = {}; S.remainder = remainder;
        reloadKeepView(1).then(function () { renderRail(); });
      }).catch(function (err) { toast(err.message, 'err'); });
    });
  }

  function doUndo(logId) {
    if (!guard()) return;
    var m = S.moves.filter(function (x) { return x.logId === logId; })[0];
    if (!m || m.undone) return;
    apiPost('/api/admin/category-mapping/undo', { log_id: logId }).then(function (res) {
      m.undone = true;
      reloadKeepView((S.list && S.list.page) || 1).then(function () { renderRail(); });
      toast(res.verdict || '되돌렸습니다', 'ok');
    }).catch(function (err) { toast(err.message, 'err'); });
  }

  document.addEventListener('click', function (e) {
    var open = S.partOpen || S.targetOpen || S.recentOpen;
    if (open && !window.Admin2Shell.isKeepClick(e.target)) { closePopovers(); renderFilters(); renderBar(); renderRail(); }

    var t = e.target.closest('[data-action]');
    if (!t) return;
    var action = t.getAttribute('data-action');
    switch (action) {
      case 'retry-boot': S.list = null; S.listErr = null; S.tree = null; S.treeErr = null; boot(); break;
      case 'retry-tree': S.treeErr = null; renderTree(); loadTree().then(function () { renderTree(); renderBar(); }); break;
      case 'pick-tab': {
        var scope = t.getAttribute('data-scope');
        if (scope === 'category' && S.catId == null) { toast('scope=category에는 category_id가 필요합니다 — 왼쪽 트리에서 분류를 고르세요', 'warn'); break; }
        setScope(scope); break;
      }
      case 'toggle-part': e.stopPropagation(); S.partOpen = !S.partOpen; S.targetOpen = false; S.recentOpen = false; renderFilters(); break;
      case 'pick-part': {
        e.stopPropagation();
        var k = t.getAttribute('data-k') || null;
        S.part = k; S.partOpen = false; S.page = 1; S.remainder = 0;
        reloadKeepView(1); break;
      }
      case 'toggle-stock': S.inStock = !S.inStock; S.page = 1; S.remainder = 0; reloadKeepView(1); break;
      case 'reset-filters': S.q = ''; S.part = null; S.inStock = false; S.page = 1; S.remainder = 0; reloadKeepView(1); break;
      case 'set-treemode': setTreeMode(t.getAttribute('data-m')); break;
      case 'toggle-collapse': {
        e.stopPropagation();
        var cid = Number(t.getAttribute('data-id'));
        S.collapsed[cid] = !S.collapsed[cid];
        renderTree(); break;
      }
      case 'pick-node': {
        var nid = Number(t.getAttribute('data-id'));
        setScope('category', nid); break;
      }
      case 'toggle-page-all': {
        e.stopPropagation();
        var items = (S.list && S.list.items) || [];
        var pageSelected = items.length > 0 && items.every(function (p) { return S.selectAllScope || S.sel[p.product_code]; });
        if (pageSelected) { S.sel = {}; } else {
          var next = {}; items.forEach(function (p) { next[p.product_code] = true; });
          S.sel = next;
        }
        S.selectAllScope = false;
        renderTable(); renderBar(); break;
      }
      case 'toggle-row': {
        var code = Number(t.getAttribute('data-code'));
        if (S.selectAllScope) { S.selectAllScope = false; S.sel = {}; }
        S.sel[code] = !S.sel[code];
        renderTable(); renderBar(); break;
      }
      case 'toggle-scope-sel': {
        e.stopPropagation();
        S.selectAllScope = !S.selectAllScope;
        S.sel = {};
        renderTable(); renderBar(); break;
      }
      case 'go-open-at': setScope(S.list.open_at); break;
      case 'page-prev': if ((S.list.page || 1) > 1) { S.sel = {}; S.selectAllScope = false; reloadKeepView((S.list.page || 1) - 1); } break;
      case 'page-next': if ((S.list.page || 1) < (S.list.pages || 1)) { S.sel = {}; S.selectAllScope = false; reloadKeepView((S.list.page || 1) + 1); } break;
      case 'clear-sel': S.sel = {}; S.selectAllScope = false; renderTable(); renderBar(); break;
      case 'toggle-target': e.stopPropagation(); if (!guard()) break; S.targetOpen = !S.targetOpen; S.partOpen = false; S.recentOpen = false; renderBar(); break;
      case 'pick-target': {
        e.stopPropagation();
        S.target = Number(t.getAttribute('data-id')); S.targetOpen = false;
        renderBar(); break;
      }
      case 'do-move': doMove(); break;
      case 'reselect-remainder': {
        S.selectAllScope = true; S.sel = {}; S.remainder = 0;
        renderTable(); renderBar();
        toast('남은 건을 다시 선택했습니다 — 대상 분류를 확인하고 실행하세요', 'ok');
        break;
      }
      case 'toggle-recent': e.stopPropagation(); S.recentOpen = !S.recentOpen; S.partOpen = false; S.targetOpen = false; renderRail(); break;
      case 'undo-move': doUndo(Number(t.getAttribute('data-lid'))); break;
      default: break;
    }
  });

  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    if (S.partOpen || S.targetOpen || S.recentOpen) { closePopovers(); renderFilters(); renderBar(); renderRail(); }
  });

  document.addEventListener('input', function (e) {
    if (e.target.id !== 'cmSearch') return;
    S.q = e.target.value;
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(function () { S.page = 1; S.remainder = 0; reloadKeepView(1); }, 300);
  });
  document.addEventListener('keydown', function (e) {
    if (e.target.id === 'cmSearch' && e.key === 'Enter') {
      clearTimeout(searchDebounce); S.page = 1; S.remainder = 0; reloadKeepView(1);
    }
  });

  // 가로 스크롤 동기화 — 결함2 3차 수정(2026-08-14): 이름 열(:317,:327 부근
  // minmax(180px,1fr))에 최소폭을 주면서 좁은 화면에서 목록이 가로로 흘러넘친다
  // (.cm-tbody가 overflow:auto라 자동으로 스크롤 막대가 생긴다). 헤더(.cm-thead)는
  // overflow-x:hidden이라 자체 스크롤 막대는 없지만 내부 그리드 폭은 행과 똑같이
  // 넓어서 잘려 있을 뿐이다 — 본문을 가로로 움직이면 헤더도 같은 만큼 scrollLeft를
  // 옮겨야 라벨과 셀이 계속 같은 열을 가리킨다(실측: 동기화 전에는 본문을 스크롤해도
  // 헤더가 전혀 안 움직여 라벨-데이터가 어긋났다). #cmTbody는 매 렌더마다 innerHTML만
  // 바뀌고 엘리먼트 자체는 재생성되지 않으므로 리스너를 한 번만 붙인다.
  // (참고 — JS 폭 보정은 뺐다: 이전엔 .cm-thead 의 grid-template-columns 계산값이
  // 뷰포트를 바꿔도 안 바뀌는 브라우저 현상이 있어 매 렌더·리사이즈마다 행의 계산값을
  // 헤더에 복사하는 syncTheadCols() 를 뒀는데, 이름 열에 minmax(180px,1fr) 최소폭을
  // 준 뒤로는 그 현상이 재현되지 않았다 — 함수를 끈 채 뷰포트 1024·1280·1440·1920,
  // 스크롤 있음/없음, 라이브 리사이즈(1440→1024, 1024→1920)까지 전부 어긋남 0px를
  // 실측으로 확인하고 제거했다. 코드가 스스로 도는 보정은 리사이즈·필터·페이지 전환
  // 마다 다시 어긋날 여지를 남기므로, CSS만으로 풀리면 남겨두지 않는다.)
  var cmTbodyScrollEl = $('cmTbody');
  if (cmTbodyScrollEl) {
    cmTbodyScrollEl.addEventListener('scroll', function () {
      var thead = document.querySelector('.cm-thead');
      if (thead) thead.scrollLeft = cmTbodyScrollEl.scrollLeft;
    });
  }

  boot();
})();
</script>
{% endraw %}
{% endblock %}
