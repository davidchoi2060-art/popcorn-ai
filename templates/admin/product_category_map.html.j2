      <input type="text" id="cmSearch" class="cm-search" placeholder="상품명 · 상품코드 검색" autocomplete="off">
      <div class="cm-partbox">
        <button type="button" class="cm-partbtn" id="cmPartBtn" data-action="toggle-part"
                aria-haspopup="listbox" aria-expanded="false">
          <span id="cmPartLabel">부품 종류 · 전체</span><span class="car">▼</span>
        </button>
        <div class="cm-partdrop" id="cmPartDrop" role="listbox" hidden></div>
      </div>
      <button type="button" class="cm-stockbtn" id="cmStockBtn" data-action="toggle-stock"
              role="switch" aria-checked="false">
        <span class="mk" id="cmStockMark">○</span><span>재고 있는 것만</span>
      </button>
      <button type="button" class="cm-resetlink" id="cmResetBtn" data-action="reset-filters">필터 초기화</button>
      <span class="cm-filternote" id="cmFilterNote"></span>
