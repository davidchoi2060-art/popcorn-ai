{% block content %}
<div class="pv-root">
  <div class="pv-loading" id="pvLoading"><div>불러오는 중…</div></div>

  <div class="pv-errbox" id="pvErrBox" hidden>
    <div class="ti">조회 실패</div>
    <div class="ds" id="pvErrMsg"></div>
    <button type="button" data-action="retry-load">다시 시도</button>
  </div>

  <div class="pv-body" id="pvBody" hidden>
    <div class="pv-banner">
      <span class="mk">경계</span>
      <span class="hd">엔진은 이 트리를 읽지 않습니다 — 분류를 옮겨도 견적 결과는 바뀌지 않습니다</span>
      <span class="ds">부품 종류(part_type, 엔진이 읽는 닫힌 집합)와 다른 축입니다. 이 화면은 대분류 → 중분류 → 소분류 → 세분류를 한 화면에서 이어서 관리하는 신규 시안입니다(ADM-CAT-011 가칭) — 기존 「상품 분류 관리」와 같은 데이터를 씁니다.</span>
    </div>

    <div class="pv-toolbar">
      <div class="ttl-wrap">
        <h1>상품 분류 관리(신규)</h1>
        <p class="sub">대분류 → 중분류 → 소분류 → 세분류를 한 화면에서 연속으로 관리합니다.</p>
      </div>
      <div class="actions">
        <button type="button" class="pv-btn-save-all" id="pvSaveAll" data-action="save-all">전체 저장</button>
      </div>
    </div>

    <div class="pv-usage">
      <b>사용법</b> · 각 분류 상단의 <b>[+ 생성]</b>으로 새 카테고리를 만들고, 카테고리명을 직접 수정한 뒤 <b>[변경 저장]</b>을 누르면 반영됩니다. <b>카테고리명을 빈칸으로 만든 뒤 저장하면 삭제</b>됩니다. 컬럼에서 분류를 고르면(점 또는 › 단추) 그 아래 하위 컬럼이 열립니다.
    </div>

    <div class="pv-cols" id="pvCols"></div>

    <div class="pv-delrule">
      <b>삭제 규칙</b> · 카테고리명을 지우고 [변경 저장]을 누르면 삭제됩니다. 단, 해당 카테고리 아래에 하위 카테고리가 있거나 매핑된 상품이 있으면 삭제되지 않고 대화상자로 이유가 표시됩니다.
    </div>
  </div>

  <div class="pv-backdrop" id="pvDialogBd" hidden>
    <div class="pv-dialog" data-keep="1">
      <div class="ti">카테고리를 삭제할 수 없습니다</div>
      <div class="bd" id="pvDialogBody"></div>
      <button type="button" class="ok" data-action="close-dialog">확인</button>
    </div>
  </div>
</div>
{% endblock %}

{% block foot_extra %}
{% raw %}
<script>
(function () {
  'use strict';

  var LEVELS = ['대분류', '중분류', '소분류', '세분류'];

  var S = {
    data: null, loadErr: null,
    selected: [null, null, null, null],
    drafts: {},          // category_id -> 편집 중인 이름(문자열)
    dialog: null          // 삭제 차단 메시지(문자열) — 있으면 대화상자가 뜬다
  };

  function $(id) { return document.getElementById(id); }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function fmt(n) { return (n == null) ? '—' : Number(n).toLocaleString('ko-KR'); }

  // ── API ──────────────────────────────────────────────────────────
  function handle(res) {
    return res.clone().json().catch(function () { return null; }).then(function (j) {
      if (!res.ok) {
        var msg = (window.popcornProgress && window.popcornProgress.errText)
          ? window.popcornProgress.errText(j, res.status, '') : ('오류 ' + res.status);
        var e = new Error(msg); e.status = res.status; e.body = j; throw e;
      }
      return j;
    });
  }
  function apiGet(path) { return fetch(path, { credentials: 'same-origin' }).then(handle); }
  function apiJson(method, path, body) {
    return fetch(path, { method: method, credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) }).then(handle);
  }
  function apiPost(path, body) { return apiJson('POST', path, body); }
  function apiPatch(path, body) { return apiJson('PATCH', path, body); }
  function apiDelete(path) { return fetch(path, { method: 'DELETE', credentials: 'same-origin' }).then(handle); }

  // ── 권한 · 토스트 — 셸(admin2-shell.js)의 것을 그대로 쓴다 ──
  // ⚠ 실제 서버 문턱은 operator 이상이다(파일 상단 "■★ 권한" 주석 참고) — 이
  // 화면은 서버가 실제로 허용하는 등급을 그대로 반영한다. "owner만"으로
  // 지어내지 않는다.
  function canWrite() { return window.Admin2Shell.canWrite('operator'); }
  function toast(msg, kind) { window.Admin2Shell.toast(msg, kind); }
  function guard() {
    if (!canWrite()) {
      var me = window.Admin2Shell.getMe();
      toast('권한이 부족합니다(필요: operator, 현재: ' + (me ? me.role : '(로그인 필요)') + ')', 'err');
      return false;
    }
    return true;
  }
  function permTitle() {
    var me = window.Admin2Shell.getMe();
    return '권한이 부족합니다(필요: operator, 현재: ' + (me ? me.role : '(로그인 필요)') + ')';
  }
  function disAttrs(disabled) {
    return disabled ? (' disabled title="' + esc(permTitle()) + '"') : '';
  }

  // ── 트리 데이터 헬퍼 ─────────────────────────────────────────────
  function items() { return (S.data && S.data.items) || []; }
  function nodeById(id) {
    var arr = items();
    for (var i = 0; i < arr.length; i++) if (arr[i].category_id === id) return arr[i];
    return null;
  }
  function childrenOf(pid) {
    return items().filter(function (n) { return n.parent_id === pid; })
      .sort(function (a, b) { return (a.sort_order - b.sort_order) || String(a.name).localeCompare(String(b.name)); });
  }

  // 컬럼 i의 정의 — **선택 상태에서 파생**한다(고정 깊이 아님). 컬럼 0의 부모는
  // 항상 null(최상위). 컬럼 i(i>0)의 부모는 "컬럼 i-1에서 고른 노드"고, 아직
  // 아무것도 안 골랐으면 그 컬럼은 잠긴다.
  function columnAt(i) {
    var parentId = i === 0 ? null : S.selected[i - 1];
    var locked = i > 0 && parentId == null;
    var parentNode = parentId != null ? nodeById(parentId) : null;
    var kids = locked ? [] : childrenOf(parentId);
    return { i: i, title: LEVELS[i], parentId: parentId, locked: locked, parentNode: parentNode, kids: kids };
  }

  function selectNode(i, id) {
    if (S.selected[i] === id) return;
    var next = S.selected.slice();
    next[i] = id;
    for (var k = i + 1; k < 4; k++) next[k] = null;
    S.selected = next;
    renderColsFrom(i + 1);
    highlightColumn(i);   // 선택 강조만 갱신 — innerHTML을 다시 쓰면 이름 입력에
                           // 포커스가 가 있을 때(onFocus로 select가 불리는 경우
                           // 포함) 그 포커스가 즉시 날아간다(입력 한 글자도 못 침).
    renderToolbar();
  }

  // 컬럼 i의 행 DOM을 다시 만들지 않고 선택 표시(.on)만 옮긴다 — 이름 입력이
  // 그 컬럼 안에 있을 수 있어(포커스로 select가 트리거된 경우) innerHTML 교체를
  // 피한다("입력 중 전체 재렌더 금지" 원칙, ADM-CAT-010과 같은 이유).
  function highlightColumn(i) {
    var el = $('pvCol' + i);
    if (!el) return;
    var rows = el.querySelectorAll('.pv-row');
    for (var r = 0; r < rows.length; r++) {
      var id = Number(rows[r].getAttribute('data-id'));
      rows[r].classList.toggle('on', id === S.selected[i]);
    }
  }

  // ── 쓰기 동작 ────────────────────────────────────────────────────
  function createIn(i) {
    if (!guard()) return;
    var col = columnAt(i);
    if (col.locked) return;
    var defaultName = '새 ' + LEVELS[i];
    var dup = col.kids.filter(function (n) { return n.name === defaultName; })[0];
    if (dup) { selectNode(i, dup.category_id); return; }
    apiPost('/api/admin/categories', { name: defaultName, parent_id: col.parentId, sort_order: 0 })
      .then(function (r) {
        return reloadTree().then(function () {
          selectNode(i, r.category_id);
          toast(r.verdict, 'ok');
        });
      })
      .catch(function (err) { toast(err.message, 'err'); });
  }

  function toggleVisible(node) {
    if (!guard()) return;
    var next = !node.is_visible;
    apiPatch('/api/admin/categories/' + node.category_id, { is_visible: next })
      .then(function (r) { node.is_visible = next; toast(r.verdict, 'ok'); renderAll(); })
      .catch(function (err) { toast(err.message, 'err'); renderAll(); });
  }

  // 여러 category_id를 한 번에 저장한다 — 컬럼별 [변경 저장]과 상단 [전체
  // 저장]이 이 함수 하나를 쓴다. 이름이 빈칸이면 삭제(DELETE), 원래 이름과
  // 다르면 수정(PATCH), 같으면 손대지 않는다. 서버 409(자식/상품이 걸림)는
  // 대화상자로, 그 외 오류는 토스트로 그대로 보여준다 — 문구를 지어내지 않는다.
  function saveIds(ids) {
    ids = ids.filter(function (id) { return id in S.drafts; });
    if (!ids.length) return;
    if (!guard()) return;
    var jobs = ids.map(function (id) {
      var node = nodeById(id);
      if (!node) { delete S.drafts[id]; return Promise.resolve({ id: id, ok: true, skipped: true }); }
      var name = String(S.drafts[id] || '').trim();
      if (name === '') {
        return apiDelete('/api/admin/categories/' + id)
          .then(function (r) { return { id: id, ok: true, verdict: r.verdict }; })
          .catch(function (err) { return { id: id, ok: false, err: err }; });
      }
      if (name === node.name) { return Promise.resolve({ id: id, ok: true, skipped: true }); }
      return apiPatch('/api/admin/categories/' + id, { name: name })
        .then(function (r) { return { id: id, ok: true, verdict: r.verdict }; })
        .catch(function (err) { return { id: id, ok: false, err: err }; });
    });
    Promise.all(jobs).then(function (results) {
      var blocked = null, okCount = 0;
      results.forEach(function (r) {
        if (r.ok) { if (!r.skipped) okCount++; delete S.drafts[r.id]; }
        else if (r.err && r.err.status === 409) { blocked = blocked || r.err.message; }
        else { toast((r.err && r.err.message) || '저장 실패', 'err'); }
      });
      if (okCount) toast(okCount + '건 저장했습니다', 'ok');
      if (blocked) { S.dialog = blocked; }
      if (okCount) { reloadTree(); } else { renderAll(); }
    });
  }

  // ── 로드 ─────────────────────────────────────────────────────────
  function loadTree() {
    return apiGet('/api/admin/categories').then(function (j) { S.data = j; S.loadErr = null; })
      .catch(function (err) { S.loadErr = err; });
  }
  function reloadTree() { return loadTree().then(renderAll); }

  function boot() {
    renderAll();
    window.Admin2Shell.meReady.then(renderAll);
    loadTree().then(renderAll);
  }

  // ── 렌더 ─────────────────────────────────────────────────────────
  function renderAll() {
    var loading = $('pvLoading'), errBox = $('pvErrBox'), body = $('pvBody');
    if (S.loadErr) {
      loading.hidden = true; body.hidden = true; errBox.hidden = false;
      $('pvErrMsg').textContent = S.loadErr.message;
      return;
    }
    if (!S.data) { loading.hidden = false; errBox.hidden = true; body.hidden = true; return; }
    loading.hidden = true; errBox.hidden = true; body.hidden = false;
    for (var i = 0; i < 4; i++) renderColumn(i);
    renderToolbar();
    renderDialog();
  }

  function renderColsFrom(startIdx) {
    for (var i = startIdx; i < 4; i++) renderColumn(i);
  }

  function rowHtml(i, n) {
    var isSel = S.selected[i] === n.category_id;
    var dirty = n.category_id in S.drafts;
    var val = dirty ? S.drafts[n.category_id] : n.name;
    var isLeafCol = (i === 3);
    var write = canWrite();
    return '<div class="pv-row' + (isSel ? ' on' : '') + '" data-id="' + n.category_id + '" data-idx="' + i + '">' +
      '<button type="button" class="dot" data-action="select-node" data-idx="' + i + '" data-id="' + n.category_id + '" title="선택"><span></span></button>' +
      '<input class="name-in' + (dirty ? ' dirty' : '') + '" type="text" data-role="name-in" data-idx="' + i + '" data-id="' + n.category_id + '" value="' + esc(val) + '" placeholder="빈칸 저장 시 삭제"' + (write ? '' : ' disabled') + '>' +
      '<label class="vis" title="노출"><input type="checkbox" data-action="toggle-visible" data-idx="' + i + '" data-id="' + n.category_id + '"' + (n.is_visible ? ' checked' : '') + (write ? '' : ' disabled') + '>노출</label>' +
      '<button type="button" class="child" data-action="select-node" data-idx="' + i + '" data-id="' + n.category_id + '" title="하위 분류 보기"' + (isLeafCol ? ' disabled' : '') + '>' + (isLeafCol ? '' : '›') + '</button>' +
      '</div>';
  }

  function renderColumn(i) {
    var el = $('pvCol' + i);
    if (!el) return;
    var col = columnAt(i);
    var write = canWrite();
    var dirtyIds = col.kids.map(function (n) { return n.category_id; }).filter(function (id) { return id in S.drafts; });

    var parentHint = i === 0 ? '최상위 분류'
      : col.locked ? (LEVELS[i - 1] + '를 먼저 선택하세요.')
      : ((col.parentNode ? col.parentNode.name : '') + ' › ' + col.title);

    var rowsHtml = col.locked
      ? '<div class="pv-empty">' + esc(LEVELS[i - 1] + '를 먼저 선택하면 이 컬럼이 열립니다.') + '</div>'
      : (col.kids.length ? col.kids.map(function (n) { return rowHtml(i, n); }).join('')
         : '<div class="pv-empty">' + esc(col.title + '가 없습니다. [+ 생성]으로 추가하세요.') + '</div>');

    el.className = 'pv-col' + (col.locked ? ' locked' : '');
    el.innerHTML =
      '<div class="pv-col-hd">' +
        '<span class="step">0' + (i + 1) + '</span>' +
        '<h4>' + esc(col.title) + '</h4>' +
        '<span class="cnt num">' + fmt(col.kids.length) + '개</span>' +
        '<button type="button" class="add' + ((col.locked || !write) ? ' dis' : '') + '" data-action="add-node" data-idx="' + i + '"' +
          (col.locked ? ' disabled title="상위 분류를 먼저 고르세요"' : disAttrs(!write)) + '>+ 생성</button>' +
      '</div>' +
      '<div class="pv-parenthint">' + esc(parentHint) + '</div>' +
      '<div class="pv-rows">' + rowsHtml + '</div>' +
      '<div class="pv-col-ft">' +
        '<span class="dirty-nt">' + (dirtyIds.length ? ('변경 ' + fmt(dirtyIds.length) + '건 미저장') : '변경 없음') + '</span>' +
        '<button type="button" class="save' + ((!dirtyIds.length || !write) ? ' dis' : '') + '" data-action="save-col" data-idx="' + i + '"' +
          (!dirtyIds.length ? ' disabled' : disAttrs(!write)) + '>변경 저장</button>' +
      '</div>';
  }

  function renderToolbar() {
    var allDirty = Object.keys(S.drafts).length;
    var btn = $('pvSaveAll');
    if (!btn) return;
    var write = canWrite();
    btn.classList.toggle('dis', !allDirty || !write);
    if (!allDirty) { btn.disabled = true; btn.removeAttribute('title'); }
    else if (!write) { btn.disabled = true; btn.title = permTitle(); }
    else { btn.disabled = false; btn.removeAttribute('title'); btn.title = ''; }
    btn.textContent = allDirty ? ('전체 저장 (' + allDirty + ')') : '전체 저장';
  }

  function renderDialog() {
    var bd = $('pvDialogBd');
    if (!S.dialog) { bd.hidden = true; return; }
    bd.hidden = false;
    $('pvDialogBody').textContent = S.dialog;
  }

  // ── 입력 중 가벼운 갱신(전체 재렌더 금지 — 커서가 튄다) ──────────
  function onNameInput(inputEl) {
    var id = Number(inputEl.getAttribute('data-id'));
    var node = nodeById(id);
    S.drafts[id] = inputEl.value;
    inputEl.classList.toggle('dirty', node ? inputEl.value !== node.name : true);
    var idx = Number(inputEl.getAttribute('data-idx'));
    patchColumnFooter(idx);
    renderToolbar();
  }

  function patchColumnFooter(i) {
    var el = $('pvCol' + i);
    if (!el) return;
    var col = columnAt(i);
    var write = canWrite();
    var dirtyIds = col.kids.map(function (n) { return n.category_id; }).filter(function (id) { return id in S.drafts; });
    var nt = el.querySelector('.pv-col-ft .dirty-nt');
    var save = el.querySelector('.pv-col-ft .save');
    if (nt) nt.textContent = dirtyIds.length ? ('변경 ' + fmt(dirtyIds.length) + '건 미저장') : '변경 없음';
    if (save) {
      var disabled = !dirtyIds.length || !write;
      save.classList.toggle('dis', disabled);
      save.disabled = disabled;
      if (!dirtyIds.length) save.removeAttribute('title');
      else if (!write) save.title = permTitle();
      else save.removeAttribute('title');
    }
  }

  // ── 컬럼 컨테이너 초기 배치 ──────────────────────────────────────
  (function initCols() {
    var wrap = $('pvCols');
    var html = '';
    for (var i = 0; i < 4; i++) html += '<section class="pv-col" id="pvCol' + i + '"></section>';
    wrap.innerHTML = html;
  })();

  // ── 이벤트 위임 ──────────────────────────────────────────────────
  document.addEventListener('click', function (e) {
    var t = e.target.closest('[data-action]');
    if (!t) return;
    var action = t.getAttribute('data-action');
    switch (action) {
      case 'retry-load':
        S.loadErr = null; renderAll(); loadTree().then(renderAll);
        break;
      case 'add-node':
        createIn(Number(t.getAttribute('data-idx')));
        break;
      case 'select-node':
        selectNode(Number(t.getAttribute('data-idx')), Number(t.getAttribute('data-id')));
        break;
      case 'save-col': {
        var i = Number(t.getAttribute('data-idx'));
        saveIds(columnAt(i).kids.map(function (n) { return n.category_id; }));
        break;
      }
      case 'save-all':
        saveIds(Object.keys(S.drafts).map(Number));
        break;
      case 'close-dialog':
        S.dialog = null; renderDialog();
        break;
    }
  });

  // 대화상자 바깥(반투명 배경) 클릭으로 닫기 — 이 노드는 innerHTML로 다시
  // 그려지지 않는 정적 요소라 위임이 아니라 직접 바인딩한다. 안쪽(.pv-dialog)
  // 클릭이 배경까지 버블돼도 target이 배경 자신일 때만 닫는다.
  $('pvDialogBd').addEventListener('click', function (e) {
    if (e.target === e.currentTarget) { S.dialog = null; renderDialog(); }
  });

  document.addEventListener('input', function (e) {
    if (e.target.matches('[data-role="name-in"]')) onNameInput(e.target);
  });
  document.addEventListener('focusin', function (e) {
    if (e.target.matches('[data-role="name-in"]')) {
      selectNode(Number(e.target.getAttribute('data-idx')), Number(e.target.getAttribute('data-id')));
    }
  });
  document.addEventListener('change', function (e) {
    if (e.target.matches('[data-action="toggle-visible"]')) {
      var id = Number(e.target.getAttribute('data-id'));
      var node = nodeById(id);
      if (node) toggleVisible(node); else e.target.checked = !e.target.checked;
    }
  });

  boot();
})();
</script>
{% endraw %}
{% endblock %}
