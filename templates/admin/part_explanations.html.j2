{% extends "admin/_admin2_shell.html.j2" %}
{% block title %}부품 관리{% endblock %}
{% block head_extra %}<link rel="stylesheet" href="/shared/parts-management.css?v=20261002-1">{% endblock %}
{% block content %}
<main class="pm">
<header class="pm-heading"><div><h1>부품 관리</h1><p>사양과 고객 설명, 보완할 정보를 한곳에서 확인합니다.</p></div><div class="pm-actions"><button class="primary" id="pm-ai-top">AI 보완 제안</button><a href="/admin2/catalog-import">자료 가져오기</a></div></header>
<section class="pm-filters" aria-label="부품 검색 조건"><input id="pm-q" maxlength="100" aria-label="부품 검색" placeholder="제품명 · 상품 코드 · 주요 사양 검색"><select id="pm-sale" aria-label="판매 상태"><option value="">판매 상태 전체</option><option>판매중</option><option>품절</option><option>단종</option></select><select id="pm-review" aria-label="보완 상태"><option value="">보완 상태 전체</option><option value="needs">보완 필요</option><option value="pending">검토 대기</option><option value="approved">승인 기록</option><option value="retired">보관</option></select><select id="pm-limit" aria-label="표시 수"><option value="10">10개</option><option value="20" selected>20개</option><option value="30">30개</option></select><label class="pm-owned"><input type="checkbox" id="pm-owned">DB 보유 부품만</label><nav class="pm-slots" aria-label="부품 종류"><button data-slot="">전체</button>{% for value,label in part_slots %}<button data-slot="{{value}}">{{label}}</button>{% endfor %}</nav></section>
<p class="pm-message" id="pm-message" role="status" aria-live="polite"></p>
<div class="pm-grid"><section class="pm-list-card"><header><h2>부품 목록</h2><span id="pm-count">불러오는 중</span></header><div class="pm-list-scroll"><table class="pm-table"><thead><tr><th><input type="checkbox" id="pm-select-page" aria-label="현재 페이지 전체 선택"></th><th>부품 · 제품명</th><th>주요 사양</th><th>판매가</th><th>설명 검토</th></tr></thead><tbody id="pm-rows"></tbody></table></div><footer class="pm-pagination"><button id="pm-batch">선택 항목 보완 제안</button><div><button id="pm-prev">이전</button><span id="pm-page"></span><button id="pm-next">다음</button></div><small>표시 수와 검색 조건 유지</small></footer></section><aside class="pm-detail-card" aria-label="부품 상세"><header><h2 id="pm-detail-title" tabindex="-1">부품 상세</h2><button id="pm-back" class="pm-back">목록으로</button></header><div id="pm-detail" class="pm-detail-body"><p class="pm-empty">목록에서 부품 선택</p></div></aside></div>
</main>
{% endblock %}
{% block foot_extra %}<script src="/shared/parts-management.js?v=20261002-1"></script>{% endblock %}
