{#
  신 관리자 첫 화면 「운영 현황」(ADM-DASH-020) — 코덱스 기획안 v1(2026-10-12), 사장님 확정
  「추천한대로 하자」. 데이터는 전부 `api/admin_home_overview.build()` 가 채운다. 이 파일은
  표시만 한다 — 숫자를 만들지 않는다.

  카드 상태 다섯: ok · warn · zero(정상 0건) · error(조회 실패) · none(집계 미연결).
  「—」 는 값이 없다는 표시이며 0건이 아니다.
#}
{% extends "admin/_admin2_shell.html.j2" %}

{% block title %}운영 현황{% endblock %}

{% block head_extra %}
<style>
.ov{flex:1;min-height:0;overflow:auto;padding:24px 28px 40px;color:var(--on);font-family:var(--font)}
.ov-hd{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:18px}
.ov-hd h1{font:700 26px/1.25 var(--font);margin:0}
.ov-hd p{margin:6px 0 0;color:var(--rv-muted);font-size:14px}
.ov-hd-r{display:flex;align-items:center;gap:10px;font-size:12.5px;color:var(--rv-muted)}
.ov-hd-r a{border:1px solid var(--rv-dim4);border-radius:6px;padding:7px 12px;background:var(--rv-card);color:var(--on);text-decoration:none;font-weight:600}
.ov-sec{margin-top:26px}
.ov-sec>h2{font:700 17px/1.3 var(--font);margin:0}
.ov-sec>p.d{margin:5px 0 12px;color:var(--rv-muted);font-size:13px}
.ov-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.ov-card{display:flex;flex-direction:column;gap:6px;border:1px solid var(--rv-dim4);border-radius:9px;background:var(--rv-card);padding:16px 16px 14px;color:var(--on);text-decoration:none;min-width:0}
a.ov-card:hover{border-color:var(--rv-green)}
a.ov-card:focus-visible,.ov a:focus-visible,.ov summary:focus-visible{outline:2px solid var(--rv-green);outline-offset:2px}
.ov-card .t{font:600 14.5px/1.35 var(--font)}
.ov-card .v{font:700 28px/1.1 var(--font-num,monospace);letter-spacing:-.5px}
.ov-card .v small{font:500 13px/1 var(--font);color:var(--rv-muted);margin-left:4px;letter-spacing:0}
.ov-card .m{font-size:12.5px;color:var(--rv-muted)}
.ov-card .n{font-size:12.5px;color:var(--rv-ink-soft)}
.ov-card .meta{margin-top:auto;padding-top:8px;border-top:1px solid var(--rv-panel2);font-size:11.5px;color:var(--rv-faint)}
.ov-card .go{font-size:12.5px;font-weight:600;color:var(--rv-green)}
.ov-card .go.off{color:var(--rv-faint);font-weight:500}
.ov-card[data-state="warn"]{border-color:var(--rv-amber-line);background:var(--rv-amber-bg)}
.ov-card[data-state="warn"] .v{color:var(--rv-amber)}
.ov-card[data-state="error"] .m{color:var(--rv-red)}
.ov-card[data-state="none"] .v,.ov-card[data-state="error"] .v{color:var(--rv-dim)}
.ov-ok{border:1px dashed var(--rv-dim4);border-radius:9px;padding:12px 14px;font-size:13px;color:var(--rv-muted);margin-bottom:12px}
.ov details{margin-top:12px;border:1px solid var(--rv-dim4);border-radius:9px;background:var(--rv-panel)}
.ov summary{cursor:pointer;padding:12px 14px;font:600 13.5px/1.3 var(--font)}
.ov details .ov-grid{padding:0 12px 12px}
.ov-tbl{width:100%;border-collapse:collapse;background:var(--rv-card);border:1px solid var(--rv-dim4);border-radius:9px;overflow:hidden;font-size:13px}
.ov-tbl td:first-child{white-space:nowrap}
.ov-tbl th{background:var(--rv-panel);text-align:left;font-size:12px;font-weight:600;padding:10px 12px;white-space:nowrap}
.ov-tbl td{padding:11px 12px;border-top:1px solid var(--rv-panel2);vertical-align:top}
.ov-tbl td.num{font-family:var(--font-num,monospace);font-weight:600;white-space:nowrap}
.ov-tbl td .s{display:block;font-size:11.5px;color:var(--rv-faint);margin-top:3px}
.ov-tbl a{color:var(--rv-green);font-weight:600;text-decoration:none;white-space:nowrap}
.ov-more{display:inline-block;margin-top:10px;color:var(--rv-green);font-weight:600;font-size:13px;text-decoration:none}
.ov-empty{padding:14px;border:1px dashed var(--rv-dim4);border-radius:9px;font-size:13px;color:var(--rv-muted)}
.ov-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;padding:0 12px 12px}
.ov-links a,.ov-links span{display:block;border:1px solid var(--rv-dim4);border-radius:8px;background:var(--rv-card);padding:12px 14px;text-decoration:none;color:var(--on)}
.ov-links b{display:block;font-size:13.5px}
.ov-links small{display:block;margin-top:4px;font-size:12px;color:var(--rv-muted)}
.ov-links span{color:var(--rv-faint)}
@media (max-width:900px){
  .ov{padding:16px 16px 32px}
  .ov-grid,.ov-links{grid-template-columns:1fr}
  .ov-hd h1{font-size:22px}
  .ov-tbl thead{display:none}
  .ov-tbl,.ov-tbl tbody,.ov-tbl tr,.ov-tbl td{display:block;width:100%}
  .ov-tbl tr{border-top:1px solid var(--rv-panel2);padding:8px 0}
  .ov-tbl td{border:0;padding:4px 12px}
  .ov-tbl td[data-l]::before{content:attr(data-l) " · ";color:var(--rv-faint);font-size:11.5px;font-weight:500}
}
</style>
{% endblock %}

{% macro ov_card(c) -%}
{% if c.href %}<a class="ov-card" href="{{ c.href }}" data-state="{{ c.state }}">{% else %}<div class="ov-card" data-state="{{ c.state }}">{% endif %}
  <div class="t">{{ c.title }}</div>
  <div class="v">{{ c.value }}{% if c.state in ('ok','warn','zero') %}<small>{{ c.unit }}</small>{% endif %}</div>
  {% if c.desc %}<div class="m">{{ c.desc }}</div>{% endif %}
  {% if c.msg %}<div class="m">{{ c.msg }}</div>{% endif %}
  {% if c.note %}<div class="n">{{ c.note }}</div>{% endif %}
  <div class="meta">{{ c.scope }}{% if c.period %} · {{ c.period }}{% endif %}{% if c.state != 'none' %} · {{ c.basis }}{% endif %}</div>
  {% if c.href %}<div class="go">목록 보기 →</div>{% else %}<div class="go off">목록 연결 확인 필요</div>{% endif %}
{% if c.href %}</a>{% else %}</div>{% endif %}
{%- endmacro %}

{% block content %}
<main class="ov" id="ovRoot" data-keep="1">
  <header class="ov-hd">
    <div>
      <h1>운영 현황</h1>
      <p>확인할 문제와 처리할 작업을 모았습니다.</p>
    </div>
    <div class="ov-hd-r"><span>조회 시각 {{ ov.loaded_at }}</span><a href="/admin2/">다시 조회</a></div>
  </header>

  <section class="ov-sec" id="ov-status" aria-labelledby="ovStatusH">
    <h2 id="ovStatusH">확인이 필요한 상태</h2>
    <p class="d">최근 확인 결과 중 다시 살펴볼 항목입니다.</p>
    {% if not ov.status.has_issue %}<div class="ov-ok">불러온 항목에서 확인할 문제가 없습니다.</div>{% endif %}
    <div class="ov-grid">{% for c in ov.status.cards %}{{ ov_card(c) }}{% endfor %}</div>
  </section>

  <section class="ov-sec" id="ov-work" aria-labelledby="ovWorkH">
    <h2 id="ovWorkH">처리할 작업</h2>
    <p class="d">아직 처리가 끝나지 않은 기록입니다. 목록에서 내용을 확인해 주세요. 한 상품이 여러 카드에 함께 셀 수 있어 합계는 내지 않습니다.</p>
    <div class="ov-grid">{% for c in ov.work.cards %}{{ ov_card(c) }}{% endfor %}</div>
    <details data-ov-fold="others">
      <summary>그 밖의 작업 {{ ov.work.others|length }}종</summary>
      <div class="ov-grid">{% for c in ov.work.others %}{{ ov_card(c) }}{% endfor %}</div>
    </details>
  </section>

  <section class="ov-sec" id="ov-release" aria-labelledby="ovReleaseH">
    <h2 id="ovReleaseH">고객 공개 전 점검</h2>
    <p class="d">공개 대상과 구성표 연결 상태를 확인합니다. 공개와 중지는 각 상세 화면에서 합니다.</p>
    <div class="ov-grid">{% for c in ov.release.cards %}{{ ov_card(c) }}{% endfor %}</div>
  </section>

  <section class="ov-sec" id="ov-flow" aria-labelledby="ovFlowH">
    <h2 id="ovFlowH">고객 이용 흐름</h2>
    <p class="d">상담·견적·쇼핑몰 인계 기록입니다. 구매 건수와 다릅니다. 범위: {{ ov.flow.scope }} · 기간: {{ ov.flow.period }}</p>
    <table class="ov-tbl">
      <thead><tr><th>단계</th><th>기록 수</th><th>범위 · 제외 조건</th><th>상세</th></tr></thead>
      <tbody>
      {% for r in ov.flow.rows %}
        <tr data-state="{{ r.state }}">
          <td>{{ r.title }}</td>
          <td class="num" data-l="기록 수">{{ r.value }}{% if r.state in ('ok','warn','zero') %} 건{% endif %}{% if r.msg %}<span class="s">{{ r.msg }}</span>{% endif %}</td>
          <td data-l="범위">{{ r.note or '—' }}</td>
          <td>{% if r.href %}<a href="{{ r.href }}">목록 보기 →</a>{% else %}—{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section class="ov-sec" id="ov-logs" aria-labelledby="ovLogsH">
    <h2 id="ovLogsH">최근 처리 기록</h2>
    <p class="d">누가 어떤 기록을 처리했는지 봅니다. 최근 10건만 보여 줍니다.</p>
    {% if ov.logs_err %}<div class="ov-empty">{{ ov.logs_err }}</div>
    {% elif not ov.logs %}<div class="ov-empty">해당 조건의 기록이 없습니다.</div>
    {% else %}
    <table class="ov-tbl">
      <thead><tr><th>시각</th><th>업무</th><th>대상</th><th>처리 내용</th><th>담당자</th></tr></thead>
      <tbody>
      {% for l in ov.logs %}
        <tr><td class="num">{{ l.at }}</td><td data-l="업무">{{ l.kind }}</td><td data-l="대상">{{ l.target }}</td><td data-l="처리" title="{{ l.code }}">{{ l.action }}</td><td data-l="담당자">{{ l.operator }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    {% endif %}
    <a class="ov-more" href="{{ ov.logs_href }}">전체 변경 이력 보기 →</a>
  </section>

  <section class="ov-sec" id="ov-links" aria-labelledby="ovLinksH">
    <h2 id="ovLinksH">자료 바로가기</h2>
    <p class="d">업무에 필요한 참고 자료와 기록을 엽니다.</p>
    <details data-ov-fold="links">
      <summary>자료 {{ ov.shortcuts|length }}종 펼치기</summary>
      <div class="ov-links">
      {% for s in ov.shortcuts %}
        {% if s.href %}<a href="{{ s.href }}"><b>{{ s.label }}</b><small>{{ s.desc }}</small></a>
        {% else %}<span><b>{{ s.label }}</b><small>{{ s.desc }}</small></span>{% endif %}
      {% endfor %}
      </div>
    </details>
  </section>
</main>
{% endblock %}

{% block foot_extra %}
<script>
/* 접힌 영역의 열림 상태와 스크롤 위치를 이 탭 안에서만 기억한다 — 목록에 갔다 돌아와도 그대로. */
(function () {
  var root = document.getElementById('ovRoot');
  if (!root) return;
  var KEY = 'ov-state';
  var saved = {};
  try { saved = JSON.parse(sessionStorage.getItem(KEY) || '{}') || {}; } catch (e) { saved = {}; }
  root.querySelectorAll('details[data-ov-fold]').forEach(function (d) {
    if (saved[d.dataset.ovFold]) d.open = true;
  });
  if (saved.top) root.scrollTop = saved.top;
  function save() {
    var s = { top: root.scrollTop };
    root.querySelectorAll('details[data-ov-fold]').forEach(function (d) { s[d.dataset.ovFold] = d.open; });
    try { sessionStorage.setItem(KEY, JSON.stringify(s)); } catch (e) { /* 기억 못 해도 화면은 같다 */ }
  }
  root.addEventListener('toggle', save, true);
  root.addEventListener('click', function (ev) { if (ev.target.closest('a')) save(); });
  window.addEventListener('pagehide', save);
})();
</script>
{% endblock %}
