{#
  작업 현황판 (ADM-AI-010) — 2026-08-12

  ■ 이 화면이 답하는 질문
    "지금 무엇을 하고 있나" 그리고 "말을 걸려면 어디에"

  ■ 어디서 오나 — 새 배선이 없다
    Claude Code 가 세션 전사본을 이미 디스크에 쌓는다(`~/.claude/projects/…/*.jsonl`).
    이 화면은 그걸 읽을 뿐이다. `api/dash.py` 가 파서다.

  ■ 「도중에」는 못 읽는다 — 화면이 그 사실을 먼저 말한다
    단일 스레드라 도구가 도는 중에는 끼어들 수 없다. 큐에 넣고 턴이 끝나면 읽는다.
    기다리는 사람이 «왜 답이 없지»를 겪지 않도록 입력창 옆에 항상 적어 둔다.

  ■ 숫자는 전부 `/api/admin/dash/state` 응답만 쓴다.
#}<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>팝콘PC 관리자 · 작업 현황판</title>
{# 색·서체는 **정본만 쓴다**(㉯·㈏ 확정 2026-08-12). 이 화면은 예전에 :root 를 자기가
   들고 있었고 서체를 구글 CDN 에서 받았다 — 팔레트가 세 벌이 되고 A-30(자체 호스팅)을
   어겼다. 회귀의 CDN 검사가 `mockups/**` 만 훑어 이걸 못 잡았다(같은 커밋에서 넓혔다). #}
<link rel="stylesheet" href="/shared/fonts/fonts.css">
<link rel="stylesheet" href="/design-system/tokens.css">
<style>
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--on);font-family:var(--font);
     -webkit-font-smoothing:antialiased;display:flex;overflow:hidden}
a{color:inherit;text-decoration:none}
.num{font-family:var(--font-num);font-variant-numeric:tabular-nums}

/* 좌측 메뉴 — 정본 admin_nav */
.lnb{width:212px;flex:none;background:var(--nav);color:var(--on-nav-muted);display:flex;
     flex-direction:column;overflow:hidden}
.lnb-top{padding:16px 16px 12px;font:600 14px/1 var(--font);color:var(--on-nav);flex:none}
.lnb-scroll{flex:1;min-height:0;overflow-y:auto;padding-bottom:16px}
.lnb-scroll::-webkit-scrollbar{width:6px}
.lnb-scroll::-webkit-scrollbar-thumb{background:rgba(255,255,255,.14);border-radius:3px}
.lnb-grp{border-bottom:1px solid rgba(255,255,255,.045)}
.lnb-g{width:100%;display:flex;align-items:center;gap:7px;padding:9px 14px;background:none;
       border:0;cursor:pointer;text-align:left;font:600 10px/1.2 var(--font-num);
       letter-spacing:.11em;color:var(--on-nav-muted)}
.lnb-g:hover{color:var(--on-nav);background:rgba(255,255,255,.045)}
.lnb-g .t{flex:1;text-transform:uppercase}
.lnb-g .c{font:500 9.5px/1 var(--font-num);color:var(--on-nav-muted)}
.lnb-g .x{font-size:8px;transition:transform .15s}
.lnb-grp[data-open="n"] .lnb-b{display:none}
.lnb-grp[data-open="n"] .lnb-g .x{transform:rotate(-90deg)}
.lnb-b{padding-bottom:5px}
.lnb a,.lnb .off{display:block;padding:7px 16px;font:500 12.5px/1.35 var(--font);
       color:var(--on-nav-muted);border-left:3px solid transparent}
.lnb a:hover{color:var(--on-nav);background:rgba(255,255,255,.05)}
.lnb a.on{color:var(--on-nav);background:rgba(255,255,255,.09);
          border-left-color:var(--primary)}
.lnb .off{color:var(--on-nav-muted);cursor:default}
.lnb .tag{font:500 9px/1 var(--font-num);padding:1px 4px;border-radius:3px;
          background:rgba(255,255,255,.06);color:var(--on-nav-muted);margin-left:5px;vertical-align:1px}

/* 셸 */
.main{flex:1;min-width:0;display:flex;flex-direction:column}
.hd{height:52px;flex:none;border-bottom:1px solid var(--outline-variant);background:var(--card);
    display:flex;align-items:center;padding:0 18px;gap:12px}
.hd .crumb{font:400 12px/1 var(--font);color:var(--on-variant)}
.hd .sep{color:var(--outline)}
.hd .now{font:600 13px/1 var(--font)}
.dot{width:8px;height:8px;border-radius:50%;flex:none;background:var(--outline)}
.dot.live{background:var(--primary);box-shadow:0 0 0 3px color-mix(in srgb, var(--primary) 18%, transparent)}
.dot.wait{background:var(--tertiary)}
/* 팀원 카드 — 신호는 «색 + 글자» 둘 다다. 관리자 화면은 통과·활동을 --primary 로 쓴다
   (U-01: 초록은 고객 화면 전용). **색만으로 상태를 말하지 않는다** — 색약 배려. */
.team{flex:none;padding:12px 16px 0;display:flex;gap:8px;overflow-x:auto}
.team::-webkit-scrollbar{height:5px}
.team::-webkit-scrollbar-thumb{background:var(--outline-variant);border-radius:3px}
.tcard{flex:0 0 auto;min-width:134px;background:var(--card);border-radius:8px;padding:8px 10px;
       border:1px solid var(--outline-variant)}
/* 신호등 (사용자 지시 2026-08-12) — 대기=회색 · 실행=노랑 깜빡 · 지연·오류=빨강 · 완료=초록.
   색은 tokens.css 의 --state-* 만 쓰고 **항상 글자를 병기**한다(색약 배려). */
.tcard[data-sig="run"]{border-color:var(--state-run);
       box-shadow:0 0 0 2px color-mix(in srgb, var(--state-run) 16%, transparent)}
.tcard[data-sig="delay"],.tcard[data-sig="fail"]{border-color:var(--state-fail);
       box-shadow:0 0 0 2px color-mix(in srgb, var(--state-fail) 14%, transparent)}
.tcard[data-sig="wait"]{opacity:.66}
.tcard[data-def="n"]{border-style:dashed}
.tcard{min-width:168px;max-width:196px}
.tcard .who{display:flex;align-items:center;gap:6px;font:600 12.5px/1.35 var(--font)}
/* 역할 — 명사구 한 줄. 정본은 정의 파일의 role: 이다. description 산문을 잘라 쓰다
   「~한다」 서술문이 카드에 흘렀다(사용자 지적) — 화면은 role 만 옮긴다 */
.tcard .role{font:400 10.5px/1.45 var(--font);color:var(--on-variant);margin:3px 0 4px;
       white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sig{width:8px;height:8px;border-radius:50%;flex:none;background:var(--state-wait)}
.sig.run{background:var(--state-run);animation:sigpulse 1.1s ease-in-out infinite}
.sig.delay,.sig.fail{background:var(--state-fail)}
.sig.done{background:var(--state-done)}
@keyframes sigpulse{0%,100%{opacity:1}50%{opacity:.25}}
@media (prefers-reduced-motion:reduce){.sig.run{animation:none}}
.tcard .st{font:500 10.5px/1.6 var(--font-num);color:var(--on-variant)}
.tcard[data-sig="run"] .st{color:color-mix(in srgb, var(--state-run) 82%, var(--on))}
.tcard[data-sig="delay"] .st,.tcard[data-sig="fail"] .st{color:var(--state-fail)}
.tcard[data-sig="done"] .st{color:var(--success-dark)}
.tcard .dg{font:400 10px/1.4 var(--font);color:var(--on-variant);margin-top:2px;
       white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:150px}

/* 오늘 처리 — 세는 방법이 있는 것만. 못 쟀으면 0 이 아니라 「못 쟀음」이다 */
.today{flex:none;padding:10px 16px 0;display:flex;gap:16px;flex-wrap:wrap;align-items:baseline}
.today .m{display:flex;align-items:baseline;gap:5px;font:400 11.5px/1.5 var(--font)}
.today .m b{font:600 15px/1 var(--font-num);font-variant-numeric:tabular-nums}
.today .m i{font-style:normal;color:var(--on-variant)}
.today .src{font:400 10.5px/1.5 var(--font);color:var(--on-variant);margin-left:auto}

.body{flex:1;min-height:0;display:flex;gap:12px;padding:14px 16px 16px}
.card{background:var(--card);border:1px solid var(--outline-variant);border-radius:8px}

/* 흐름 */
.flow{flex:1;min-width:0;display:flex;flex-direction:column;min-height:0}
.flow-hd{padding:10px 12px;border-bottom:1px solid var(--outline-variant);flex:none;
         display:flex;align-items:baseline;gap:8px}
.flow-body{flex:1;min-height:0;overflow:auto;padding:8px 12px 14px}
.flow-ft{flex:none;display:flex;align-items:center;gap:6px;padding:7px 12px;
         border-top:1px solid var(--outline-variant)}
.fbtn{padding:4px 10px;border:1px solid var(--outline-variant);border-radius:5px;
      background:var(--card);color:var(--on-variant);font:500 11px/1.4 var(--font);cursor:pointer}
.fbtn:hover{color:var(--on);border-color:var(--outline)}
.fbtn[aria-pressed="true"]{background:var(--on);color:var(--bg);border-color:var(--on)}
/* 사건 행의 [메모] — 평소엔 숨고 행에 올리면 보인다. 늘 보이면 흐름이 버튼밭이 된다 */
.ev .mbtn{flex:none;align-self:flex-start;margin-left:6px;padding:1px 7px;border-radius:4px;
    border:1px solid var(--outline-variant);background:var(--card);color:var(--on-variant);
    font:500 10px/1.5 var(--font);cursor:pointer;visibility:hidden}
.ev:hover .mbtn{visibility:visible}
.ev .mbtn:hover{color:var(--on);border-color:var(--outline)}
/* 메모 카드 */
.memo{padding:7px 0;border-bottom:1px solid var(--container)}
.memo .tx{font:400 11.5px/1.5 var(--font);white-space:pre-wrap;word-break:break-word;
    display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.memo .mt{display:flex;align-items:baseline;gap:7px;margin-top:3px}
.memo .mt .note{flex:1}
.memo .mt button{padding:1px 8px;border-radius:4px;border:1px solid var(--outline-variant);
    background:var(--card);color:var(--on-variant);font:500 10px/1.6 var(--font);cursor:pointer}
.memo .mt button:hover{color:var(--on);border-color:var(--outline)}
.ev{padding:6px 0;border-bottom:1px solid var(--container);display:flex;gap:9px;
    align-items:flex-start}
.ev .t{width:52px;flex:none;font:400 10px/1.6 var(--font-num);color:var(--on-variant)}
.ev .b{flex:1;min-width:0}
.ev .who{display:inline-block;font:600 9.5px/1.5 var(--font-num);padding:0 5px;border-radius:4px;
         margin-right:6px;vertical-align:1px}
.who-user{background:var(--nav);color:var(--on-nav)}
.who-claude{background:var(--primary-container);color:var(--on);
            border:1px solid var(--outline-variant)}
.who-result{background:var(--container);color:var(--on-variant)}
.tool{display:inline-flex;align-items:baseline;gap:6px;font:500 11px/1.6 var(--font-num)}
.tool .n{color:var(--secondary)}
.tool .d{color:var(--on-variant);font-family:var(--font);font-size:11.5px}
.say{font:400 12.5px/1.6 var(--font);white-space:pre-wrap;word-break:break-word}
.res{font:400 11px/1.5 var(--font-num);color:var(--on-variant);white-space:pre-wrap;
     word-break:break-all}

/* 우측 */
.side{width:330px;flex:none;display:flex;flex-direction:column;gap:12px;min-height:0}
.cap{font:500 10.5px/1 var(--font-num);letter-spacing:.1em;color:var(--on-variant);margin-bottom:8px}
.kv{display:flex;align-items:baseline;gap:8px;padding:3px 0;font:400 11.5px/1.5 var(--font)}
.kv .k{width:74px;flex:none;color:var(--on-variant)}
.kv .v{flex:1;font-family:var(--font-num);font-variant-numeric:tabular-nums}
.agent{padding:7px 0;border-bottom:1px solid var(--container)}
.agent .h{display:flex;align-items:baseline;gap:7px}
.agent .id{font:600 10.5px/1.4 var(--font-num)}
.agent .tail{font:400 10.5px/1.45 var(--font-num);color:var(--on-variant);margin-top:2px;
             white-space:pre-wrap;word-break:break-all}
.say-box{flex:none;display:flex;flex-direction:column}
.say-box textarea{width:100%;min-height:78px;resize:vertical;border:1px solid var(--outline-variant);
  border-radius:6px;padding:8px 9px;font:400 12.5px/1.5 var(--font);background:var(--bg)}
.say-box textarea:focus{outline:2px solid color-mix(in srgb, var(--primary) 40%, transparent);outline-offset:1px}
.btn{padding:8px 16px;border-radius:6px;background:var(--on);color:var(--bg);border:0;
     cursor:pointer;font:500 12px/1 var(--font)}
.btn:disabled{opacity:.45;cursor:default}
.note{font:400 10.5px/1.5 var(--font);color:var(--on-variant)}
.pending{font:500 11px/1.5 var(--font);color:var(--on);
         background:var(--primary-container);border:1px solid var(--primary);
         border-radius:5px;padding:5px 8px;margin-top:8px}
.err{font:400 11.5px/1.6 var(--font);color:var(--error)}

@media (max-width:1000px){
  body{overflow:auto;display:block}
  .lnb{width:100%;max-height:170px}
  .body{flex-direction:column}
  .side{width:100%}
  .flow{height:460px;flex:none}
}
</style>
</head>
<body data-screen-id="ADM-AI-010" data-domain="dash">

<nav class="lnb" aria-label="주메뉴">
  <div class="lnb-top">admin2</div>
  <div class="lnb-scroll">
    {% for g in nav %}
      <div class="lnb-grp" data-grp="{{ g.title }}" data-open="{{ 'y' if g.active else 'n' }}">
        <button type="button" class="lnb-g" data-action="lnb-group"
                aria-expanded="{{ 'true' if g.active else 'false' }}">
          <span class="t">{{ g.title }}</span>
          <span class="c">{{ g.done }}/{{ g.total }}</span>
          <span class="x" aria-hidden="true">▼</span>
        </button>
        <div class="lnb-b">
          {% for it in g["items"] %}
            {% if it.href %}
              <a href="{{ it.href }}" class="{% if it.active %}on{% endif %}"
                 {% if it.active %}aria-current="page"{% endif %}>{{ it.label }}</a>
            {% else %}
              <span class="off" title="{{ '기존 화면 있음 · 재구축 전' if it.state == 'old' else '신설 예정' }}"
                >{{ it.label }}<span class="tag">{{ '기존' if it.state == 'old' else '신설' }}</span></span>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endfor %}
  </div>
</nav>

<div class="main">
  <header class="hd">
    <span class="crumb">AI 관리</span>
    <span class="sep">/</span>
    <span class="now">작업 현황판</span>
    <span class="dot" data-bind="dot" title="상태"></span>
    <span class="num" style="font-size:11.5px;color:var(--on-variant)" data-bind="status">연결 중…</span>
    <span style="flex:1"></span>
    <span class="num" style="font-size:11px;color:var(--on-variant)" data-bind="session">—</span>
  </header>

  <!-- 팀원 명단 — 정본은 `.claude/agents/*.md` 다. 화면이 이름을 지어내지 않는다 -->
  <section class="team" data-repeat="team" aria-label="팀원 상태"></section>

  <!-- 오늘 처리 -->
  <div class="today" data-repeat="today"></div>

  <div class="body">
    <section class="card flow">
      <div class="flow-hd">
        <h5 style="margin:0;font:600 12px/1.2 var(--font)">진행 흐름</h5>
        <span class="note" data-bind="flow-note">전사본 갱신 시 자동 표시</span>
      </div>
      <div class="flow-body" data-repeat="events"></div>
      <!-- 흐름이 길어지면 여기서 줄인다(사용자 요청 2026-08-12).
           **기록(전사본)은 지우지 않는다** — 화면 표시만 조절한다. -->
      <div class="flow-ft">
        <button type="button" class="fbtn" data-action="flow-compact">간략히</button>
        <button type="button" class="fbtn" data-action="flow-clear">화면 비우기</button>
        <button type="button" class="fbtn" data-action="flow-all" hidden>모두 보기</button>
        <span class="note" data-bind="flow-hidden" style="margin-left:auto"></span>
      </div>
    </section>

    <aside class="side">
      <div class="card" style="padding:10px 12px;flex:none">
        <div class="cap">현황</div>
        <div data-repeat="stats"></div>
      </div>

      <div class="card" style="padding:10px 12px;flex:1;min-height:0;overflow:auto">
        <!-- 「팀원 작업」이 아니다 — 이 파일들은 서브에이전트와 백그라운드 셸 명령을
             구분하지 않는다(`api/dash._bg_tasks` 주석). 화면이 아는 것만 말한다 -->
        <div class="cap">백그라운드 작업</div>
        <div data-repeat="agents"></div>
      </div>

      <!-- 메모 — 흐름에서 [메모]로 저장한 것. [보내기]가 큐 재투입(재실행)이다 -->
      <div class="card" style="padding:10px 12px;flex:none;max-height:200px;overflow:auto">
        <div class="cap">메모</div>
        <div data-repeat="memos"><span class="note">저장된 메모 없음</span></div>
      </div>

      <div class="card say-box" style="padding:10px 12px">
        <div class="cap">메시지 전송</div>
        <!-- placeholder 는 **사용자가 칠 말의 예시**라 구어가 맞다. 라벨·안내와는 성격이 다르다 -->
        <textarea data-bind="say-text" placeholder="예: 회귀 돌려줘 / 지금 상태 정리해줘"
                  aria-label="보낼 내용"></textarea>
        <div style="display:flex;align-items:center;gap:8px;margin-top:8px">
          <button class="btn" type="button" data-action="say">보내기</button>
          <span class="note" style="flex:1">작업 실행 중 읽기 불가 · 완료 후 자동 읽음</span>
        </div>
        <div data-bind="say-result"></div>
      </div>
    </aside>
  </div>
</div>

{% raw %}
<script>
(function () {
  'use strict';
  var $ = function (k) {
    return document.querySelector('[data-bind="' + k + '"],[data-repeat="' + k + '"]');
  };
  var esc = function (s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  };
  var hhmm = function (iso) {
    if (!iso) return '';
    var d = new Date(iso);
    return isNaN(d) ? '' : ('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2)+':'
                          + ('0'+d.getSeconds()).slice(-2);
  };
  var WHO = {user:['who-user','사장님'], claude:['who-claude','클로드'], result:['who-result','결과']};
  // 방금 보낸 것의 확인 문구. `render()` 가 주기적으로 도는데 그때 지워지면
  // 사장님은 «보내진 건가?» 를 알 수 없다. 큐가 비면(= 세션이 읽으면) 그때 지운다.
  var sayMsg = null;

  // 흐름 표시 상태 — 세션 저장(새로고침에도 유지 · 다른 PC 와는 무관한 개인 표시 설정)
  var flowClear = null, flowCompact = false;
  try {
    flowClear = sessionStorage.getItem('dash-flow-clear') || null;
    flowCompact = sessionStorage.getItem('dash-flow-compact') === 'y';
  } catch (e) { /* 무시 */ }
  var lastEvTs = null;                       // 「화면 비우기」의 기준 시각

  // 8543초처럼 원시 단위를 그대로 내밀지 않는다 — 읽는 사람이 나눗셈을 해야 한다
  function ago(s) {
    s = Math.max(0, Math.floor(s || 0));
    if (s < 60) return s + '초 전';
    if (s < 3600) return Math.floor(s / 60) + '분 전';
    if (s < 86400) return Math.floor(s / 3600) + '시간 ' + Math.floor((s % 3600) / 60) + '분 전';
    return Math.floor(s / 86400) + '일 전';
  }
  function size(b) {
    b = Math.max(0, Math.floor(b || 0));
    if (b < 1024) return b + ' B';
    if (b < 1048576) return (b / 1024).toFixed(1) + ' KB';
    return (b / 1048576).toFixed(1) + ' MB';
  }

  function render(d) {
    var dot = $('dot'), st = $('status');
    if (!d.ok) {
      dot.className = 'dot';
      st.textContent = d.reason || '조회 실패';
      st.style.color = 'var(--error)';
      $('events').innerHTML = '<div class="err">전사본 없음 — ' + esc(d.dir || '') + '</div>';
      return;
    }
    st.style.color = '';
    var idle = d.idle_s;
    dot.className = 'dot ' + (idle < 8 ? 'live' : (idle < 120 ? 'wait' : ''));
    st.textContent = idle < 8 ? '작업 중' : (idle < 120 ? ('대기 ' + idle + '초') : ('멈춤 ' + ago(idle).replace(' 전', '')));
    $('session').textContent = d.session ? (d.session.slice(0, 8) + ' · ' + d.size_mb + 'MB') : '';

    $('stats').innerHTML = [
      ['세션', d.session ? d.session.slice(0, 8) : '—'],
      ['마지막 기록', ago(idle)],
      ['전사본', d.size_mb + ' MB'],
      ['사건', d.events.length + '건'],
      ['전달 대기', (d.queued || []).length + '건']
    ].map(function (r) {
      return '<div class="kv"><span class="k">' + esc(r[0]) + '</span>'
           + '<span class="v">' + esc(r[1]) + '</span></div>';
    }).join('');

    // 창(기본 30분) 밖의 출력 파일은 지난 일이다. 「없다」와 「창 밖에 있다」를 구분해 적는다 —
    // 안 그러면 4일 전 파일이 지금 도는 작업처럼 맨 위에 앉는다(2026-08-12 실측).
    // ── 팀원 카드 ────────────────────────────────────────────────────
    // 「실행 중」은 **잰 값이다**: Agent 호출은 있는데 결과가 아직 없는 것(api/dash._scan).
    // 그 밖의 방법으로는 알 수 없다 — tasks/*.output 은 셸 명령과 구분되지 않는다.
    var team = d.roster || [];
    $('team').innerHTML = team.length ? team.map(function (a) {
      var sig = a.sig || 'wait';
      return '<div class="tcard" data-sig="' + esc(sig) + '"'
        + ' data-def="' + (a.defined ? 'y' : 'n') + '"'
        + ' title="' + esc(a.desc || '') + '">'
        + '<div class="who"><span class="sig ' + esc(sig) + '"></span>' + esc(a.ko) + '</div>'
        // 역할은 정의 파일의 role:(명사구)만 옮긴다 — 화면이 지어내지 않는다
        + '<div class="role">' + esc(a.role || '') + '</div>'
        // 색 옆에 **항상 글자**. 상태(서버 판정) + 수만 붙인다
        + '<div class="st">' + esc(a.state)
        + (a.running ? ' ' + a.running + '건'
           : a.today ? ' ' + a.today + '회'
           : a.fail ? ' ' + a.fail + '회' : '')
        + (a.fail && sig !== 'fail' ? ' · 실패 ' + a.fail : '') + '</div>'
        + (a.doing && a.doing.length ? '<div class="dg">' + esc(a.doing[0]) + '</div>' : '')
        + '</div>';
    }).join('') : '<div class="note">팀원 정의가 없습니다 — .claude/agents/</div>';

    // ── 오늘 처리 ────────────────────────────────────────────────────
    // 못 쟀으면 **0 이 아니라 「못 쟀음」**이다. 둘을 섞으면 «오늘 아무 일도 없었다»가 된다.
    var T = d.today || {};
    var num = function (v) { return v == null ? '<i>못 쟀음</i>' : '<b>' + v + '</b>'; };
    $('today').innerHTML =
      [['커밋', T.commits], ['팀원 완료', T.agent_done], ['팀원 실행 중', T.agent_running],
       ['팀원 지연', T.agent_delayed], ['팀원 실패', T.agent_fail], ['도구 호출', T.tools],
       ['사장님 발화', T.says], ['현황판 메시지', T.dash_msgs]]
        .map(function (r) {
          return '<span class="m"><i>' + esc(r[0]) + '</i>' + num(r[1]) + '</span>';
        }).join('')
      + '<span class="src">' + esc(T.day || '') + ' · 커밋은 git · 나머지는 이 세션 전사본</span>';

    var ag = d.agents || [], win = d.agents_window_min || 30, older = d.agents_older || 0;
    var tailNote = older ? '<div class="note" style="margin-top:6px">최근 ' + win
                         + '분 밖 ' + older + '건은 표시하지 않음</div>' : '';
    $('agents').innerHTML = (ag.length ? ag.map(function (a) {
      return '<div class="agent"><div class="h">'
        + '<span class="id">' + esc(a.id) + '</span>'
        + '<span class="note"> · ' + (a.live ? '실행 중' : '멈춤') + ' · '
        + ago(a.age_s) + ' · ' + size(a.bytes) + '</span></div>'
        + (a.tail ? '<div class="tail">' + esc(a.tail) + '</div>' : '') + '</div>';
    }).join('') : '<div class="note">최근 ' + win + '분 내 작업 없음</div>') + tailNote;

    var box = $('events');
    var atBottom = box.scrollHeight - box.scrollTop - box.clientHeight < 60;
    // ── 표시 조절 (사용자 요청 2026-08-12) — **기록은 못 지운다. 표시만 줄인다** ──
    //   화면 비우기: 그 시점 이전 사건을 숨긴다 (ISO 시각은 문자열 비교가 시간 비교다)
    //   간략히    : 도구·결과 줄을 빼고 발화만 남긴다
    var all = d.events || [];
    if (all.length) lastEvTs = all[all.length - 1].ts || lastEvTs;
    var evs = all.filter(function (e) { return !flowClear || (e.ts || '') > flowClear; });
    var hiddenN = all.length - evs.length;
    if (flowCompact)
      evs = evs.filter(function (e) {
        return (e.blocks || []).some(function (b) { return b.kind === 'say'; });
      });
    $('flow-hidden').textContent =
      (hiddenN ? '이전 ' + hiddenN + '건 숨김 · 기록은 보존됨' : '') +
      (flowCompact ? (hiddenN ? ' · ' : '') + '발화만 표시' : '');
    var clearBtn = document.querySelector('[data-action="flow-all"]');
    if (clearBtn) clearBtn.hidden = !flowClear;
    box.innerHTML = evs.map(function (e) {
      var w = WHO[e.who] || ['who-result', e.who];
      var inner = (e.blocks || []).map(function (b) {
        if (b.kind === 'tool') {
          if (flowCompact) return '';
          return '<span class="tool"><span class="n">' + esc(b.name) + '</span>'
               + '<span class="d">' + esc(b.detail) + '</span></span>';
        }
        if (b.kind === 'result') return flowCompact ? '' : '<div class="res">' + esc(b.text) + '</div>';
        return '<div class="say">' + esc(b.text) + '</div>';
      }).join('');
      // [메모] — 이 사건의 발화·내용을 저장한다. 내용이 없는 줄(도구만)엔 도구 요약을 담는다
      var memoTxt = (e.blocks || []).map(function (b) {
        return b.kind === 'tool' ? (b.name + ' ' + (b.detail || '')) : (b.text || '');
      }).join('\n').trim();
      return '<div class="ev" data-ts="' + esc(e.ts || '') + '" data-who="' + esc(e.who || '') + '">'
        + '<span class="t">' + hhmm(e.ts) + '</span><span class="b">'
        + '<span class="who ' + w[0] + '">' + w[1] + '</span>' + inner + '</span>'
        + (memoTxt ? '<button type="button" class="mbtn" data-action="memo-save"'
           + ' data-memo="' + esc(memoTxt).replace(/"/g, '&quot;') + '" title="메모 저장">메모</button>' : '')
        + '</div>';
    }).join('') || '<div class="note" style="padding:8px 0">표시할 사건 없음'
        + (flowClear ? ' · [모두 보기]로 되돌림' : '') + '</div>';
    if (atBottom) box.scrollTop = box.scrollHeight;

    var q = (d.queued || []).length;
    var r = $('say-result');
    if (q) {
      r.innerHTML = '<div class="pending">전달 대기 ' + q + '건 · 작업 완료 후 읽음</div>';
    } else if (sayMsg) {
      // 큐가 비었다 = 세션이 읽었다. 그 사실을 말하고 나서 지운다
      r.innerHTML = '<div class="note">읽음 처리됨</div>';
      sayMsg = null;
    } else {
      r.innerHTML = '';
    }
  }

  function load() {
    fetch('/api/admin/dash/state?limit=60', {credentials: 'same-origin'})
      .then(function (r) {
        if (!r.ok) { var e = new Error('HTTP ' + r.status); e.status = r.status; throw e; }
        return r.json();
      })
      .then(render)
      .catch(function (err) {
        var st = $('status');
        st.textContent = err.status === 401 ? '세션 만료 — 로그인 필요' : ('조회 실패 ' + err.message);
        st.style.color = 'var(--error)';
        $('dot').className = 'dot';
      });
  }

  // **잠금 해제를 한 경로에만 걸지 않는다.** `.finally` 하나에 의존했다가
  // 한 번 보내면 버튼이 잠긴 채 남는 것을 실측으로 봤다(2026-08-12). 원인이 무엇이든
  // 사용자에게는 «두 번째부터 안 보내지는 화면»이라 결과가 같다.
  //   ① then/catch 양쪽에서 푼다  ② 타이머로 한 번 더 받친다
  var sayBusy = false;
  document.querySelector('[data-action="say"]').addEventListener('click', function () {
    var ta = $('say-text'), btn = this, box = $('say-result');
    var t = (ta.value || '').trim();
    if (!t) { ta.focus(); return; }
    if (sayBusy) return;
    sayBusy = true;
    btn.disabled = true;
    var release = function () { sayBusy = false; btn.disabled = false; };
    var guard = setTimeout(function () {           // 응답이 영영 안 와도 화면은 살아난다
      release();
      box.innerHTML = '<div class="err">응답 없음 · 재시도 필요</div>';
    }, 8000);
    fetch('/api/admin/dash/say', {method: 'POST', credentials: 'same-origin',
        headers: {'Content-Type': 'application/json'}, body: JSON.stringify({text: t})})
      .then(function (r) {
        if (!r.ok) { var e = new Error('HTTP ' + r.status); e.status = r.status; throw e; }
        return r.json();
      })
      .then(function (j) {
        clearTimeout(guard); release();
        if (j.ok) ta.value = '';
        sayMsg = j.verdict;                        // render 가 덮어쓰지 않게 남겨 둔다
        box.innerHTML = '<div class="pending">' + esc(j.verdict) + '</div>';
        load();
      })
      .catch(function (e) {
        clearTimeout(guard); release();
        sayMsg = null;
        box.innerHTML = '<div class="err">전송 실패 — '
          + esc(e.status === 401 ? '세션 만료 · 로그인 필요' : e.message) + '</div>';
      });
  });

  // ── 흐름 표시 버튼 ─────────────────────────────────────────────────
  document.querySelector('[data-action="flow-compact"]').addEventListener('click', function () {
    flowCompact = !flowCompact;
    this.setAttribute('aria-pressed', String(flowCompact));
    try { sessionStorage.setItem('dash-flow-compact', flowCompact ? 'y' : 'n'); } catch (e) { /* 무시 */ }
    load();
  });
  document.querySelector('[data-action="flow-clear"]').addEventListener('click', function () {
    if (!lastEvTs) return;
    flowClear = lastEvTs;                    // 기록은 그대로다 — 이 시각 이전을 안 그릴 뿐
    try { sessionStorage.setItem('dash-flow-clear', flowClear); } catch (e) { /* 무시 */ }
    load();
  });
  document.querySelector('[data-action="flow-all"]').addEventListener('click', function () {
    flowClear = null;
    try { sessionStorage.removeItem('dash-flow-clear'); } catch (e) { /* 무시 */ }
    load();
  });

  // ── 메모 ──────────────────────────────────────────────────────────
  // 행이 매번 다시 그려지므로 버튼이 아니라 **상자에** 리스너를 건다(위임)
  function loadMemos() {
    fetch('/api/admin/dash/memos', {credentials: 'same-origin'})
      .then(function (r) { return r.json(); })
      .then(function (j) {
        var ms = j.memos || [];
        $('memos').innerHTML = ms.length ? ms.map(function (m) {
          return '<div class="memo"><div class="tx">' + esc(m.content) + '</div>'
            + '<div class="mt"><span class="note">' + esc((m.event_ts || '').slice(11, 16))
            + (m.used_count ? ' · 재실행 ' + m.used_count + '회' : '') + '</span>'
            + '<button type="button" data-memo-send="' + m.memo_id + '">보내기</button>'
            + '<button type="button" data-memo-del="' + m.memo_id + '">삭제</button></div></div>';
        }).join('') : '<span class="note">저장된 메모 없음</span>';
      })
      .catch(function () { $('memos').innerHTML = '<span class="note">메모 조회 실패</span>'; });
  }
  $('events').addEventListener('click', function (ev) {
    var b = ev.target.closest('[data-action="memo-save"]');
    if (!b) return;
    var row = b.closest('.ev');
    b.disabled = true;
    fetch('/api/admin/dash/memos', {method: 'POST', credentials: 'same-origin',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({content: b.getAttribute('data-memo') || '',
                              event_ts: row.getAttribute('data-ts') || '',
                              who: row.getAttribute('data-who') || ''})})
      .then(function (r) { return r.json(); })
      .then(function (j) { b.textContent = j.ok ? '저장됨' : '실패'; loadMemos(); })
      .catch(function () { b.textContent = '실패'; b.disabled = false; });
  });
  $('memos').addEventListener('click', function (ev) {
    var s = ev.target.closest('[data-memo-send]'), x = ev.target.closest('[data-memo-del]');
    if (!s && !x) return;
    var id = (s || x).getAttribute(s ? 'data-memo-send' : 'data-memo-del');
    var url = '/api/admin/dash/memos/' + id + (s ? '/send' : '');
    fetch(url, {method: s ? 'POST' : 'DELETE', credentials: 'same-origin'})
      .then(function (r) { return r.json(); })
      .then(function (j) {
        if (s && j.ok) { sayMsg = j.verdict; }
        loadMemos(); load();
      })
      .catch(function () { /* 다음 새로고침이 알린다 */ });
  });
  loadMemos();

  // 좌측 메뉴 아코디언 — 접힘을 세션에 남긴다(조감도와 같은 규약)
  var KEY = 'admin2.lnb.closed';
  var closed = (function(){ try { return JSON.parse(sessionStorage.getItem(KEY)) || []; }
                            catch(e){ return []; } })();
  document.querySelectorAll('.lnb-grp').forEach(function (g) {
    var k = g.getAttribute('data-grp');
    if (closed.indexOf(k) >= 0) {
      g.setAttribute('data-open', 'n');
      g.querySelector('[data-action="lnb-group"]').setAttribute('aria-expanded', 'false');
    }
    var b = g.querySelector('[data-action="lnb-group"]');
    b.addEventListener('click', function () {
      var open = g.getAttribute('data-open') === 'y';
      g.setAttribute('data-open', open ? 'n' : 'y');
      b.setAttribute('aria-expanded', String(!open));
      var i = closed.indexOf(k);
      if (open && i < 0) closed.push(k);
      if (!open && i >= 0) closed.splice(i, 1);
      try { sessionStorage.setItem(KEY, JSON.stringify(closed)); } catch (e) { /* 무시 */ }
    });
  });

  load();
  // 전사본이 자라면 알려준다. SSE 가 끊기면 폴링으로 내려앉는다 — 조용히 멈추지 않게.
  // **폴링은 한 번만 세운다.** `onerror` 는 재연결 시도마다 뜰 수 있어 그대로 두면
  // 타이머가 겹쳐 쌓이고 요청이 배로 늘어난다(서버 재시작 때 실제로 이 경로를 탔다).
  var polling = false;
  function fallback() {
    if (polling) return;
    polling = true;
    setInterval(load, 3000);
  }
  try {
    var es = new EventSource('/api/admin/dash/stream');
    es.onmessage = function () { load(); };
    es.onerror = function () { es.close(); fallback(); };
  } catch (e) { fallback(); }
})();
</script>
{% endraw %}
</body>
</html>
