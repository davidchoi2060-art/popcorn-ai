{% extends 'admin/_admin2_shell.html.j2' %}
{% block title %}회원 관리{% endblock %}
{% block head_extra %}<link rel="stylesheet" href="/shared/admin2/members.css?v=20261003-focus-1">{% endblock %}
{% block content %}
<section class="mm-workspace" id="membersWorkspace" data-view="list">
  <div class="mm-title"><div><h1>회원 관리</h1><p class="mm-muted">회원을 찾고, 기록을 확인하고, 필요한 요청을 남깁니다.</p></div><button id="reload" class="mm-btn" type="button"><img class="mm-icon" src="/shared/icons/admin/rotate-ccw.svg" alt="">새로고침</button></div>
  <div class="mm-mode"><span class="mm-dot" aria-hidden="true"></span><strong id="memberMode">운영 모드 확인 중</strong><span id="modeNote"></span></div>
  <div class="mm-callout mm-page-message" id="pageMessage" role="status" aria-live="polite" hidden></div>
  <div class="mm-grid">
    <section class="mm-list-panel" aria-label="회원 찾기와 목록">
      <div class="mm-search-panel">
        <form id="filterForm" class="mm-filters">
          <label class="mm-search-caption" for="q">회원 검색</label>
          <div class="mm-search-line"><input id="q" placeholder="회원번호, 이름 또는 이메일" maxlength="100" autocomplete="off"><button class="mm-btn mm-primary" id="searchBtn" type="submit">검색</button></div>
          <div class="mm-filter-bar"><button id="filterToggle" class="mm-btn mm-filter-toggle" type="button" aria-expanded="false" aria-controls="filterFields"><img class="mm-icon" src="/shared/icons/admin/sliders.svg" alt=""><span id="filterLabel">필터 · 전체</span></button><button class="mm-btn" type="button" id="reset">초기화</button></div>
          <div id="filterFields" class="mm-filter-fields" hidden>
            <label>가입 경로<select id="via"><option value="">전체 경로</option></select></label>
            <label>쇼핑몰 연결<select id="map"><option value="">전체 상태</option><option value="none">미연결</option><option value="requested">요청 기록</option><option value="mapped">연결 ID 기록</option></select></label>
            <label>회원 상태<select id="status"><option value="">전체 상태</option></select></label>
          </div>
        </form>
        <div class="mm-list-options"><label class="mm-inline">정렬 <select id="sort"><option value="joined_desc">가입 최신순</option><option value="id_asc">회원번호순</option><option value="activity_desc">기록 생성 최신순</option></select></label><label class="mm-inline">표시 <select id="pageSize"><option>10</option><option selected>20</option><option>50</option></select></label></div>
        <div class="mm-list-head"><strong id="resultCount" role="status">불러오는 중</strong></div>
        <p class="mm-origin-notice">등록된 분류는 실제 고객임을 확인한 결과가 아닙니다.</p>
      </div>
      <ul id="rows" class="mm-member-list" aria-label="검색된 회원"></ul>
      <div class="mm-empty" id="listMessage" role="status">회원 목록 조회 중</div>
      <div class="mm-pager"><span id="pageRange">건수 확인 중</span><div><button class="mm-btn" id="prev" type="button" aria-label="이전 페이지" disabled>이전</button><span id="pageLabel">—</span><button class="mm-btn" id="next" type="button" aria-label="다음 페이지" disabled>다음</button></div></div>
    </section>
    <aside class="mm-detail" id="detail" aria-label="선택한 회원 상세" aria-live="polite"><div class="mm-empty">회원 선택 후 상세 확인</div></aside>
  </div>
  <p class="mm-timezone" id="displayTimezone"></p>
</section>
<dialog class="mm-dialog" id="confirm" aria-labelledby="confirmTitle" aria-describedby="confirmScope confirmDelivery"><form method="dialog"><div class="mm-dialog-head"><span class="mm-eyebrow">연결 요청 기록</span><button class="mm-btn mm-cancel" value="cancel" aria-label="닫기">닫기</button></div><h2 id="confirmTitle"></h2><p id="confirmMode"></p><p id="confirmScope">이 회원에 대한 요청 시각과 관리자 작업 기록을 저장합니다.</p><div class="mm-callout" id="confirmDelivery">요청 기록은 DB에 저장되며, 외부 전달 여부는 미확인입니다.</div><p class="mm-muted">이 기록만으로 실제 쇼핑몰 계정 연결을 확인할 수 없습니다.</p><div class="mm-dialog-foot"><button class="mm-btn mm-cancel" value="cancel">취소</button><button class="mm-btn mm-primary" id="saveRequest" type="button">요청 기록</button></div></form></dialog>
<div class="mm-toast" id="toast" role="status" hidden></div>
{% endblock %}
{% block foot_extra %}<script src="/shared/fmt-time.js"></script><script src="/shared/admin2/members.js?v=20261010-kst-1"></script>{% endblock %}
