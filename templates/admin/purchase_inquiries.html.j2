}
</style>
{% endblock %}

{% block content %}
<div class="pi-wrap" data-keep="1">
  <section class="pi-kpis" aria-label="요약">
    <div class="pi-kpi"><b id="kWait">—</b><span>대기</span></div>
    <div class="pi-kpi"><b id="kDoing">—</b><span>처리 중</span></div>
    <div class="pi-kpi"><b id="kDone">—</b><span>완료</span></div>
  </section>
  <div class="pi-kinds" id="piKinds" role="group" aria-label="문의 종류별 건수"></div>
  <div id="piRawNotice"></div>
  <p class="pi-note" id="piNote">고객이 상담 화면에서 연락처와 함께 남긴 신청입니다. 연락처는 개인정보이므로 처리에만 씁니다.</p>
  <p class="pi-note" id="piKindNote"></p>
  <p class="pi-note" id="piUrlNote" aria-live="polite"></p>
  <p class="pi-note" id="piVisitor" aria-live="polite"></p>
  <div class="pi-bar">
    <label>상태 <select id="piStatus"><option value="">전체</option><option>대기</option><option>처리 중</option><option>완료</option></select></label>
    <label>문의 종류 <select id="piKind"><option value="">전체</option></select></label>
    <label>주제 <select id="piTopic"><option value="">전체</option></select></label>
    <label>고객 화면 <select id="piSurface"><option value="">전체</option></select></label>
    <label>연결 <select id="piLink"><option value="">전체</option><option value="quote">보관 견적</option><option value="config">새로 구성된 PC</option><option value="none">연결 자료 없음</option></select></label>
    <label>보관 기한 <select id="piDue"><option value="">전체</option><option value="soon">곧 지남</option><option value="expired">지남</option></select></label>
    <label><input type="checkbox" id="piTest"> 시험 신청 포함</label>
    <span class="pi-muted" id="piTestNote"></span>
  </div>
  <div class="pi-table">
    <table>
      <thead><tr>
        <th scope="col">신청 시각</th><th scope="col">번호</th><th scope="col">주제</th>
        <th scope="col">연락처</th><th scope="col">상품 · 구성</th><th scope="col">상태</th><th scope="col">보관 기한</th>
      </tr></thead>
      <tbody id="piRows"><tr><td colspan="7" class="pi-empty">불러오는 중입니다.</td></tr></tbody>
    </table>
  </div>
  <div class="pi-pager">
    <span id="piPage" class="pi-muted"></span>
    <button type="button" id="piPrev">이전</button><button type="button" id="piNext">다음</button>
  </div>
</div>
<aside class="pi-drawer" id="piDrawer" hidden data-keep="1" aria-label="신청 상세">
  <header><h2 id="piDTitle">신청 상세</h2><button type="button" id="piClose">닫기</button></header>
  <div class="pi-body" id="piDBody"></div>
</aside>
<script src="/shared/admin2/raw-text.js?v=20261011"></script>
<script>
(function(){
  var API = '/api/admin/purchase-inquiries';
  var SEL = {kind:'piKind', topic:'piTopic', surface:'piSurface'};
  var st = {offset:0, limit:50, picked:null, canWrite:false,
            visitor: /^#u\d{1,12}$/.test(location.hash) ? location.hash.slice(1) : null,
            // 주소로 받은 거르기 조건 — 선택지가 서버에서 오기 전까지만 여기서 읽는다(첫 응답이 선택 상자로 옮긴다)
            fromUrl: (function(){ var u=new URLSearchParams(location.search);
              var o={kind:u.get('kind'), topic:u.get('topic'), surface:u.get('surface')};
              return (o.kind||o.topic||o.surface) ? o : null; })()};
  var $ = function(id){ return document.getElementById(id); };
  function el(tag, cls, txt){ var e=document.createElement(tag); if(cls) e.className=cls; if(txt!=null) e.textContent=txt; return e; }
  function won(n){ return n==null ? '—' : Number(n).toLocaleString('ko-KR')+'원'; }
  function signed(n){ return (n>0?'+':n<0?'−':'')+Number(Math.abs(n)).toLocaleString('ko-KR')+'원'; }
  function day(s){ return s ? new Date(s).toLocaleDateString('ko-KR',{year:'numeric',month:'2-digit',day:'2-digit'}) : '—'; }
  function when(s){ return s ? new Date(s).toLocaleString('ko-KR',{month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'}) : '—'; }
  function contact(it){ if (it.contact_purged) return '보관 기간 지남'; return [it.name, it.phone, it.email].filter(Boolean).join(' · ') || '—'; }
  function qs(){
    var p=['offset='+st.offset];
    if ($('piStatus').value) p.push('status='+encodeURIComponent($('piStatus').value));
    if ($('piLink').value) p.push('link='+encodeURIComponent($('piLink').value));
    if ($('piDue').value) p.push('due='+encodeURIComponent($('piDue').value));
    Object.keys(SEL).forEach(function(k){ var v=$(SEL[k]).value||(st.fromUrl&&st.fromUrl[k])||''; if (v) p.push(k+'='+encodeURIComponent(v)); });
    if ($('piTest').checked) p.push('include_test=true');
    if (st.visitor) p.push('visitor='+encodeURIComponent(st.visitor));
    return '?'+p.join('&');
  }
  function emptyRow(msg){ var b=$('piRows'); b.textContent=''; var tr=el('tr'); var td=el('td','pi-empty',msg); td.colSpan=7; tr.appendChild(td); b.appendChild(tr); }
  function addOpt(sel, value, label){ var o=document.createElement('option'); o.value=value; o.textContent=label; sel.appendChild(o); }
  function fillFilters(d){
    // 선택지는 서버가 준다(filters). 처음 한 번만 채우고, 서버가 받아들인 조건을 선택 상자에 되돌린다 — 주소로 연 조건도 여기서 자리를 잡는다.
    var f=d.filters||{}, kindSel=$('piKind'), topicSel=$('piTopic'), surfSel=$('piSurface');
    if (kindSel.options.length===1) (f.kinds||[]).forEach(function(k){ addOpt(kindSel,k.key,k.label); });
    if (topicSel.options.length===1) (f.topics||[]).forEach(function(t){ addOpt(topicSel,t,t); });
    if (surfSel.options.length===1) (f.surfaces||[]).forEach(function(s){ addOpt(surfSel,s.key,s.label); });
    // 주소로 연 조건은 첫 응답에서만 선택 상자로 옮긴다 — 그 뒤 응답은 사용자가 바꾼 선택을 덮지 않는다.
    if (st.fromUrl){ kindSel.value=d.kind||''; topicSel.value=d.topic||''; surfSel.value=d.surface||''; st.fromUrl=null; }
    // 종류 칩은 처음 한 번만 만들고 제자리에서 글자·눌림만 갱신한다 — 키보드 초점이 응답마다 사라지지 않게.
    var ks=$('piKinds');
    (f.kinds||[]).forEach(function(k){
      var n=(d.kind_counts&&d.kind_counts[k.key]!=null)?d.kind_counts[k.key]:'—';
      var btn=ks.querySelector('button[data-k="'+k.key+'"]');
      if (!btn){
        btn=el('button','pi-chip'); btn.type='button'; btn.setAttribute('data-k',k.key);
        btn.addEventListener('click',function(){ kindSel.value=(kindSel.value===k.key?'':k.key); $('piUrlNote').textContent=''; st.offset=0; load(); });
        ks.appendChild(btn);
      }
      btn.textContent=k.label+' '+n;
      btn.setAttribute('aria-pressed', d.kind===k.key?'true':'false');
      btn.title=d.kind===k.key?'이 종류만 보는 중 · 다시 누르면 전체':'이 종류만 보기';
    });
    $('piKindNote').textContent=d.kind_note||'';
  }
  function dropUrlFilters(){
    // 주소에서 문의 종류·주제·고객 화면만 지운다 — status= 와 #u방문자 해시는 그대로 둔다(그 조건은 계속 적용된다).
    var u=new URLSearchParams(location.search); Object.keys(SEL).forEach(function(k){ u.delete(k); });
    var q=u.toString(); history.replaceState(null,'',location.pathname+(q?'?'+q:'')+location.hash);
  }
  var seq = 0;
  function load(){
    var my = ++seq;                        // 늦게 온 응답은 버린다 — 선택을 바꾼 뒤 옛 요청이 목록·선택 상자를 덮지 않게
    fetch(API+qs()).then(function(r){
      if (my!==seq) return null;
      if (r.ok) return r.json();
      if (r.status===400 && st.fromUrl){   // 주소의 문의 종류·주제·고객 화면 조건을 서버가 모른다 — 그 셋만 빼고 다시 부른다
        st.fromUrl=null; dropUrlFilters();
        $('piUrlNote').textContent='주소에 적힌 문의 종류 · 주제 · 고객 화면 조건을 알 수 없어 빼고 봅니다. 상태 · 방문자 조건은 그대로입니다.';
        load(); return null;
      }
      throw new Error('신청 목록을 불러오지 못했습니다');
    })
    .then(function(d){
      if (!d || my!==seq) return;
      st.limit=d.limit; st.canWrite=d.can_write;
      fillFilters(d);
      $('kWait').textContent=d.counts['대기']; $('kDoing').textContent=d.counts['처리 중']; $('kDone').textContent=d.counts['완료'];
      $('piTestNote').textContent=d.include_test?'':(d.test_excluded?'시험 신청 '+d.test_excluded+'건을 뺐습니다.':'');
      $('piRawNotice').innerHTML=RawText.notice(d.raw_notice);
      $('piNote').textContent='고객이 상담 화면에서 연락처와 함께 남긴 신청입니다. 연락처는 개인정보이므로 처리에만 씁니다.'
        +(d.contact_masked?' 조회 권한에서는 연락처 가운데를 가립니다.':'');
      var vf=$('piVisitor'); vf.textContent='';
      if (st.visitor){
        vf.appendChild(document.createTextNode('방문자 '+st.visitor.slice(1)+'의 신청만 보는 중입니다. '));
        var all=el('a',null,'전체 보기'); all.href='#'; all.addEventListener('click',function(ev){ ev.preventDefault(); history.replaceState(null,'',location.pathname); st.visitor=null; st.offset=0; load(); });
        vf.appendChild(all);
      }
      if (!d.items.length){
        // 상태 건수(시험 제외 전체)가 0 이면 정말 없는 것이고, 아니면 지금 조건에 맞는 것이 없는 것이다 — 칩의 전체 건수와 모순되지 않게.
        var any=(d.counts['대기']||0)+(d.counts['처리 중']||0)+(d.counts['완료']||0);
        emptyRow(any ? '조건에 맞는 신청이 없습니다.' : '아직 구매 상담 신청이 없습니다.');
      }
      else {
        var b=$('piRows'); b.textContent='';
        d.items.forEach(function(it){
          var tr=el('tr'); tr.setAttribute('data-i', it.inquiry_id);
          if (st.picked===it.inquiry_id) tr.setAttribute('aria-selected','true');
          tr.appendChild(el('td','pi-at',when(it.at)));
          tr.appendChild(el('td',null,it.inquiry_no+(it.test?' (시험)':'')));
          var tc=el('td',null,it.topic); tc.appendChild(el('span','pi-sub',it.inquiry_kind_label||'')); tr.appendChild(tc);
          tr.appendChild(el('td',null,contact(it)));
          var pc=el('td',it.product_name||it.product_code?null:'pi-muted',it.product_name||(it.product_code?'상품 '+it.product_code:'없음'));
          pc.appendChild(el('span','pi-sub',it.surface_label+' · '+it.kind_label+(it.handoff_no?' · 팝콘PC 이동 '+it.handoff_no:'')));
          tr.appendChild(pc);
          tr.appendChild(el('td',null,it.status+(it.assignee?' · '+it.assignee:'')));
          tr.appendChild(el('td','pi-at',it.contact_purged?'지남':day(it.purge_at)));
          tr.addEventListener('click',function(){ open(it); });
          b.appendChild(tr);
        });
      }
      var from=d.total?d.offset+1:0, to=d.offset+d.items.length;
      $('piPage').textContent='전체 '+d.total+'건 중 '+from+'–'+to;
      $('piPrev').disabled=d.offset<=0; $('piNext').disabled=to>=d.total;
    }).catch(function(e){ if (my===seq) emptyRow(e.message); });
  }
  function line(b, label, value){ b.appendChild(el('span','pi-lbl',label)); b.appendChild(el('p','pi-say',value||'—')); }
  function open(it){
    st.picked=it.inquiry_id;
    Array.prototype.forEach.call(document.querySelectorAll('#piRows tr'),function(r){ r.toggleAttribute('aria-selected', r.getAttribute('data-i')==String(it.inquiry_id)); });
    $('piDTitle').textContent=it.inquiry_no+' · '+it.topic;
    var b=$('piDBody'); b.textContent='';
    line(b,'신청 시각',when(it.at));
    line(b,'신청 화면',it.surface_label);
    line(b,'문의 종류',it.inquiry_kind_label);
    line(b,'연락처 (신청 당시)',contact(it));
    line(b,'문의 내용',it.message||(it.contact_purged?'보관 기간 지남':'적지 않음'));
    line(b,'상품',it.product_name||(it.product_code?'상품 '+it.product_code:'없음'));
    line(b,'구성 · 연결',it.kind_label+'\n'+it.link_label);
    if (it.fixed_product){
      // AI 슈퍼컴퓨터 고정 완제품 문의(0165) — 금액은 신청 순간 판매가로 서버가 다시 센 값
      var fp=it.fixed_product, won=function(n){return Number(n).toLocaleString('ko-KR')+'원';};
      line(b,'모델 · 수량',(fp.storage||'')+' · '+fp.quantity+'대 · '+(fp.intent==='adoption'?'AI 도입 상담':'견적 문의')+(fp.purpose?' · '+fp.purpose:'')+
        '\n'+(fp.total!=null?'신청 시점 합계 '+won(fp.total)+' (1대 '+won(fp.unit_price)+')':'신청 시점 판매 확인 필요 · 가격 없음')+
        (fp.price_differs?'\n고객이 본 1대 가격 '+(fp.seen_unit_price!=null?won(fp.seen_unit_price):'없음')+' — 상담 때 금액 조정':''));
    }
    if (it.quote){
      var q=it.quote, qt=el('div','pi-card');
      qt.appendChild(el('h3',null,'연결된 보관 견적'));
      qt.appendChild(el('p',null,'PC 한 대 '+won(q.price)+(q.sets>1?' × '+q.sets+'대 = '+won(q.total):'')+
        (q.changes.length?'\n바꾼 부품 '+q.changes.length+'개 · 차액 '+signed(q.delta_sum):'')+
        q.changes.map(function(c){ return '\n· '+(c.label||'부품')+' '+(c.before||'—')+' → '+(c.after||'—')+(c.quantity>1?' × '+c.quantity:'')+' ('+signed(c.delta)+')'; }).join('')));
      qt.appendChild(el('span','pi-sub',q.price_note+' · 보관 '+q.purpose));
      b.appendChild(qt);
    }
    if (it.handoff_no){
      var ho=el('div','pi-card'); ho.appendChild(el('h3',null,'팝콘PC 이동 기록'));
      var ha=el('a',null,it.handoff_no+' · '+when(it.handoff_at)); ha.href='/admin2/handoff-log'; ho.appendChild(ha);
      ho.appendChild(el('span','pi-sub','이동 이유 미기록 · 구매 결과 미확인'));
      b.appendChild(ho);
    }
    if (it.contact_purged){
      b.appendChild(el('p','pi-sub','보관 기한이 지나 연락처와 신청 내용을 표시하지 않습니다.'));
      b.appendChild(el('span','pi-sub',it.purged_at?'파기 작업이 값을 비운 시각 '+when(it.purged_at):'실제 파기 여부 미확인 · 보관 기한 · 파기 이력 화면에서 실행 기록 확인'));
    } else if (it.registered){
      var rg=it.registered, rc=el('div','pi-card'+(rg.differs?' warn':''));
      rc.appendChild(el('h3',null,'현재 등록 연락처 (견적 보관 때 받은 연락처)'));
      rc.appendChild(el('p',null,[rg.name,rg.phone,rg.email].filter(Boolean).join(' · ')||'—'));
      rc.appendChild(el('span','pi-sub',rg.differs?'현재 등록 연락처와 다릅니다. 이 신청에 남긴 연락처를 확인해 주세요.':'이 신청에 남긴 연락처와 같습니다.'));
      rc.appendChild(el('span','pi-sub','등록 연락처 파기 예정일 '+day(rg.purge_at)));
      b.appendChild(rc);
    }
    if (it.free_build && it.free_build.parts){
      var fb=it.free_build;
      line(b,'고객이 고른 부품',fb.parts.map(function(p){ return p.slot+' '+p.name+(p.quantity>1?' × '+p.quantity:'')+' · '+Number(p.sale_price*p.quantity).toLocaleString('ko-KR')+'원'; }).join('\n')
        +'\n조립비 '+Number(fb.assembly_fee).toLocaleString('ko-KR')+'원 · 총액 '+Number(fb.total).toLocaleString('ko-KR')+'원 (신청 시각 판매가)'
        +((fb.empty||[]).length?'\n비운 자리: '+fb.empty.join(', '):''));
    }
    if (it.visitor){ var a=el('a',null,'이 방문자의 문의 · 보관 견적 보기'); a.href='/admin2/mvp3-consults#'+it.visitor; b.appendChild(a); }
    b.appendChild(el('span','pi-lbl','이 신청의 파기 예정일 '+day(it.purge_at)+(it.contact_purged?' · 기한 지남 · 개인정보 표시 제한':'')));
    b.appendChild(el('span','pi-lbl','처리'));
    var row=el('div','pi-status');
    ['대기','처리 중','완료'].forEach(function(s){
      var l=el('label'); var r=el('input'); r.type='radio'; r.name='piSt'; r.value=s; r.checked=it.status===s; r.disabled=!st.canWrite;
      l.appendChild(r); l.appendChild(document.createTextNode(' '+s)); row.appendChild(l);
    });
    b.appendChild(row);
    var ml=el('label'); var mine=el('input'); mine.type='checkbox'; mine.disabled=!st.canWrite;
    ml.appendChild(mine); ml.appendChild(document.createTextNode(' 내가 맡기'+(it.assignee?' (지금 담당: '+it.assignee+')':'')));
    var mr=el('div','pi-status'); mr.appendChild(ml); b.appendChild(mr);
    var ta=el('textarea'); ta.maxLength=1000; ta.placeholder='연락 결과와 다음 할 일을 적습니다.'; ta.value=it.memo||''; ta.disabled=!st.canWrite; b.appendChild(ta);
    var save=el('button',null,'저장'); save.disabled=!st.canWrite;
    var msg=el('span','pi-msg', st.canWrite?(it.updated_at?'마지막 저장 '+when(it.updated_at):''):'조회 권한은 처리 결과를 저장할 수 없습니다.');
    var ln=el('div','pi-status'); ln.appendChild(save); ln.appendChild(msg); b.appendChild(ln);
    save.addEventListener('click',function(){
      var picked=b.querySelector('input[name=piSt]:checked');
      save.disabled=true; msg.className='pi-msg'; msg.textContent='저장하는 중입니다.';
      fetch(API+'/'+it.inquiry_id,{method:'PUT',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({status:picked?picked.value:'대기', memo:ta.value, assign_me:mine.checked})})
      .then(function(r){ return r.json().then(function(d){ return {ok:r.ok,d:d}; }); })
      .then(function(x){ if(!x.ok) throw new Error((x.d&&x.d.detail)||'저장하지 못했습니다'); msg.textContent=x.d.note; save.disabled=false; load(); })
      .catch(function(e){ msg.className='pi-msg err'; msg.textContent=e.message; save.disabled=false; });
    });
    $('piDrawer').hidden=false;
  }
  $('piClose').addEventListener('click',function(){ $('piDrawer').hidden=true; st.picked=null; });
  // 「운영 현황」 카드처럼 주소에 status= 가 오면 같은 조건으로 연다(목록에 있는 값만 받는다).
  (function(){ var v=new URLSearchParams(location.search).get('status'); var sel=$('piStatus');
    if (v && Array.prototype.some.call(sel.options,function(o){ return o.value===v; })) sel.value=v; })();
  ['piStatus','piKind','piTopic','piSurface','piLink','piDue','piTest'].forEach(function(id){ $(id).addEventListener('change',function(){ $('piUrlNote').textContent=''; st.offset=0; load(); }); });
  $('piPrev').addEventListener('click',function(){ st.offset=Math.max(0,st.offset-st.limit); load(); });
  $('piNext').addEventListener('click',function(){ st.offset+=st.limit; load(); });
  load();
})();
</script>
{% endblock %}
