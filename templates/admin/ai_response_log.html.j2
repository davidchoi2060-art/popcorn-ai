          '<span class="body"><span class="claim">' + esc(f.claim) + '</span><span class="engine">' + esc(f.engine) + '</span></span></div>';
      }).join('') + '</div></div>';
    $('dwFoot').textContent = '가상 데이터입니다 — 플래그는 저장되지 않고 화면을 벗어나면 사라집니다';
    $('dwFlagBtn').classList.toggle('on', !!row.flagged);
    $('dwFlagBtn').textContent = row.flagged ? '⚑ 플래그 해제' : '⚑ 플래그';
  }
  function toggleFlag() {
    if (S.sel == null) return;
    var row = S.demo[S.sel];
    row.flagged = !row.flagged;
    toast(row.flagged ? '플래그를 남겼습니다 — 목록에서 ⚑로 바로 보입니다(가상 데이터, 저장되지 않음)' : '플래그를 해제했습니다', 'ok');
    renderPreview(); renderDrawer();
  }

  // ── 이벤트 위임 ──────────────────────────────────────────────────
  document.addEventListener('click', function (e) {
    if (!(window.Admin2Shell && window.Admin2Shell.isKeepClick(e.target))) {
      if (S.drawerOpen) closeDrawer();
    }
    if (!e.target.closest('.filter-group')) { S.openMenu = null; renderFilterMenus(); }

    var t = e.target.closest('[data-action]');
    if (!t) return;
    switch (t.getAttribute('data-action')) {
      case 'set-mode': setMode(t.getAttribute('data-mode')); break;
      case 'toggle-menu': { var k = t.getAttribute('data-menu'); S.openMenu = S.openMenu === k ? null : k; renderFilterMenus(); break; }
      case 'set-period': S.f.period = t.getAttribute('data-v'); S.openMenu = null; renderFilterBar(); renderFilterMenus(); if (S.mode === 'measured') loadMeasured(); break;
      case 'set-task': S.f.task = t.getAttribute('data-v'); S.openMenu = null; renderFilterBar(); renderFilterMenus(); if (S.mode === 'measured') loadMeasured(); else renderPreview(); break;
      case 'set-model': S.f.model = t.getAttribute('data-v'); S.openMenu = null; renderFilterBar(); renderFilterMenus(); if (S.mode === 'measured') loadMeasured(); else renderPreview(); break;
      case 'toggle-flagged': S.flaggedOnly = !S.flaggedOnly; renderFilterBar(); if (S.mode === 'measured') loadMeasured(); else renderPreview(); break;
      case 'open-row': openRow(Number(t.getAttribute('data-idx'))); break;
      case 'close-drawer': closeDrawer(); break;
      case 'toggle-flag': toggleFlag(); break;
      case 'go-task-settings': toast('AI 작업 설정(ADM-AI-030)으로 이동 — 이 작업의 모델·폴백을 바꿀 수 있습니다', 'ok'); break;
      case 'retry-measured': loadMeasured(); break;
      default: break;
    }
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && S.drawerOpen) closeDrawer();
  });

  function boot() {
    // 작업 종류 라벨은 서버(decision-log A-35 기준)에서 받는다 — 화면이 다시 정의하지 않는다.
    loadMeasured();
    renderAll();
  }
  boot();
})();
</script>
