{% endblock %}
{#  ui-progress.js · admin2-shell.js는 셸(_admin2_shell.html.j2)이 이미 싣는다(100~101행).
    content 블록은 그 두 스크립트보다 문서상 "먼저" 렌더링되므로, 아래 로직 스크립트를
    여기(foot_extra)로 옮겨 셸 스크립트 다음에 실행되게 한다 — 안 그러면 admin2-shell.js가
    두 번 실행돼 window.Admin2Shell 인스턴스가 둘 생기고, 이 화면의 meReady 콜백이 먼저 뜬
    인스턴스에 걸려 나중에 덮어써진 뒤로는 영영 resolve되지 않는다(owner인데도 업로드
    카드가 계속 잠긴 채였던 원인 — 2026-08-15 확인자 실측). #}
{% block foot_extra %}
<script>
(function () {
  'use strict';

  var S = {
    meLoaded: false, canUpload: false,
    phase: 'form',
    masterFile: null, eavProducts: null, eavSpecs: null, origin: 'real',
    dryrunLoading: false, dryrunError: null, staging: null,
    applyLoading: false, applyError: null, applied: null,
    lastImpact: null, lastSkipTotal: 0,
    jobs: null, jobsErr: null,
    drawerJobId: null, drawerListMeta: null, drawerData: null, drawerErr: null,
    drawerLoading: false, drawerTab: null,
    // 적재 원본 보관 목록(요청 39 · 2026-08-31). owner 가 아니면 서버가 403을 주므로
    // 그때는 null 로 두고 단추를 아예 그리지 않는다 — 눌러도 안 되는 단추를 두지 않는다.
    drawerFiles: null
  };
  var PART_LABELS = {};

  function $(id) { return document.getElementById(id); }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function mdBold(s) { return s.replace(/\*\*(.+?)\*\*/g, '<b>$1</b>'); }
  function numBold(s) { return s.replace(/\d[\d,]*/g, function (m) { return '<b class="num">' + m + '</b>'; }); }
  function rich(s) { return numBold(mdBold(esc(s))); }
  function fmt(n) { return (n === null || n === undefined) ? '—' : Number(n).toLocaleString('ko-KR'); }
  function fmtDate(s) {
    if (!s) return '—';
    var d = new Date(s);
    if (isNaN(d.getTime())) return String(s);
    function p(n) { return (n < 10 ? '0' : '') + n; }
    return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
  }
  function partLabel(pt) { return PART_LABELS[pt] || pt; }
  function friendlyErr(e) {
    if (e && e.status === 401) return '세션이 만료되었습니다 — 새로고침 후 다시 로그인해 주세요.';
    if (e && e.status === 403) return '권한이 없습니다 — owner 등급만 할 수 있습니다.';
    if (e && e.status) return e.message || ('오류 ' + e.status);
    return '네트워크 오류 — 연결을 확인하고 다시 시도하세요.';
  }

  // ── API — 공용 진행 배너를 걸지 않는 원본 fetch만 쓴다(상단 캡처, ui-progress.js 로드 전) ──
  function handle(res) {
    return res.clone().json().catch(function () { return null; }).then(function (j) {
      if (!res.ok) {
        var msg = '';
        try {
          if (window.popcornProgress && window.popcornProgress.errText) {
            msg = window.popcornProgress.errText(j, res.status, '') || '';
          }
        } catch (e2) { msg = ''; }
        if (!msg && j) {
          if (j.detail && typeof j.detail === 'object' && typeof j.detail.detail === 'string') msg = j.detail.detail;
          else if (typeof j.detail === 'string') msg = j.detail;
          else if (j.detail) msg = JSON.stringify(j.detail);
        }
        if (!msg) msg = '오류 ' + res.status;
        var e = new Error(msg); e.status = res.status; e.body = j; throw e;
      }
      return j;
    });
  }
  function apiGet(path) { return window.__ciRawFetch(path, { credentials: 'same-origin' }).then(handle); }
  function apiPostBody(path, body) {
    return window.__ciRawFetch(path, { method: 'POST', credentials: 'same-origin', body: body }).then(handle);
  }

  // ── 좌측 상단 권한 안내 ─────────────────────────────────────────────
  function renderScope() {
    var el = $('ciScope');
    if (!S.meLoaded) { el.textContent = '권한 확인 중…'; return; }
    el.innerHTML = S.canUpload
      ? '업로드·적용은 <b>owner</b> 등급만 가능합니다 · 이력·오류 조회는 로그인한 모든 등급에 열려 있습니다.'
      : '조회 전용입니다 — 업로드·적용은 <b>owner</b> 등급만 가능합니다. 아래 이력·오류 조회는 그대로 이용할 수 있습니다.';
  }

  // ── 좌측 aside — 국면과 무관한 고정 계약 참고 카드 ──────────────────
  function renderAside() {
    var el = $('ciAside');
    if (!S.meLoaded || !S.canUpload) { el.hidden = true; return; }
    el.hidden = false;
    el.innerHTML = ''
      + '<div class="ci-cap">올리기 전에 — 고정 계약</div>'
      + '<div class="ci-card"><div style="font-weight:600;font-size:11px;margin-bottom:4px">헤더 14열이 정확히 있어야 합니다 — 열 매핑 기능 없음</div>'
      + '<div style="font-family:var(--font-num);font-size:10px;line-height:1.7;color:var(--rv-muted)">자체상품코드 · 상품명 · 카테고리1 · 카테고리2 · 카테고리3 · 상태값 · 매입가 · 일반회원 · 시중가 · 공급처 · 스펙 · 제조사 · 모델명 · 다나와No</div>'
      + '<div class="ci-note" style="margin-top:4px">하나라도 없으면 즉시 거부되고 무엇이 없는지 그대로 알려줍니다.</div></div>'
      + '<div class="ci-card"><div style="font-weight:600;font-size:11px;margin-bottom:4px">자체상품코드 = 쇼핑몰 상품코드(pd_no)</div>'
      + '<div class="ci-note">이 코드가 정본 코드를 그대로 결정합니다 — 잘못된 코드는 라이브 몰 상품과 충돌하거나 엉뚱한 상품을 덮어씁니다.</div></div>'
      + '<div class="ci-card"><div class="ci-note">삭제는 없습니다 — 올린다고 기존 상품이 사라지지 않습니다. 운영자가 잠근(locked) 값은 덮지 않습니다. 미리보기 후 <b style="color:var(--on)">1시간</b> 안에 적용하지 않으면 파일이 청소되어 처음부터 다시 합니다.</div></div>';
  }

  // ── 중앙 패널 — 국면별 렌더 ──────────────────────────────────────────
  function renderPanel() {
    var el = $('ciPanel');
    if (!S.meLoaded) { el.innerHTML = '<div class="ci-loading">권한 확인 중…</div>'; return; }
    if (!S.canUpload) { el.innerHTML = lockedHtml(); return; }
    if (S.phase === 'report' && S.staging) { el.innerHTML = reportHtml(S.staging); return; }
    if (S.phase === 'done' && S.applied) { el.innerHTML = doneHtml(S.applied); return; }
    el.innerHTML = formHtml();
  }

  function lockedHtml() {
    return '<div class="ci-lock"><span class="tag">잠김</span>'
      + '<span style="flex:1;min-width:0">'
      + '<span class="t">새 일괄 등록은 owner 등급만 할 수 있습니다</span>'
      + '<span class="d">파일 하나가 정본 카탈로그 전체를 되돌리기 없이 덮을 수 있어 업로드·적용은 owner 전용입니다(시도 시 403). 아래 이력·거부 행 조회는 등급 무관하게 열려 있습니다 — 의도된 비대칭입니다.</span>'
      + '</span></div>';
  }

  function eavRowHtml(label, suffix, file) {
    return '<div class="ci-filerow"><span style="flex:none;width:14px">' + (file ? '✓' : '○') + '</span>'
      + '<span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + esc(label) + (file ? (' · ' + esc(file.name)) : '') + '</span>'
      + '<button type="button" class="ci-btn ghost" data-action="ci-pick-' + suffix + '" style="padding:5px 9px;font-size:10.5px;flex:none">' + (file ? '교체' : '선택') + '</button>'
      + (file ? ('<button type="button" class="ci-btn ghost" data-action="ci-clear-' + suffix + '" style="padding:5px 9px;font-size:10.5px;flex:none">지우기</button>') : '')
      + '</div>';
  }

  function formHtml() {
    var m = S.masterFile, eavP = S.eavProducts, eavS = S.eavSpecs;
    var eavMismatch = (!!eavP !== !!eavS);
    var canGo = !!m && !eavMismatch && !S.dryrunLoading;
    return ''
      + '<div class="ci-cap">새 일괄 등록 — 업로드 → 미리보기 → 확인 → 적용 순서가 강제됩니다</div>'
      + (m
        ? ('<div class="ci-card"><div style="display:flex;align-items:center;gap:8px">'
          + '<span style="color:oklch(0.5 0.11 165);font-weight:600">✓</span>'
          + '<span style="flex:1;min-width:0;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + esc(m.name) + '</span>'
          + '<button type="button" class="ci-btn ghost" data-action="ci-clear-master" style="padding:6px 10px;font-size:11px;flex:none">지우기</button>'
          + '</div><div class="ci-note" style="margin-top:4px">' + (m.size / 1048576).toFixed(1) + 'MB</div></div>')
        : ('<div class="ci-drop" data-drop="master" data-action="ci-pick-master">'
          + '<span class="tag">CSV</span>'
          + '<span class="t">마스터 CSV를 끌어다 놓거나 클릭해서 선택</span>'
          + '<span class="d">필수 · 최대 64MB · UTF-8 · 헤더 14열이 정확히 일치해야 합니다</span>'
          + '</div>'))
      + '<input type="file" id="ciMasterInput" accept=".csv,text/csv" hidden>'
      + '<div class="ci-eav">'
      + '<div class="lb">사양 EAV 세트 (선택 · 2파일 함께)</div>'
      + '<div class="d">db_products + db_specs — 둘 중 하나만 올리면 그 자리에서 막힙니다. 안 올리면 사양은 "스펙" 열에서만 추출되고 기존 확인값은 유지됩니다.</div>'
      + eavRowHtml('db_products (상품 매핑)', 'eavp', eavP)
      + eavRowHtml('db_specs (사양 값)', 'eavs', eavS)
      + (eavMismatch ? '<div class="ci-err">두 파일을 모두 선택하거나 모두 비워야 합니다.</div>' : '')
      + '</div>'
      + '<input type="file" id="ciEavPInput" hidden>'
      + '<input type="file" id="ciEavSInput" hidden>'
      + '<div class="ci-cap" style="margin-top:2px">데이터 원천 — 명시적으로 선택</div>'
      + '<div class="ci-origin">'
      + '<button type="button" class="' + (S.origin === 'real' ? 'on' : '') + '" data-action="ci-origin-real">실데이터</button>'
      + '<button type="button" class="' + (S.origin === 'demo' ? 'on' : '') + '" data-action="ci-origin-demo">데모</button>'
      + '</div>'
      + '<div class="ci-warn"><b>적용 후 되돌리기가 없습니다.</b> 자체상품코드는 라이브 몰 상품코드(pd_no)와 같은 값입니다 — 잘못된 코드로 올리면 다른 상품을 덮어쓸 수 있습니다.</div>'
      + '<span class="ci-grow"></span>'
      + '<div class="ci-foot-row">'
      + '<span class="ci-grow"></span>'
      + (S.dryrunError ? ('<span class="ci-err" style="flex:none;max-width:360px">' + esc(S.dryrunError) + '</span>') : '')
      + (S.dryrunLoading ? '<span class="ci-note">확인하는 중…</span>' : '')
      + '<button type="button" class="ci-btn" data-action="ci-preview" ' + (canGo ? '' : 'disabled') + '>미리보기(드라이런)</button>'
      + '</div>';
  }

  function reportHtml(st) {
    var s = st.summary || {}, imp = st.impact || {};
    var distHtml = (s.by_type && s.by_type.length)
      ? s.by_type.map(function (t) { return esc(partLabel(t.part_type)) + ' ' + fmt(t.n); }).join(' · ')
      : '';
    var skipKeys = Object.keys(s.skipped || {});
    var skipHtml = skipKeys.length
      ? skipKeys.sort(function (a, b) { return s.skipped[b] - s.skipped[a]; })
        .map(function (k) { return esc(k) + ' ' + fmt(s.skipped[k]); }).join(' · ')
      : '없음';
    var errGroups = {};
    (s.error_samples || []).forEach(function (e) { errGroups[e.reason] = (errGroups[e.reason] || 0) + 1; });
    var errKeys = Object.keys(errGroups);
    var errHtml = errKeys.length
      ? errKeys.sort(function (a, b) { return errGroups[b] - errGroups[a]; })
        .map(function (k) { return esc(k) + ' ' + fmt(errGroups[k]); }).join(' · ')
      : '없음';
    var sampleShown = (s.error_samples || []).length;
    var errSampleNote = (s.error > sampleShown)
      ? ('<div class="ci-note" style="margin-top:3px">표본 ' + fmt(sampleShown) + '건 기준(총 ' + fmt(s.error) + '건) — 전량은 적용 후 배치 상세에서 확인합니다.</div>')
      : '';
    return ''
      + '<div class="ci-cap">드라이런 보고 — DB는 아직 그대로입니다 · staging ' + esc(st.staging_id) + '</div>'
      + '<div class="ci-verdict">' + rich(st.verdict || '') + '</div>'
      + (distHtml ? ('<div class="ci-dist"><span class="k">부품 종류별 분포</span><span class="v">' + distHtml + '</span></div>') : '')
      + '<div class="ci-chip"><span class="k">제외 ' + fmt(s.skipped_total) + '</span><span class="v">' + skipHtml + (s.skipped_total ? ' — <b style="color:oklch(0.5 0.14 55)">이 사유는 적용 후 다시 볼 수 없습니다. 지금 확인하세요.</b>' : '') + '</span></div>'
      + '<div class="ci-chip err"><span class="k">오류 ' + fmt(s.error) + '</span><span class="v">' + errHtml + (s.error ? ' — 반영되지 않고 원본·사유가 저장됩니다.' : '') + errSampleNote + '</span></div>'
      + '<div class="ci-chip"><span class="k">사양</span><span class="v">' + (st.eav_included ? '사양 EAV 파일을 반영합니다.' : '사양 파일이 없어 "스펙" 열에서만 추출합니다 — 이미 확인된 기존 사양값은 유지됩니다.') + '</span></div>'
      + '<div class="ci-chip"><span class="k">잠금</span><span class="v">운영자가 손으로 고쳐 잠근 값(locked_fields)은 파일 내용과 무관하게 덮지 않습니다.</span></div>'
      + (st.warning ? ('<div class="ci-warn">' + rich(st.warning) + '</div>') : '')
      + (st.note ? ('<div class="ci-note">' + esc(st.note) + '</div>') : '')
      + '<span class="ci-grow"></span>'
      + '<div class="ci-foot-row">'
      + '<span class="ci-note" style="max-width:420px">적용 시 확인한 건수(expect_ok=' + fmt(s.ok) + ')를 함께 보냅니다 — 그 사이 DB가 바뀌면 거부되고 다시 검증합니다.</span>'
      + '<span class="ci-grow"></span>'
      + (S.applyError ? ('<span class="ci-err" style="flex:none;max-width:300px">' + esc(S.applyError) + '</span>') : '')
      + (S.applyLoading ? '<span class="ci-note">적용하는 중…</span>' : '')
      + '<button type="button" class="ci-btn ghost" data-action="ci-reset" ' + (S.applyLoading ? 'disabled' : '') + '>처음부터 다시</button>'
      + '<button type="button" class="ci-btn danger" data-action="ci-apply" ' + (S.applyLoading ? 'disabled' : '') + '>되돌릴 수 없음을 알고 ' + fmt(s.ok) + '건 적용</button>'
      + '</div>';
  }

  function statCard(label, value, delta, sub) {
    var deltaHtml = (delta === null || delta === undefined) ? '' : ('<span class="dd' + (delta < 0 ? ' down' : '') + '">' + (delta >= 0 ? '+' : '') + fmt(delta) + '</span>');
    return '<div class="ci-stat"><div class="lb">' + esc(label) + '</div>'
      + '<div class="row"><span class="vv num">' + fmt(value) + '</span>' + deltaHtml + '</div>'
      + '<div class="sub">' + esc(sub || '') + '</div></div>';
  }

  function doneHtml(ap) {
    var a = ap.after || {};
    var im = S.lastImpact || {};
    return ''
      + '<div class="ci-donewrap">'
      + '<div class="ci-done">'
      + '<div class="t">✓ 배치 #' + fmt(ap.job_id) + '로 반영되었습니다</div>'
      + '<div class="d">' + rich(ap.verdict || '') + '</div>'
      + '<div class="ci-note">' + (S.lastSkipTotal ? ('제외 ' + fmt(S.lastSkipTotal) + '건의 사유는 저장되지 않았습니다 — 드라이런 화면에서만 볼 수 있었습니다. ') : '') + '반영 행의 원본 셀도 보관하지 않습니다(원본 CSV가 정본). 되돌리기는 없습니다 — 고친 CSV를 다시 올려 upsert로 바로잡습니다.</div>'
      + '<span class="ci-grow"></span>'
      + '<div style="display:flex;gap:9px;flex-wrap:wrap">'
      + '<button type="button" class="ci-btn" data-action="ci-open-applied">배치 #' + fmt(ap.job_id) + ' 상세</button>'
      + '<button type="button" class="ci-btn ghost" data-action="ci-reset">새 일괄 등록 시작</button>'
      + '</div>'
      + '</div>'
      + '<div class="ci-stats">'
      + statCard('카탈로그 전체', a.catalog, (im.new !== undefined ? im.new : null), '실데이터 · 데모 합계')
      + statCard('추천 후보', a.pool, (im.pool_in !== undefined ? (im.pool_in - im.pool_out) : null), (im.pool_in !== undefined ? ('진입 ' + fmt(im.pool_in) + ' · 이탈 ' + fmt(im.pool_out) + ' — 드라이런 예고와 일치') : ''))
      + statCard('검수 대기', a.review, (im.review_new !== undefined ? im.review_new : null), '상품 사양 검수 화면에서 처리합니다')
      + '</div>'
      + '</div>';
  }

  // ── 부품 라벨 — product-meta 재사용(코드→한글을 이 화면에서 다시 정의하지 않는다) ──
  function loadMeta() {
    apiGet('/api/admin/product-meta').then(function (j) {
      ['part_labels', 'peripheral_labels', 'built_labels'].forEach(function (k) {
        (j[k] || []).forEach(function (x) { PART_LABELS[x.part_type] = x.label; });
      });
    }).catch(function () { /* 라벨 없이도 화면은 동작 — 코드값 그대로 표시 */ });
  }

  // ── 배치 이력 ────────────────────────────────────────────────────────
  function loadJobs() {
    S.jobsErr = null;
    apiGet('/api/admin/import-jobs').then(function (j) {
      S.jobs = j; renderJobs();
    }).catch(function (e) {
      S.jobsErr = friendlyErr(e); renderJobs();
    });
  }
  function rowHtml(it) {
    var errHas = it.error > 0;
    return '<div class="ci-row ci-row-body' + (S.drawerJobId === it.job_id ? ' on' : '') + '" data-jobid="' + it.job_id + '" data-action="ci-open-job">'
      + '<span class="no">#' + it.job_id + '</span>'
      + '<span class="at">' + fmtDate(it.at) + '</span>'
      + '<span class="who">' + esc(it.operator || '—') + '</span>'
      + '<span class="file">' + esc(it.file || '—') + '</span>'
      + '<span class="ci-origin-tag ' + (it.origin === 'demo' ? 'demo' : 'real') + '">' + esc(it.origin_label || it.origin || '—') + '</span>'
      + '<span class="num">' + fmt(it.total) + '</span>'
      + '<span class="num ok">' + fmt(it.ok) + '</span>'
      + '<span class="num">' + fmt(it.review) + '</span>'
      + '<span class="num err' + (errHas ? ' has' : '') + '">' + fmt(it.error) + '</span>'
      + '<span class="ci-status">' + esc(it.status || '—') + '</span>'
      + '</div>';
  }
  function renderJobs() {
    var body = $('ciJobsBody');
    if (S.jobsErr) {
      body.innerHTML = '<div class="ci-errbox">이력을 불러오지 못했습니다 — ' + esc(S.jobsErr) + '</div>';
      $('ciHistCount').textContent = '—'; $('ciHistCat').textContent = '';
      return;
    }
    if (!S.jobs) { body.innerHTML = '<div class="ci-empty">불러오는 중…</div>'; return; }
    var items = S.jobs.items || [], sum = S.jobs.summary || {};
    var realN = 0, demoN = 0;
    items.forEach(function (it) { if (it.origin === 'demo') demoN++; else realN++; });
    var trunc = (sum.batches && items.length < sum.batches);
    $('ciHistCount').textContent = '전체 ' + fmt(sum.batches) + '건 · 실데이터 ' + fmt(realN) + ' · 데모 ' + fmt(demoN) + (trunc ? ' (최근 ' + items.length + '건 표시)' : '');
    $('ciHistCat').innerHTML = sum.catalog !== undefined
      ? ('현재 카탈로그 실측 <b class="num">' + fmt(sum.catalog) + '</b>건 (실데이터 ' + fmt(sum.real) + ' · 데모 ' + fmt(sum.demo) + ') — 배치 합계와 다를 수 있습니다')
      : '';
    if (!items.length) { body.innerHTML = '<div class="ci-empty">등록된 배치가 없습니다.</div>'; return; }
    body.innerHTML = items.map(rowHtml).join('')
      + (S.jobs.note ? ('<div class="ci-foot-note">' + esc(S.jobs.note) + '</div>') : '');
  }

  // ── 미리보기 / 적용 / 초기화 ────────────────────────────────────────
  function runPreview() {
    if (!S.masterFile || S.dryrunLoading) return;
    if (!!S.eavProducts !== !!S.eavSpecs) { S.dryrunError = '사양 EAV는 두 파일을 함께 올리거나 모두 비워야 합니다.'; renderPanel(); return; }
    S.dryrunLoading = true; S.dryrunError = null; renderPanel();
    var fd = new FormData();
    fd.append('master', S.masterFile);
    if (S.eavProducts) fd.append('db_products', S.eavProducts);
    if (S.eavSpecs) fd.append('db_specs', S.eavSpecs);
    fd.append('origin', S.origin);
    apiPostBody('/api/admin/catalog-import/dryrun', fd).then(function (j) {
      S.dryrunLoading = false; S.staging = j; S.phase = 'report'; renderPanel();
    }).catch(function (e) {
      S.dryrunLoading = false; S.dryrunError = friendlyErr(e); renderPanel();
    });
  }
  function resetForm() {
    S.masterFile = null; S.eavProducts = null; S.eavSpecs = null; S.origin = 'real';
    S.staging = null; S.dryrunError = null; S.applyError = null; S.applied = null;
    S.phase = 'form'; renderPanel();
  }
  function runApply() {
    if (!S.staging || S.applyLoading) return;
    S.applyLoading = true; S.applyError = null; renderPanel();
    var body = new URLSearchParams();
    body.append('staging_id', S.staging.staging_id);
    body.append('expect_ok', String(S.staging.summary.ok));
    apiPostBody('/api/admin/catalog-import/apply', body).then(function (j) {
      S.applyLoading = false;
      S.lastImpact = S.staging.impact; S.lastSkipTotal = S.staging.summary.skipped_total;
      S.applied = j; S.staging = null; S.phase = 'done'; renderPanel();
      loadJobs();
    }).catch(function (e) {
      S.applyLoading = false; S.applyError = friendlyErr(e); renderPanel();
    });
  }

  // ── 배치 상세 서랍 ──────────────────────────────────────────────────
  function openDrawer(jobId, listMeta) {
    S.drawerJobId = jobId; S.drawerListMeta = listMeta || null;
    S.drawerData = null; S.drawerErr = null; S.drawerLoading = true; S.drawerTab = null;
    S.drawerFiles = null;
    $('ciBackdrop').hidden = false; $('ciDrawer').hidden = false;
    renderJobs(); renderDrawer();
    // 보관 목록은 **곁다리 조회**다 — 실패해도 서랍 본문을 막지 않는다(owner 아니면 403).
    apiGet('/api/admin/catalog-import/jobs/' + jobId + '/files').then(function (f) {
      if (S.drawerJobId === jobId) { S.drawerFiles = f; renderDrawer(); }
    }).catch(function () { /* 권한 없음·미보관 — 단추를 안 그린다 */ });
    apiGet('/api/admin/import-jobs/' + jobId + '/rows?limit=500').then(function (j) {
      S.drawerLoading = false; S.drawerData = j;
      var errs = (j.rows || []).filter(function (r) { return r.kind === 'error'; });
      S.drawerTab = errs.length ? 'error' : 'kept';
      renderDrawer();
    }).catch(function (e) {
      S.drawerLoading = false; S.drawerErr = friendlyErr(e); renderDrawer();
    });
  }
  function closeDrawer() {
    S.drawerJobId = null;
    $('ciBackdrop').hidden = true; $('ciDrawer').hidden = true;
    renderJobs();
  }
  function renderDrawer() {
    if (!S.drawerJobId) return;
    var lm = S.drawerListMeta;
    $('ciDwTitle').textContent = '배치 #' + S.drawerJobId + (lm && lm.file ? (' — ' + lm.file) : '');
    if (S.drawerLoading) {
      $('ciDwMeta').textContent = ''; $('ciDwTabs').innerHTML = '';
      $('ciDwBody').innerHTML = '<div class="ci-loading">불러오는 중…</div>'; $('ciDwFoot').textContent = '';
      return;
    }
    if (S.drawerErr) {
      $('ciDwMeta').textContent = ''; $('ciDwTabs').innerHTML = '';
      $('ciDwBody').innerHTML = '<div class="ci-errbox">' + esc(S.drawerErr) + '</div>'; $('ciDwFoot').textContent = '';
      return;
    }
    var d = S.drawerData; if (!d || !d.job) return;
    var job = d.job;
    var metaParts = [fmtDate(job.at)];
    if (lm && lm.operator) metaParts.push(esc(lm.operator));
    metaParts.push(job.origin === 'demo' ? '데모' : '실데이터');
    metaParts.push(fmt(job.total) + '행 → 반영 ' + fmt(job.ok) + ' · 검수 ' + fmt(job.review) + ' · 오류 ' + fmt(job.error));
    $('ciDwMeta').innerHTML = metaParts.map(function (x) { return '<span>' + x + '</span>'; }).join('');

    var rows = d.rows || [];
    var errs = rows.filter(function (r) { return r.kind === 'error'; });
    var kept = rows.filter(function (r) { return r.kind === 'kept'; });
    $('ciDwTabs').innerHTML = ''
      + '<button type="button" class="ci-dw-tab' + (S.drawerTab === 'error' ? ' on' : '') + '" data-action="ci-dw-tab-error">거부 행 <span class="num">' + fmt(job.error) + '</span></button>'
      + '<button type="button" class="ci-dw-tab' + (S.drawerTab === 'kept' ? ' on' : '') + '" data-action="ci-dw-tab-kept">반영 상품 <span class="num">' + fmt(job.ok) + '</span></button>';

    var bodyHtml = '';
    if (S.drawerTab === 'error') {
      if (!job.error) bodyHtml = '<div class="ci-empty">거부된 행이 없습니다.</div>';
      else if (!errs.length) bodyHtml = '<div class="ci-empty">저장된 원본이 없습니다.</div>';
      else {
        bodyHtml = errs.map(function (e) {
          var cells = (e.cells || []).map(function (c) { return '<span class="cell"><b>' + esc(c.col) + '</b> ' + esc(c.value) + '</span>'; }).join('');
          return '<div class="ci-rej"><div class="row1"><span class="ln">행 ' + fmt(e.row_no) + '</span><span class="rs">' + esc(e.reason || '') + '</span></div>'
            + (cells ? ('<div class="cells">' + cells + '</div>') : '') + '</div>';
        }).join('');
        if (job.error > errs.length) {
          bodyHtml += '<div class="ci-note">표시 ' + fmt(errs.length) + '건 / 총 ' + fmt(job.error) + '건 — 배치당 원본은 최대 200행까지만 저장됩니다.</div>';
        }
      }
    } else {
      if (!job.ok) bodyHtml = '<div class="ci-empty">반영된 상품이 없습니다.</div>';
      else if (!kept.length) {
        bodyHtml = '<div class="ci-note">원본 셀은 보관하지 않습니다 — 반영 총 ' + fmt(job.ok) + '건은 상품 관리에서 SKU로 조회하세요.</div>';
      } else {
        bodyHtml = '<div class="ci-sku">' + kept.map(function (k) { return '<span>' + esc(k.sku || '—') + '</span>'; }).join('') + '</div>';
      }
    }
    $('ciDwBody').innerHTML = bodyHtml;

    // ── 적재 원본 내려받기 (요청 39 · 2026-08-31) ──────────────────────────
    //   2026-08-31 이전 배치는 파일이 없다 — 그때는 적재 후 스테이징을 지우기만 했다.
    //   **없는 것을 있는 척하지 않는다**: 단추를 안 그리고 그 사유를 서버 문장으로 적는다.
    var f = S.drawerFiles, dlHtml = '';
    if (f && (f.items || []).length) {
      dlHtml = '<div class="ci-dl"><span class="ci-dl-lb">적재한 원본</span>'
        + f.items.map(function (it) {
            return '<a class="ci-dl-btn" download href="/api/admin/catalog-import/jobs/'
              + S.drawerJobId + '/files/' + encodeURIComponent(it.kind) + '">'
              + esc(it.label) + ' <span class="sz">' + fmtBytes(it.bytes) + '</span></a>';
          }).join('')
        + '</div>';
    } else if (f && f.note) {
      dlHtml = '<div class="ci-dl ci-dl-none">' + esc(f.note) + '</div>';
    }
    $('ciDwFoot').innerHTML = dlHtml
      + (d.note ? '<div class="ci-dw-note">' + esc(d.note) + '</div>' : '');
  }

  /* 바이트를 사람이 읽는 크기로 — 내려받기 전에 «얼마나 큰지» 알려준다(28MB 짜리가 있다). */
  function fmtBytes(n) {
    if (typeof n !== 'number' || n < 0) return '';
    if (n < 1024) return n + 'B';
    if (n < 1048576) return (n / 1024).toFixed(0) + 'KB';
    return (n / 1048576).toFixed(1) + 'MB';
  }

  // ── 이벤트 위임 (data-action) ────────────────────────────────────────
  document.addEventListener('click', function (ev) {
    if (ev.target.closest && ev.target.closest('#ciBackdrop')) { closeDrawer(); return; }
    var a = ev.target.closest && ev.target.closest('[data-action]');
    if (!a) return;
    switch (a.getAttribute('data-action')) {
      case 'ci-pick-master': $('ciMasterInput').click(); break;
      case 'ci-clear-master': S.masterFile = null; renderPanel(); break;
      case 'ci-pick-eavp': $('ciEavPInput').click(); break;
      case 'ci-clear-eavp': S.eavProducts = null; renderPanel(); break;
      case 'ci-pick-eavs': $('ciEavSInput').click(); break;
      case 'ci-clear-eavs': S.eavSpecs = null; renderPanel(); break;
      case 'ci-origin-real': S.origin = 'real'; renderPanel(); break;
      case 'ci-origin-demo': S.origin = 'demo'; renderPanel(); break;
      case 'ci-preview': runPreview(); break;
      case 'ci-reset': resetForm(); break;
      case 'ci-apply': runApply(); break;
      case 'ci-open-applied':
        if (S.applied) openDrawer(S.applied.job_id, null);
        break;
      case 'ci-open-job':
        var jid = Number(a.getAttribute('data-jobid'));
        var meta = ((S.jobs && S.jobs.items) || []).filter(function (x) { return x.job_id === jid; })[0] || null;
        openDrawer(jid, meta);
        break;
      case 'ci-drawer-close': closeDrawer(); break;
      case 'ci-dw-tab-error': S.drawerTab = 'error'; renderDrawer(); break;
      case 'ci-dw-tab-kept': S.drawerTab = 'kept'; renderDrawer(); break;
    }
  });
  document.addEventListener('change', function (ev) {
    if (ev.target.id === 'ciMasterInput') { S.masterFile = ev.target.files[0] || null; S.dryrunError = null; renderPanel(); }
    else if (ev.target.id === 'ciEavPInput') { S.eavProducts = ev.target.files[0] || null; renderPanel(); }
    else if (ev.target.id === 'ciEavSInput') { S.eavSpecs = ev.target.files[0] || null; renderPanel(); }
  });
  var panelEl = $('ciPanel');
  panelEl.addEventListener('dragover', function (ev) {
    var dz = ev.target.closest && ev.target.closest('[data-drop="master"]');
    if (dz) { ev.preventDefault(); dz.classList.add('over'); }
  });
  panelEl.addEventListener('dragleave', function (ev) {
    var dz = ev.target.closest && ev.target.closest('[data-drop="master"]');
    if (dz) dz.classList.remove('over');
  });
  panelEl.addEventListener('drop', function (ev) {
    var dz = ev.target.closest && ev.target.closest('[data-drop="master"]');
    if (!dz) return;
    ev.preventDefault(); dz.classList.remove('over');
    var f = ev.dataTransfer && ev.dataTransfer.files && ev.dataTransfer.files[0];
    if (f) { S.masterFile = f; S.dryrunError = null; renderPanel(); }
  });

  // ── 부트스트랩 ──────────────────────────────────────────────────────
  renderScope(); renderAside(); renderPanel(); renderJobs();
  loadMeta(); loadJobs();
  if (window.Admin2Shell && window.Admin2Shell.meReady) {
    window.Admin2Shell.meReady.then(function () {
      S.meLoaded = true;
      S.canUpload = window.Admin2Shell.canWrite('owner');
      renderScope(); renderAside(); renderPanel();
    });
  } else {
    S.meLoaded = true; S.canUpload = false;
    renderScope(); renderAside(); renderPanel();
  }
})();
</script>
{% endblock %}
