.ci-top{flex:none;min-height:300px;display:flex;border:1px solid rgba(0,0,0,.12);border-radius:9px;overflow:hidden;background:var(--card)}
.ci-aside{width:280px;flex:none;background:var(--container);border-right:1px solid rgba(0,0,0,.1);padding:15px;display:flex;flex-direction:column;gap:9px;overflow:auto}
.ci-aside[hidden]{display:none}
.ci-panel{flex:1;min-width:0;padding:16px 20px;display:flex;flex-direction:column;gap:10px;overflow:auto}

.ci-cap{font:600 10.5px/1 var(--font);color:var(--rv-faint);letter-spacing:.04em}
.ci-card{background:var(--card);border:1px solid rgba(0,0,0,.12);border-radius:7px;padding:10px 12px}
.ci-drop{flex:1;border:2px dashed rgba(0,0,0,.28);border-radius:9px;background:var(--card);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;cursor:pointer;padding:22px;min-height:150px}
.ci-drop.over{border-color:var(--on);background:var(--container-low)}
.ci-drop .tag{font:600 13px/1 var(--font-num);color:var(--rv-faint);border:1px solid rgba(0,0,0,.18);border-radius:6px;padding:8px 10px;background:var(--container)}
.ci-drop .t{font:600 14px/1.4 var(--font)}
.ci-drop .d{font:400 11px/1.6 var(--font);color:var(--rv-faint);text-align:center;max-width:420px}
.ci-btn{font:600 12px/1 var(--font);color:var(--rv-canvas);background:var(--on);border:none;border-radius:5px;padding:11px 16px;cursor:pointer}
.ci-btn.ghost{color:var(--on);background:var(--card);border:1px solid rgba(0,0,0,.24)}
