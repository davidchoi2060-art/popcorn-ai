      <div class="ci-panel" id="ciPanel"><div class="ci-loading">불러오는 중…</div></div>
    </section>

    <section class="ci-hist">
      <div class="ci-hist-hd">
        <span class="ci-hist-title">배치 이력</span>
        <span class="ci-hist-count" id="ciHistCount">—</span>
        <span class="ci-grow"></span>
        <span class="ci-hist-cat" id="ciHistCat"></span>
      </div>
      <div class="ci-hist-scroll" id="ciHistScroll">
        <div class="ci-row ci-row-head">
          <span>배치</span><span>시각</span><span>업로더</span><span>파일명</span><span>원천</span>
          <span style="text-align:right">업로드 행</span><span style="text-align:right">반영</span>
          <span style="text-align:right">검수</span><span style="text-align:right">오류</span><span>상태</span>
