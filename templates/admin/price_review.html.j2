{% block content %}
<div class="pr-root" data-screen-id="ADM-PRC-010" data-domain="price-review">
  <div class="pr-loading" id="prLoading">불러오는 중…</div>
  <div class="pr-error" id="prError" hidden></div>

  <div id="prMain" class="pr-main-flex" hidden>
    <div class="pr-kpis" id="prKpis"></div>
    <div class="pr-tablewrap">
      <div class="pr-thead" role="row">
        <span role="columnheader">상품번호</span>
        <span role="columnheader">상품명</span>
        <span role="columnheader" class="c-num">매입가</span>
        <span role="columnheader" class="c-num">현재</span>
        <span role="columnheader" class="c-num">제안</span>
        <span role="columnheader" class="c-num">마진</span>
        <span role="columnheader">사유</span>
      </div>
      <div class="pr-tbody" id="prTbody" role="table" aria-label="가격 검토 대기 목록"></div>
      <div class="pr-footnote" id="prFootnote"></div>
    </div>
  </div>

  <div class="pr-empty" id="prEmpty" hidden>
    <div class="pr-empty-main">
      <div class="pr-empty-title">지금 검토할 것이 없습니다</div>
      <div class="pr-empty-sub" id="prEmptySub">판매가가 비어 있으면서 검수까지 끝난 상품이 —건입니다.</div>
      <div class="pr-reason">
        <div class="pr-reason-hd">왜 비어 있는가 — 파생 조건을 그대로 풀어 씁니다</div>
        <div id="prReasonLines">
          <div class="pr-loading" style="padding:14px 0">불러오는 중…</div>
        </div>
        <div class="pr-reason-cond" id="prReasonCond">—</div>
      </div>
    </div>
    <aside class="pr-empty-aside">
      <div class="pr-aside-box">
        <h4>v1 은 「첫 산정」 유형 하나뿐입니다</h4>
        <p id="prAsideNote">—</p>
      </div>
      <div class="pr-aside-box">
        <h4>제안가는 이렇게 계산됩니다</h4>
        <div class="pr-reason-cond" id="prFormula" style="margin-top:0">—</div>
        <p style="margin-top:8px">매입가가 없으면 공급처 최저 매입가를 대신 씁니다. 둘 다 없으면 제안가·마진이
          비어 오고, 화면은 그것을 「제안할 수 없음」으로 밝힙니다(빈 칸으로 두지 않습니다).</p>
      </div>
      <div class="pr-aside-box">
        <h4>세 가지 판정과 그 결과</h4>
        <div class="pr-verdict-mini">
          <div class="row"><b>① 승인</b><span>제안가로 확정합니다 — 이력에 margin_policy 사유로 남습니다</span></div>
          <div class="row"><b>② 직접 입력</b><span>0보다 큰 값 · 1,000원 단위 강제 없음 · 판매가가 잠깁니다</span></div>
          <div class="row"><b>③ 유지</b><span>값은 비운 채 「다시 제안하지 마라」로 잠급니다 — 추천 후보에서 계속 빠집니다</span></div>
        </div>
      </div>
    </aside>
  </div>
</div>

<div class="pr-backdrop" id="prBackdrop" data-keep="1" hidden></div>
<aside class="pr-drawer" id="prDrawer" data-keep="1" hidden>
  <div class="pr-dw-hd">
    <div class="row1">
      <span class="title" id="dwTitle">—</span>
      <span class="pr-badge">첫 산정</span>
      <button type="button" class="close" data-action="pr-close-drawer" aria-label="닫기">✕</button>
    </div>
    <div class="pr-dw-meta">
      <span id="dwCode">—</span>
      <span id="dwCat">—</span>
      <span>판매가 미정</span>
      <span>검수 완료</span>
    </div>
  </div>
  <div class="pr-dw-body" id="dwBody">
    <div class="pr-value-cards">
      <div class="pr-value-card">
        <div class="lb">매입가</div>
        <div class="v" id="dwPurchase">—</div>
        <div class="d" id="dwPurchaseSrc">—</div>
      </div>
      <div class="pr-value-card">
        <div class="lb">제안 판매가</div>
        <div class="v" id="dwProposed">—</div>
        <div class="d" id="dwProposedSrc">—</div>
      </div>
    </div>

    <div class="pr-warn" id="dwWarn" hidden></div>

    <div class="pr-verdicts">
      <div class="pr-verdict">
        <div class="row1"><span class="num">①</span><span class="lb">제안가 승인</span>
          <span class="amt" id="dwApproveAmt">—</span></div>
        <div class="desc">이력에 margin_policy 사유로 남습니다</div>
        <div class="act">
          <button type="button" class="pr-btn primary" id="dwApproveBtn" data-action="pr-approve">승인</button>
        </div>
      </div>
      <div class="pr-verdict">
        <div class="row1"><span class="num">②</span><span class="lb">직접 입력</span></div>
        <div class="desc">0보다 큰 값 · 1,000원 단위 강제 없음 · 잠깁니다</div>
        <div class="act">
          <label for="dwManualPrice" style="position:absolute;left:-9999px">직접 입력 판매가</label>
          <input type="number" class="pr-manual-input" id="dwManualPrice" min="1" step="1" placeholder="판매가 입력">
          <button type="button" class="pr-btn" id="dwManualBtn" data-action="pr-manual">확정</button>
        </div>
        <div class="pr-inline-err" id="dwManualErr" hidden></div>
      </div>
      <div class="pr-verdict">
        <div class="row1"><span class="num">③</span><span class="lb">미정으로 유지</span></div>
        <div class="desc">값은 비워 두고 「다시 제안하지 마라」로 잠급니다 — 추천 후보에서는 계속 빠집니다</div>
        <div class="act">
          <button type="button" class="pr-btn" id="dwKeepBtn" data-action="pr-keep">유지</button>
        </div>
      </div>
    </div>
  </div>
  <div class="pr-dw-foot">
    어느 판정이든 <b>처리 즉시 이 상품은 큐에서 사라집니다. 이 화면에는 되돌리기가 없습니다</b> —
    잘못 처리하면 상품 관리에서 값을 다시 고쳐야 하고, 판정 자체는 작업 기록에만 남습니다.
  </div>
</aside>
{% endblock %}

{% block foot_extra %}
{% raw %}
<script>
(function () {
  'use strict';

  var API_LIST = '/api/admin/price-review';
  var API_BREAKDOWN = '/api/admin/price-review/empty-breakdown';
  function API_DECIDE(code) { return '/api/admin/price-review/' + code + '/decide'; }
  function API_PRODUCT(code) { return '/api/admin/products/' + code; }
  var LOGIN_URL = '/admin/login.html';

  var S = { items: [], fee: null, margin: null, note: '', breakdown: null, openCode: null, suppliers: null };

  function $(id) { return document.getElementById(id); }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
    });
  }
  function fmtWon(n) { return (n == null) ? '—' : Number(n).toLocaleString('ko-KR') + '원'; }
  function fmtPct1(n) { return (n == null) ? '—' : Number(n).toFixed(1) + '%'; }
  function fmtFee3(n) { return (n == null) ? '—' : (Number(n) * 100).toFixed(3) + '%'; }
  function fmtMargin1(n) { return (n == null) ? '—' : (Number(n) * 100).toFixed(1) + '%'; }

  function setError(msg, opts) {
    $('prLoading').hidden = true;
    $('prMain').hidden = true;
    $('prEmpty').hidden = true;
    var box = $('prError');
    box.hidden = false;
    box.innerHTML = esc(msg) + (opts && opts.relogin
      ? ' <a href="' + LOGIN_URL + '">다시 로그인</a>'
      : ' <button type="button" data-action="pr-retry">다시 시도</button>');
  }

  function load() {
    $('prLoading').hidden = false;
    $('prError').hidden = true;
    $('prMain').hidden = true;
    $('prEmpty').hidden = true;

    var listP = fetch(API_LIST).then(function (res) {
      return res.json().catch(function () { return null; }).then(function (body) {
        return { ok: res.ok, status: res.status, body: body };
      });
    });
    var bdP = fetch(API_BREAKDOWN).then(function (res) {
      return res.json().catch(function () { return null; }).then(function (body) {
        return { ok: res.ok, status: res.status, body: body };
      });
    }).catch(function () { return { ok: false, status: 0, body: null }; });

    Promise.all([listP, bdP]).then(function (results) {
      var L = results[0], B = results[1];
      if (!L.ok) {
        if (L.status === 401) {
          setError('세션이 만료되었습니다 — 다시 로그인해야 합니다.', { relogin: true });
          return;
        }
        var d = L.body && (L.body.detail || L.body.error || L.body.message);
        setError('목록을 불러오지 못했습니다 — 오류 ' + L.status + (d ? ' · ' + d : ''));
        return;
      }
      S.items = (L.body && L.body.items) || [];
      S.fee = L.body ? L.body.fee_rate : null;
      S.margin = L.body ? L.body.margin_rate : null;
      S.note = (L.body && L.body.note) || '';
      S.breakdown = B.ok ? B.body : null;
      $('prLoading').hidden = true;
      renderHeadNote();
      if (S.items.length === 0) { renderEmpty(); } else { renderMain(); }
    }, function (err) {
      setError('네트워크 오류 — ' + (err && err.message ? err.message : '서버에 연결할 수 없습니다'));
    });
  }

  function renderHeadNote() {
    var n = $('prHeadNote');
    if (!n) return;
    if (S.fee == null || S.margin == null) { n.textContent = '마진·수수료 값을 불러오지 못했습니다'; return; }
    n.textContent = '지금 마진 ' + fmtMargin1(S.margin) + ' · 카드수수료 ' + fmtFee3(S.fee) + ' 기준으로 제안합니다';
  }

  // ── 1a 빈 큐 ──────────────────────────────────────────────────────
  function renderEmpty() {
    $('prEmpty').hidden = false;
    var q = (S.breakdown && S.breakdown.queue != null) ? S.breakdown.queue : S.items.length;
    $('prEmptySub').innerHTML = '판매가가 비어 있으면서 검수까지 끝난 상품이 <b>' + q +
      '건</b>입니다.<br>조회가 실패한 것이 아니라 지금 그런 상품이 없습니다.';

    var linesBox = $('prReasonLines');
    if (!S.breakdown) {
      linesBox.innerHTML = '<div class="pr-reason-line"><span class="t">이유 갈래를 세지 못했습니다(집계 조회 실패) '
        + '— 큐가 ' + q + '건이라는 사실은 위 목록 조회로 이미 확인됐습니다.</span></div>';
    } else {
      var nTotal = S.breakdown.null_total, nReview = S.breakdown.review_pending, nLocked = S.breakdown.locked_out;
      var l2 = (nTotal > 0 && nReview === nTotal)
        ? '그 ' + nTotal + '건은 전부 아직 검수 대기 중입니다 — 검수가 끝나야 이 큐로 넘어옵니다'
        : (nReview === 0
          ? '검수 대기 때문에 빠진 건은 없습니다'
          : '그중 ' + nReview + '건이 아직 검수 대기 중입니다 — 검수가 끝나야 이 큐로 넘어옵니다');
      var l3 = (nLocked === 0)
        ? '잠금 때문에 빠진 건은 없습니다'
        : '잠금 때문에 빠진 건이 있습니다 — 「다시 제안하지 마라」로 잠근 상품입니다';
      linesBox.innerHTML =
        '<div class="pr-reason-line"><span class="m">—</span><span class="t">판매가가 비어 있는 상품 자체가 적습니다</span>'
        + '<span class="n">' + nTotal + '건</span></div>'
        + '<div class="pr-reason-line"><span class="m">▲</span><span class="t">' + esc(l2) + '</span>'
        + '<span class="n">' + nReview + '건</span></div>'
        + '<div class="pr-reason-line"><span class="m">·</span><span class="t">' + esc(l3) + '</span>'
        + '<span class="n">' + nLocked + '건</span></div>';
    }
    $('prReasonCond').textContent =
      'sale_price IS NULL AND review_required_yn = false AND NOT (locked_fields @> \'["sale_price"]\'::jsonb)';

    $('prAsideNote').textContent = S.note
      || 'v1은 「첫 산정」(판매가 미산정) 유형만 실데이터입니다 — 매입가 ±15% 임계·마진 정책 위반'
      + ' 유형은 원천이 준비되면 합류합니다.';
    renderFormulaBlock('prFormula');
  }

  function renderFormulaBlock(id) {
    var box = $(id);
    if (!box) return;
    if (S.fee == null || S.margin == null) { box.textContent = '마진·수수료 값을 불러오지 못했습니다'; return; }
    var feeTxt = fmtFee3(S.fee), marginTxt = fmtMargin1(S.margin);
    var mult = (1 + S.fee + S.margin).toFixed(5);
    box.textContent = '제안가 = 매입가 × (1 + 카드수수료 ' + feeTxt + ' + 마진 ' + marginTxt + ')\n'
      + '     = 매입가 × ' + mult + ' → 1,000원 단위 반올림';
  }

  // ── 1b 대상 있음 ──────────────────────────────────────────────────
  function renderMain() {
    $('prMain').hidden = false;
    renderKpis();
    renderRows();
    $('prFootnote').textContent =
      '전체 ' + S.items.length + '건 · 직접입력은 0보다 큰 값을 요구합니다(1,000원 단위 강제 없음) · '
      + '「유지」는 값을 비운 채 「다시 제안하지 마라」는 잠금만 남깁니다 · '
      + '되돌리기는 이 화면에 없고 활동 기록에만 남습니다.';
  }

  function renderKpis() {
    var items = S.items;
    var noPurchase = items.filter(function (i) { return i.purchase == null; }).length;
    var withMargin = items.filter(function (i) { return i.margin_pct != null; });
    var avgMargin = withMargin.length
      ? (withMargin.reduce(function (s, i) { return s + i.margin_pct; }, 0) / withMargin.length)
      : null;
    var polN = S.breakdown ? S.breakdown.category_margin_policy_count : null;

    var cards = [
      { label: '검토 대기', value: items.length + '건', sub: '판매가 미정 · 검수 완료 · 잠금 없음', warn: false },
      { label: '제안 불가(매입가 없음)', value: noPurchase + '건', sub: '매입가·공급처 정보 모두 없음',
        warn: noPurchase > 0 },
      { label: '평균 제안 마진', value: (avgMargin == null ? '—' : avgMargin.toFixed(1) + '%'),
        sub: '표본 ' + withMargin.length + '건', warn: false },
      { label: '적용 마진', value: fmtMargin1(S.margin),
        sub: (polN == null ? '분류별 정책 값을 불러오지 못했습니다' : '분류별 정책 ' + polN + '건'), warn: false },
    ];
    $('prKpis').innerHTML = cards.map(function (c) {
      return '<div class="pr-kpi' + (c.warn ? ' warn' : '') + '">'
        + '<div class="k-label">' + esc(c.label) + '</div>'
        + '<div class="k-value">' + esc(c.value) + '</div>'
        + '<div class="k-sub">' + esc(c.sub) + '</div></div>';
    }).join('');
  }

  function rowHtml(item) {
    var noPurchase = item.purchase == null;
    var why = noPurchase ? '제안할 수 없음 — 매입가가 없습니다' : (item.why || '첫 산정');
    return '<div class="pr-row" role="row" tabindex="0" data-code="' + esc(item.product_code) + '">'
      + '<span role="cell" class="c-num">' + esc(item.product_code) + '</span>'
      + '<span role="cell" class="c-name" title="' + esc(item.name) + '">' + esc(item.name) + '</span>'
      + '<span role="cell" class="c-num' + (noPurchase ? ' c-err' : '') + '">'
      + (noPurchase ? '없음' : fmtWon(item.purchase)) + '</span>'
      + '<span role="cell" class="c-num c-muted">미정</span>'
      + '<span role="cell" class="c-num">' + fmtWon(item.proposed) + '</span>'
      + '<span role="cell" class="c-num">' + fmtPct1(item.margin_pct) + '</span>'
      + '<span role="cell" class="' + (noPurchase ? 'c-err' : 'c-muted') + '">' + esc(why) + '</span>'
      + '</div>';
  }

  function renderRows() {
    $('prTbody').innerHTML = S.items.map(rowHtml).join('');
  }

  // ── 서랍 ─────────────────────────────────────────────────────────
  function findItem(code) {
    for (var i = 0; i < S.items.length; i++) {
      if (String(S.items[i].product_code) === String(code)) return S.items[i];
    }
    return null;
  }

  function openDrawer(code) {
    var item = findItem(code);
    if (!item) return;
    S.openCode = code;
    S.suppliers = null;

    $('dwTitle').textContent = item.name || ('상품 ' + code);
    $('dwCode').textContent = 'No.' + item.product_code + (item.sku ? ' · ' + item.sku : '');
    $('dwCat').textContent = item.cat || '—';
    $('dwPurchase').textContent = item.purchase == null ? '없음' : fmtWon(item.purchase);
    $('dwPurchaseSrc').textContent = item.purchase == null ? '공급처 매입가 없음'
      : ('공급처 최저 · ' + (item.supplier || '—'));
    $('dwProposed').textContent = item.proposed == null ? '제안할 수 없음' : fmtWon(item.proposed);
    $('dwProposedSrc').textContent = item.proposed == null ? '매입가가 없어 계산할 수 없습니다'
      : ('마진 ' + fmtPct1(item.margin_pct) + ' · 1,000원 단위');

    $('dwApproveAmt').textContent = item.proposed == null ? '—' : fmtWon(item.proposed);
    var approveBtn = $('dwApproveBtn');
    approveBtn.disabled = (item.proposed == null);
    approveBtn.title = (item.proposed == null)
      ? '매입가가 없어 제안가를 계산할 수 없습니다 — 직접 입력 또는 유지를 쓰세요' : '';

    $('dwManualPrice').value = '';
    $('dwManualErr').hidden = true;

    buildWarn(null);
    $('prBackdrop').hidden = false;
    $('prDrawer').hidden = false;

    fetch(API_PRODUCT(code)).then(function (res) {
      return res.json().catch(function () { return null; }).then(function (j) { return { ok: res.ok, body: j }; });
    }).then(function (r) {
      if (S.openCode !== code) return;               // 그 사이 다른 행을 열었으면 버린다
      if (!r.ok || !r.body) { buildWarn([]); return; }
      S.suppliers = r.body.suppliers || [];
      buildWarn(S.suppliers);
    }, function () { if (S.openCode === code) buildWarn([]); });
  }

  function closeDrawer() {
    S.openCode = null;
    $('prDrawer').hidden = true;
    $('prBackdrop').hidden = true;
  }

  function buildWarn(suppliers) {
    var box = $('dwWarn');
    if (suppliers === null) {
      box.hidden = false; box.className = 'pr-warn mini';
      box.innerHTML = '<div class="t">공급처 정보 확인 중…</div>';
      return;
    }
    if (!suppliers.length) {
      box.hidden = false; box.className = 'pr-warn mini';
      box.innerHTML = '<div class="t">연결된 공급처가 없습니다</div>'
        + '<div class="d">이 매입가는 공급처 단가가 아니라 상품 정보에 저장된 값입니다.</div>';
      return;
    }
    var sorted = suppliers.slice().sort(function (a, b) { return (a.cost_price || 0) - (b.cost_price || 0); });
    var list = sorted.map(function (s) {
      return esc(s.supplier) + ' ' + fmtWon(s.cost_price)
        + (s.state && s.state !== '가능' ? '(' + esc(s.state) + ')' : '');
    }).join(' · ');
    if (suppliers.length === 1) {
      box.hidden = false; box.className = 'pr-warn mini';
      box.innerHTML = '<div class="t">공급처가 1곳입니다</div>'
        + '<div class="d">' + list + ' — 승인하면 매입가가 이 값으로 갱신될 수 있습니다.</div>';
      return;
    }
    box.hidden = false; box.className = 'pr-warn';
    box.innerHTML = '<div class="t">승인하면 매입가도 함께 재판정될 수 있습니다</div>'
      + '<div class="d">이 상품은 공급처가 <b>' + suppliers.length + '곳</b>입니다(' + list + '). 승인 처리는'
      + ' 재산정 함수를 재사용하므로 매입가가 최저값으로 갱신될 수 있습니다 — 판매가만 승인한 줄 알았는데'
      + ' 매입가도 바뀌는 일을 막기 위해 미리 밝힙니다.</div>'
      + '<div class="suppliers">' + list + '</div>';
  }

  // ── 판정 ─────────────────────────────────────────────────────────
  function confirmIrreversible(msg) {
    return window.confirm(msg + '\n\n처리 즉시 이 상품은 큐에서 사라지고, 이 화면에는 되돌리기가 없습니다.'
      + ' 계속하시겠습니까?');
  }

  function decide(code, action, price) {
    return fetch(API_DECIDE(code), {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: action, price: price == null ? null : price }),
    }).then(function (res) {
      return res.json().catch(function () { return null; }).then(function (j) {
        return { ok: res.ok, status: res.status, body: j };
      });
    });
  }

  function afterDecideSuccess() {
    closeDrawer();
    load();
  }

  function onApprove() {
    var code = S.openCode, item = findItem(code);
    if (!item || item.proposed == null) return;
    if (!confirmIrreversible('제안가 ' + fmtWon(item.proposed) + '(으)로 승인합니다.')) return;
    decide(code, 'approve').then(function (r) { if (r.ok) afterDecideSuccess(); });
  }

  function onManual() {
    var code = S.openCode;
    var input = $('dwManualPrice');
    var v = Number(input.value);
    var errBox = $('dwManualErr');
    if (!input.value || !(v > 0) || !isFinite(v)) {
      errBox.hidden = false; errBox.textContent = '0보다 큰 값을 입력하세요.';
      return;
    }
    errBox.hidden = true;
    if (!confirmIrreversible('직접 입력값 ' + fmtWon(v) + '(으)로 확정하고 판매가를 잠급니다.')) return;
    decide(code, 'manual', v).then(function (r) {
      if (r.ok) { afterDecideSuccess(); return; }
      errBox.hidden = false;
      errBox.textContent = (r.body && r.body.detail) || ('오류 ' + r.status);
    });
  }

  function onKeep() {
    var code = S.openCode;
    if (!confirmIrreversible('판매가를 미정으로 유지하고, 다시 제안하지 않도록 잠급니다.')) return;
    decide(code, 'keep').then(function (r) { if (r.ok) afterDecideSuccess(); });
  }

  // ── 이벤트 배선 ──────────────────────────────────────────────────
  document.addEventListener('click', function (e) {
    var actionEl = e.target.closest('[data-action]');
    if (actionEl) {
      var act = actionEl.getAttribute('data-action');
      if (act === 'pr-close-drawer') { closeDrawer(); return; }
      if (act === 'pr-approve') { onApprove(); return; }
      if (act === 'pr-manual') { onManual(); return; }
      if (act === 'pr-keep') { onKeep(); return; }
      if (act === 'pr-retry') { load(); return; }
    }
    var row = e.target.closest('.pr-row');
    if (row) { openDrawer(row.getAttribute('data-code')); return; }
    if (e.target.closest('[data-keep]')) return;
    if (S.openCode != null) closeDrawer();
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && S.openCode != null) closeDrawer();
  });

  $('prTbody').addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    var row = e.target.closest('.pr-row');
    if (row) { e.preventDefault(); openDrawer(row.getAttribute('data-code')); }
  });

  load();
})();
</script>
{% endraw %}
{% endblock %}
